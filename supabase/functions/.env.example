# Blak-on-WhatsApp Edge secrets. Set with:
#   supabase secrets set --env-file supabase/functions/.env
# NEVER commit the filled-in version. Live secrets (token, app secret,
# service-role key) must only ever live in Edge Function secrets.

# ── Supabase (the brain) ────────────────────────────────────────────────────
SUPABASE_URL=
# Service-role key — bypasses RLS, server-only. Do NOT expose to any browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta WhatsApp Cloud API ─────────────────────────────────────────────────
# From Meta Business Suite -> WhatsApp -> API Setup (number +91 7702063434).
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token (whatsapp_business_messaging + _management).
WHATSAPP_TOKEN=
# App -> Settings -> Basic -> App Secret (used to verify webhook signatures).
WHATSAPP_APP_SECRET=
# A random string you invent; set the SAME value in the webhook config dialog.
WHATSAPP_VERIFY_TOKEN=

# ── LLM providers (Qwen 2.5 72B). At least one required; more = no downtime. ──
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=

# ── Proactive engine guard ──────────────────────────────────────────────────
# Random string; pg_cron sends it in the x-cron-secret header.
CRON_SECRET=
