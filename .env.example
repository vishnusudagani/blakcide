# Blaksyd site — environment variables (example).
# Copy to `.env` for local dev, and set the same keys in Netlify (Site settings →
# Environment variables) for production. NEVER commit real secrets.
#
# ── Phase 0 minimum to run Blak ──────────────────────────────────────────────
#   Required: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#             SUPABASE_JWT_SECRET, SYMP_API_KEY, and at least ONE LLM key
#             (GEMINI_API_KEY recommended on credits, or GROQ_API_KEY free floor).
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Blaksyd → Symp proxy (shared secret injected server-side; never in browser) ─
SYMP_API_KEY=

# ── LLM router (open-source / Gemini; OpenAI-compatible) ─────────────────────
# Priority (user chat): Azure GPT-4o-mini (credit-covered primary) → Gemini →
# Qwen 2.5 72B hosts → Groq Llama floor. A provider with no key is silently
# skipped. COST GUARDRAIL: only the user-facing chat uses Azure; ALL background
# work (vibe/summary/search) defaults to the free Groq floor, never Azure.

# Azure OpenAI — RELIABLE PRIMARY for beta, covered by the $1k Azure credit.
# Set ALL THREE to activate (the entry drops out if any is missing). ENDPOINT is
# your resource URL; DEPLOYMENT is the NAME you gave the gpt-4o-mini deployment.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21        # optional; GA default is fine

# Gemini — the org disallows Google API keys, so Blak reaches Gemini through the
# ADC Cloud Run proxy in services/gemini-proxy (authenticates to Vertex via the
# service account, no keys; draws the GCP credits). Point GEMINI_BASE_URL at the
# deployed proxy; GEMINI_API_KEY is the proxy's PROXY_SECRET (NOT a Google key).
GEMINI_BASE_URL=https://blak-vertex-proxy-XXXX.run.app/v1/chat/completions
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash         # chat: best quality-per-rupee
GEMINI_VOICE_MODEL=gemini-2.5-flash-lite   # calls (Phase 2): fastest + cheapest. Never use Pro.

# Qwen 2.5 72B hosts (any one is enough; OpenRouter also enables web search)
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=

# Groq — free tier, sub-second; the always-available downtime floor + voice STT
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Sarvam — India-native models (chat + Telugu/Hindi TTS/STT). Used by the
# bake-off now; promoted into the router once the endpoint/auth is confirmed.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-m
# SARVAM_BASE_URL=https://api.sarvam.ai/v1/chat/completions

# Optional embeddings for semantic memory (Phase 1)
# SYMP_EMBED_PROVIDER=
# SYMP_EMBED_BASE_URL=
# SYMP_EMBED_MODEL=

# ── Voice (Phase 2) ──────────────────────────────────────────────────────────
# Self-hosted TTS / voice-clone on Modal (voice notes + Persona voice)
VOICE_INFER_URL=
VOICE_INFER_SECRET=
BLAK_VOICE_DESCRIPTION=
# Realtime calls — LiveKit Agents worker
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# TURN/ICE for WebRTC
METERED_API_KEY=
METERED_APP_NAME=

# ── WhatsApp Blak channel (Meta Cloud API) ───────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANG=en
WHATSAPP_OTP_BUTTON=
SEND_SMS_HOOK_SECRET=

# ── Twilio (SMS/voice fallback) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Stripe (credits / billing) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_100=
STRIPE_PRICE_500=
STRIPE_PRICE_2500=
STRIPE_PRICE_10000=

# ── Spotify (suggestions tool) ───────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Legacy — being removed (no OpenAI on the Blak path) ──────────────────────
# OPENAI_API_KEY=
# BLAKCIDE_OPENAI_KEY=
