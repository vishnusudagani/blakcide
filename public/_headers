# ───────────── Landing-only hardening (HTML document routes) ─────────────
# CSP notes:
#   - script-src/style-src include 'unsafe-inline' because the no-flash theme
#     script must run inline before paint and the section animations are inline.
#     The page has no user input / reflected data, so practical XSS surface ~ 0.
#     This can be upgraded to hash-based (drop 'unsafe-inline') by moving the
#     non-head scripts to Astro-bundled files — a follow-up, not required now.
#   - connect-src 'self' blocks any external exfiltration; widen it only when
#     real auth/analytics are wired in.
#   - fonts are self-hosted (/fonts/*, same-origin); no external font origins,
#     so font-src/style-src stay 'self' (style-src keeps 'unsafe-inline' for the
#     bundled/inline styles only).
/
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://uoosspumdmffccinszuj.supabase.co wss://uoosspumdmffccinszuj.supabase.co; manifest-src 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
