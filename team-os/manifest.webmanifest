{
  "name": "blaksyd Team OS",
  "short_name": "Team OS",
  "description": "Operating system for the blaksyd team — tasks, roadmaps, contacts, comments, AI triage.",
  "start_url": "/team-os/",
  "scope": "/team-os/",
  "id": "/team-os/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0F172A",
  "theme_color": "#0F172A",
  "icons": [
    {
      "src": "brand/blaksyd-white.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "brand/blaksyd-white.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/team-os/?share=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    { "name": "My work",   "short_name": "My", "url": "/team-os/my",      "description": "Tasks assigned to me" },
    { "name": "Tasks",     "short_name": "Tasks", "url": "/team-os/tasks", "description": "Kanban board" },
    { "name": "Checklist", "short_name": "List",  "url": "/team-os/checklist", "description": "Personal checklist" }
  ],
  "categories": ["productivity", "business"]
}
