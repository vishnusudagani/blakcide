---
// AppLayout — the logged-in Blaksyd BETA app shell (UI only for now).
// "First Light" dark warm-dawn aesthetic, distinct from the cream marketing site
// so signing in *feels* like entering the product. Sidebar on desktop, bottom
// tab-bar on mobile. Not indexed. Real auth-gating + functionality land per-pillar.
import '../styles/fonts.css';
import '../styles/tokens.css';

interface Props { active?: 'home' | 'blak' | 'persona' | 'minit' | 'nexus' | 'profile'; title?: string; soon?: boolean; chat?: boolean; }
const { active = 'home', title = 'Home', soon = false, chat = false } = Astro.props;

// soon: feature is a preview, not yet live (Blak / Persona / Minit). Nexus is live.
// Each pillar carries a distinct glyph + its brand colour (tokens.css):
// Blak = spark (coral) · Minit = caring message (mint) · Nexus = constellation (aqua) · Persona = identity frame (lavender).
const nav = [
  { id: 'blak',    href: '/beta/blak/',    label: 'Blak',    c: 'coral', svg: '<path d="M12 4l1.7 5 5 1.7-5 1.7L12 17.4l-1.7-5L5.3 10.7l5-1.7z"/><path d="M18.8 3.6l.5 1.6 1.6.5-1.6.5-.5 1.6-.5-1.6-1.6-.5 1.6-.5z"/>' },
  { id: 'persona', href: '/beta/persona/', label: 'Persona', c: 'lav',   soon: true, svg: '<rect x="4" y="4" width="16" height="16" rx="5.5"/><circle cx="12" cy="10" r="2.5"/><path d="M7.9 17.3a4.5 4.5 0 0 1 8.2 0"/>' },
  { id: 'minit',   href: '/beta/minit/',   label: 'Minit',   c: 'mint',  svg: '<path d="M20 11.5a7.5 7.5 0 0 1-10.8 6.7L4 20l1.8-4.7A7.5 7.5 0 1 1 20 11.5z"/><path d="M12 14.7l-2.3-2.2a1.55 1.55 0 1 1 2.3-2.05 1.55 1.55 0 1 1 2.3 2.05z"/>' },
  { id: 'nexus',   href: '/beta/nexus/',   label: 'Nexus',   c: 'aqua',  svg: '<circle cx="6" cy="7" r="2.1"/><circle cx="18" cy="7" r="2.1"/><circle cx="12" cy="17.5" r="2.1"/><path d="M7.9 8 10.6 15.6M16.1 8 13.4 15.6M8.1 7h7.8"/>' },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#0B0D1F" />
  <title>{title} · Blaksyd beta</title>
  <link rel="icon" href="/favicon.ico" />
  <script is:inline>
    /* Match the OS (or an explicit choice shared with the marketing site) before
       paint, so the app isn't locked to dark. Priority: stored toggle → OS → dark. */
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'light' ? '#FAF4EC' : '#0B0D1F');
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <div class="ap-atmos" aria-hidden="true"></div>

  <div class={`ap ${active === 'blak' || chat ? 'ap--chat' : ''}`}>
    <!-- ── side / brand rail ── -->
    <aside class="ap-rail">
      <a href="/beta/" class="ap-brand" aria-label="Blaksyd beta">
        <span class="ap-mark"></span><span class="ap-beta">beta</span>
      </a>
      <nav class="ap-nav" aria-label="Blaksyd">
        {nav.map((n) => (
          <a href={n.href} data-nav={n.id} class={`ap-link c-${n.c} ${active === n.id ? 'is-on' : ''}`} aria-current={active === n.id ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={n.svg} />
            <span>{n.label}</span>
            {n.soon && <span class="ap-link-soon">soon</span>}
          </a>
        ))}
      </nav>
      <div class="ap-me">
        <button type="button" class="ap-avatar" id="ap-avatar" aria-label="Your account">Y</button>
        <button type="button" class="ap-theme" id="ap-theme" aria-label="Switch light or dark theme" title="Theme">
          <svg class="ap-ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="ap-ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
        </button>
        <button type="button" class="ap-signout" id="ap-signout">Sign out</button>
      </div>
    </aside>

    <!-- ── content ── -->
    <main class="ap-main" id="main">
      {soon && (
        <div class="ap-soon-banner">
          <span class="ap-soon-dot"></span>
          <span><b>{title} is coming soon</b> — an early preview, not live yet.</span>
        </div>
      )}
      <slot />
    </main>
  </div>

  <!-- app-wide in-app notification banner (Minit "listener free", etc.) -->
  <div class="ap-notif" id="ap-notif" hidden role="status" aria-live="polite"></div>

  <style is:global>
    /* color-scheme follows the theme via tokens.css (:root = dark, [data-theme=light] = light) */
    * { box-sizing: border-box; }
    /* in-app notification banner */
    .ap-notif { position: fixed; z-index: 9500; left: 50%; top: 16px; transform: translateX(-50%) translateY(-150%); width: min(440px, calc(100vw - 24px)); display: flex; align-items: center; gap: .7rem; padding: .65rem .7rem .65rem .9rem; border-radius: var(--r-pill); background: var(--glass-strong); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border: 1px solid rgba(106,211,184,.4); box-shadow: 0 18px 50px rgba(0,0,0,.4), 0 0 30px rgba(106,211,184,.12); opacity: 0; transition: transform .42s var(--ease-soft), opacity .3s ease; cursor: pointer; }
    .ap-notif.show { transform: translateX(-50%) translateY(0); opacity: 1; }
    .ap-notif[hidden] { display: none; }
    .ap-notif-dot { width: 10px; height: 10px; border-radius: 50%; flex: none; background: var(--mint-deep); box-shadow: 0 0 10px var(--mint-deep); }
    .ap-notif-tx { flex: 1; min-width: 0; }
    .ap-notif-tx b { display: block; font-size: var(--fs-sm); color: var(--ink); font-weight: 650; }
    .ap-notif-tx span { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: var(--fs-xs); color: var(--ink-soft); overflow: hidden; }
    .ap-notif-x { flex: none; width: 44px; height: 44px; border: 8px solid transparent; background-clip: padding-box; border-radius: 50%; background-color: var(--surface); color: var(--ink-faint); cursor: pointer; font-size: .95rem; line-height: 1; display: grid; place-items: center; }
    .ap-notif-x:hover { color: var(--ink); }
    @media (max-width: 560px) { .ap-notif { top: auto; bottom: calc(96px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%) translateY(180%); } .ap-notif.show { transform: translateX(-50%) translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .ap-notif { transition: opacity .3s ease; } }
    html, body { margin: 0; height: 100%; }
    body {
      font-family: var(--font-body); color: var(--ink); background: var(--bg);
      -webkit-font-smoothing: antialiased;
    }
    /* Subtle Gemini-style wash — clean up top, a soft warm Blaksyd tint pooled
       low (behind the composer). Low intensity, even — not loud blooms. */
    .ap-atmos {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background:
        radial-gradient(120% 55% at 50% 113%, rgba(255, 150, 120, .10), transparent 60%),
        linear-gradient(180deg, transparent 46%, rgba(201, 184, 255, .05));
    }
    html[data-theme="light"] .ap-atmos {
      background:
        radial-gradient(120% 55% at 50% 112%, rgba(255, 138, 108, .12), transparent 62%),
        linear-gradient(180deg, transparent 50%, rgba(255, 182, 138, .06));
    }

    .ap { position: relative; z-index: 1; display: grid; grid-template-columns: 248px 1fr; min-height: 100vh; min-height: 100svh; }

    /* rail */
    .ap-rail {
      position: sticky; top: 0; height: 100vh; height: 100svh;
      display: flex; flex-direction: column; gap: 1.4rem;
      padding: 1.5rem 1.1rem; border-right: 1px solid var(--line);
      background: rgba(8, 9, 26, .45); backdrop-filter: blur(12px);
    }
    html[data-theme="light"] .ap-rail { background: rgba(255, 252, 244, .6); }
    .ap-brand { display: inline-flex; align-items: center; gap: .5rem; }
    .ap-mark { display: block; height: 24px; width: 84px; background: url('/assets/blaksyd-white.webp') left center / contain no-repeat; }
    html[data-theme="light"] .ap-mark { background-image: url('/assets/blaksyd-black.webp'); }
    .ap-beta {
      font-family: var(--font-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase;
      color: var(--gold); border: 1px solid rgba(255, 210, 122, .4); border-radius: 999px; padding: 2px 6px;
    }
    html[data-theme="light"] .ap-beta { color: var(--gold-ink); border-color: rgba(138, 100, 16, .4); }
    .ap-nav { display: flex; flex-direction: column; gap: .25rem; margin-top: .5rem; }
    .ap-link {
      display: flex; align-items: center; gap: .75rem;
      padding: .6rem .7rem; border-radius: var(--r-md);
      color: var(--ink-soft); font-size: var(--fs-lg); font-weight: 500;
      transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
    }
    .ap-link svg { width: 20px; height: 20px; flex: none; opacity: .85; }
    .ap-link:hover { background: var(--surface); color: var(--ink); }
    .ap-link.is-on { color: var(--ink); background: var(--surface-strong); }
    .c-coral.is-on { box-shadow: inset 3px 0 0 var(--coral); color: var(--coral); }
    .c-lav.is-on   { box-shadow: inset 3px 0 0 var(--lavender); color: var(--lavender); }
    .c-mint.is-on  { box-shadow: inset 3px 0 0 var(--mint-deep); color: var(--mint); }
    .c-aqua.is-on  { box-shadow: inset 3px 0 0 var(--aqua); color: var(--aqua); }
    .c-gold.is-on  { box-shadow: inset 3px 0 0 var(--gold); color: var(--gold); }
    .ap-link-soon { margin-left: auto; font-family: var(--font-mono); font-size: 8px; letter-spacing: .08em; text-transform: uppercase; color: var(--gold); background: rgba(255, 210, 122, .12); border: 1px solid rgba(255, 210, 122, .25); border-radius: 999px; padding: 1px 5px; }
    html[data-theme="light"] .ap-link-soon { color: var(--gold-ink); border-color: rgba(138, 100, 16, .3); }

    .ap-me { margin-top: auto; display: flex; align-items: center; gap: .6rem; padding-top: 1rem; border-top: 1px solid var(--line); }
    .ap-avatar {
      width: 38px; height: 38px; border-radius: 50%; flex: none; cursor: pointer; border: 0;
      background: var(--cta-grad); color: #1b1030; font-weight: 700; font-size: var(--fs-md);
      box-shadow: 0 0 16px rgba(255, 107, 157, .4);
    }
    .ap-signout { background: none; border: 0; color: var(--ink-faint); font-size: var(--fs-sm); cursor: pointer; font-family: inherit; margin-left: auto; }
    .ap-signout:hover { color: var(--ink-soft); }
    .ap-theme { width: 36px; height: 36px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); cursor: pointer; transition: color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out); }
    .ap-theme:hover { color: var(--ink); background: var(--surface-strong); }
    .ap-theme svg { width: 17px; height: 17px; }
    .ap-ic-moon { display: none; }
    html[data-theme="light"] .ap-ic-sun { display: none; }
    html[data-theme="light"] .ap-ic-moon { display: block; }

    /* main */
    .ap-main { position: relative; z-index: 1; min-width: 0; }
    .ap-soon-banner { display: flex; align-items: center; justify-content: center; gap: .55rem; padding: .6rem 1rem; font-size: var(--fs-sm); color: var(--gold); background: rgba(255, 210, 122, .10); border-bottom: 1px solid rgba(255, 210, 122, .22); text-align: center; }
    .ap-soon-banner b { color: var(--gold); font-weight: 650; }
    html[data-theme="light"] .ap-soon-banner { color: var(--gold-ink); background: rgba(138, 100, 16, .07); border-color: rgba(138, 100, 16, .2); }
    html[data-theme="light"] .ap-soon-banner b { color: var(--gold-ink); }
    .ap-soon-dot { width: 7px; height: 7px; border-radius: 50%; flex: none; background: var(--gold); box-shadow: 0 0 8px var(--gold); }

    /* ── mobile: rail becomes top brand + bottom tab bar ── */
    @media (max-width: 820px) {
      .ap { grid-template-columns: 1fr; }
      .ap-rail {
        position: sticky; top: 0; height: auto; flex-direction: row; align-items: center; justify-content: space-between;
        padding: .7rem 1rem; gap: .5rem; border-right: 0; border-bottom: 1px solid var(--line); z-index: 20;
        /* drop backdrop-filter on mobile: it makes .ap-rail the containing block
           for its position:fixed child (.ap-nav), pinning the tab bar to the rail
           (top) instead of the viewport bottom. Opaque bg instead. */
        backdrop-filter: none; background: rgba(8, 9, 26, .92);
      }
      html[data-theme="light"] .ap-rail { background: rgba(255, 252, 244, .94); }
      /* Floating liquid-glass capsule (Apple Vision Pro vibe) — centered, frosted */
      .ap-nav {
        position: fixed; bottom: calc(.8rem + env(safe-area-inset-bottom, 0px)); left: 50%; transform: translateX(-50%);
        width: auto; margin: 0; flex-direction: row; justify-content: center; align-items: center; gap: .4rem;
        padding: .4rem .5rem; border-radius: var(--r-pill); z-index: 30;
        background: rgba(18, 20, 40, .4);
        -webkit-backdrop-filter: blur(34px) saturate(1.9); backdrop-filter: blur(34px) saturate(1.9);
        border: 1px solid rgba(255, 255, 255, .16);
        box-shadow: 0 18px 48px rgba(0, 0, 0, .45), inset 0 1.5px 0 rgba(255, 255, 255, .3), inset 0 -2px 4px rgba(0, 0, 0, .28);
      }
      html[data-theme="light"] .ap-nav {
        background: rgba(255, 255, 255, .55); border-color: rgba(255, 255, 255, .8);
        box-shadow: 0 12px 36px rgba(60, 40, 20, .16), inset 0 1px 0 rgba(255, 255, 255, .9);
      }
      /* three level icon buttons; the active one gets a lighter rounded-rect highlight */
      .ap-link { flex: none; padding: .5rem 1.25rem; gap: 0; border-radius: var(--r-pill); justify-content: center; align-items: center; transition: background var(--t-base) var(--ease-soft); }
      .ap-link span { display: none; }                              /* icons only — Instagram-style */
      .ap-link svg { width: 26px; height: 26px; opacity: .62; transition: opacity var(--t-fast) var(--ease-out); }
      .ap-link:hover { background: transparent; }
      .ap-link.is-on { box-shadow: none !important; background: rgba(255, 255, 255, .2); }
      html[data-theme="light"] .ap-link.is-on { background: rgba(20, 16, 10, .08); }
      .ap-link.is-on svg { opacity: 1; }
      .ap-me { margin-top: 0; padding-top: 0; border-top: 0; }
      .ap-avatar { width: 44px; height: 44px; font-size: var(--fs-lg); }
      .ap-theme { width: 44px; height: 44px; }
      .ap-signout { display: none; }
      .ap-link-soon { display: none; }
      .ap-main { padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px)); }
      .ap--chat .ap-main { padding-bottom: 0; }

      /* ── Instagram-style bar: Blak · Minit · Nexus — three level icons, active highlighted ── */
      .ap-nav .ap-link[data-nav="home"],
      .ap-nav .ap-link[data-nav="persona"] { display: none; }
      .ap-nav .ap-link[data-nav="minit"] { order: 1; }
      .ap-nav .ap-link[data-nav="blak"]  { order: 2; }
      .ap-nav .ap-link[data-nav="nexus"] { order: 3; }
      /* each icon carries its pillar colour — muted at rest, vivid + pill when active */
      .ap-nav .ap-link[data-nav="minit"] { color: var(--mint-deep); }
      .ap-nav .ap-link[data-nav="blak"]  { color: var(--coral); }
      .ap-nav .ap-link[data-nav="nexus"] { color: var(--aqua); }

      /* On the Blak screen, blak.astro owns the header — hide the shell's top row */
      .ap--chat .ap-brand, .ap--chat .ap-me { display: none; }
      .ap--chat .ap-rail { padding: 0; border-bottom: 0; min-height: 0; }
    }

    /* shared content primitives */
    .ap-page { max-width: 960px; margin-inline: auto; padding: clamp(1.4rem, 4vw, 2.4rem) clamp(1rem, 4vw, 2rem) 3rem; }
    .ap-h1 { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.6rem, 1.1rem + 2vw, 2.4rem); letter-spacing: -.02em; margin: 0; }
    .ap-sub { color: var(--ink-soft); margin: .4rem 0 0; font-size: var(--fs-lg); }
    .ap-kicker { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 .4rem; }
    .ap-card {
      background: var(--glass-strong); border: 1px solid var(--line-strong); border-radius: var(--r-lg);
      box-shadow: var(--shadow-soft), inset 0 1px 0 rgba(255, 255, 255, .06); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    }
  </style>

  <script is:inline>
    (function () {
      // Light session awareness (UI only): set the avatar initial from the signed-in
      // email if a Supabase session exists; wire sign-out. Real gating comes later.
      var av = document.getElementById('ap-avatar');
      var out = document.getElementById('ap-signout');
      if (av) av.addEventListener('click', function () { window.location.href = '/beta/account/'; });
      // Manual light/dark toggle — persists the choice (shared with the marketing
      // site) and from then on overrides OS-follow until cleared.
      var themeBtn = document.getElementById('ap-theme');
      if (themeBtn) themeBtn.addEventListener('click', function () {
        var t = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        try { localStorage.setItem('theme', t); } catch (e) {}
        var mc = document.querySelector('meta[name="theme-color"]');
        if (mc) mc.setAttribute('content', t === 'light' ? '#FAF4EC' : '#0B0D1F');
      });
      try {
        var keys = Object.keys(localStorage).filter(function (k) { return k.indexOf('-auth-token') > -1 || k.indexOf('supabase.auth') > -1; });
        if (keys.length) {
          var sess = JSON.parse(localStorage.getItem(keys[0]) || '{}');
          var email = (sess && (sess.user && sess.user.email)) || (sess && sess.currentSession && sess.currentSession.user && sess.currentSession.user.email);
          if (email && av) av.textContent = email[0].toUpperCase();
        }
      } catch (e) {}
      if (out) out.addEventListener('click', function () {
        try { Object.keys(localStorage).forEach(function (k) { if (k.indexOf('supabase') > -1 || k.indexOf('-auth-token') > -1) localStorage.removeItem(k); }); } catch (e) {}
        window.location.href = '/';
      });
      // Follow OS light/dark changes live (unless a theme was explicitly chosen on the site).
      try {
        var mq = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
        if (mq && mq.addEventListener) mq.addEventListener('change', function (e) {
          if (localStorage.getItem('theme')) return;
          var t = e.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
          var mc = document.querySelector('meta[name="theme-color"]');
          if (mc) mc.setAttribute('content', t === 'light' ? '#FAF4EC' : '#0B0D1F');
        });
      } catch (e) {}
    })();
  </script>

  <script>
    // Beta auth gate — ONE login (on the landing page) unlocks EVERY /beta/ feature.
    // Not signed in → bounce to the landing login, remembering where you were headed;
    // after sign-in you're returned to that exact page. Importing the Supabase client
    // also runs detectSessionInUrl, which consumes the #access_token / ?code on return.
    import { supabase } from '../lib/supabaseClient';
    (async () => {
      if (!supabase) return; // auth env not set → don't lock anyone out

      const here = () => location.pathname + location.search;
      const safeBeta = (p) => (typeof p === 'string' && /^\/beta\//.test(p) && p.indexOf('//') !== 0) ? p : null;
      const getSession = async () => { try { return (await supabase.auth.getSession()).data.session; } catch (e) { return null; } };

      let session = await getSession();

      // Just back from sign-in? Tokens are still being exchanged — poll before deciding.
      const authInUrl = /[#?&](access_token|code|token_hash)=/.test(location.hash + location.search);
      for (let i = 0; !session && authInUrl && i < 40; i++) { await new Promise((r) => setTimeout(r, 250)); session = await getSession(); }

      // Persistent login (ChatGPT-style): a merely-expired access token must NEVER
      // force a re-login. On a normal revisit with no live session, recover from the
      // refresh token on disk before bouncing to sign-in — so you stay signed in
      // until you explicitly log out.
      if (!session && !authInUrl) {
        try {
          let rt = null;
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && /sb-.*-auth-token/.test(k)) { try { rt = (JSON.parse(localStorage.getItem(k)) || {}).refresh_token || null; } catch (e) {} }
          }
          if (rt) { const { data } = await supabase.auth.refreshSession({ refresh_token: rt }); session = (data && data.session) || null; }
        } catch (e) { /* fall through to sign-in */ }
      }

      if (!session) {
        if (authInUrl) {
          // OAuth returned but the session never formed after ~10s of polling — this is
          // exactly the "login bounces back to the landing page" bug. Instead of the
          // silent redirect (which hides the cause), surface a one-time diagnostic the
          // affected user can screenshot. TEMPORARY — remove once the mobile/Samsung
          // login failure is identified.
          try {
            var _u = (location.hash || '') + (location.search || '');
            var _er = _u.match(/error[^=]*=([^&]+)/);
            var _ls = false; try { localStorage.setItem('_blk_t', '1'); _ls = localStorage.getItem('_blk_t') === '1'; localStorage.removeItem('_blk_t'); } catch (e) {}
            var _key = ''; try { for (var _i = 0; _i < localStorage.length; _i++) { var _k = localStorage.key(_i); if (/sb-.*-auth-token/.test(_k)) _key = _k; } } catch (e) {}
            var _msg = 'origin: ' + location.origin + '\n' + 'token in URL: ' + (/access_token=/.test(_u)) + '\n' + 'error: ' + (_er ? decodeURIComponent(_er[1]) : 'none') + '\n' + 'localStorage OK: ' + _ls + '\n' + 'session key: ' + (_key || 'NONE');
            var _box = document.createElement('div');
            _box.style.cssText = 'position:fixed;left:8px;right:8px;bottom:8px;z-index:2147483647;background:#1b1030;color:#fff;border:1px solid #c9b8ff;border-radius:12px;padding:14px;font:12px/1.5 ui-monospace,monospace;white-space:pre-wrap;box-shadow:0 8px 30px rgba(0,0,0,.5)';
            _box.textContent = 'Sign-in didn’t complete — screenshot this & send it:\n\n' + _msg;
            document.body.appendChild(_box);
          } catch (e) {}
          return;
        }
        try { sessionStorage.setItem('blk_redirect', here()); } catch (e) {}
        location.replace('/?auth=1');
        return;
      }

      // Signed in — if a destination was stashed before login, go there once.
      try {
        const want = safeBeta(sessionStorage.getItem('blk_redirect'));
        sessionStorage.removeItem('blk_redirect');
        if (want && want !== location.pathname && want !== here()) { location.replace(want); return; }
      } catch (e) {}

      await ageGate(session);

      const email = session.user && session.user.email;
      if (email) { const av = document.getElementById('ap-avatar'); if (av) av.textContent = email[0].toUpperCase(); }

      initNotifications(session.user.id);
      setupSwipe();
    })();

    // 18+ age gate (NEXUS-GAPS.md Phase 1, #9; India DPDP — beta is adults-only).
    // One-time DOB confirmation, now SERVER-AUTHORITATIVE via the age_status / set_my_dob
    // RPCs, which write user_profiles — the SAME source of truth the fail-closed Minit
    // gate reads (previously this wrote only auth metadata + profiles, so unknown-age
    // could still reach Minit and self-set metadata could bypass). Still FAILS OPEN on
    // any RPC/JS error so a bug can never lock anyone out; the fail-closed Minit RPC
    // backstops the most sensitive flow. Under-18 → signed out.
    function blockUnder18() {
      let ov = document.getElementById('blk-agegate');
      if (!ov) { ov = document.createElement('div'); ov.id = 'blk-agegate'; ov.style.cssText = 'position:fixed;inset:0;z-index:2147483646;background:var(--bg,#0B0D1F);display:grid;place-items:center;padding:1.4rem;'; document.body.appendChild(ov); }
      ov.innerHTML = '<div style="max-width:360px;text-align:center;color:var(--ink,#fff);font-family:var(--font-body,system-ui)"><h2 style="font-size:1.3rem;margin:0 0 .6rem">You must be 18 or older</h2><p style="color:var(--ink-soft,#b9bdd6)">Blaksyd isn’t available to under-18s yet. Thanks for understanding.</p></div>';
      try { supabase.auth.signOut(); } catch (e) {}
      setTimeout(() => { location.href = '/'; }, 2800);
    }
    async function ageGate(session) {
      try {
        const md = (session.user && session.user.user_metadata) || {};
        // Server-authoritative decision first — shares one source of truth (user_profiles)
        // with the Minit gate and closes the user-writable-metadata bypass.
        let status = null;
        try { const { data, error } = await supabase.rpc('age_status'); if (!error) status = data; } catch (e) {}
        if (status === 'adult') return;
        if (status === 'minor') { blockUnder18(); return; }
        // Already confirmed under the old metadata-only gate? Trust it, backfill the
        // canonical user_profiles row (so the Minit gate sees it), and don't re-ask.
        if (md.dob || md.age_confirmed_at) {
          if (md.dob) { try { await supabase.rpc('set_my_dob', { p_dob: md.dob }); } catch (e) {} }
          return;
        }
        // status 'unknown' (or RPC unreachable), never confirmed → capture DOB.
        const ov = document.createElement('div');
        ov.id = 'blk-agegate';
        ov.style.cssText = 'position:fixed;inset:0;z-index:2147483646;background:var(--bg,#0B0D1F);display:grid;place-items:center;padding:1.4rem;';
        ov.innerHTML = '<div style="max-width:380px;width:100%;text-align:center;font-family:var(--font-body,system-ui)">'
          + '<h2 style="font-size:1.4rem;font-weight:650;margin:0 0 .5rem;color:var(--ink,#fff)">One quick thing</h2>'
          + '<p style="color:var(--ink-soft,#b9bdd6);margin:0 0 1.2rem;line-height:1.5">Blaksyd is for adults. Please confirm your date of birth.</p>'
          + '<input id="blk-dob" type="date" style="width:100%;box-sizing:border-box;padding:.8rem 1rem;border-radius:12px;border:1px solid var(--line-strong,#2a2d4a);background:var(--surface,#15172e);color:var(--ink,#fff);font-size:16px;margin-bottom:.4rem" />'
          + '<p id="blk-dob-err" style="color:#ff6b8b;font-size:.85rem;min-height:1.1rem;margin:.2rem 0 .6rem"></p>'
          + '<button id="blk-dob-go" type="button" style="width:100%;padding:.85rem;border:0;border-radius:999px;font-weight:650;font-size:1rem;cursor:pointer;background:linear-gradient(135deg,#6AD3B8,#5BC0FF);color:#06231C">Continue</button>'
          + '</div>';
        document.body.appendChild(ov);
        const go = ov.querySelector('#blk-dob-go'), err = ov.querySelector('#blk-dob-err');
        go.addEventListener('click', async () => {
          const v = ov.querySelector('#blk-dob').value;
          if (!v) { err.textContent = 'Please enter your date of birth.'; return; }
          const dob = new Date(v), now = new Date();
          let age = now.getFullYear() - dob.getFullYear();
          const mo = now.getMonth() - dob.getMonth();
          if (mo < 0 || (mo === 0 && now.getDate() < dob.getDate())) age--;
          if (isNaN(age)) { err.textContent = 'Please enter a valid date.'; return; }
          if (age < 18) { blockUnder18(); return; }   // block before any write (data minimisation)
          go.disabled = true; go.textContent = 'Saving…';
          const uid = session.user && session.user.id;
          // Authoritative write to user_profiles (server recomputes age) — the value the
          // fail-closed Minit gate reads. Then mirror into auth metadata + the profile.
          try { await supabase.rpc('set_my_dob', { p_dob: v }); } catch (e) {}
          try { await supabase.auth.updateUser({ data: { dob: v, age_confirmed_at: new Date().toISOString() } }); } catch (e) {}
          if (uid) {
            try { await supabase.from('profiles').upsert({ id: uid, dob: v, birthday: v }, { onConflict: 'id' }); } catch (e) {}
            try {
              const bday = new Date(v).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
              await supabase.from('symp_knowledge_facts').upsert(
                { user_id: uid, area: 'identity', key: 'age', label: 'Age / birthday', value: bday, source: 'user', status: 'user_edited', confidence: 1, last_seen_at: new Date().toISOString() },
                { onConflict: 'user_id,area,key' },
              );
            } catch (e) {}
          }
          ov.remove();
        });
      } catch (e) { /* fail open */ }
    }

    // App-wide in-app notification banner. Listens to the `notifications` inbox
    // (realtime + a poll fallback) and surfaces the latest unread — tap to act,
    // ✕ to dismiss. Web push / WhatsApp (Phase 2b/2c) fan out from the same rows.
    function escapeHtml(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
    function initNotifications(uid) {
      const el = document.getElementById('ap-notif');
      if (!el || !supabase) return;
      // `shown` PERSISTS across page loads: the beta navigates via full page loads,
      // so an in-memory set let the same unread toast re-pop on every navigation
      // ("listener's free" forever). Once a toast appears it's remembered + marked
      // read when it auto-hides, so it surfaces exactly once.
      const SKEY = 'bx_notif_shown_' + uid;
      let shown;
      try { shown = new Set(JSON.parse(localStorage.getItem(SKEY) || '[]')); } catch (e) { shown = new Set(); }
      const remember = (id) => { shown.add(id); try { localStorage.setItem(SKEY, JSON.stringify([...shown].slice(-300))); } catch (e) {} };
      let hideTimer = 0, currentId = null;
      const markRead = (id) => { if (!id) return; try { supabase.from('notifications').update({ read_at: new Date().toISOString() }).eq('id', id); } catch (e) {} };
      const hide = () => { el.classList.remove('show'); setTimeout(() => { el.hidden = true; }, 440); if (currentId) { markRead(currentId); currentId = null; } if (hideTimer) { clearTimeout(hideTimer); hideTimer = 0; } };
      const render = (n) => {
        if (!n || shown.has(n.id)) return; remember(n.id); currentId = n.id;
        el.innerHTML = '<span class="ap-notif-dot"></span><span class="ap-notif-tx"><b>' + escapeHtml(n.title) + '</b><span>' + escapeHtml(n.body || '') + '</span></span><button type="button" class="ap-notif-x" aria-label="Dismiss">✕</button>';
        el.hidden = false; requestAnimationFrame(() => el.classList.add('show'));
        el.onclick = () => { markRead(n.id); currentId = null; if (n.url) location.href = n.url; };
        el.querySelector('.ap-notif-x').onclick = (e) => { e.stopPropagation(); markRead(n.id); currentId = null; hide(); };
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(hide, 12000);
      };
      const latestUnread = async () => {
        try { const { data } = await supabase.from('notifications').select('*').is('read_at', null).order('created_at', { ascending: false }).limit(1); if (data && data[0]) render(data[0]); } catch (e) {}
      };
      latestUnread();
      try { supabase.channel('notif_' + uid).on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'notifications', filter: 'user_id=eq.' + uid }, (p) => render(p.new)).subscribe(); } catch (e) {}
      setInterval(latestUnread, 20000);
    }
    // Swipe left/right between the three pillars (Minit ↔ Blak ↔ Nexus), matching the bar order.
    function setupSwipe() {
      const order = [['minit', '/beta/minit/'], ['blak', '/beta/blak/'], ['nexus', '/beta/nexus/']];
      const onLink = document.querySelector('.ap-link.is-on');
      const idx = onLink ? order.findIndex((o) => o[0] === onLink.getAttribute('data-nav')) : -1;
      if (idx < 0) return;                                            // home / profile / admin → no swipe
      const hScrollable = (el) => { for (let n = el; n && n !== document.body; n = n.parentElement) { const s = getComputedStyle(n); if ((s.overflowX === 'auto' || s.overflowX === 'scroll') && n.scrollWidth > n.clientWidth + 4) return true; } return false; };
      let x0 = 0, y0 = 0, t0 = 0, ok = false;
      document.addEventListener('touchstart', (e) => {
        const t = e.touches[0]; if (!t) { ok = false; return; }
        if (e.target.closest('input,textarea,select,[contenteditable],[data-noswipe],.bx-cv-drawer,.bx-call-ov,.mnx-modal,.mnx-drawer,.nx-modal,.nx-room,.lsn-modal,.lsn-panel') || hScrollable(e.target)) { ok = false; return; }
        x0 = t.clientX; y0 = t.clientY; t0 = Date.now(); ok = true;
      }, { passive: true });
      document.addEventListener('touchend', (e) => {
        if (!ok) return; ok = false;
        const t = e.changedTouches[0]; if (!t) return;
        const dx = t.clientX - x0, dy = t.clientY - y0, dt = Date.now() - t0;
        if (Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 1.8 && dt < 600) {
          const ni = idx + (dx < 0 ? 1 : -1);                         // swipe left → next-right pillar
          if (ni >= 0 && ni < order.length) location.href = order[ni][1];
        }
      }, { passive: true });
    }
  </script>
</body>
