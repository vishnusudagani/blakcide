---
// AppLayout — the logged-in Blaksyd BETA app shell (UI only for now).
// "First Light" dark warm-dawn aesthetic, distinct from the cream marketing site
// so signing in *feels* like entering the product. Sidebar on desktop, bottom
// tab-bar on mobile. Not indexed. Real auth-gating + functionality land per-pillar.
import '../styles/fonts.css';
import '../styles/tokens.css';

interface Props { active?: 'home' | 'blak' | 'persona' | 'minit' | 'nexus' | 'profile'; title?: string; soon?: boolean; }
const { active = 'home', title = 'Home', soon = false } = Astro.props;

// soon: feature is a preview, not yet live (Blak / Persona / Minit). Nexus is live.
const nav = [
  { id: 'home',    href: '/beta/',         label: 'Home',    c: 'gold',  d: 'M3 11l9-7 9 7M5 10v10h14V10' },
  { id: 'blak',    href: '/beta/blak/',    label: 'Blak',    c: 'coral', d: 'M4 5h16v11H8l-4 4z' },
  { id: 'persona', href: '/beta/persona/', label: 'Persona', c: 'lav',   soon: true, d: 'M12 12a4 4 0 100-8 4 4 0 000 8zM5 20a7 7 0 0114 0' },
  { id: 'minit',   href: '/beta/minit/',   label: 'Minit',   c: 'mint',  d: 'M9 11a3 3 0 100-6 3 3 0 000 6zM2.5 19a6.5 6.5 0 0113 0M16 5.5a3 3 0 010 6M21.5 19a6.5 6.5 0 00-3-5.5' },
  { id: 'nexus',   href: '/beta/nexus/',   label: 'Nexus',   c: 'aqua',  d: 'M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18' },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#0B0D1F" />
  <title>{title} · Blaksyd beta</title>
  <link rel="icon" href="/favicon.ico" />
  <script is:inline>
    /* Match the OS (or an explicit choice shared with the marketing site) before
       paint, so the app isn't locked to dark. Priority: stored toggle → OS → dark. */
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'light' ? '#FAF4EC' : '#0B0D1F');
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <div class="ap-atmos" aria-hidden="true"></div>

  <div class={`ap ${active === 'blak' ? 'ap--chat' : ''}`}>
    <!-- ── side / brand rail ── -->
    <aside class="ap-rail">
      <a href="/beta/" class="ap-brand" aria-label="Blaksyd beta">
        <span class="ap-mark"></span><span class="ap-beta">beta</span>
      </a>
      <nav class="ap-nav" aria-label="Blaksyd">
        {nav.map((n) => (
          <a href={n.href} data-nav={n.id} class={`ap-link c-${n.c} ${active === n.id ? 'is-on' : ''}`} aria-current={active === n.id ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={n.d} /></svg>
            <span>{n.label}</span>
            {n.soon && <span class="ap-link-soon">soon</span>}
          </a>
        ))}
      </nav>
      <div class="ap-me">
        <button type="button" class="ap-avatar" id="ap-avatar" aria-label="Your account">Y</button>
        <button type="button" class="ap-theme" id="ap-theme" aria-label="Switch light or dark theme" title="Theme">
          <svg class="ap-ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="ap-ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
        </button>
        <button type="button" class="ap-signout" id="ap-signout">Sign out</button>
      </div>
    </aside>

    <!-- ── content ── -->
    <main class="ap-main" id="main">
      {soon && (
        <div class="ap-soon-banner">
          <span class="ap-soon-dot"></span>
          <span><b>{title} is coming soon</b> — an early preview, not live yet.</span>
        </div>
      )}
      <slot />
    </main>
  </div>

  <style is:global>
    /* color-scheme follows the theme via tokens.css (:root = dark, [data-theme=light] = light) */
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; }
    body {
      font-family: var(--font-body); color: var(--ink); background: var(--bg);
      -webkit-font-smoothing: antialiased;
    }
    .ap-atmos {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background:
        radial-gradient(70% 50% at 18% -8%, rgba(255, 150, 120, .16), transparent 60%),
        radial-gradient(60% 50% at 92% 4%, rgba(201, 184, 255, .12), transparent 60%),
        radial-gradient(80% 60% at 50% 120%, rgba(91, 192, 255, .10), transparent 60%);
    }
    html[data-theme="light"] .ap-atmos {
      background:
        radial-gradient(70% 50% at 18% -8%, rgba(255, 138, 108, .16), transparent 60%),
        radial-gradient(60% 50% at 92% 4%, rgba(150, 131, 230, .12), transparent 60%),
        radial-gradient(80% 60% at 50% 120%, rgba(70, 180, 192, .10), transparent 60%);
    }

    .ap { position: relative; z-index: 1; display: grid; grid-template-columns: 248px 1fr; min-height: 100vh; min-height: 100svh; }

    /* rail */
    .ap-rail {
      position: sticky; top: 0; height: 100vh; height: 100svh;
      display: flex; flex-direction: column; gap: 1.4rem;
      padding: 1.5rem 1.1rem; border-right: 1px solid var(--line);
      background: rgba(8, 9, 26, .45); backdrop-filter: blur(12px);
    }
    html[data-theme="light"] .ap-rail { background: rgba(255, 252, 244, .6); }
    .ap-brand { display: inline-flex; align-items: center; gap: .5rem; }
    .ap-mark { display: block; height: 24px; width: 84px; background: url('/assets/blaksyd-white.webp') left center / contain no-repeat; }
    html[data-theme="light"] .ap-mark { background-image: url('/assets/blaksyd-black.webp'); }
    .ap-beta {
      font-family: var(--font-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase;
      color: var(--gold); border: 1px solid rgba(255, 210, 122, .4); border-radius: 999px; padding: 2px 6px;
    }
    html[data-theme="light"] .ap-beta { color: var(--gold-ink); border-color: rgba(138, 100, 16, .4); }
    .ap-nav { display: flex; flex-direction: column; gap: .25rem; margin-top: .5rem; }
    .ap-link {
      display: flex; align-items: center; gap: .75rem;
      padding: .6rem .7rem; border-radius: var(--r-md);
      color: var(--ink-soft); font-size: var(--fs-lg); font-weight: 500;
      transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
    }
    .ap-link svg { width: 20px; height: 20px; flex: none; opacity: .85; }
    .ap-link:hover { background: var(--surface); color: var(--ink); }
    .ap-link.is-on { color: var(--ink); background: var(--surface-strong); }
    .c-coral.is-on { box-shadow: inset 3px 0 0 var(--coral); color: var(--coral); }
    .c-lav.is-on   { box-shadow: inset 3px 0 0 var(--lavender); color: var(--lavender); }
    .c-mint.is-on  { box-shadow: inset 3px 0 0 var(--mint-deep); color: var(--mint); }
    .c-aqua.is-on  { box-shadow: inset 3px 0 0 var(--aqua); color: var(--aqua); }
    .c-gold.is-on  { box-shadow: inset 3px 0 0 var(--gold); color: var(--gold); }
    .ap-link-soon { margin-left: auto; font-family: var(--font-mono); font-size: 8px; letter-spacing: .08em; text-transform: uppercase; color: var(--gold); background: rgba(255, 210, 122, .12); border: 1px solid rgba(255, 210, 122, .25); border-radius: 999px; padding: 1px 5px; }
    html[data-theme="light"] .ap-link-soon { color: var(--gold-ink); border-color: rgba(138, 100, 16, .3); }

    .ap-me { margin-top: auto; display: flex; align-items: center; gap: .6rem; padding-top: 1rem; border-top: 1px solid var(--line); }
    .ap-avatar {
      width: 38px; height: 38px; border-radius: 50%; flex: none; cursor: pointer; border: 0;
      background: var(--cta-grad); color: #1b1030; font-weight: 700; font-size: var(--fs-md);
      box-shadow: 0 0 16px rgba(255, 107, 157, .4);
    }
    .ap-signout { background: none; border: 0; color: var(--ink-faint); font-size: var(--fs-sm); cursor: pointer; font-family: inherit; margin-left: auto; }
    .ap-signout:hover { color: var(--ink-soft); }
    .ap-theme { width: 36px; height: 36px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); cursor: pointer; transition: color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out); }
    .ap-theme:hover { color: var(--ink); background: var(--surface-strong); }
    .ap-theme svg { width: 17px; height: 17px; }
    .ap-ic-moon { display: none; }
    html[data-theme="light"] .ap-ic-sun { display: none; }
    html[data-theme="light"] .ap-ic-moon { display: block; }

    /* main */
    .ap-main { position: relative; z-index: 1; min-width: 0; }
    .ap-soon-banner { display: flex; align-items: center; justify-content: center; gap: .55rem; padding: .6rem 1rem; font-size: var(--fs-sm); color: var(--gold); background: rgba(255, 210, 122, .10); border-bottom: 1px solid rgba(255, 210, 122, .22); text-align: center; }
    .ap-soon-banner b { color: var(--gold); font-weight: 650; }
    html[data-theme="light"] .ap-soon-banner { color: var(--gold-ink); background: rgba(138, 100, 16, .07); border-color: rgba(138, 100, 16, .2); }
    html[data-theme="light"] .ap-soon-banner b { color: var(--gold-ink); }
    .ap-soon-dot { width: 7px; height: 7px; border-radius: 50%; flex: none; background: var(--gold); box-shadow: 0 0 8px var(--gold); }

    /* ── mobile: rail becomes top brand + bottom tab bar ── */
    @media (max-width: 820px) {
      .ap { grid-template-columns: 1fr; }
      .ap-rail {
        position: sticky; top: 0; height: auto; flex-direction: row; align-items: center; justify-content: space-between;
        padding: .7rem 1rem; gap: .5rem; border-right: 0; border-bottom: 1px solid var(--line); z-index: 20;
        /* drop backdrop-filter on mobile: it makes .ap-rail the containing block
           for its position:fixed child (.ap-nav), pinning the tab bar to the rail
           (top) instead of the viewport bottom. Opaque bg instead. */
        backdrop-filter: none; background: rgba(8, 9, 26, .92);
      }
      html[data-theme="light"] .ap-rail { background: rgba(255, 252, 244, .94); }
      .ap-nav {
        position: fixed; bottom: 0; left: 0; right: 0; margin: 0;
        flex-direction: row; justify-content: space-around;
        padding: .4rem .3rem calc(.4rem + env(safe-area-inset-bottom, 0)); gap: 0;
        background: rgba(8, 9, 26, .92); backdrop-filter: blur(16px); border-top: 1px solid var(--line-strong); z-index: 30;
      }
      html[data-theme="light"] .ap-nav { background: rgba(255, 252, 244, .94); }
      .ap-link { flex-direction: column; gap: 2px; padding: .35rem .5rem; font-size: var(--fs-2xs); border-radius: var(--r-sm); }
      .ap-link.is-on { box-shadow: none !important; background: transparent; }
      .ap-link svg { width: 22px; height: 22px; opacity: 1; }
      .ap-me { margin-top: 0; padding-top: 0; border-top: 0; }
      .ap-signout { display: none; }
      .ap-link-soon { display: none; }
      .ap-main { padding-bottom: 72px; }

      /* ── Snapchat-style bottom bar: Minit · Blak(center, raised) · Nexus ── */
      .ap-nav .ap-link[data-nav="home"],
      .ap-nav .ap-link[data-nav="persona"] { display: none; }
      .ap-nav { justify-content: space-evenly; align-items: flex-end; padding-bottom: calc(.5rem + env(safe-area-inset-bottom, 0)); }
      .ap-nav .ap-link[data-nav="minit"] { order: 1; }
      .ap-nav .ap-link[data-nav="blak"]  { order: 2; }
      .ap-nav .ap-link[data-nav="nexus"] { order: 3; }
      .ap-nav .ap-link[data-nav="blak"] {
        background: var(--cta-grad); color: #1b1030; border-radius: 50%;
        width: 56px; height: 56px; margin-top: -20px; align-self: center;
        box-shadow: 0 0 22px rgba(255,107,157,.5); flex: none;
      }
      .ap-nav .ap-link[data-nav="blak"] svg { width: 25px; height: 25px; opacity: 1; }
      .ap-nav .ap-link[data-nav="blak"] span { display: none; }
      .ap-nav .ap-link[data-nav="blak"].is-on { box-shadow: 0 0 28px rgba(255,107,157,.75); }

      /* On the Blak screen, blak.astro owns the header — hide the shell's top row */
      .ap--chat .ap-brand, .ap--chat .ap-me { display: none; }
      .ap--chat .ap-rail { padding: 0; border-bottom: 0; min-height: 0; }
    }

    /* shared content primitives */
    .ap-page { max-width: 960px; margin-inline: auto; padding: clamp(1.4rem, 4vw, 2.4rem) clamp(1rem, 4vw, 2rem) 3rem; }
    .ap-h1 { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.6rem, 1.1rem + 2vw, 2.4rem); letter-spacing: -.02em; margin: 0; }
    .ap-sub { color: var(--ink-soft); margin: .4rem 0 0; font-size: var(--fs-lg); }
    .ap-kicker { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 .4rem; }
    .ap-card {
      background: var(--glass-strong); border: 1px solid var(--line-strong); border-radius: var(--r-lg);
      box-shadow: var(--shadow-soft), inset 0 1px 0 rgba(255, 255, 255, .06); backdrop-filter: blur(16px);
    }
  </style>

  <script is:inline>
    (function () {
      // Light session awareness (UI only): set the avatar initial from the signed-in
      // email if a Supabase session exists; wire sign-out. Real gating comes later.
      var av = document.getElementById('ap-avatar');
      var out = document.getElementById('ap-signout');
      if (av) av.addEventListener('click', function () { window.location.href = '/beta/profile/'; });
      // Manual light/dark toggle — persists the choice (shared with the marketing
      // site) and from then on overrides OS-follow until cleared.
      var themeBtn = document.getElementById('ap-theme');
      if (themeBtn) themeBtn.addEventListener('click', function () {
        var t = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        try { localStorage.setItem('theme', t); } catch (e) {}
        var mc = document.querySelector('meta[name="theme-color"]');
        if (mc) mc.setAttribute('content', t === 'light' ? '#FAF4EC' : '#0B0D1F');
      });
      try {
        var keys = Object.keys(localStorage).filter(function (k) { return k.indexOf('-auth-token') > -1 || k.indexOf('supabase.auth') > -1; });
        if (keys.length) {
          var sess = JSON.parse(localStorage.getItem(keys[0]) || '{}');
          var email = (sess && (sess.user && sess.user.email)) || (sess && sess.currentSession && sess.currentSession.user && sess.currentSession.user.email);
          if (email && av) av.textContent = email[0].toUpperCase();
        }
      } catch (e) {}
      if (out) out.addEventListener('click', function () {
        try { Object.keys(localStorage).forEach(function (k) { if (k.indexOf('supabase') > -1 || k.indexOf('-auth-token') > -1) localStorage.removeItem(k); }); } catch (e) {}
        window.location.href = '/';
      });
      // Follow OS light/dark changes live (unless a theme was explicitly chosen on the site).
      try {
        var mq = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
        if (mq && mq.addEventListener) mq.addEventListener('change', function (e) {
          if (localStorage.getItem('theme')) return;
          var t = e.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
          var mc = document.querySelector('meta[name="theme-color"]');
          if (mc) mc.setAttribute('content', t === 'light' ? '#FAF4EC' : '#0B0D1F');
        });
      } catch (e) {}
    })();
  </script>

  <script>
    // Beta auth gate — ONE login (on the landing page) unlocks EVERY /beta/ feature.
    // Not signed in → bounce to the landing login, remembering where you were headed;
    // after sign-in you're returned to that exact page. Importing the Supabase client
    // also runs detectSessionInUrl, which consumes the #access_token / ?code on return.
    import { supabase } from '../lib/supabaseClient';
    (async () => {
      if (!supabase) return; // auth env not set → don't lock anyone out

      const here = () => location.pathname + location.search;
      const safeBeta = (p) => (typeof p === 'string' && /^\/beta\//.test(p) && p.indexOf('//') !== 0) ? p : null;
      const getSession = async () => { try { return (await supabase.auth.getSession()).data.session; } catch (e) { return null; } };

      let session = await getSession();

      // Just back from sign-in? Tokens are still being exchanged — poll before deciding.
      const authInUrl = /[#?&](access_token|code|token_hash)=/.test(location.hash + location.search);
      for (let i = 0; !session && authInUrl && i < 40; i++) { await new Promise((r) => setTimeout(r, 250)); session = await getSession(); }

      if (!session) {
        try { sessionStorage.setItem('blk_redirect', here()); } catch (e) {}
        location.replace('/?auth=1');
        return;
      }

      // Signed in — if a destination was stashed before login, go there once.
      try {
        const want = safeBeta(sessionStorage.getItem('blk_redirect'));
        sessionStorage.removeItem('blk_redirect');
        if (want && want !== location.pathname && want !== here()) { location.replace(want); return; }
      } catch (e) {}

      const email = session.user && session.user.email;
      if (email) { const av = document.getElementById('ap-avatar'); if (av) av.textContent = email[0].toUpperCase(); }
    })();
  </script>
</body>
</html>
