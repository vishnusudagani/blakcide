---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/sections.css';
import Auth from '../components/Auth.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /* Page-specific JSON-LD nodes (no @context needed — they're folded into the
     site-wide @graph below). e.g. the homepage passes SoftwareApplication + FAQPage. */
  schema?: Record<string, unknown>[];
  /* Keep a page out of the index (e.g. the 404). */
  noindex?: boolean;
}

const {
  title = 'Blaksyd — Human + AI, revolving around you.',
  description = 'Human + AI, together, revolving around you. Blak knows you and acts for you, Persona is your digital self, Minit brings real listeners close, and Nexus is where you belong — one world, always learning you.',
  image = '/assets/og-cover.png',
  schema = [],
  noindex = false,
} = Astro.props;

// Absolute URLs for canonical + link-preview cards (Astro.site = https://blaksyd.com).
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(image, Astro.site).href;

// ───────────── Structured data (JSON-LD) ─────────────
// Site-wide entity graph so Google and AI answer-engines understand exactly what
// Blaksyd is and who runs it. Facts mirror the canonical product definition;
// nothing speculative (e.g. unresolved per-minute pricing) is asserted here.
// @id anchors let page-level nodes (passed via `schema`) reference the org/site.
const ORG_ID = 'https://blaksyd.com/#organization';
const SITE_ID = 'https://blaksyd.com/#website';

const organization = {
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'Blaksyd',
  legalName: 'Blaksyd LLP',
  foundingDate: '2026',
  url: 'https://blaksyd.com/',
  logo: 'https://blaksyd.com/assets/blaksyd-black.webp',
  image: 'https://blaksyd.com/assets/og-cover.png',
  slogan: 'Human + AI, revolving around you.',
  email: 'ceo@blaksyd.com',
  description:
    'Blaksyd is a Human + AI life platform built around you — four pillars (Blak and Persona on the AI side; Minit and Nexus on the human side) unified by a learning co-pilot layer.',
  foundingLocation: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressRegion: 'Telangana', addressCountry: 'IN' },
  },
  // Official profiles — ties this entity to its known accounts for the knowledge
  // graph and AI assistants. Add more (X, Wikidata) here as they go live.
  sameAs: [
    'https://www.instagram.com/blaksyd',
    'https://www.youtube.com/@blaksyd',
    'https://www.linkedin.com/company/blaksyd',
    'https://www.crunchbase.com/organization/blaksyd',
    'https://www.wikidata.org/wiki/Q140068113',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': SITE_ID,
  name: 'Blaksyd',
  url: 'https://blaksyd.com/',
  description:
    'Human + AI, together, revolving around you. Blak, Persona, Minit, and Nexus — one world, always learning you.',
  inLanguage: 'en',
  publisher: { '@id': ORG_ID },
};

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...schema],
  // Escape "<" so the JSON can never break out of the <script> element.
}).replace(/</g, '\\u003c');

// Inline gradient-dot favicon — a tiny "living presence" in the brand accents.
const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><defs><radialGradient id="g" cx="50%" cy="38%" r="70%"><stop offset="0%" stop-color="#FFD4B8"/><stop offset="45%" stop-color="#FF6B9D"/><stop offset="100%" stop-color="#C9B8FF"/></radialGradient></defs><circle cx="16" cy="16" r="13" fill="url(#g)"/></svg>',
  );
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#08091A" />

    {/* Google Search Console — site-ownership verification. Keep permanently. */}
    <meta name="google-site-verification" content="9mosoNbZxxY3aU9M8TIIHVRKrchK7SN87jqcvPe5D2c" />

    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <link rel="icon" href={favicon} />
    <link rel="canonical" href={canonicalURL} />

    {/* Open Graph — link previews (iMessage, Slack, LinkedIn, Facebook…) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Blaksyd" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Blaksyd — Human + AI, revolving around you." />

    {/* Twitter / X large-image card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Entity + locale hints */}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:type" content="image/png" />
    <meta name="author" content="Blaksyd LLP" />
    <meta name="publisher" content="Blaksyd LLP" />
    <meta name="application-name" content="Blaksyd" />

    {/* Structured data — Organization + WebSite site-wide, plus any page nodes
        (e.g. SoftwareApplication + FAQPage on the homepage). Feeds Google rich
        results and helps AI assistants describe Blaksyd correctly. */}
    <script type="application/ld+json" set:html={jsonLd} />

    {/* Set theme before paint to avoid a flash of the wrong mode.
        Priority: explicit toggle choice → OS preference → dark fallback. */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.setAttribute('data-theme', t);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', t === 'light' ? '#FAF4EC' : '#08091A');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    {/* Self-hosted fonts (src/styles/fonts.css) — no third-party render-blocking
        request. Preload the two faces that paint above the fold (Inter for body +
        headings, Instrument Serif italic for the hero accent) so glyphs don't wait
        on the stylesheet. */}
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-400-italic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="world" aria-hidden="true">
      <div class="wl wl-far"  data-bg="0.020"><div class="wl-inner"></div></div>
      <div class="wl wl-near" data-bg="0.055"><div class="wl-inner"></div></div>
    </div>
    <slot />
    <Auth />

    {/* Site-wide scroll reveal — position-based so it fires on load + scroll + resize
        (robust across browsers; no IntersectionObserver dependency). */}
    <script is:inline>
      (function () {
        var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var pending = [].slice.call(document.querySelectorAll('[data-reveal]'));
        if (!pending.length) return;
        if (reduced) { pending.forEach(function (el) { el.classList.add('seen'); }); return; }

        function visibleFrac(el) {
          var r = el.getBoundingClientRect();
          var h = window.innerHeight || document.documentElement.clientHeight;
          if (r.height === 0) return (r.top < h && r.bottom > 0) ? 1 : 0;
          return Math.max(0, Math.min(r.bottom, h) - Math.max(r.top, 0)) / Math.min(r.height, h);
        }
        function check() {
          pending = pending.filter(function (el) {
            if (visibleFrac(el) >= 0.12) { el.classList.add('seen'); return false; }
            return true;
          });
          if (!pending.length) {
            window.removeEventListener('scroll', check);
            window.removeEventListener('resize', check);
          }
        }
        requestAnimationFrame(function () { requestAnimationFrame(check); });
        window.addEventListener('scroll', check, { passive: true });
        window.addEventListener('resize', check);
      })();
    </script>

    {/* Scroll engine — one rAF-throttled, passive handler drives (1) the moving
        background: two depth layers (.wl) trail scroll at different rates so the
        world parallaxes; (2) decorative layers (section glows + any [data-parallax])
        easing past their own resting position at their own speed. Transform-only
        (GPU); reduced-motion opts out entirely. Base centres are read via an
        offsetTop walk (transform-independent) so the parallax never feeds back. */}
    <script is:inline>
      (function () {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;

        var bg = [].slice.call(document.querySelectorAll('.world .wl')).map(function (el) {
          return { el: el, k: parseFloat(el.getAttribute('data-bg')) || 0 };
        });
        var px = [];
        [].slice.call(document.querySelectorAll('[data-parallax]')).forEach(function (el) {
          px.push({ el: el, k: parseFloat(el.getAttribute('data-parallax')) || 0, c: 0 });
        });
        [].slice.call(document.querySelectorAll('.bk-glow, .pp-glow, .mn-glow, .nx-glow, .s-glow')).forEach(function (el) {
          px.push({ el: el, k: 0.09, c: 0 });
        });
        if (!bg.length && !px.length) return;

        var vh = window.innerHeight || document.documentElement.clientHeight;
        function docTop(el) { var t = 0; while (el) { t += el.offsetTop; el = el.offsetParent; } return t; }
        function measure() {
          vh = window.innerHeight || document.documentElement.clientHeight;
          for (var i = 0; i < px.length; i++) { px[i].c = docTop(px[i].el) + px[i].el.offsetHeight / 2; }
        }

        var raf = 0;
        function frame() {
          raf = 0;
          var y = window.scrollY || window.pageYOffset || 0;
          var mid = y + vh / 2;
          for (var i = 0; i < bg.length; i++) {
            bg[i].el.style.transform = 'translate3d(0,' + (-(y * bg[i].k)).toFixed(1) + 'px,0)';
          }
          for (var j = 0; j < px.length; j++) {
            px[j].el.style.transform = 'translate3d(0,' + ((mid - px[j].c) * px[j].k).toFixed(1) + 'px,0)';
          }
        }
        function schedule() { if (!raf) raf = requestAnimationFrame(frame); }

        measure();
        requestAnimationFrame(frame);
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', function () { measure(); schedule(); }, { passive: true });
        window.addEventListener('load', function () { measure(); schedule(); });
        if (document.fonts && document.fonts.ready) { document.fonts.ready.then(function () { measure(); schedule(); }); }
      })();
    </script>
  </body>
</html>
