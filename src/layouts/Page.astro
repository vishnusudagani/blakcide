---
// Page — shared layout for content pages (pillars, about, manifesto, blog posts).
// Built on Base, so it inherits theme, fonts, tokens, OG/Twitter cards, and the
// site-wide Organization + WebSite JSON-LD graph. On top it adds, per page:
//   • a visible + structured BreadcrumbList (SEO: shows hierarchy in results)
//   • a real, alt-texted <img> hero (Google Images can finally index brand art)
//   • a quotable kicker / headline / lede block (AEO/GEO snippet bait)
//   • a closing CTA band + the sitewide Footer (internal-link graph)
// Each page passes its own title/description/OG image and any extra JSON-LD nodes
// (Article, WebPage, FAQPage…) via `schema`, which fold into Base's @graph.
import Base from './Base.astro';
import Footer from '../components/Footer.astro';

interface Crumb { name: string; href: string; }
interface Props {
  title: string;
  description: string;
  image?: string;            // OG image (absolute path under /assets)
  kicker?: string;
  kickerClass?: string;      // k-lav | k-mint | k-aqua | k-gold (pillar colour)
  heading: string;           // plain part of the H1
  accent?: string;           // serif-italic gradient tail of the H1
  accentCool?: boolean;      // cool gradient (human side) vs warm (AI side)
  lede: string;
  heroImage?: string;        // real <img> for the hero (indexable)
  heroAlt?: string;
  breadcrumb: Crumb[];       // e.g. [{name:'Home',href:'/'},{name:'Blak',href:'/blak/'}]
  schema?: Record<string, unknown>[];
  updated?: string;          // ISO date shown in the meta line
  ogType?: string;           // 'article' for blog posts
  publishedTime?: string;    // ISO → article:published_time
  modifiedTime?: string;     // ISO → article:modified_time
  machineReadableAlternates?: { type: string; title: string; href: string }[];
  profile?: { firstName: string; lastName: string; username?: string };
}

const {
  title, description, image, kicker, kickerClass = '', heading, accent,
  accentCool = false, lede, heroImage, heroAlt, breadcrumb, schema = [], updated,
  ogType = 'website', publishedTime, modifiedTime, machineReadableAlternates = [], profile,
} = Astro.props;

// BreadcrumbList JSON-LD — absolute item URLs (the SERP shows the trail, and AI
// engines learn the site hierarchy). Folded into Base's @graph alongside `schema`.
const breadcrumbList = {
  '@type': 'BreadcrumbList',
  '@id': new URL(Astro.url.pathname, Astro.site).href + '#breadcrumb',
  itemListElement: breadcrumb.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href, Astro.site).href,
  })),
};
---

<Base title={title} description={description} image={image} schema={[breadcrumbList, ...schema]} ogType={ogType} publishedTime={publishedTime} modifiedTime={modifiedTime} machineReadableAlternates={machineReadableAlternates} profile={profile}>
  <header class="pg-top u-wrap">
    <a href="/" class="pg-brand" aria-label="Blaksyd — home"><span class="pg-mark" aria-hidden="true"></span></a>
    <button type="button" class="pg-cta" data-open-auth data-tab="signup">Get early access</button>
  </header>

  <main class="pg" id="main" tabindex="-1">
    {/* Visible breadcrumb — mirrors the JSON-LD, helps users and crawlers place the page */}
    <nav class="pg-crumbs" aria-label="Breadcrumb">
      <ol>
        {breadcrumb.map((c, i) => (
          <li>
            {i < breadcrumb.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            {i < breadcrumb.length - 1 && <span class="sep" aria-hidden="true">/</span>}
          </li>
        ))}
      </ol>
    </nav>

    <div class="pg-head">
      {kicker && <p class={`s-kicker ${kickerClass}`}><span class="orb"></span>{kicker}</p>}
      <h1 class="pg-h1">
        {heading}{accent && <> <span class={`accent ${accentCool ? 'cool' : ''}`}>{accent}</span></>}
      </h1>
      <p class="pg-lede">{lede}</p>
      {updated && <p class="pg-meta">Last updated {updated} · Blaksyd LLP</p>}
    </div>

    {heroImage && (
      <figure class="pg-hero">
        <img src={heroImage} alt={heroAlt} width="1200" height="630" loading="eager" decoding="async" />
      </figure>
    )}

    <article class="prose">
      <slot />
    </article>

    {/* Closing CTA — every content page funnels to the one real action */}
    <section class="pg-cta-band">
      <p class="s-kicker k-gold"><span class="orb"></span>your world, from here</p>
      <h2 class="pg-cta-title">Step into a world <span class="accent">that's yours.</span></h2>
      <div class="pg-cta-row">
        <button type="button" class="btn btn-primary" data-open-auth data-tab="signup">
          <span>Get early access</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
        <a href="/#faq" class="btn btn-ghost">What is Blaksyd?</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .pg-top {
    position: relative; z-index: 2;
    display: flex; align-items: center; justify-content: space-between;
    padding-top: clamp(1.4rem, 3vh, 2rem);
  }
  .pg-brand { display: inline-flex; transition: transform var(--t-fast) var(--ease-spring); }
  .pg-brand:hover { transform: scale(1.04); }
  .pg-mark {
    display: block; height: 26px; width: auto; aspect-ratio: 737 / 338;
    background: url('/assets/blaksyd-white.webp') left center / contain no-repeat;
  }
  html[data-theme="light"] .pg-mark { aspect-ratio: 758 / 329; background-image: url('/assets/blaksyd-black.webp'); }
  .pg-cta {
    font-size: var(--fs-md); font-weight: 600; color: var(--cta-ink); white-space: nowrap;
    padding: .55rem 1.05rem; border-radius: var(--r-pill);
    background: var(--cta); background-size: 200% 200%; background-position: 0% 50%;
    box-shadow: 0 8px 24px rgba(30, 99, 216, .4);
    transition: background-position var(--t-slow) var(--ease-out), transform 300ms var(--ease-magnet);
  }
  .pg-cta:hover { background-position: 100% 50%; transform: translateY(-1px); }

  .pg {
    max-width: 820px; margin-inline: auto;
    padding: clamp(1.5rem, 4vh, 2.5rem) clamp(1.25rem, 5vw, 2rem) clamp(2rem, 5vh, 3rem);
    position: relative; z-index: 1;
  }

  .pg-crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: .1rem; list-style: none; }
  .pg-crumbs li { display: inline-flex; align-items: center; }
  .pg-crumbs {
    font-family: var(--font-mono); font-size: var(--fs-2xs); text-transform: uppercase; letter-spacing: .12em;
    color: var(--ink-faint); margin-bottom: clamp(1.6rem, 4vh, 2.4rem);
  }
  .pg-crumbs a { color: var(--ink-soft); transition: color var(--t-fast) var(--ease-out); }
  .pg-crumbs a:hover { color: var(--ink); }
  .pg-crumbs .sep { margin: 0 .5rem; color: var(--ink-ghost); }
  .pg-crumbs [aria-current="page"] { color: var(--ink); }

  .pg-head { max-width: 40ch; }
  .pg-head .s-kicker { margin-bottom: 1.1rem; }
  .pg-h1 {
    font-family: var(--font-display); font-weight: 600;
    font-size: var(--t-h2); line-height: 1.02; letter-spacing: -.03em; color: var(--ink);
  }
  .pg-h1 .accent {
    font-family: var(--font-serif); font-weight: 400; font-style: italic; font-size: 1.08em;
    background: var(--accent-grad); -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .pg-h1 .accent.cool { background: linear-gradient(110deg, var(--mint), var(--mint-deep) 40%, var(--aqua) 90%); -webkit-background-clip: text; background-clip: text; }
  /* Light theme: deepen the gradient accent TEXT so large H1s stay legible on the
     cream canvas — the bright base accents wash out as reading text (mirrors the
     .s-title treatment in styles/sections.css). */
  html[data-theme="light"] .pg-h1 .accent {
    background: linear-gradient(110deg, var(--gold-ink) 0%, var(--coral-ink) 50%, var(--lavender-ink) 95%);
    -webkit-background-clip: text; background-clip: text;
  }
  html[data-theme="light"] .pg-h1 .accent.cool {
    background: linear-gradient(110deg, var(--mint-ink) 0%, var(--aqua-ink) 95%);
    -webkit-background-clip: text; background-clip: text;
  }
  .pg-lede {
    margin-top: 1.3rem; max-width: 60ch;
    font-size: var(--t-lead); line-height: 1.6; color: var(--ink-soft);
  }
  .pg-meta {
    margin-top: 1rem; font-family: var(--font-mono); font-size: var(--fs-2xs);
    text-transform: uppercase; letter-spacing: .14em; color: var(--ink-faint);
  }

  .pg-hero {
    margin: clamp(2.2rem, 5vh, 3.2rem) 0;
    border-radius: var(--r-lg); overflow: hidden;
    border: 1px solid var(--line-strong); box-shadow: var(--shadow-soft);
  }
  .pg-hero img { width: 100%; height: auto; display: block; }

  /* Prose styling for slotted body content lives GLOBALLY in styles/sections.css —
     Astro component-scoped styles can't reach <slot> content, so it must not live
     here. (The .pg-* chrome above is Page's own template, so it stays scoped.) */

  /* ── closing CTA band ── */
  .pg-cta-band {
    margin-top: clamp(3.5rem, 9vh, 6rem); padding-top: clamp(2.5rem, 6vh, 4rem);
    border-top: 1px solid var(--line); text-align: center;
  }
  .pg-cta-band .s-kicker { margin-inline: auto; }
  .pg-cta-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: var(--t-h3); letter-spacing: -.02em; color: var(--ink); margin-bottom: 1.8rem;
  }
  .pg-cta-title .accent {
    font-family: var(--font-serif); font-weight: 400; font-style: italic;
    background: linear-gradient(110deg, var(--coral), var(--lavender) 50%, var(--aqua));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
  }
  html[data-theme="light"] .pg-cta-title .accent {
    background: linear-gradient(110deg, var(--coral-ink), var(--lavender-ink) 50%, var(--aqua-ink));
    -webkit-background-clip: text; background-clip: text;
  }
  .pg-cta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; }
  @media (max-width: 600px) { .pg-cta-row { max-width: 360px; margin-inline: auto; } }
</style>
