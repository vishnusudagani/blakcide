---
// Talk to Blak — a scripted, no-API "taste" of the AI friend. Pick a moment (chip)
// and Blak replies IN CHARACTER: proactive, warm, acts for you, remembers. The
// reply types out; under reduced-motion / perf-lite it appears instantly. Honestly
// labelled as a demo — the canned lookup swaps for a real API later, same UI.
---

<section class="tb s-section" id="try-blak" aria-label="Talk to Blak">
  <div class="u-wrap tb-wrap">
    <p class="s-kicker k-gold tb-kicker" data-reveal><span class="orb"></span>try it</p>
    <h2 class="s-title tb-title" data-reveal>Talk to <span class="accent">Blak</span>.</h2>
    <p class="s-sub tb-sub" data-reveal>A taste of your AI friend — pick a moment, and Blak takes it from there.</p>

    <div class="tb-chat" data-reveal>
      <div class="tb-stream" id="tb-stream" aria-live="polite">
        <div class="tb-row tb-from-blak">
          <span class="tb-av" aria-hidden="true"></span>
          <div class="tb-bubble">Hey — I'm Blak. What's going on for you right now?</div>
        </div>
      </div>
      <div class="tb-chips" id="tb-chips" role="group" aria-label="Pick a moment">
        <button type="button" class="tb-chip" data-k="overwhelmed">I'm overwhelmed</button>
        <button type="button" class="tb-chip" data-k="weekend">Plan my weekend</button>
        <button type="button" class="tb-chip" data-k="quiet">I've been off lately</button>
        <button type="button" class="tb-chip" data-k="win">Something good happened</button>
        <button type="button" class="tb-chip" data-k="focus">Help me focus</button>
      </div>
    </div>

    <p class="tb-note" data-reveal>A scripted taste — real, open-ended conversations arrive at launch.</p>
  </div>
</section>

<style is:global>
  /* global (not scoped) because the chat messages are created in JS at runtime and
     would otherwise miss Astro's scoping attribute. All selectors are .tb-* namespaced. */
  .tb { position: relative; z-index: 1; }
  .tb-wrap { max-width: 620px; margin-inline: auto; text-align: center; }
  .tb-kicker, .tb-title { margin-inline: auto; }
  .tb-sub { margin-inline: auto; margin-bottom: clamp(1.6rem, 4vh, 2.4rem); }

  .tb-chat {
    text-align: left; border-radius: var(--r-lg);
    background: var(--glass-strong);
    backdrop-filter: blur(20px) saturate(150%); -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-soft), inset 0 1px 0 rgba(255, 255, 255, .4);
    padding: 1.2rem;
  }
  .tb-stream { display: flex; flex-direction: column; gap: .7rem; min-height: 120px; }
  .tb-row { display: flex; align-items: flex-end; gap: .55rem; max-width: 90%; }
  .tb-from-blak { align-self: flex-start; }
  .tb-from-you { align-self: flex-end; flex-direction: row-reverse; }
  .tb-av {
    width: 28px; height: 28px; flex: none; border-radius: 50%;
    background: var(--cta-grad); box-shadow: 0 0 12px rgba(255, 107, 157, .5);
    animation: tb-breathe 5s ease-in-out infinite;
  }
  @keyframes tb-breathe { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.08); } }
  .tb-bubble { padding: .7rem .95rem; border-radius: 16px; font-size: var(--fs-base); line-height: 1.5; color: var(--ink); }
  .tb-from-blak .tb-bubble {
    background: rgba(255, 107, 157, .10); border: 1px solid rgba(255, 107, 157, .18);
    border-bottom-left-radius: 5px;
  }
  .tb-from-you .tb-bubble {
    background: var(--surface-strong); border: 1px solid var(--line-strong);
    border-bottom-right-radius: 5px; color: var(--ink-soft);
  }
  html[data-theme="light"] .tb-from-blak .tb-bubble { background: rgba(199, 31, 102, .07); border-color: rgba(199, 31, 102, .16); }

  .tb-typing .tb-bubble { display: inline-flex; gap: 4px; align-items: center; }
  .tb-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--coral); animation: tb-blink 1.2s infinite ease-in-out; }
  .tb-dot:nth-child(2) { animation-delay: .18s; }
  .tb-dot:nth-child(3) { animation-delay: .36s; }
  @keyframes tb-blink { 0%,100% { opacity: .3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-2px); } }

  .tb-chips {
    display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.1rem;
    padding-top: 1rem; border-top: 1px solid var(--line);
    transition: opacity var(--t-base) var(--ease-out);
  }
  .tb-chip {
    font-size: var(--fs-md); font-weight: 500; color: var(--ink-soft);
    padding: .5rem .85rem; border-radius: var(--r-pill);
    background: var(--surface); border: 1px solid var(--line-strong);
    transition: color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-spring);
  }
  .tb-chip:hover { color: var(--ink); border-color: var(--coral); background: var(--surface-strong); transform: translateY(-1px); }
  html[data-theme="light"] .tb-chip:hover { border-color: var(--coral-ink); }

  .tb-cta {
    font-size: var(--fs-md); font-weight: 600; color: var(--cta-ink);
    padding: .6rem 1.1rem; border-radius: var(--r-pill);
    background: var(--cta); background-size: 200% 200%; background-position: 0% 50%;
    box-shadow: var(--shadow-cta);
    transition: background-position var(--t-slow) var(--ease-out), transform var(--t-fast) var(--ease-magnet);
  }
  .tb-cta:hover { background-position: 100% 50%; transform: translateY(-1px); }
  .tb-note { margin-top: 1rem; text-align: center; font-size: var(--fs-sm); color: var(--ink-faint); }

  @media (prefers-reduced-motion: reduce) { .tb-dot, .tb-av { animation: none; } }
</style>

<script is:inline>
  (function () {
    var stream = document.getElementById('tb-stream');
    var chips = document.getElementById('tb-chips');
    if (!stream || !chips) return;
    var reduced = window.__blkLite || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

    var REPLIES = {
      overwhelmed: "Then let's make today smaller. I'll move everything non-urgent to tomorrow and keep just the one thing that matters. Breathe — I've got the rest.",
      weekend: "On it. You've been wanting time outdoors — there's a quiet trail 20 minutes away and Saturday looks clear. Want me to pencil it in and sort lunch after?",
      quiet: "I noticed. No need to explain anything. I'm just glad you're here — want to talk it through, or should I keep you company a minute?",
      win: "Yes — tell me everything. (And I'm saving this one, so I can bring it back up on a harder day.)",
      focus: "Love it. I'll quiet your notifications for the next hour, line up the two things that actually move the needle, and nudge you when the block's done. Music or silence?"
    };
    var USER = { overwhelmed: "I'm overwhelmed.", weekend: "Plan my weekend.", quiet: "I've been off lately.", win: "Something good happened.", focus: "Help me focus." };

    function bubble(who, text) {
      var r = document.createElement('div');
      r.className = 'tb-row ' + (who === 'blak' ? 'tb-from-blak' : 'tb-from-you');
      r.innerHTML = (who === 'blak' ? '<span class="tb-av" aria-hidden="true"></span>' : '') + '<div class="tb-bubble"></div>';
      var b = r.querySelector('.tb-bubble');
      if (text != null) b.textContent = text;
      stream.appendChild(r);
      return b;
    }
    function showTyping() {
      var r = document.createElement('div');
      r.className = 'tb-row tb-from-blak tb-typing';
      r.innerHTML = '<span class="tb-av" aria-hidden="true"></span><div class="tb-bubble"><span class="tb-dot"></span><span class="tb-dot"></span><span class="tb-dot"></span></div>';
      stream.appendChild(r);
      return r;
    }

    var busy = false;
    function answer(k) {
      if (busy) return;
      busy = true; chips.style.opacity = '.45'; chips.style.pointerEvents = 'none';
      // used prompts drop away — each sample stays fresh, never the same canned
      // reply twice (which would give the scripted demo away).
      var usedChip = chips.querySelector('[data-k="' + k + '"]');
      if (usedChip) usedChip.remove();
      bubble('you', USER[k] || k);
      var full = REPLIES[k] || "I'm here.";
      if (reduced) { bubble('blak', full); finish(); return; }
      var t = showTyping();
      setTimeout(function () {
        stream.removeChild(t);
        var b = bubble('blak', '');
        var i = 0;
        var iv = setInterval(function () {
          b.textContent = full.slice(0, ++i);
          if (i >= full.length) { clearInterval(iv); finish(); }
        }, 18);
      }, 750);
    }
    var count = 0;
    function finish() {
      busy = false;
      if (++count >= 3) {
        // Honest cap — after a few exchanges, turn the taste into the real thing
        // rather than pretending the canned demo is endless.
        chips.innerHTML = '';
        bubble('blak', "That's just a taste — the real Blak learns only you and remembers every conversation. Yours is waiting.");
        var cta = document.createElement('button');
        cta.type = 'button'; cta.className = 'tb-cta';
        cta.setAttribute('data-open-auth', ''); cta.setAttribute('data-tab', 'signup');
        cta.textContent = 'Get early access →';
        chips.appendChild(cta);
      }
      chips.style.opacity = ''; chips.style.pointerEvents = '';
    }

    [].slice.call(chips.querySelectorAll('.tb-chip')).forEach(function (c) {
      c.addEventListener('click', function () { answer(c.getAttribute('data-k')); });
    });
  })();
</script>
