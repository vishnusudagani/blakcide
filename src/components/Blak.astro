---
// AI-side locator + Blak — the first product scene, now a *playable* demo.
// The left column orients (the AI that knows you); the right card is Blak, live:
// Blak opens proactively, then the visitor taps prompt chips and watches Blak
// respond — typing → a warm reply → an animated action card (a cab running its
// route, an order ETA filling, reminders rescheduling, pitch-prep ticking in).
// On scroll-in it auto-plays one beat so it feels alive before you touch it.
// Show-don't-tell, made interactive. Reduced-motion safe; carries the trust line.
---

<section class="locator" id="ai" aria-label="The AI side">
  <div class="u-wrap locator-inner">
    <p class="eyebrow" data-reveal>
      <span class="eyebrow-dot"></span>
      the ai that knows you
    </p>
    <h2 class="locator-title" data-reveal>
      Two minds on your side.<br />
      <span class="accent">Always learning you.</span>
    </h2>
    <p class="locator-sub" data-reveal>
      One understands you. One carries you. Together they grow with every day —
      and answer to no one but you.
    </p>
  </div>
</section>

<section class="blak" id="blak">
  <div class="u-wrap blak-inner">
    <div class="blak-copy">
      <p class="kicker" data-reveal><span class="kicker-orb"></span>Blak · your AI friend</p>

      <h3 class="blak-title" data-reveal>
        Blak knows you.<br />
        <span class="accent">And moves first.</span>
      </h3>

      <p class="blak-sub" data-reveal>
        Not an assistant. Not a bot. A friend who pays attention to your day —
        then quietly handles the rest, from the small stuff to almost anything
        you'd ask of one.
      </p>

      <ul class="blak-points" data-reveal>
        <li><span class="pt-dot pt-1"></span><b>Anticipates</b> what you'll need next.</li>
        <li><span class="pt-dot pt-2"></span><b>Understands</b> how you actually feel.</li>
        <li><span class="pt-dot pt-3"></span><b>Acts</b> for you — food, rides, plans, music, the small stuff.</li>
      </ul>

      <p class="blak-trust" data-reveal>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="5" y="11" width="14" height="9" rx="2" />
          <path d="M8 11V8a4 4 0 0 1 8 0v3" />
        </svg>
        Everything Blak learns stays yours. Always.
      </p>
    </div>

    <div class="blak-stage" id="blak-stage" data-reveal="right" role="group" aria-label="Blak, live — tap a prompt to see what Blak does">
      <div class="bk-glow" aria-hidden="true"></div>

      <div class="bk-card">
        <div class="bk-head">
          <span class="bk-avatar" aria-hidden="true"><i class="bk-ring"></i></span>
          <span class="bk-who">
            <b>Blak</b>
            <i class="bk-status"><span class="bk-live"></span>with you today</i>
          </span>
          <span class="bk-badge">moves first</span>
        </div>

        <div class="bk-feed" id="bk-feed" aria-live="polite">
          <div class="bk-row left">
            <div class="bk-bubble blak">
              <span class="bk-cap cap-anticipate"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.5"/></svg></span>You're back-to-back till 2 — I've got the small stuff. What do you need?
            </div>
          </div>
        </div>

        <div class="bk-chips" id="bk-chips" role="group" aria-label="Ask Blak">
          <button type="button" class="bk-chip" data-act="ride" aria-pressed="false">Book me a ride</button>
          <button type="button" class="bk-chip" data-act="food" aria-pressed="false">Order my usual</button>
          <button type="button" class="bk-chip" data-act="mood" aria-pressed="false">I'm wiped today</button>
          <button type="button" class="bk-chip" data-act="pitch" aria-pressed="false">Prep my pitch</button>
        </div>
      </div>

      <p class="demo-note">Interactive preview — the real thing opens at launch.</p>

      <p class="cap-rail" aria-hidden="true">
        <span class="cap-lead">also</span>
        <span>calls to check in</span>
        <span>drafts the hard text</span>
        <span>tracks your day</span>
        <span>speaks your languages</span>
        <span class="cap-more">&amp; more</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* ───────── shared locator ───────── */
  .locator {
    position: relative; z-index: 1;
    scroll-margin-top: 120px;
    padding-block: clamp(5.5rem, 14vh, 9rem) clamp(1rem, 3vh, 2rem);
  }
  .locator-inner { text-align: center; max-width: 60ch; }
  .locator .eyebrow {
    display: inline-flex; align-items: center; gap: .7rem;
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow); text-transform: uppercase; letter-spacing: .28em;
    color: var(--lavender-deep);
    margin-bottom: 1.4rem;
  }
  html[data-theme="dark"] .locator .eyebrow { color: var(--lavender); }
  .locator .eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--lavender); box-shadow: 0 0 12px var(--lavender);
  }
  .locator-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3.25rem);
    line-height: 1.04; letter-spacing: -.03em; color: var(--ink);
  }
  .locator-title .accent {
    font-family: var(--font-serif); font-weight: 400; font-style: italic;
    font-size: 1.08em; letter-spacing: -.02em;
    background: var(--accent-grad);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .locator-sub {
    margin: 1.3rem auto 0; max-width: 52ch;
    font-size: var(--t-lead); color: var(--ink-soft); line-height: 1.6;
  }

  /* ───────── Blak scene ───────── */
  .blak {
    position: relative; z-index: 1;
    scroll-margin-top: 110px;
    padding-block: clamp(3rem, 8vh, 5.5rem) clamp(5rem, 12vh, 8rem);
  }
  .blak-inner {
    display: grid; grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 5rem); align-items: center;
  }

  .kicker {
    display: inline-flex; align-items: center; gap: .55rem;
    font-family: var(--font-mono); font-size: var(--fs-xs);
    text-transform: uppercase; letter-spacing: .2em; color: var(--coral);
    margin-bottom: 1.2rem;
  }
  .kicker-orb {
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--cta-grad); box-shadow: 0 0 16px rgba(255, 184, 122, .5);
  }
  .blak-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: var(--t-h2); line-height: 1.0; letter-spacing: -.03em; color: var(--ink);
  }
  .blak-title .accent {
    font-family: var(--font-serif); font-weight: 400; font-style: italic;
    font-size: 1.1em; letter-spacing: -.02em;
    background: var(--accent-grad);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .blak-sub {
    margin-top: 1.3rem; max-width: 44ch;
    font-size: var(--t-lead); color: var(--ink-soft); line-height: 1.6;
  }

  /* capability rows — absolute dot so a wrapped 2nd line keeps the dot pinned to
     the first line (matches Minit/Nexus .s-points; flex+center floated it mid-row) */
  .blak-points { list-style: none; margin-top: 1.6rem; display: grid; gap: .85rem; }
  .blak-points li {
    position: relative; padding-left: 1.55rem;
    font-size: var(--fs-lg); line-height: 1.5; color: var(--ink-soft);
  }
  .blak-points b { color: var(--ink); font-weight: 600; }
  .pt-dot { position: absolute; left: 1px; top: .55em; width: 9px; height: 9px; border-radius: 50%; }
  .pt-1 { background: var(--coral); box-shadow: 0 0 10px var(--coral); }
  .pt-2 { background: var(--lavender); box-shadow: 0 0 10px var(--lavender); }
  .pt-3 { background: var(--mint); box-shadow: 0 0 10px var(--mint); }

  .blak-trust {
    display: inline-flex; align-items: center; gap: .55rem;
    margin-top: 1.9rem;
    font-size: var(--fs-md); color: var(--ink-faint);
  }
  .blak-trust svg {
    width: 16px; height: 16px; flex: none;
    fill: none; stroke: var(--mint-deep); stroke-width: 1.8;
    stroke-linecap: round; stroke-linejoin: round;
  }

  /* ───────── Blak — live, playable card ───────── */
  .blak-stage { position: relative; }
  .bk-glow {
    position: absolute; inset: -8% -6% -10% -6%; z-index: 0; pointer-events: none;
    background:
      radial-gradient(60% 50% at 30% 18%, rgba(255, 107, 157, .26), transparent 70%),
      radial-gradient(60% 55% at 80% 80%, rgba(201, 184, 255, .24), transparent 72%);
    filter: blur(36px);
  }
  .bk-card {
    position: relative; z-index: 1;
    border-radius: var(--r-lg);
    background: var(--glass-strong);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-soft), inset 0 1px 0 rgba(255, 255, 255, .45);
    padding: 1.1rem 1.1rem 1.2rem;
  }
  /* coral edge ring — Blak wears the AI side's warm tint */
  .bk-card::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    padding: 1px; opacity: .55;
    background: linear-gradient(150deg, rgba(255, 107, 157, .55), transparent 55%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask-composite: exclude;
  }

  /* head */
  .bk-head { display: flex; align-items: center; gap: .7rem; padding: .2rem .3rem 1rem; border-bottom: 1px solid var(--line); }
  .bk-avatar {
    position: relative; width: 40px; height: 40px; border-radius: 50%; flex: none;
    background: var(--cta-grad);
    box-shadow: 0 0 18px rgba(255, 107, 157, .5), inset 0 1px 2px rgba(255, 255, 255, .4);
    animation: bk-breathe 5s ease-in-out infinite;
  }
  .bk-ring {
    position: absolute; inset: 0; border-radius: 50%;
    border: 1px solid rgba(255, 107, 157, .5);
    animation: bk-ring-echo 3.4s ease-out infinite;
  }
  @keyframes bk-breathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.06); } }
  @keyframes bk-ring-echo { 0% { transform: scale(1); opacity: .7; } 100% { transform: scale(1.7); opacity: 0; } }
  .bk-who { display: flex; flex-direction: column; line-height: 1.2; }
  .bk-who b { font-size: var(--fs-lg); color: var(--ink); font-weight: 600; }
  .bk-status {
    display: inline-flex; align-items: center; gap: .35rem;
    font-style: normal; font-size: var(--fs-xs); color: var(--ink-faint); letter-spacing: .02em;
  }
  .bk-live {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--mint-deep); box-shadow: 0 0 8px var(--mint-deep);
    animation: bk-pulse 2.4s ease-in-out infinite;
  }
  @keyframes bk-pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .5; transform: scale(.7); } }
  .bk-badge {
    margin-left: auto;
    font-family: var(--font-mono); font-size: var(--fs-3xs);
    text-transform: uppercase; letter-spacing: .18em; color: var(--coral);
    padding: .25rem .55rem; border-radius: var(--r-pill);
    border: 1px solid rgba(255, 107, 157, .3);
  }
  html[data-theme="light"] .bk-badge { color: var(--coral-ink); }

  /* feed (the live conversation viewport) */
  .bk-feed {
    display: flex; flex-direction: column; gap: .6rem;
    height: clamp(280px, 40vh, 360px);
    margin-top: 1rem; padding: .1rem;
    overflow-y: auto; scroll-behavior: smooth; scrollbar-width: none;
  }
  .bk-feed::-webkit-scrollbar { display: none; }
  .bk-row { display: flex; }
  .bk-row.left { justify-content: flex-start; }
  .bk-row.right { justify-content: flex-end; }

  .bk-bubble {
    max-width: 86%; padding: .8rem .95rem;
    font-size: var(--fs-base); line-height: 1.5; color: var(--ink);
    animation: bk-bubble-in 340ms var(--ease-spring) both;
  }
  .bk-bubble.blak {
    border-radius: 6px 18px 18px 18px;
    background: linear-gradient(135deg, rgba(255, 107, 157, .15), rgba(255, 184, 122, .08));
    border: 1px solid rgba(255, 107, 157, .2);
  }
  .bk-bubble.me {
    border-radius: 18px 6px 18px 18px;
    background: var(--surface-strong); border: 1px solid var(--line);
    color: var(--ink-soft);
  }
  @keyframes bk-bubble-in { from { opacity: 0; transform: translateY(10px) scale(.98); } to { opacity: 1; transform: none; } }
  .bk-cap { display: inline-flex; vertical-align: -2px; margin-right: .35rem; }
  .bk-cap svg { width: 14px; height: 14px; }
  .cap-anticipate  { color: var(--coral); }
  .cap-understands { color: var(--lavender-deep); }
  .cap-acts        { color: var(--mint-deep); }
  .cap-guides      { color: #B9892F; }
  html[data-theme="dark"] .cap-guides { color: var(--gold); }
  html[data-theme="light"] .cap-anticipate  { color: var(--coral-ink); }
  html[data-theme="light"] .cap-understands { color: var(--lavender-ink); }
  html[data-theme="light"] .cap-acts        { color: var(--mint-ink); }
  html[data-theme="light"] .cap-guides      { color: var(--gold-ink); }

  /* typing — a Blak bubble with three dots */
  .bk-typing { display: inline-flex; gap: .3rem; }
  .bk-typing span {
    width: 7px; height: 7px; border-radius: 50%; background: var(--coral);
    animation: bk-bounce 1.2s ease-in-out infinite;
  }
  .bk-typing span:nth-child(2) { animation-delay: .18s; }
  .bk-typing span:nth-child(3) { animation-delay: .36s; }
  @keyframes bk-bounce { 0%,60%,100% { transform: translateY(0); opacity: .5; } 30% { transform: translateY(-5px); opacity: 1; } }

  /* action card — the proof Blak actually did the thing */
  .bk-action {
    margin-top: .35rem; padding: .7rem .8rem .8rem;
    border-radius: 14px; background: var(--surface); border: 1px solid var(--line-strong);
    animation: bk-action-in 440ms var(--ease-spring) both;
  }
  @keyframes bk-action-in { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: none; } }
  .bk-act-head { display: flex; align-items: center; gap: .45rem; font-size: var(--fs-md); color: var(--ink); }
  .bk-act-head b { font-weight: 600; }
  .bk-act-head svg { width: 16px; height: 16px; flex: none; color: var(--coral); }
  .bk-action.pitch .bk-act-head svg { color: #B9892F; }
  html[data-theme="dark"] .bk-action.pitch .bk-act-head svg { color: var(--gold); }
  html[data-theme="light"] .bk-action .bk-act-head svg { color: var(--coral-ink); }
  html[data-theme="light"] .bk-action.pitch .bk-act-head svg { color: var(--gold-ink); }
  .bk-eta { margin-left: auto; font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .06em; color: var(--ink-faint); }

  /* ride — a cab running its route */
  .bk-route { position: relative; height: 22px; margin-top: .55rem; }
  .bk-route::before {
    content: ''; position: absolute; left: 6px; right: 6px; top: 50%; height: 2px;
    transform: translateY(-50%); border-radius: 2px;
    background: linear-gradient(90deg, var(--coral), var(--peach-deep)); opacity: .45;
  }
  .bk-dot { position: absolute; top: 50%; width: 7px; height: 7px; border-radius: 50%; transform: translate(-50%, -50%); }
  .bk-dot.a { left: 6px; background: var(--ink-faint); }
  .bk-dot.b { left: calc(100% - 6px); background: var(--coral); box-shadow: 0 0 8px var(--coral); }
  .bk-car {
    position: absolute; top: 50%; left: 6px; width: 11px; height: 11px; border-radius: 50%;
    transform: translate(-50%, -50%); background: var(--bg, #fff); border: 2px solid var(--coral);
    box-shadow: 0 0 10px var(--coral);
  }
  .bk-action.run .bk-car { animation: bk-route 2.6s var(--ease-soft) .15s 2 forwards; }
  @keyframes bk-route { from { left: 6px; } to { left: calc(100% - 6px); } }

  /* food — order progress filling */
  .bk-prog { height: 6px; margin-top: .55rem; border-radius: 999px; background: var(--line); overflow: hidden; }
  .bk-prog span { display: block; height: 100%; width: 10%; border-radius: 999px; background: linear-gradient(90deg, var(--coral), var(--peach-deep)); }
  .bk-action.run .bk-prog span { animation: bk-fill 1.9s var(--ease-out) forwards; }
  @keyframes bk-fill { from { width: 10%; } to { width: 100%; } }

  /* mood — quiet "handled" chips */
  .bk-dones { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .55rem; }
  .bk-dones span {
    font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .03em;
    color: var(--coral); background: rgba(255, 107, 157, .12);
    border: 1px solid rgba(255, 107, 157, .22); padding: .22rem .5rem; border-radius: var(--r-pill);
    opacity: 0; transform: translateY(4px);
  }
  html[data-theme="light"] .bk-dones span { color: var(--coral-ink); }
  .bk-action.run .bk-dones span { animation: bk-tick 380ms var(--ease-out) both; }
  .bk-action.run .bk-dones span:nth-child(2) { animation-delay: .12s; }
  .bk-action.run .bk-dones span:nth-child(3) { animation-delay: .24s; }
  @keyframes bk-tick { to { opacity: 1; transform: none; } }

  /* pitch — talking points tick in, playlist equalizes */
  .bk-ticks { list-style: none; margin-top: .45rem; display: grid; gap: .34rem; }
  .bk-ticks li {
    position: relative; padding-left: 1.4rem; font-size: var(--fs-sm); color: var(--ink-soft);
    opacity: 0; transform: translateY(4px);
  }
  .bk-ticks li::before {
    content: ''; position: absolute; left: 0; top: .25em; width: 14px; height: 14px;
    border-radius: 50%; background: rgba(255, 210, 122, .2); border: 1px solid var(--gold);
  }
  .bk-ticks li::after {
    content: ''; position: absolute; left: 5px; top: .42em; width: 3px; height: 7px;
    border: solid #B9892F; border-width: 0 1.5px 1.5px 0; transform: rotate(45deg);
  }
  html[data-theme="dark"] .bk-ticks li::after { border-color: var(--gold); }
  .bk-action.run .bk-ticks li { animation: bk-tick 400ms var(--ease-out) both; }
  .bk-action.run .bk-ticks li:nth-child(2) { animation-delay: .14s; }
  .bk-action.run .bk-ticks li:nth-child(3) { animation-delay: .28s; }
  .bk-eq { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; margin-left: .3rem; vertical-align: middle; }
  .bk-eq b { width: 3px; height: 35%; border-radius: 2px; background: var(--gold); }
  .bk-action.run .bk-eq b { animation: bk-eq 900ms ease-in-out infinite; }
  .bk-eq b:nth-child(2) { animation-delay: .15s; }
  .bk-eq b:nth-child(3) { animation-delay: .3s; }
  .bk-eq b:nth-child(4) { animation-delay: .45s; }
  @keyframes bk-eq { 0%,100% { height: 30%; } 50% { height: 100%; } }

  /* prompt chips — the interactive control */
  .bk-chips { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }
  .bk-chip {
    font-family: inherit; font-size: var(--fs-sm); font-weight: 500; color: var(--ink-soft);
    padding: .5rem .85rem; border-radius: var(--r-pill);
    background: var(--surface); border: 1px solid var(--line-strong); cursor: pointer;
    transition: transform 200ms var(--ease-spring), border-color 200ms var(--ease-out),
                color 200ms var(--ease-out), background 200ms var(--ease-out);
  }
  .bk-chip:hover { transform: translateY(-2px); color: var(--coral); border-color: rgba(255, 107, 157, .45); }
  .bk-chip:active { transform: translateY(0) scale(.97); }
  .bk-chip:focus-visible { outline: 2px solid var(--coral); outline-offset: 2px; }
  html[data-theme="light"] .bk-chip:hover { color: var(--coral-ink); }
  .bk-chip.done { color: var(--ink-faint); border-style: dashed; }
  .bk-chip.done::before { content: '✓'; color: var(--mint-deep); margin-right: .35rem; }

  /* ── capability rail — the long tail, "and so much more" ── */
  .cap-rail { position: relative; z-index: 1; margin-top: 1.1rem; display: flex; flex-wrap: wrap; gap: .4rem; }
  .cap-rail span {
    font-family: var(--font-mono); font-size: var(--fs-3xs);
    text-transform: lowercase; letter-spacing: .04em; color: var(--ink-faint);
    padding: .26rem .58rem; border-radius: var(--r-pill);
    border: 1px solid var(--line); background: var(--surface);
  }
  .cap-rail .cap-lead { color: var(--coral); border-color: rgba(255, 107, 157, .28); text-transform: uppercase; letter-spacing: .14em; }
  .cap-rail .cap-more { color: var(--ink-soft); border-style: dashed; }

  /* light theme — deepen accent text to clear WCAG AA on cream */
  html[data-theme="light"] .kicker { color: var(--coral-ink); }
  html[data-theme="light"] .locator .eyebrow { color: var(--lavender-ink); }
  html[data-theme="light"] .cap-rail .cap-lead { color: var(--coral-ink); }

  /* ───────── responsive ───────── */
  @media (max-width: 900px) {
    .blak-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .blak-copy { text-align: left; }
    .blak-stage { max-width: 460px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bk-avatar, .bk-ring, .bk-live { animation: none !important; }
    .bk-feed { scroll-behavior: auto; }
    .bk-bubble, .bk-action { animation: none !important; }
    .bk-typing span { animation: none !important; }
    .bk-car { animation: none !important; left: calc(100% - 6px) !important; }
    .bk-prog span { animation: none !important; width: 100% !important; }
    .bk-dones span, .bk-ticks li { animation: none !important; opacity: 1 !important; transform: none !important; }
    .bk-eq b { animation: none !important; height: 65% !important; }
  }
</style>

<script is:inline>
  // Blak — live, playable. Tap a chip → visitor bubble → typing → Blak reply +
  // an animated action card. Auto-plays one beat on scroll-in so it feels alive.
  (function () {
    var stage = document.getElementById('blak-stage');
    if (!stage) return;
    var feed  = document.getElementById('bk-feed');
    var chips = [].slice.call(stage.querySelectorAll('.bk-chip'));
    if (!feed) return;
    var reduced = window.__blkLite || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    var busy = false, interacted = false, autoTimer = 0, armed = false;

    // Astro scopes component CSS via a data-astro-cid-* attribute that only the
    // template's own elements carry. Nodes we create in JS lack it, so scoped
    // rules (.bk-bubble, .bk-cap svg, …) wouldn't apply and would render raw.
    // Mirror the attribute onto everything we build so the live bubbles and
    // action cards inherit the component's styles.
    var CID = null;
    (function () { var a = stage.attributes; for (var i = 0; i < a.length; i++) { if (a[i].name.indexOf('data-astro-cid-') === 0) { CID = a[i].name; break; } } })();
    function tag(el) { if (!CID || !el) return el; el.setAttribute(CID, ''); var k = el.querySelectorAll('*'); for (var i = 0; i < k.length; i++) k[i].setAttribute(CID, ''); return el; }

    function icon(name) {
      var p = {
        anticipate:  '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.5"/>',
        understands: '<path d="M12 20s-7-4.6-7-9.5A3.5 3.5 0 0 1 12 8a3.5 3.5 0 0 1 7 1.5C19 15.4 12 20 12 20z"/>',
        acts:        '<path d="M13 2 5 13h5l-1 9 8-12h-5z"/>',
        guides:      '<circle cx="12" cy="12" r="9"/><path d="M14.5 9.5l-2 4.5-4.5 2 2-4.5z"/>',
        car:         '<path d="M4 13l1.5-4.6A2 2 0 0 1 7.4 7h9.2a2 2 0 0 1 1.9 1.4L20 13v4a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-1H7v1a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><circle cx="7.5" cy="13.5" r="1"/><circle cx="16.5" cy="13.5" r="1"/>',
        bowl:        '<path d="M3 11h18a9 9 0 0 1-18 0z"/><path d="M12 4c1 1 1 2 0 3"/>',
        heart:       '<path d="M12 20s-7-4.6-7-9.5A3.5 3.5 0 0 1 12 8a3.5 3.5 0 0 1 7 1.5C19 15.4 12 20 12 20z"/>',
        spark:       '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/>'
      }[name] || '';
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + p + '</svg>';
    }

    var DATA = {
      ride:  { me: "Book me a ride to the airport.", cap: "acts", blak: "On it — your usual driver's 6 minutes out. I'll text you the plate.",
               action: '<div class="bk-action ride"><div class="bk-act-head">' + icon('car') + ' <b>Cab booked</b> <span class="bk-eta">6 min · 6:10</span></div><div class="bk-route"><i class="bk-dot a"></i><i class="bk-dot b"></i><span class="bk-car"></span></div></div>' },
      food:  { me: "I'm starving — order my usual.", cap: "acts", blak: "Done. Sienna's bowl, extra dressing — at your desk by 1:45.",
               action: '<div class="bk-action food"><div class="bk-act-head">' + icon('bowl') + ' <b>Sienna\'s · your usual</b> <span class="bk-eta">ETA 1:45</span></div><div class="bk-prog"><span></span></div></div>' },
      mood:  { me: "Honestly, I'm wiped today.", cap: "understands", blak: "I've got you. Evening's clear, two reminders pushed, and I told Maya you'll call tomorrow. Just breathe.",
               action: '<div class="bk-action mood"><div class="bk-act-head">' + icon('heart') + ' <b>Looking after it</b> <span class="bk-eta">just rest</span></div><div class="bk-dones"><span>evening cleared</span><span>2 reminders moved</span><span>Maya · tomorrow</span></div></div>' },
      pitch: { me: "Help me prep for tomorrow's pitch.", cap: "guides", blak: "Already started — your morning's blocked, three talking points are in your notes, and there's a calm playlist for the drive.",
               action: '<div class="bk-action pitch"><div class="bk-act-head">' + icon('spark') + ' <b>Pitch prep ready</b> <span class="bk-eta">9:00 blocked</span></div><ul class="bk-ticks"><li>3 talking points in your notes</li><li>morning cleared to prep</li><li>calm playlist queued <i class="bk-eq"><b></b><b></b><b></b><b></b></i></li></ul></div>' }
    };

    function scrollDown() { feed.scrollTop = feed.scrollHeight; }

    function addRow(side, html) {
      var row = document.createElement('div');
      row.className = 'bk-row ' + (side === 'me' ? 'right' : 'left');
      row.innerHTML = html;
      tag(row);
      feed.appendChild(row);
      scrollDown();
      return row;
    }

    function bubble(side, text, cap) {
      var capHtml = cap ? '<span class="bk-cap cap-' + cap + '">' + icon(cap) + '</span>' : '';
      var safe = String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return addRow(side, '<div class="bk-bubble ' + (side === 'me' ? 'me' : 'blak') + '">' + capHtml + safe + '</div>');
    }

    function respond(key) {
      if (busy) return;
      var d = DATA[key]; if (!d) return;
      interacted = true;
      if (autoTimer) { clearTimeout(autoTimer); autoTimer = 0; }
      busy = true;

      var chip = chips.filter(function (c) { return c.getAttribute('data-act') === key; })[0];
      bubble('me', d.me, null);

      function deliver() {
        bubble('blak', d.blak, d.cap);
        if (d.action) {
          var row = addRow('left', d.action);
          var card = row.querySelector('.bk-action');
          if (card) requestAnimationFrame(function () { card.classList.add('run'); });
        }
        if (chip) { chip.classList.add('done'); chip.setAttribute('aria-pressed', 'true'); }
        busy = false;
      }

      if (reduced) { deliver(); return; }

      var t = addRow('left', '<div class="bk-bubble blak bk-typing"><span></span><span></span><span></span></div>');
      setTimeout(function () { if (t && t.parentNode) feed.removeChild(t); deliver(); }, 760);
    }

    chips.forEach(function (c) {
      c.addEventListener('click', function () { respond(c.getAttribute('data-act')); });
    });

    // auto-play one beat once the card is in view (alive before you touch it)
    function visibleFrac(el) {
      var r = el.getBoundingClientRect();
      var h = window.innerHeight || document.documentElement.clientHeight;
      if (r.height === 0) return (r.top < h && r.bottom > 0) ? 1 : 0;
      return Math.max(0, Math.min(r.bottom, h) - Math.max(r.top, 0)) / Math.min(r.height, h);
    }
    function check() {
      if (armed) return;
      if (visibleFrac(stage) >= 0.35) {
        armed = true;
        window.removeEventListener('scroll', check);
        window.removeEventListener('resize', check);
        if (!reduced) { autoTimer = setTimeout(function () { if (!interacted) respond('ride'); }, 1500); }
      }
    }
    requestAnimationFrame(function () { requestAnimationFrame(check); });
    window.addEventListener('scroll', check, { passive: true });
    window.addEventListener('resize', check);
  })();
</script>
