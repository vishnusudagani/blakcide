---
// Human-side locator + Minit — the first Human scene, now a *playable* connect
// console. After the AI side and the Learning keystone, a cool-toned locator
// orients the visitor: now it's about real people. Minit proves it show-don't-
// tell: pick how you want to reach a real person — talk now, smart-match, book
// for later, or a specialist — and watch Blaksyd reach out (a warm "finding
// someone" ripple) and bring a real, anonymous listener close. Surfaces the
// co-pilot link ("Blak briefed them on the shape — you won't re-explain") and
// two-sided care. Cool palette (mint/aqua). Copy LEFT, device RIGHT.
---

<section class="locator cool" id="people" aria-label="The Human side">
  <div class="u-wrap locator-inner">
    <p class="eyebrow" data-reveal>
      <span class="eyebrow-dot"></span>
      the people who show up
    </p>
    <h2 class="locator-title" data-reveal>
      Real people.<br />
      <span class="accent">Right when it counts.</span>
    </h2>
    <p class="locator-sub" data-reveal>
      Sometimes you just want a real person in the mix. Blaksyd brings friendly
      humans close — on your terms, anytime, anonymous if you like.
    </p>
  </div>
</section>

<section class="s-section minit" id="minit">
  <div class="u-wrap s-two">
    <div class="minit-copy">
      <p class="s-kicker k-mint" data-reveal><span class="orb"></span>Minit · real people, now</p>

      <h3 class="s-title" data-reveal>
        Someone real.<br />
        <span class="accent cool">In a minute.</span>
      </h3>

      <p class="s-sub" data-reveal>
        Not a queue. Not a ticket. A real, friendly person — vetted, never
        random — matched to your vibe the moment you reach out.
      </p>

      <ul class="s-points" data-reveal>
        <li><span class="pt-dot pt-3"></span><b>Connect now</b> — a real person in about a minute.</li>
        <li><span class="pt-dot pt-aqua"></span><b>Vetted, not random</b> — real people we actually check, never random strangers.</li>
        <li><span class="pt-dot pt-3"></span><b>Reconnect anytime</b> — pick up with someone you trust.</li>
      </ul>

      <div class="mn-presence" data-reveal aria-label="1,240 real people online right now">
        <span class="mn-faces" aria-hidden="true">
          <span class="mn-face f1"></span>
          <span class="mn-face f2"></span>
          <span class="mn-face f3"></span>
          <span class="mn-face f4"></span>
          <span class="mn-face f5"></span>
          <span class="mn-face more">+</span>
        </span>
        <span class="mn-presence-txt"><b>1,240+ real people</b> online right now</span>
      </div>

      <p class="s-trust" data-reveal>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="5" y="11" width="14" height="9" rx="2" />
          <path d="M8 11V8a4 4 0 0 1 8 0v3" />
        </svg>
        Talk freely — your name is yours to give, never required.
      </p>
    </div>

    <div class="s-stage minit-stage" id="minit-stage" data-reveal="right" role="group" aria-label="Minit, live — choose how to reach a real person">
      <div class="mn-glow" aria-hidden="true"></div>

      <div class="mn-card">
        <div class="mn-head">
          <span class="mn-avatar" aria-hidden="true"><i class="mn-ring"></i></span>
          <span class="mn-who">
            <b>Minit</b>
            <i class="mn-status"><span class="mn-live"></span>1,240 listeners online</i>
          </span>
          <span class="mn-badge">human</span>
        </div>

        <div class="mn-feed" id="mn-feed" aria-live="polite">
          <p class="mn-lead">Pick how you want to connect — a real person, your way. Anonymous unless you say otherwise.</p>
        </div>

        <div class="mn-modes" id="mn-modes" role="group" aria-label="How to connect">
          <button type="button" class="mn-mode go" data-mode="talk">Talk now</button>
          <button type="button" class="mn-mode" data-mode="smart">Smart match</button>
          <button type="button" class="mn-mode" data-mode="book">Book for later</button>
          <button type="button" class="mn-mode" data-mode="spec">Find a specialist</button>
        </div>
      </div>

      <p class="demo-note">Interactive preview — the real thing opens at launch.</p>

      <p class="cap-rail" aria-hidden="true">
        <span class="cap-lead">also</span>
        <span>voice or text</span>
        <span>any language</span>
        <span>talk as long as you need</span>
        <span class="cap-more">&amp; more</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* ───────── Human-side locator (cool) ───────── */
  .locator {
    position: relative; z-index: 1;
    scroll-margin-top: 120px;
    padding-block: clamp(5.5rem, 14vh, 9rem) clamp(1rem, 3vh, 2rem);
  }
  .locator-inner { text-align: center; max-width: 60ch; margin-inline: auto; }
  .locator .eyebrow {
    display: inline-flex; align-items: center; gap: .7rem;
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow); text-transform: uppercase; letter-spacing: .28em;
    color: var(--mint-deep);
    margin-bottom: 1.4rem;
  }
  .locator .eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--mint); box-shadow: 0 0 12px var(--mint);
  }
  .locator-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3.25rem);
    line-height: 1.04; letter-spacing: -.03em; color: var(--ink);
  }
  .locator-title .accent {
    font-family: var(--font-serif); font-weight: 400; font-style: italic;
    font-size: 1.08em; letter-spacing: -.02em;
    background: linear-gradient(110deg, var(--mint) 0%, var(--mint-deep) 42%, var(--aqua) 92%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .locator-sub {
    margin: 1.3rem auto 0; max-width: 52ch;
    font-size: var(--t-lead); color: var(--ink-soft); line-height: 1.6;
  }

  /* ───────── Minit scene ───────── */
  .minit { scroll-margin-top: 110px; }

  /* listener presence — overlapping gradient orbs (abstract + anonymous: human
     warmth without faces or identities) plus a live count. Makes "real people"
     felt while respecting Minit's anonymous-by-default promise. */
  .mn-presence { display: flex; align-items: center; gap: .7rem; margin-top: 1.7rem; }
  .mn-faces { display: inline-flex; }
  .mn-face {
    width: 30px; height: 30px; border-radius: 50%; flex: none; margin-left: -10px;
    border: 2px solid var(--bg);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, .4);
  }
  .mn-face:first-child { margin-left: 0; }
  .mn-face.f1 { background: linear-gradient(135deg, var(--mint), var(--mint-deep)); }
  .mn-face.f2 { background: linear-gradient(135deg, var(--aqua), var(--lavender)); }
  .mn-face.f3 { background: linear-gradient(135deg, var(--gold), var(--peach-deep)); }
  .mn-face.f4 { background: linear-gradient(135deg, var(--coral), var(--lavender-deep)); }
  .mn-face.f5 { background: linear-gradient(135deg, var(--mint-deep), var(--aqua)); }
  .mn-face.more {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--surface-strong); color: var(--ink-soft);
    font-family: var(--font-mono); font-size: var(--fs-2xs); font-weight: 600;
  }
  .mn-presence-txt { font-size: var(--fs-md); color: var(--ink-soft); }
  .mn-presence-txt b { color: var(--ink); font-weight: 600; }
  @media (max-width: 900px) {
    .minit-stage { max-width: 460px; margin-inline: auto; width: 100%; }
  }

  /* ───────── Minit — live, playable connect console ───────── */
  .minit-stage { position: relative; }
  .mn-glow {
    position: absolute; inset: -8% -6% -10% -6%; z-index: 0; pointer-events: none;
    background:
      radial-gradient(58% 50% at 28% 16%, rgba(106, 211, 184, .26), transparent 70%),
      radial-gradient(58% 55% at 82% 84%, rgba(91, 192, 255, .22), transparent 72%);
    filter: blur(36px);
  }
  .mn-card {
    position: relative; z-index: 1;
    border-radius: var(--r-lg);
    background: var(--glass-strong);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-soft), inset 0 1px 0 rgba(255, 255, 255, .45);
    padding: 1.1rem 1.1rem 1.2rem;
  }
  .mn-card::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    padding: 1px; opacity: .55;
    background: linear-gradient(150deg, rgba(106, 211, 184, .55), transparent 55%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask-composite: exclude;
  }

  /* head */
  .mn-head { display: flex; align-items: center; gap: .7rem; padding: .2rem .3rem 1rem; border-bottom: 1px solid var(--line); }
  .mn-avatar {
    position: relative; width: 40px; height: 40px; border-radius: 50%; flex: none;
    background: linear-gradient(135deg, var(--mint), var(--mint-deep) 70%, var(--aqua));
    box-shadow: 0 0 18px rgba(106, 211, 184, .5), inset 0 1px 2px rgba(255, 255, 255, .4);
    animation: mn-breathe 5s ease-in-out infinite;
  }
  .mn-ring {
    position: absolute; inset: 0; border-radius: 50%;
    border: 1px solid rgba(106, 211, 184, .5);
    animation: mn-ring-echo 3.4s ease-out infinite;
  }
  @keyframes mn-breathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.06); } }
  @keyframes mn-ring-echo { 0% { transform: scale(1); opacity: .7; } 100% { transform: scale(1.7); opacity: 0; } }
  .mn-who { display: flex; flex-direction: column; line-height: 1.2; }
  .mn-who b { font-size: var(--fs-lg); color: var(--ink); font-weight: 600; }
  .mn-status { display: inline-flex; align-items: center; gap: .35rem; font-style: normal; font-size: var(--fs-xs); color: var(--ink-faint); letter-spacing: .02em; }
  .mn-live {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--mint-deep); box-shadow: 0 0 8px var(--mint-deep);
    animation: mn-pulse 2.4s ease-in-out infinite;
  }
  @keyframes mn-pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .5; transform: scale(.7); } }
  .mn-badge {
    margin-left: auto;
    font-family: var(--font-mono); font-size: var(--fs-3xs);
    text-transform: uppercase; letter-spacing: .16em; color: var(--mint-deep);
    padding: .25rem .55rem; border-radius: var(--r-pill);
    border: 1px solid rgba(106, 211, 184, .35);
  }
  html[data-theme="light"] .mn-badge { color: var(--mint-ink); }

  /* feed (the match console) */
  .mn-feed { min-height: clamp(244px, 34vh, 304px); margin-top: 1rem; padding: .1rem; }
  @media (max-width: 600px) { .mn-feed { min-height: clamp(190px, 28vh, 248px); margin-top: .7rem; } }
  .mn-lead { font-size: var(--fs-base); line-height: 1.55; color: var(--ink-soft); max-width: 40ch; padding: .3rem .2rem; }

  /* connecting — Blaksyd reaching out (the human equivalent of "typing") */
  .mn-connect { display: flex; align-items: center; gap: .9rem; padding: 1rem .3rem; animation: mn-in 300ms var(--ease-out) both; }
  .mn-ripple { position: relative; width: 40px; height: 40px; flex: none; }
  .mn-ripple i {
    position: absolute; inset: 0; border-radius: 50%; border: 1.5px solid var(--mint-deep);
    animation: mn-rip 1.8s ease-out infinite;
  }
  .mn-ripple i:nth-child(2) { animation-delay: .6s; }
  .mn-ripple i:nth-child(3) { animation-delay: 1.2s; }
  .mn-ripple::after {
    content: ''; position: absolute; inset: 13px; border-radius: 50%;
    background: linear-gradient(135deg, var(--mint), var(--aqua)); box-shadow: 0 0 12px rgba(106,211,184,.6);
  }
  @keyframes mn-rip { 0% { transform: scale(.35); opacity: .9; } 100% { transform: scale(1); opacity: 0; } }
  .mn-connect-txt { font-size: var(--fs-md); color: var(--ink-soft); }
  .mn-connect-txt b { color: var(--ink); font-weight: 600; }

  /* listener card — a real, warm, anonymous human */
  .mn-listener { animation: mn-in 460ms var(--ease-spring) both; }
  @keyframes mn-in { from { opacity: 0; transform: translateY(10px) scale(.99); } to { opacity: 1; transform: none; } }
  .mn-l-top { display: flex; align-items: center; gap: .8rem; }
  .mn-pic {
    position: relative; width: 46px; height: 46px; border-radius: 50%; flex: none;
    background: linear-gradient(135deg, var(--mint) 0%, var(--mint-deep) 60%, var(--aqua) 130%);
    box-shadow: 0 0 16px rgba(106, 211, 184, .45), inset 0 1px 2px rgba(255, 255, 255, .45);
  }
  .mn-pic.spec { background: linear-gradient(135deg, var(--aqua) 0%, var(--aqua-ink) 130%); }
  .mn-pic::after {
    content: ''; position: absolute; right: -1px; bottom: -1px; width: 11px; height: 11px;
    border-radius: 50%; background: var(--mint-deep); box-shadow: 0 0 0 2px var(--glass-strong), 0 0 8px var(--mint-deep);
  }
  .mn-l-who { display: flex; flex-direction: column; line-height: 1.3; }
  .mn-l-who b { font-size: var(--fs-lg); color: var(--ink); font-weight: 600; }
  .mn-l-meta { font-size: var(--fs-sm); color: var(--ink-soft); }
  .mn-l-rate { margin-left: auto; font-size: var(--fs-md); color: var(--gold); font-weight: 600; white-space: nowrap; }
  html[data-theme="light"] .mn-l-rate { color: var(--gold-ink); }

  .mn-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .85rem; }
  .mn-tag {
    font-family: var(--font-mono); font-size: var(--fs-3xs);
    text-transform: lowercase; letter-spacing: .04em;
    padding: .26rem .58rem; border-radius: var(--r-pill);
    color: var(--mint-deep); background: rgba(106, 211, 184, .14); border: 1px solid rgba(106, 211, 184, .22);
  }
  html[data-theme="light"] .mn-tag { color: var(--mint-ink); }

  .mn-l-status {
    display: inline-flex; align-items: center; gap: .5rem; margin-top: .9rem;
    font-size: var(--fs-sm); color: var(--ink-soft);
  }
  .mn-l-status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--mint-deep); box-shadow: 0 0 10px var(--mint-deep); animation: mn-pulse 2s ease-in-out infinite; }

  .mn-note {
    display: flex; align-items: flex-start; gap: .5rem; margin-top: .9rem;
    padding: .6rem .7rem; border-radius: 12px;
    background: rgba(91, 192, 255, .08); border: 1px solid rgba(91, 192, 255, .2);
    font-size: var(--fs-sm); line-height: 1.45; color: var(--ink-soft);
  }
  .mn-note svg { width: 15px; height: 15px; flex: none; margin-top: .1em; color: var(--aqua); fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  html[data-theme="light"] .mn-note svg { color: var(--aqua-ink); }
  .mn-note b { color: var(--ink); font-weight: 600; }

  .mn-go-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
    width: 100%; margin-top: 1rem; padding: .7rem 1rem; border-radius: var(--r-pill);
    font-family: inherit; font-size: var(--fs-md); font-weight: 600; color: #06231C; cursor: pointer; border: 0;
    background: linear-gradient(135deg, var(--mint) 0%, var(--mint-deep) 70%, var(--aqua) 130%);
    box-shadow: 0 10px 28px rgba(106, 211, 184, .3);
  }

  /* booking confirmation */
  .mn-booked { animation: mn-in 460ms var(--ease-spring) both; }
  .mn-booked-when {
    display: flex; align-items: center; gap: .7rem; padding: .9rem 1rem; border-radius: 14px;
    background: linear-gradient(160deg, rgba(106, 211, 184, .12), rgba(91, 192, 255, .07));
    border: 1px solid rgba(106, 211, 184, .24);
  }
  .mn-cal {
    width: 38px; height: 38px; border-radius: 11px; flex: none; position: relative;
    background: var(--surface-strong); border: 1px solid var(--line-strong);
    display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1;
  }
  .mn-cal b { font-size: var(--fs-md); color: var(--ink); font-weight: 700; }
  .mn-cal i { font-family: var(--font-mono); font-size: var(--fs-3xs); text-transform: uppercase; letter-spacing: .08em; color: var(--mint-deep); font-style: normal; }
  .mn-booked-txt b { color: var(--ink); font-weight: 600; }
  .mn-booked-txt { font-size: var(--fs-base); color: var(--ink-soft); line-height: 1.4; }

  /* connect-mode chips — the interactive control */
  .mn-modes { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }
  .mn-mode {
    font-family: inherit; font-size: var(--fs-sm); font-weight: 500; color: var(--ink-soft);
    padding: .5rem .85rem; border-radius: var(--r-pill);
    background: var(--surface); border: 1px solid var(--line-strong); cursor: pointer;
    transition: transform 200ms var(--ease-spring), border-color 200ms var(--ease-out),
                color 200ms var(--ease-out), background 200ms var(--ease-out);
  }
  .mn-mode:hover { transform: translateY(-2px); color: var(--mint-ink); border-color: rgba(106, 211, 184, .5); }
  html[data-theme="dark"] .mn-mode:hover { color: var(--mint); }
  .mn-mode:active { transform: translateY(0) scale(.97); }
  .mn-mode:focus-visible { outline: 2px solid var(--mint-deep); outline-offset: 2px; }
  .mn-mode.go {
    color: #06231C; border: 0;
    background: linear-gradient(135deg, var(--mint) 0%, var(--mint-deep) 70%, var(--aqua) 130%);
    box-shadow: 0 6px 18px rgba(106, 211, 184, .3);
  }
  .mn-mode.go:hover { color: #06231C; }
  .mn-mode.is-active { color: var(--ink); border-color: rgba(106, 211, 184, .6); background: linear-gradient(135deg, rgba(106, 211, 184, .16), rgba(91, 192, 255, .08)); }
  .mn-mode.go.is-active { color: #06231C; }

  /* ── capability rail ── */
  .cap-rail { position: relative; z-index: 1; margin-top: 1.1rem; display: flex; flex-wrap: wrap; gap: .4rem; }
  .cap-rail span {
    font-family: var(--font-mono); font-size: var(--fs-3xs);
    text-transform: lowercase; letter-spacing: .04em; color: var(--ink-faint);
    padding: .26rem .58rem; border-radius: var(--r-pill);
    border: 1px solid var(--line); background: var(--surface);
  }
  .cap-rail .cap-lead { color: var(--mint-deep); border-color: rgba(106, 211, 184, .28); text-transform: uppercase; letter-spacing: .14em; }
  .cap-rail .cap-more { color: var(--ink-soft); border-style: dashed; }

  /* light theme — deepen accent TEXT to clear WCAG AA on cream */
  html[data-theme="light"] .locator .eyebrow { color: var(--mint-ink); }
  html[data-theme="light"] .cap-rail .cap-lead { color: var(--mint-ink); }

  @media (prefers-reduced-motion: reduce) {
    .mn-avatar, .mn-ring, .mn-live { animation: none !important; }
    .mn-listener, .mn-booked, .mn-connect { animation: none !important; }
    .mn-ripple i { animation: none !important; opacity: .25 !important; }
    .mn-l-status-dot { animation: none !important; }
  }
</style>

<script is:inline>
  // Minit — live, playable. Pick a connect mode → Blaksyd "reaches out" (a warm
  // ripple) → a real, anonymous person arrives (or a booking is set). Surfaces
  // the Blak co-pilot brief. Auto-plays one connect on scroll-in so the promise
  // — someone real, in a minute — is felt.
  (function () {
    var stage = document.getElementById('minit-stage');
    if (!stage) return;
    var feed = document.getElementById('mn-feed');
    var modes = [].slice.call(stage.querySelectorAll('.mn-mode'));
    if (!feed) return;
    var reduced = window.__blkLite || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    var busy = false, interacted = false, autoTimer = 0, armed = false, current = null;

    // Mirror Astro's scope attribute onto JS-built nodes so component styles apply.
    var CID = null;
    (function () { var a = stage.attributes; for (var i = 0; i < a.length; i++) { if (a[i].name.indexOf('data-astro-cid-') === 0) { CID = a[i].name; break; } } })();
    function tag(el) { if (!CID || !el) return el; el.setAttribute(CID, ''); var k = el.querySelectorAll('*'); for (var i = 0; i < k.length; i++) k[i].setAttribute(CID, ''); return el; }

    var lockSvg = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
    var sparkSvg = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/></svg>';
    var heartSvg = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.6-7-9.5A3.5 3.5 0 0 1 12 8a3.5 3.5 0 0 1 7 1.5C19 15.4 12 20 12 20z"/></svg>';

    var DATA = {
      talk: { connect: 'Finding your <b>person</b>, right now…',
        result: '<div class="mn-listener"><div class="mn-l-top"><span class="mn-pic"></span><span class="mn-l-who"><b>Aria M.</b><span class="mn-l-meta">warm · funny · great company</span></span><span class="mn-l-rate">★ 4.9</span></div>'
          + '<div class="mn-tags"><span class="mn-tag">trip planning</span><span class="mn-tag">pep talks</span><span class="mn-tag">big ideas</span></div>'
          + '<div class="mn-l-status"><span class="mn-l-status-dot"></span>available now · connects in ~28s</div>'
          + '<div class="mn-note">' + lockSvg + '<span><b>Anonymous</b> by default — your name is yours to give, never required.</span></div>'
          + '<button type="button" class="mn-go-btn">Start talking</button></div>' },
      smart: { connect: 'Reading your <b>vibe</b> and matching…',
        result: '<div class="mn-listener"><div class="mn-l-top"><span class="mn-pic"></span><span class="mn-l-who"><b>Sol K.</b><span class="mn-l-meta">steady · great brainstorm buddy</span></span><span class="mn-l-rate">★ 4.9</span></div>'
          + '<div class="mn-tags"><span class="mn-tag">ideas</span><span class="mn-tag">plans</span><span class="mn-tag">motivation</span></div>'
          + '<div class="mn-l-status"><span class="mn-l-status-dot"></span>matched to you · connects in ~40s</div>'
          + '<div class="mn-note">' + sparkSvg + '<span><b>Blak briefed Sol</b> on the shape of it — context, not content. You won\'t have to re-explain.</span></div>'
          + '<button type="button" class="mn-go-btn">Start talking</button></div>' },
      spec: { connect: 'Want someone with a <b>specialty</b>? Finding them…',
        result: '<div class="mn-listener"><div class="mn-l-top"><span class="mn-pic spec"></span><span class="mn-l-who"><b>Specialist</b><span class="mn-l-meta">knows your world inside out</span></span><span class="mn-l-rate">★ 5.0</span></div>'
          + '<div class="mn-tags"><span class="mn-tag">deep dives</span><span class="mn-tag">your niche</span></div>'
          + '<div class="mn-l-status"><span class="mn-l-status-dot"></span>available · connects in ~2 min</div>'
          + '<div class="mn-note">' + heartSvg + '<span><b>Good vibes both ways</b> — the people you talk to are looked after too.</span></div>'
          + '<button type="button" class="mn-go-btn">Talk to a specialist</button></div>' },
      book: { connect: 'Holding a time for you…',
        result: '<div class="mn-booked"><div class="mn-booked-when"><span class="mn-cal"><b>9:00</b><i>tonight</i></span><span class="mn-booked-txt"><b>Priya</b> will be ready at 9:00 tonight. We\'ll nudge you at 8:55 — nothing to remember.</span></div>'
          + '<div class="mn-note">' + lockSvg + '<span>Talked before? <b>Reconnect with Priya</b> anytime — she keeps the thread, you keep the privacy.</span></div>'
          + '<button type="button" class="mn-go-btn">Confirm tonight, 9:00</button></div>' }
    };

    function render(key) {
      var d = DATA[key]; if (!d) return;
      feed.innerHTML = '';
      var wrap = document.createElement('div'); wrap.innerHTML = d.result;
      var node = wrap.firstChild; tag(node); feed.appendChild(node);
    }

    function setActive(el) { modes.forEach(function (m) { m.classList.remove('is-active'); }); el.classList.add('is-active'); }

    function connect(key) {
      if (busy || key === current) return;
      interacted = true;
      if (autoTimer) { clearTimeout(autoTimer); autoTimer = 0; }
      busy = true; current = key;
      var d = DATA[key];

      if (reduced) { render(key); busy = false; return; }

      feed.innerHTML = '';
      var c = document.createElement('div'); c.className = 'mn-connect';
      c.innerHTML = '<span class="mn-ripple"><i></i><i></i><i></i></span><span class="mn-connect-txt">' + d.connect + '</span>';
      tag(c); feed.appendChild(c);
      setTimeout(function () { render(key); busy = false; }, 1150);
    }

    modes.forEach(function (m) {
      m.addEventListener('click', function () { setActive(m); connect(m.getAttribute('data-mode')); });
    });

    // auto-play one connect on scroll-in (someone real, in a minute — felt)
    function visibleFrac(el) {
      var r = el.getBoundingClientRect();
      var h = window.innerHeight || document.documentElement.clientHeight;
      if (r.height === 0) return (r.top < h && r.bottom > 0) ? 1 : 0;
      return Math.max(0, Math.min(r.bottom, h) - Math.max(r.top, 0)) / Math.min(r.height, h);
    }
    function check() {
      if (armed) return;
      if (visibleFrac(stage) >= 0.35) {
        armed = true;
        window.removeEventListener('scroll', check);
        window.removeEventListener('resize', check);
        /* One gentle auto-beat on mobile only (no hover + fast scroll = passive
           users miss the demo otherwise); desktop stays tap-driven and calm. */
        if (!reduced && window.matchMedia && window.matchMedia('(max-width: 760px)').matches) { autoTimer = setTimeout(function () {
          if (!interacted) { var el = modes.filter(function (m) { return m.getAttribute('data-mode') === 'talk'; })[0]; if (el) { setActive(el); connect('talk'); } }
        }, 1500); }
      }
    }
    requestAnimationFrame(function () { requestAnimationFrame(check); });
    window.addEventListener('scroll', check, { passive: true });
    window.addEventListener('resize', check);
  })();
</script>
