---
// Finale — the closing payoff. After the four products and the Learning keystone,
// the page zooms back out to the whole: one world, built around you. Emotion is
// "the better future" — hopeful, warm, human. The accent spans warm→cool to fuse
// the AI and Human sides one last time. One "Begin" CTA opens the signup/login
// modal, and a quiet five-dot constellation recaps the structure
// (Blak · Persona · Learning · Minit · Nexus) without a word of jargon.
---

<section class="s-section finale" id="waitlist" aria-label="Join Blaksyd">
  <div class="finale-glow" aria-hidden="true"></div>

  <div class="u-wrap finale-inner">
    <p class="s-kicker k-gold finale-kicker" data-reveal><span class="orb"></span>your world, from here</p>

    <h2 class="s-title finale-title" data-reveal>
      Step into a world<br />
      <span class="accent">that's yours.</span>
    </h2>

    <p class="s-sub finale-sub" data-reveal>
      Blak and Persona to know you. Minit and Nexus to bring people close. All of
      it, quietly becoming yours. The better future isn't
      coming — it's yours to enter.
    </p>

    <figure class="finale-founder" data-reveal>
      <blockquote>"Most apps are built to take your time. We're building Blaksyd to make your life better — and we'd love for you to be one of the first inside."</blockquote>
      <figcaption class="finale-sigs">
        <span class="founder-sig">
          <span class="sig-img sig-vishnu" aria-hidden="true"></span>
          <span class="sig-role">Vishnu Sudagani · CEO</span>
        </span>
        <span class="founder-sig">
          <span class="sig-img sig-sindhuu" aria-hidden="true"></span>
          <span class="sig-role">Dr. Sindhuu Devarakonda · CPO</span>
        </span>
      </figcaption>
    </figure>

    <form class="finale-form" data-reveal data-wl novalidate>
      <input type="email" class="finale-email" name="email" inputmode="email" autocomplete="email" placeholder="you@example.com" aria-label="Your email" required />
      <button type="submit" class="btn btn-primary">
        <span>Get early access</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>
    </form>
    <p class="finale-reassure" data-reveal>Anonymous by default · we never sell your data · free early access.</p>
    <p class="finale-wl-note" data-wl-note role="status" aria-live="polite" hidden></p>

    <div class="constellation" id="finale-constellation" data-reveal aria-hidden="true">
      <span class="con-wire" aria-hidden="true"></span>
      <span class="cdot c-coral"></span>
      <span class="cdot c-lav"></span>
      <span class="cdot c-mint"></span>
      <span class="cdot c-aqua"></span>
    </div>
    <p class="cnames" data-reveal>Blak · Persona · Minit · Nexus</p>
  </div>

</section>

<style>
  .finale {
    position: relative; overflow: hidden;
    padding-block: clamp(5rem, 13vh, 9rem) 0;
  }
  .finale-glow {
    position: absolute; left: 50%; top: 18%; transform: translateX(-50%);
    width: min(900px, 120%); height: 520px; z-index: 0; pointer-events: none;
    filter: blur(70px); opacity: .9;
    background:
      radial-gradient(42% 60% at 30% 40%, rgba(255, 107, 157, .26), transparent 70%),
      radial-gradient(42% 60% at 70% 45%, rgba(91, 192, 255, .22), transparent 70%),
      radial-gradient(50% 60% at 50% 60%, rgba(201, 184, 255, .20), transparent 72%);
  }
  .finale-inner { position: relative; z-index: 1; text-align: center; max-width: 64ch; margin-inline: auto; }
  .finale-kicker { margin-inline: auto; }

  .finale-title { margin-inline: auto; max-width: 16ch; }
  .finale-title .accent {
    /* warm→cool spectrum — fuses the AI and Human sides one last time */
    background: linear-gradient(110deg, var(--coral) 0%, var(--lavender) 42%, var(--aqua) 92%);
    -webkit-background-clip: text; background-clip: text;
  }
  .finale-sub { margin-inline: auto; max-width: 54ch; }
  /* founder note — a personal trust beat right before the ask (swap in a real name + photo later) */
  .finale-founder { margin: 2.2rem auto 0; max-width: 48ch; }
  .finale-founder blockquote {
    margin: 0; font-family: var(--font-serif); font-style: italic;
    font-size: var(--fs-xl); line-height: 1.5; color: var(--ink);
  }
  .finale-sigs {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-end; gap: 1.4rem 3rem;
    margin-top: 1.4rem;
  }
  .founder-sig { display: flex; flex-direction: column; align-items: center; gap: .4rem; }
  /* signature graphics, masked so the ink follows the theme (dark on cream, cream on void) */
  .sig-img {
    height: 52px; color: var(--ink); background-color: currentColor;
    -webkit-mask: var(--sig) center / contain no-repeat;
            mask: var(--sig) center / contain no-repeat;
  }
  .sig-vishnu  { --sig: url('/assets/sig-vishnu.png');  width: 63px; }
  .sig-sindhuu { --sig: url('/assets/sig-sindhuu.png'); width: 111px; }
  .sig-role {
    font-family: var(--font-mono); font-size: var(--fs-3xs);
    text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint);
  }

  .finale-form {
    display: flex; flex-wrap: wrap; justify-content: center; gap: .7rem;
    margin-top: 2.6rem; max-width: 480px; margin-inline: auto;
  }
  .finale-email {
    flex: 1 1 220px; min-width: 0; padding: 1rem 1.1rem;
    background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill);
    color: var(--ink); font-size: var(--fs-lg);
    transition: border-color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out), box-shadow var(--t-fast) var(--ease-out);
  }
  .finale-email::placeholder { color: var(--ink-ghost); }
  .finale-email:focus { outline: none; border-color: var(--coral); background: var(--surface-strong); box-shadow: 0 0 0 3px rgba(255, 107, 157, .18); }
  html[data-theme="light"] .finale-email:focus { border-color: var(--coral-ink); }
  .finale-form .btn-primary { flex: 0 0 auto; }
  .finale-reassure { margin-top: 1rem; font-size: var(--fs-sm); color: var(--ink-soft); }
  .finale-wl-note {
    margin: .9rem auto 0; max-width: 420px;
    font-size: var(--fs-sm); line-height: 1.5; color: var(--ink-soft);
    padding: .65rem .85rem; border-radius: var(--r-sm);
    background: var(--surface); border: 1px solid var(--line);
  }
  .finale-wl-note.is-error { color: var(--coral-deep); border-color: rgba(244, 69, 140, .4); background: rgba(244, 69, 140, .07); }
  .finale-wl-note.is-ok { color: var(--mint-deep); border-color: rgba(106, 211, 184, .4); background: rgba(106, 211, 184, .08); }
  html[data-theme="light"] .finale-wl-note.is-error { color: var(--coral-ink); }
  html[data-theme="light"] .finale-wl-note.is-ok { color: var(--mint-ink); }
  @media (max-width: 600px) {
    .finale-form { flex-direction: column; max-width: 360px; }
    /* kill the 220px flex-basis so the stacked input keeps its natural height
       instead of ballooning into a 220px-tall pill (mirrors the hero fix) */
    .finale-email { flex: 0 0 auto; width: 100%; }
    .finale-form .btn-primary { width: 100%; justify-content: center; }
  }

  /* ── closing constellation — the whole system in five dots ── */
  .constellation {
    position: relative; display: inline-flex; align-items: center; gap: clamp(1.4rem, 5vw, 2.6rem);
    margin-top: clamp(3rem, 7vh, 4.5rem); padding: 0 .4rem;
  }
  .constellation::before {
    content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-strong) 18%, var(--line-strong) 82%, transparent);
    z-index: 0;
  }
  /* the bright connective wire that draws across on scroll-in (over the faint track) */
  .con-wire {
    position: absolute; left: 0; top: 50%; height: 2px; width: 0; z-index: 0;
    transform: translateY(-50%); border-radius: 2px;
    background: linear-gradient(90deg,
      var(--coral) 0%, var(--lavender) 30%, var(--gold) 52%, var(--mint-deep) 76%, var(--aqua) 100%);
    box-shadow: 0 0 10px rgba(255, 210, 122, .35);
    transition: width 1000ms var(--ease-out);
  }
  .constellation.drawn .con-wire { width: 100%; }

  .cdot {
    position: relative; z-index: 1; width: 11px; height: 11px; border-radius: 50%;
    transform: scale(0);
    transition: transform 560ms var(--ease-spring);
    animation: finale-twinkle 3.4s ease-in-out infinite;
  }
  .c-coral { background: var(--coral);    box-shadow: 0 0 12px var(--coral); }
  .c-lav   { background: var(--lavender); box-shadow: 0 0 12px var(--lavender); animation-delay: .4s; }
  .c-gold  { background: var(--gold);     box-shadow: 0 0 14px var(--gold); animation-delay: .8s; }
  .c-mint  { background: var(--mint);     box-shadow: 0 0 12px var(--mint); animation-delay: 1.2s; }
  .c-aqua  { background: var(--aqua);     box-shadow: 0 0 12px var(--aqua); animation-delay: 1.6s; }

  /* dots pop in sequence as the wire reaches them — the system assembles itself */
  .constellation.drawn .cdot   { transform: scale(1); }
  .constellation.drawn .c-coral { transition-delay: 0ms; }
  .constellation.drawn .c-lav   { transition-delay: 200ms; }
  .constellation.drawn .c-gold  { transition-delay: 400ms; transform: scale(1.18); }
  .constellation.drawn .c-mint  { transition-delay: 600ms; }
  .constellation.drawn .c-aqua  { transition-delay: 800ms; }
  @keyframes finale-twinkle { 0%,100% { opacity: 1; } 50% { opacity: .5; } }

  .cnames {
    margin-top: 1.1rem;
    font-family: var(--font-mono); font-size: var(--fs-2xs);
    letter-spacing: .18em; text-transform: uppercase; color: var(--ink-faint);
  }

  /* (the sitewide footer now lives in components/Footer.astro) */

  @media (prefers-reduced-motion: reduce) {
    .cdot { animation: none !important; transform: none !important; transition: none !important; }
    .c-gold { transform: scale(1.18) !important; }
    .con-wire { width: 100% !important; transition: none !important; }
  }
</style>

<script is:inline>
  // Finale constellation — draw the connective wire and pop the five pillars in
  // sequence once it scrolls into view (the peak-end note the page closes on).
  (function () {
    var con = document.getElementById('finale-constellation');
    if (!con) return;
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;                              // CSS shows it fully assembled
    var done = false;

    function visibleFrac(el) {
      var r = el.getBoundingClientRect();
      var h = window.innerHeight || document.documentElement.clientHeight;
      if (r.height === 0) return 0;
      return Math.max(0, Math.min(r.bottom, h) - Math.max(r.top, 0)) / Math.min(r.height, h);
    }
    function check() {
      if (done) return;
      if (visibleFrac(con) >= 0.6) {
        done = true;
        con.classList.add('drawn');
        window.removeEventListener('scroll', check);
        window.removeEventListener('resize', check);
      }
    }
    requestAnimationFrame(function () { requestAnimationFrame(check); });
    window.addEventListener('scroll', check, { passive: true });
    window.addEventListener('resize', check);
  })();
</script>

<script is:inline>
  // Inline waitlist capture — posts the email straight to /api/waitlist (Supabase),
  // no modal hop. Mirrors the Auth modal's validation + result states.
  (function () {
    var RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    [].forEach.call(document.querySelectorAll('[data-wl]'), function (form) {
    var note = form.parentNode.querySelector('[data-wl-note]');
    var input = form.querySelector('input[type="email"]');
    var btn = form.querySelector('button[type="submit"]');
    var busy = false;
    function setNote(msg, kind) {
      if (!note) return;
      note.innerHTML = msg; note.hidden = false;
      note.classList.remove('is-error', 'is-ok');
      note.classList.add(kind === 'error' ? 'is-error' : 'is-ok');
    }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (busy) return;
      var val = (input.value || '').trim();
      if (!RE.test(val)) { setNote('Enter a valid email to continue.', 'error'); input.focus(); return; }
      busy = true; if (btn) btn.disabled = true; setNote('One moment…', 'ok');
      fetch('/api/waitlist', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: val }) })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (r) {
          if (r.ok && r.d && r.d.ok) { setNote('You\'re in — welcome to Blaksyd. We\'ll email you the moment we open. Meanwhile, <a href="/manifesto/">see why we\'re building this →</a>', 'ok'); form.reset(); }
          else { setNote((r.d && r.d.error) || 'Could not save right now. Please try again.', 'error'); }
        })
        .catch(function () { setNote('Network error — please try again.', 'error'); })
        .then(function () { busy = false; if (btn) btn.disabled = false; });
    });
    });
  })();
</script>
