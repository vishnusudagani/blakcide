---
// Finale — the closing payoff. After the four products and the Learning keystone,
// the page zooms back out to the whole: one world, built around you. Emotion is
// "the better future" — hopeful, warm, human. The accent spans warm→cool to fuse
// the AI and Human sides one last time. One "Begin" CTA opens the signup/login
// modal, and a quiet five-dot constellation recaps the structure
// (Blak · Persona · Learning · Minit · Nexus) without a word of jargon.
---

<section class="s-section finale" id="waitlist" aria-label="Join Blaksyd">
  <div class="finale-glow" aria-hidden="true"></div>

  <div class="u-wrap finale-inner">
    <p class="s-kicker k-gold finale-kicker" data-reveal><span class="orb"></span>your world, from here</p>

    <h2 class="s-title finale-title" data-reveal>
      Step into a world<br />
      <span class="accent">that's yours alone.</span>
    </h2>

    <p class="s-sub finale-sub" data-reveal>
      Blak and Persona to know you. Minit and Nexus to bring people close. One
      engine learning you a little more every day. The better future isn't
      coming — it's yours to enter.
    </p>

    <div class="finale-ctas" data-reveal>
      <button type="button" class="btn btn-primary" data-open-auth data-tab="signup">
        <span>Join Us</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>
    </div>

    <div class="constellation" id="finale-constellation" data-reveal aria-hidden="true">
      <span class="con-wire" aria-hidden="true"></span>
      <span class="cdot c-coral"></span>
      <span class="cdot c-lav"></span>
      <span class="cdot c-gold"></span>
      <span class="cdot c-mint"></span>
      <span class="cdot c-aqua"></span>
    </div>
    <p class="cnames" data-reveal>Blak · Persona · Learning · Minit · Nexus</p>
  </div>

</section>

<style>
  .finale {
    position: relative; overflow: hidden;
    padding-block: clamp(5rem, 13vh, 9rem) 0;
  }
  .finale-glow {
    position: absolute; left: 50%; top: 18%; transform: translateX(-50%);
    width: min(900px, 120%); height: 520px; z-index: 0; pointer-events: none;
    filter: blur(70px); opacity: .9;
    background:
      radial-gradient(42% 60% at 30% 40%, rgba(255, 107, 157, .26), transparent 70%),
      radial-gradient(42% 60% at 70% 45%, rgba(91, 192, 255, .22), transparent 70%),
      radial-gradient(50% 60% at 50% 60%, rgba(201, 184, 255, .20), transparent 72%);
  }
  .finale-inner { position: relative; z-index: 1; text-align: center; max-width: 64ch; margin-inline: auto; }
  .finale-kicker { margin-inline: auto; }

  .finale-title { margin-inline: auto; max-width: 16ch; }
  .finale-title .accent {
    /* warm→cool spectrum — fuses the AI and Human sides one last time */
    background: linear-gradient(110deg, var(--coral) 0%, var(--lavender) 42%, var(--aqua) 92%);
    -webkit-background-clip: text; background-clip: text;
  }
  .finale-sub { margin-inline: auto; max-width: 54ch; }

  .finale-ctas {
    display: flex; flex-wrap: wrap; justify-content: center; gap: .9rem;
    margin-top: 2.6rem;
  }
  @media (max-width: 600px) {
    .finale-ctas { width: 100%; max-width: 360px; margin-inline: auto; }
  }

  /* ── closing constellation — the whole system in five dots ── */
  .constellation {
    position: relative; display: inline-flex; align-items: center; gap: clamp(1.4rem, 5vw, 2.6rem);
    margin-top: clamp(3rem, 7vh, 4.5rem); padding: 0 .4rem;
  }
  .constellation::before {
    content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-strong) 18%, var(--line-strong) 82%, transparent);
    z-index: 0;
  }
  /* the bright connective wire that draws across on scroll-in (over the faint track) */
  .con-wire {
    position: absolute; left: 0; top: 50%; height: 2px; width: 0; z-index: 0;
    transform: translateY(-50%); border-radius: 2px;
    background: linear-gradient(90deg,
      var(--coral) 0%, var(--lavender) 30%, var(--gold) 52%, var(--mint-deep) 76%, var(--aqua) 100%);
    box-shadow: 0 0 10px rgba(255, 210, 122, .35);
    transition: width 1000ms var(--ease-out);
  }
  .constellation.drawn .con-wire { width: 100%; }

  .cdot {
    position: relative; z-index: 1; width: 11px; height: 11px; border-radius: 50%;
    transform: scale(0);
    transition: transform 560ms var(--ease-spring);
    animation: finale-twinkle 3.4s ease-in-out infinite;
  }
  .c-coral { background: var(--coral);    box-shadow: 0 0 12px var(--coral); }
  .c-lav   { background: var(--lavender); box-shadow: 0 0 12px var(--lavender); animation-delay: .4s; }
  .c-gold  { background: var(--gold);     box-shadow: 0 0 14px var(--gold); animation-delay: .8s; }
  .c-mint  { background: var(--mint);     box-shadow: 0 0 12px var(--mint); animation-delay: 1.2s; }
  .c-aqua  { background: var(--aqua);     box-shadow: 0 0 12px var(--aqua); animation-delay: 1.6s; }

  /* dots pop in sequence as the wire reaches them — the system assembles itself */
  .constellation.drawn .cdot   { transform: scale(1); }
  .constellation.drawn .c-coral { transition-delay: 0ms; }
  .constellation.drawn .c-lav   { transition-delay: 200ms; }
  .constellation.drawn .c-gold  { transition-delay: 400ms; transform: scale(1.18); }
  .constellation.drawn .c-mint  { transition-delay: 600ms; }
  .constellation.drawn .c-aqua  { transition-delay: 800ms; }
  @keyframes finale-twinkle { 0%,100% { opacity: 1; } 50% { opacity: .5; } }

  .cnames {
    margin-top: 1.1rem;
    font-family: var(--font-mono); font-size: .68rem;
    letter-spacing: .18em; text-transform: uppercase; color: var(--ink-faint);
  }

  /* (the sitewide footer now lives in components/Footer.astro) */

  @media (prefers-reduced-motion: reduce) {
    .cdot { animation: none !important; transform: none !important; transition: none !important; }
    .c-gold { transform: scale(1.18) !important; }
    .con-wire { width: 100% !important; transition: none !important; }
  }
</style>

<script is:inline>
  // Finale constellation — draw the connective wire and pop the five pillars in
  // sequence once it scrolls into view (the peak-end note the page closes on).
  (function () {
    var con = document.getElementById('finale-constellation');
    if (!con) return;
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;                              // CSS shows it fully assembled
    var done = false;

    function visibleFrac(el) {
      var r = el.getBoundingClientRect();
      var h = window.innerHeight || document.documentElement.clientHeight;
      if (r.height === 0) return 0;
      return Math.max(0, Math.min(r.bottom, h) - Math.max(r.top, 0)) / Math.min(r.height, h);
    }
    function check() {
      if (done) return;
      if (visibleFrac(con) >= 0.6) {
        done = true;
        con.classList.add('drawn');
        window.removeEventListener('scroll', check);
        window.removeEventListener('resize', check);
      }
    }
    requestAnimationFrame(function () { requestAnimationFrame(check); });
    window.addEventListener('scroll', check, { passive: true });
    window.addEventListener('resize', check);
  })();
</script>
