---
/* =====================================================================
   Auth — the single "Begin" gateway. One glass modal that opens from any
   [data-open-auth] trigger on the page (hero "Begin", nav "Enter", finale
   CTAs). Self-contained email capture for signup / login; posts the email
   to the waitlist (/api/waitlist -> Supabase). Dark + light aware via tokens. Esc / backdrop / × close it;
   body scroll locks while open; focus moves in and returns to the trigger.
   ===================================================================== */
---

<div class="auth" id="auth" data-auth hidden>
  <div class="auth-backdrop" data-auth-close></div>

  <div
    class="auth-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="auth-title"
    aria-describedby="auth-sub"
  >
    <button type="button" class="auth-x" data-auth-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>

    <span class="auth-dot" aria-hidden="true"></span>

    <h2 class="auth-title" id="auth-title" data-auth-title>Step into your world</h2>
    <p class="auth-sub" id="auth-sub" data-auth-sub>Built around you. Join in seconds.</p>

    <form class="auth-form" data-auth-form novalidate>
      <label class="auth-field">
        <span class="auth-label">Email</span>
        <input
          type="email"
          name="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
          data-auth-email
        />
      </label>

      <button type="submit" class="btn btn-primary auth-submit" data-auth-submit>
        <span data-auth-cta>Get early access</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>

      <p class="auth-note" data-auth-note role="status" aria-live="polite" hidden></p>
    </form>

    {/* Pre-launch there are no real accounts yet — only the waitlist — so the
        signup/login switch is hidden to keep one honest action. The login flow
        still works underneath; remove `hidden` at launch to restore the toggle. */}
    <p class="auth-switch" hidden>
      <span data-auth-switch-text>Already have a world?</span>
      <button type="button" class="auth-switch-btn" data-auth-switch>Log in</button>
    </p>

    <p class="auth-fine">
      By continuing you agree to our <a href="/terms/">Terms</a> &amp; <a href="/privacy/">Privacy</a>.
    </p>
  </div>
</div>

<style>
  .auth {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: var(--gutter);
  }
  .auth[hidden] { display: none; }

  .auth-backdrop {
    position: absolute;
    inset: 0;
    background: var(--glass-strong);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    backdrop-filter: blur(14px) saturate(120%);
    opacity: 0;
    transition: opacity 320ms var(--ease-soft);
  }
  .auth.is-open .auth-backdrop { opacity: 1; }

  .auth-card {
    position: relative;
    z-index: 1;
    isolation: isolate;
    width: 100%;
    max-width: 420px;
    padding: clamp(1.7rem, 1rem + 2.2vw, 2.5rem);
    background: var(--bg-warm);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-soft), 0 0 90px rgba(255, 182, 138, 0.16);
    text-align: center;
    overflow: hidden;
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transition:
      transform 460ms var(--ease-spring),
      opacity 320ms var(--ease-out);
  }
  .auth.is-open .auth-card { opacity: 1; transform: none; }

  /* soft living glow behind the card top */
  .auth-card::before {
    content: "";
    position: absolute;
    inset: -45% -10% auto -10%;
    height: 62%;
    background: radial-gradient(ellipse at 50% 0%, rgba(255, 107, 157, 0.20), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .auth-x {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--ink-faint);
    border-radius: var(--r-pill);
    transition:
      color var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out);
  }
  .auth-x:hover { color: var(--ink); background: var(--surface); }
  .auth-x svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .auth-dot {
    display: block;
    width: 34px;
    height: 34px;
    margin: 0 auto 1.15rem;
    border-radius: 50%;
    background: var(--accent-grad);
    box-shadow: var(--shadow-glow);
    animation: auth-breathe 4s var(--ease-soft) infinite;
  }
  @keyframes auth-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }

  .auth-title {
    font-size: var(--t-h3);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .auth-sub {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--t-body);
  }

  .auth-form {
    margin-top: 1.6rem;
    display: grid;
    gap: 0.9rem;
    text-align: left;
  }
  .auth-field { display: grid; gap: 0.4rem; }
  .auth-label {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .auth-field input {
    width: 100%;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    color: var(--ink);
    font-size: var(--fs-lg);
    transition:
      border-color var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out),
      box-shadow var(--t-fast) var(--ease-out);
  }
  .auth-field input::placeholder { color: var(--ink-ghost); }
  .auth-field input:focus {
    outline: none;
    border-color: var(--coral);
    background: var(--surface-strong);
    box-shadow: 0 0 0 3px rgba(255, 107, 157, 0.18);
  }

  .auth-submit {
    width: 100%;
    justify-content: center;
    margin-top: 0.3rem;
  }

  .auth-note {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.5;
    color: var(--ink-soft);
    padding: 0.65rem 0.85rem;
    border-radius: var(--r-sm);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .auth-note.is-error {
    color: var(--coral-deep);
    border-color: rgba(244, 69, 140, 0.4);
    background: rgba(244, 69, 140, 0.07);
  }
  .auth-note.is-ok {
    color: var(--mint-deep);
    border-color: rgba(106, 211, 184, 0.4);
    background: rgba(106, 211, 184, 0.08);
  }

  .auth-switch {
    margin-top: 1.3rem;
    font-size: var(--fs-md);
    color: var(--ink-soft);
  }
  .auth-switch-btn {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--coral);
    transition: color var(--t-fast) var(--ease-out);
  }
  .auth-switch-btn:hover { color: var(--coral); }

  /* light theme — accent text + focus UI to clear WCAG AA on cream */
  html[data-theme="light"] .auth-field input:focus { border-color: var(--coral-ink); }
  html[data-theme="light"] .auth-note.is-error { color: var(--coral-ink); }
  html[data-theme="light"] .auth-note.is-ok { color: var(--mint-ink); }
  html[data-theme="light"] .auth-switch-btn { text-decoration-color: var(--coral-ink); }
  html[data-theme="light"] .auth-switch-btn:hover { color: var(--coral-ink); }

  .auth-fine {
    margin-top: 1.1rem;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--ink-faint);
  }
  .auth-fine a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .auth-fine a:hover { color: var(--ink); }

  @media (prefers-reduced-motion: reduce) {
    .auth-backdrop,
    .auth-card { transition: none; }
    .auth-dot { animation: none; }
  }
</style>

<script is:inline>
  (function () {
    var modal = document.getElementById('auth');
    if (!modal) return;

    var titleEl = modal.querySelector('[data-auth-title]');
    var subEl = modal.querySelector('[data-auth-sub]');
    var ctaEl = modal.querySelector('[data-auth-cta]');
    var switchTextEl = modal.querySelector('[data-auth-switch-text]');
    var switchBtn = modal.querySelector('[data-auth-switch]');
    var form = modal.querySelector('[data-auth-form]');
    var email = modal.querySelector('[data-auth-email]');
    var note = modal.querySelector('[data-auth-note]');
    var submitBtn = modal.querySelector('[data-auth-submit]');

    var mode = 'signup';
    var lastTrigger = null;
    var openTimer, closeTimer;

    var COPY = {
      signup: {
        title: 'Step into your world',
        sub: 'Built around you. Join in seconds.',
        cta: 'Get early access',
        switchText: 'Already have a world?',
        switchBtn: 'Log in',
        ok: 'You\'re in — welcome to Blaksyd. We\'ll email you the moment we open. Meanwhile, <a href="/manifesto/">see why we\'re building this →</a>'
      },
      login: {
        title: 'Welcome back',
        sub: 'Your world is right where you left it.',
        cta: 'Continue',
        switchText: 'New here?',
        switchBtn: 'Create your world',
        ok: 'Welcome back — opening your world.'
      }
    };

    function render() {
      var c = COPY[mode];
      titleEl.textContent = c.title;
      subEl.textContent = c.sub;
      ctaEl.textContent = c.cta;
      switchTextEl.textContent = c.switchText;
      switchBtn.textContent = c.switchBtn;
      clearNote();
    }
    function clearNote() {
      note.hidden = true;
      note.textContent = '';
      note.classList.remove('is-error', 'is-ok');
    }
    function setNote(msg, kind) {
      note.innerHTML = msg;
      note.hidden = false;
      note.classList.remove('is-error', 'is-ok');
      note.classList.add(kind === 'error' ? 'is-error' : 'is-ok');
    }

    function open(tab, trigger) {
      mode = tab === 'login' ? 'login' : 'signup';
      lastTrigger = trigger || null;
      render();
      clearTimeout(closeTimer);
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { modal.classList.add('is-open'); });
      });
      openTimer = setTimeout(function () { if (email) email.focus(); }, 140);
      document.addEventListener('keydown', onKey);
    }
    function close() {
      clearTimeout(openTimer);
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      closeTimer = setTimeout(function () {
        modal.hidden = true;
        clearNote();
        if (form) form.reset();
        if (lastTrigger && typeof lastTrigger.focus === 'function') lastTrigger.focus();
      }, 380);
    }
    function onKey(e) {
      if (e.key === 'Escape') { close(); return; }
      if (e.key === 'Tab') trapFocus(e);
    }
    function trapFocus(e) {
      var f = [].slice.call(modal.querySelectorAll('button, input, a[href]')).filter(function (el) {
        return !el.disabled && el.offsetParent !== null;
      });
      if (!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }

    /* delegated, site-wide: any [data-open-auth] opens; any [data-auth-close] closes */
    document.addEventListener('click', function (e) {
      var opener = e.target.closest && e.target.closest('[data-open-auth]');
      if (opener) { e.preventDefault(); open(opener.getAttribute('data-tab'), opener); return; }
      var closer = e.target.closest && e.target.closest('[data-auth-close]');
      if (closer) { e.preventDefault(); close(); }
    });

    switchBtn.addEventListener('click', function () {
      mode = mode === 'signup' ? 'login' : 'signup';
      render();
      if (email) email.focus();
    });

    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    var submitting = false;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (submitting) return;
      var val = (email.value || '').trim();
      if (!EMAIL_RE.test(val)) {
        setNote('Enter a valid email to continue.', 'error');
        email.focus();
        return;
      }
      submitting = true;
      if (submitBtn) submitBtn.disabled = true;
      setNote('One moment…', 'ok');
      fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: val })
      })
        .then(function (res) {
          return res.json().catch(function () { return {}; }).then(function (data) {
            return { ok: res.ok, data: data };
          });
        })
        .then(function (r) {
          if (r.ok && r.data && r.data.ok) {
            setNote(COPY[mode].ok, 'ok');
            form.reset();
          } else {
            setNote((r.data && r.data.error) || 'Could not save right now. Please try again.', 'error');
          }
        })
        .catch(function () {
          setNote('Network error — please try again.', 'error');
        })
        .then(function () {
          submitting = false;
          if (submitBtn) submitBtn.disabled = false;
        });
    });
  })();
</script>
