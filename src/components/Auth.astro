---
/* =====================================================================
   Auth — the single "Begin" gateway. One glass modal that opens from any
   [data-open-auth] trigger on the page (hero "Begin", nav "Enter", finale
   CTAs). Self-contained email capture for signup / login; posts the email
   to the waitlist (/api/waitlist -> Supabase). Dark + light aware via tokens. Esc / backdrop / × close it;
   body scroll locks while open; focus moves in and returns to the trigger.
   ===================================================================== */
---

<div class="auth" id="auth" data-auth hidden>
  <div class="auth-backdrop" data-auth-close></div>

  <div
    class="auth-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="auth-title"
    aria-describedby="auth-sub"
  >
    <button type="button" class="auth-x" data-auth-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>

    <span class="auth-dot" aria-hidden="true"></span>

    <h2 class="auth-title" id="auth-title" data-auth-title>Try the Blaksyd beta</h2>
    <p class="auth-sub" id="auth-sub" data-auth-sub>Continue with Google, or a magic link by email.</p>

    <div class="auth-views">
      {/* ── choose a door ── */}
      <div class="auth-view" data-auth-view="methods">
        <button type="button" class="auth-social" data-auth-method="google">
          <svg class="auth-ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.5 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.2-4.8 3.2-7.9z"/><path fill="#34A853" d="M12 23c2.9 0 5.4-1 7.2-2.7l-3.6-2.7c-1 .7-2.3 1.1-3.6 1.1-2.8 0-5.1-1.9-6-4.4H2.3v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M6 14.3a6.6 6.6 0 0 1 0-4.2V7.3H2.3a11 11 0 0 0 0 9.8L6 14.3z"/><path fill="#EA4335" d="M12 5.5c1.6 0 3 .5 4.1 1.6l3.1-3.1A11 11 0 0 0 12 1 11 11 0 0 0 2.3 7.3L6 10.1c.9-2.6 3.2-4.6 6-4.6z"/></svg>
          Continue with Google
        </button>

        {/* WhatsApp parked until the Meta authentication template is approved.
            Re-enable by un-commenting this button (the phone/otp views below stay):
        <button type="button" class="auth-social auth-wa" data-auth-method="whatsapp">
          <svg class="auth-ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="#25D366" d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-5-4.3-5.1-4.5-.2-.2-1.2-1.6-1.2-3s.7-2.2 1-2.5c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.1.3.7 1.1 1.4 1.8 1 .9 1.8 1.1 2 1.3.3.1.4.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.8.9c.2.1.4.2.5.3.1.2.1.7-.1 1.5z"/></svg>
          Continue with WhatsApp
        </button>
        */}

        <div class="auth-or" aria-hidden="true"><span>or</span></div>

        <form class="auth-form" data-auth-form="email" novalidate>
          <input type="email" name="email" inputmode="email" autocomplete="email" placeholder="you@example.com" required data-auth-email />
          <button type="submit" class="btn btn-primary auth-submit"><span>Email me a sign-in link</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </button>
        </form>
      </div>

      {/* ── WhatsApp: phone entry ── */}
      <form class="auth-view" data-auth-view="phone" data-auth-form="phone" hidden novalidate>
        <p class="auth-step">We'll message a 6-digit code to your WhatsApp.</p>
        <input type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder="+91 98765 43210" required data-auth-phone />
        <button type="submit" class="btn btn-primary auth-submit"><span>Send code on WhatsApp</span></button>
        <button type="button" class="auth-back" data-auth-back>← other ways to enter</button>
      </form>

      {/* ── OTP: code entry ── */}
      <form class="auth-view" data-auth-view="otp" data-auth-form="otp" hidden novalidate>
        <p class="auth-step">Enter the 6-digit code sent to <b data-auth-dest>your WhatsApp</b>.</p>
        <input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" placeholder="••••••" required data-auth-otp class="auth-otp" aria-label="6-digit code" />
        <button type="submit" class="btn btn-primary auth-submit"><span>Verify &amp; enter</span></button>
        <div class="auth-row">
          <button type="button" class="auth-back" data-auth-resend>Resend code</button>
          <button type="button" class="auth-back" data-auth-back>← back</button>
        </div>
      </form>

      {/* ── done ── */}
      <div class="auth-view" data-auth-view="done" hidden>
        <p class="auth-step auth-done"><b>You're in — welcome to Blaksyd.</b><br />We'll open your world the moment we launch.</p>
      </div>
    </div>

    <p class="auth-note" data-auth-note role="status" aria-live="polite" hidden></p>

    <p class="auth-fine">
      By continuing you agree to our <a href="/terms/">Terms</a> &amp; <a href="/privacy/">Privacy</a>.
    </p>
  </div>
</div>

<style>
  .auth {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: var(--gutter);
  }
  .auth[hidden] { display: none; }

  .auth-backdrop {
    position: absolute;
    inset: 0;
    background: var(--glass-strong);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    backdrop-filter: blur(14px) saturate(120%);
    opacity: 0;
    transition: opacity 320ms var(--ease-soft);
  }
  .auth.is-open .auth-backdrop { opacity: 1; }

  .auth-card {
    position: relative;
    z-index: 1;
    isolation: isolate;
    width: 100%;
    max-width: 420px;
    padding: clamp(1.7rem, 1rem + 2.2vw, 2.5rem);
    background: var(--bg-warm);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-soft), 0 0 90px rgba(255, 182, 138, 0.16);
    text-align: center;
    overflow: hidden;
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transition:
      transform 460ms var(--ease-spring),
      opacity 320ms var(--ease-out);
  }
  .auth.is-open .auth-card { opacity: 1; transform: none; }

  /* soft living glow behind the card top */
  .auth-card::before {
    content: "";
    position: absolute;
    inset: -45% -10% auto -10%;
    height: 62%;
    background: radial-gradient(ellipse at 50% 0%, rgba(255, 107, 157, 0.20), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .auth-x {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--ink-faint);
    border-radius: var(--r-pill);
    transition:
      color var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out);
  }
  .auth-x:hover { color: var(--ink); background: var(--surface); }
  .auth-x svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .auth-dot {
    display: block;
    width: 34px;
    height: 34px;
    margin: 0 auto 1.15rem;
    border-radius: 50%;
    background: var(--accent-grad);
    box-shadow: var(--shadow-glow);
    animation: auth-breathe 4s var(--ease-soft) infinite;
  }
  @keyframes auth-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }

  .auth-title {
    font-size: var(--t-h3);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .auth-sub {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--t-body);
  }

  .auth-form {
    margin-top: 1.6rem;
    display: grid;
    gap: 0.9rem;
    text-align: left;
  }
  .auth-field { display: grid; gap: 0.4rem; }
  .auth-label {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .auth-field input {
    width: 100%;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    color: var(--ink);
    font-size: var(--fs-lg);
    transition:
      border-color var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out),
      box-shadow var(--t-fast) var(--ease-out);
  }
  .auth-field input::placeholder { color: var(--ink-ghost); }
  .auth-field input:focus {
    outline: none;
    border-color: var(--coral);
    background: var(--surface-strong);
    box-shadow: 0 0 0 3px rgba(255, 107, 157, 0.18);
  }

  .auth-submit {
    width: 100%;
    justify-content: center;
    margin-top: 0.3rem;
  }

  .auth-note {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.5;
    color: var(--ink-soft);
    padding: 0.65rem 0.85rem;
    border-radius: var(--r-sm);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .auth-note.is-error {
    color: var(--coral-deep);
    border-color: rgba(244, 69, 140, 0.4);
    background: rgba(244, 69, 140, 0.07);
  }
  .auth-note.is-ok {
    color: var(--mint-deep);
    border-color: rgba(106, 211, 184, 0.4);
    background: rgba(106, 211, 184, 0.08);
  }

  .auth-switch {
    margin-top: 1.3rem;
    font-size: var(--fs-md);
    color: var(--ink-soft);
  }
  .auth-switch-btn {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--coral);
    transition: color var(--t-fast) var(--ease-out);
  }
  .auth-switch-btn:hover { color: var(--coral); }

  /* light theme — accent text + focus UI to clear WCAG AA on cream */
  html[data-theme="light"] .auth-field input:focus { border-color: var(--coral-ink); }
  html[data-theme="light"] .auth-note.is-error { color: var(--coral-ink); }
  html[data-theme="light"] .auth-note.is-ok { color: var(--mint-ink); }
  html[data-theme="light"] .auth-switch-btn { text-decoration-color: var(--coral-ink); }
  html[data-theme="light"] .auth-switch-btn:hover { color: var(--coral-ink); }

  .auth-fine {
    margin-top: 1.1rem;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--ink-faint);
  }
  .auth-fine a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .auth-fine a:hover { color: var(--ink); }

  @media (prefers-reduced-motion: reduce) {
    .auth-backdrop,
    .auth-card { transition: none; }
    .auth-dot { animation: none; }
  }

  /* ── multi-method auth (Google · WhatsApp · email) ── */
  .auth-views { margin-top: .4rem; text-align: left; }
  .auth-view { display: flex; flex-direction: column; gap: .7rem; }
  .auth-view[hidden] { display: none; }

  .auth-social {
    display: inline-flex; align-items: center; justify-content: center; gap: .6rem;
    width: 100%; padding: .85rem 1rem; border-radius: var(--r-pill);
    font-family: inherit; font-size: var(--fs-md); font-weight: 600; color: var(--ink);
    background: var(--surface-strong); border: 1px solid var(--line-strong); cursor: pointer;
    transition: transform var(--t-fast) var(--ease-spring), border-color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out);
  }
  .auth-social:hover { transform: translateY(-1px); border-color: var(--ink-faint); }
  .auth-social:disabled { opacity: .5; cursor: not-allowed; transform: none; }
  .auth-ic { width: 18px; height: 18px; flex: none; }
  .auth-wa:hover { border-color: rgba(37, 211, 102, .55); }

  .auth-or {
    display: flex; align-items: center; gap: .8rem; margin: .15rem 0;
    font-family: var(--font-mono); font-size: var(--fs-2xs); text-transform: uppercase; letter-spacing: .14em; color: var(--ink-faint);
  }
  .auth-or span { flex: none; }
  .auth-or::before, .auth-or::after { content: ''; flex: 1; height: 1px; background: var(--line); }

  .auth-form { display: flex; flex-direction: column; gap: .7rem; }
  .auth-view input {
    width: 100%; padding: .85rem 1rem; border-radius: var(--r-pill);
    font-family: inherit; font-size: var(--fs-md); color: var(--ink); text-align: center;
    background: var(--surface); border: 1px solid var(--line-strong);
    transition: border-color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out), box-shadow var(--t-fast) var(--ease-out);
  }
  .auth-view input::placeholder { color: var(--ink-faint); }
  .auth-view input:focus { outline: none; border-color: #1E63D8; background: var(--surface-strong); box-shadow: 0 0 0 3px rgba(30, 99, 216, .16); }
  .auth-otp { letter-spacing: .45em; font-size: var(--fs-xl); font-weight: 600; padding-left: .45em; }

  .auth-submit { width: 100%; justify-content: center; }
  .auth-step { font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.5; }
  .auth-step b { color: var(--ink); font-weight: 600; }
  .auth-done { font-size: var(--fs-md); color: var(--ink); text-align: center; }
  .auth-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .auth-back {
    align-self: center; font-family: inherit; font-size: var(--fs-sm); color: var(--ink-faint); cursor: pointer;
    transition: color var(--t-fast) var(--ease-out);
  }
  .auth-back:hover { color: var(--ink); }
</style>

<script>
  import { supabase, supabaseConfigured } from '../lib/supabaseClient';

  (function () {
    var modal = document.getElementById('auth');
    if (!modal) return;

    var note = modal.querySelector('[data-auth-note]');
    var views = {};
    [].forEach.call(modal.querySelectorAll('[data-auth-view]'), function (v) { views[v.getAttribute('data-auth-view')] = v; });
    var emailForm = modal.querySelector('[data-auth-form="email"]');
    var emailInput = modal.querySelector('[data-auth-email]');
    var phoneForm = modal.querySelector('[data-auth-form="phone"]');
    var phoneInput = modal.querySelector('[data-auth-phone]');
    var otpForm = modal.querySelector('[data-auth-form="otp"]');
    var otpInput = modal.querySelector('[data-auth-otp]');
    var destEl = modal.querySelector('[data-auth-dest]');

    var lastTrigger = null;
    var openTimer, closeTimer;
    var pendingPhone = '';
    var busy = false;
    var redirectTo = window.location.origin + '/';


    function clearNote() { note.hidden = true; note.textContent = ''; note.classList.remove('is-error', 'is-ok'); }
    function setNote(msg, kind) { note.innerHTML = msg; note.hidden = false; note.classList.remove('is-error', 'is-ok'); note.classList.add(kind === 'error' ? 'is-error' : 'is-ok'); }

    // ── view switching: methods -> phone -> otp -> done ──
    function showView(name) {
      for (var k in views) { if (views[k]) views[k].hidden = (k !== name); }
      clearNote();
      var first = views[name] && views[name].querySelector('input, button');
      if (first) setTimeout(function () { try { first.focus(); } catch (e) {} }, 60);
    }

    // ── open / close (preserved focus-trap + scroll-lock) ──
    function open(tab, trigger) {
      lastTrigger = trigger || null;
      showView('methods');
      clearTimeout(closeTimer);
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () { requestAnimationFrame(function () { modal.classList.add('is-open'); }); });
      document.addEventListener('keydown', onKey);
    }
    function close() {
      clearTimeout(openTimer);
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      closeTimer = setTimeout(function () {
        modal.hidden = true; clearNote();
        if (emailForm) emailForm.reset(); if (phoneForm) phoneForm.reset(); if (otpForm) otpForm.reset();
        showView('methods');
        if (lastTrigger && typeof lastTrigger.focus === 'function') lastTrigger.focus();
      }, 380);
    }
    function onKey(e) {
      if (e.key === 'Escape') { close(); return; }
      if (e.key === 'Tab') trapFocus(e);
    }
    function trapFocus(e) {
      var f = [].slice.call(modal.querySelectorAll('button, input, a[href]')).filter(function (el) { return !el.disabled && el.offsetParent !== null; });
      if (!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }

    /* delegated, site-wide: any [data-open-auth] opens; any [data-auth-close] closes */
    document.addEventListener('click', function (e) {
      var opener = e.target.closest && e.target.closest('[data-open-auth]');
      if (opener) { e.preventDefault(); open(opener.getAttribute('data-tab'), opener); return; }
      var closer = e.target.closest && e.target.closest('[data-auth-close]');
      if (closer) { e.preventDefault(); close(); }
    });

    function setBusy(b) {
      busy = b;
      [].forEach.call(modal.querySelectorAll('button, input'), function (el) { if (el.hasAttribute('data-auth-close')) return; el.disabled = b; });
    }

    // ── method picks + back buttons ──
    [].forEach.call(modal.querySelectorAll('[data-auth-method]'), function (btn) {
      btn.addEventListener('click', function () {
        var m = btn.getAttribute('data-auth-method');
        if (m === 'whatsapp') { showView('phone'); }
        else if (m === 'google') { googleSignIn(); }
      });
    });
    [].forEach.call(modal.querySelectorAll('[data-auth-back]'), function (b) { b.addEventListener('click', function () { showView('methods'); }); });

    // ── Google OAuth ──
    function googleSignIn() {
      if (!supabaseConfigured || !supabase) { setNote('Google sign-in is being set up — try email or WhatsApp.', 'error'); return; }
      setBusy(true); setNote('Opening Google…', 'ok');
      supabase.auth.signInWithOAuth({ provider: 'google', options: { redirectTo: redirectTo } })
        .then(function (r) { if (r.error) { setBusy(false); setNote(r.error.message || 'Could not start Google sign-in.', 'error'); } })
        .catch(function () { setBusy(false); setNote('Could not start Google sign-in.', 'error'); });
    }

    // ── email (passwordless link); graceful waitlist fallback until auth env is set ──
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (emailForm) emailForm.addEventListener('submit', function (e) {
      e.preventDefault(); if (busy) return;
      var val = (emailInput.value || '').trim();
      if (!EMAIL_RE.test(val)) { setNote('Enter a valid email.', 'error'); emailInput.focus(); return; }
      setBusy(true); setNote('Sending your link…', 'ok');
      if (!supabaseConfigured || !supabase) {
        fetch('/api/waitlist', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: val }) })
          .then(function (res) { return res.json().catch(function () { return {}; }).then(function (d) { return res.ok && d && d.ok; }); })
          .then(function (ok) { setBusy(false); if (ok) { setNote('You are on the list — we will email you. ✨', 'ok'); emailForm.reset(); } else { setNote('Could not save right now — please try again.', 'error'); } })
          .catch(function () { setBusy(false); setNote('Network error — please try again.', 'error'); });
        return;
      }
      supabase.auth.signInWithOtp({ email: val, options: { emailRedirectTo: redirectTo } })
        .then(function (r) { setBusy(false); if (r.error) { setNote(r.error.message || 'Could not send the link.', 'error'); } else { setNote('Check your inbox — a sign-in link is on its way to <b>' + val + '</b>.', 'ok'); } })
        .catch(function () { setBusy(false); setNote('Network error — please try again.', 'error'); });
    });

    // ── WhatsApp: send code (Supabase phone OTP, delivered by the Meta hook) ──
    if (phoneForm) phoneForm.addEventListener('submit', function (e) {
      e.preventDefault(); if (busy) return;
      var raw = (phoneInput.value || '').trim().replace(/[^\d+]/g, '');
      if (!/^\+\d{8,15}$/.test(raw)) { setNote('Enter your number with country code, e.g. +91…', 'error'); phoneInput.focus(); return; }
      if (!supabaseConfigured || !supabase) { setNote('WhatsApp sign-in is being set up — try email.', 'error'); return; }
      setBusy(true); setNote('Sending a code to your WhatsApp…', 'ok');
      supabase.auth.signInWithOtp({ phone: raw })
        .then(function (r) { setBusy(false); if (r.error) { setNote(r.error.message || 'Could not send the code.', 'error'); } else { pendingPhone = raw; if (destEl) destEl.textContent = raw; showView('otp'); } })
        .catch(function () { setBusy(false); setNote('Network error — please try again.', 'error'); });
    });

    // ── WhatsApp: verify code -> real Supabase session ──
    if (otpForm) otpForm.addEventListener('submit', function (e) {
      e.preventDefault(); if (busy) return;
      var code = (otpInput.value || '').trim();
      if (!/^\d{4,8}$/.test(code)) { setNote('Enter the 6-digit code.', 'error'); otpInput.focus(); return; }
      if (!supabase) return;
      setBusy(true); setNote('Verifying…', 'ok');
      supabase.auth.verifyOtp({ phone: pendingPhone, token: code, type: 'sms' })
        .then(function (r) { setBusy(false); if (r.error) { setNote(r.error.message || 'That code did not match — try again.', 'error'); } else { onSignedIn(); } })
        .catch(function () { setBusy(false); setNote('Network error — please try again.', 'error'); });
    });

    // ── resend ──
    [].forEach.call(modal.querySelectorAll('[data-auth-resend]'), function (b) {
      b.addEventListener('click', function () {
        if (!supabase || !pendingPhone) return;
        setBusy(true); setNote('Resending…', 'ok');
        supabase.auth.signInWithOtp({ phone: pendingPhone })
          .then(function (r) { setBusy(false); setNote(r.error ? (r.error.message || 'Could not resend.') : 'A new code is on its way.', r.error ? 'error' : 'ok'); })
          .catch(function () { setBusy(false); setNote('Could not resend.', 'error'); });
      });
    });

    var APP = '/beta/';
    function goToApp() { window.location.replace(APP); }
    function onSignedIn() { showView('done'); }
    function showAuthError(msg) { try { open(null, null); setNote(msg, 'error'); } catch (e) {} }

    // Auth params come back in the hash (implicit) or the query (PKCE / magic link).
    var authStr = (location.hash || '').replace(/^#/, '') + '&' + (location.search || '').replace(/^\?/, '');
    var hadAuthInUrl = /(^|&)(access_token|code|token_hash)=/.test(authStr);
    var hadAuthError = /(^|&)error(_description|_code)?=/.test(authStr);

    if (hadAuthError) {
      // The provider / Supabase bounced the sign-in (commonly a Redirect-URL or
      // Site-URL mismatch). Surface it instead of silently dropping the user here.
      var ep = new URLSearchParams(authStr);
      var em = (ep.get('error_description') || ep.get('error') || 'Sign-in could not be completed.').replace(/\+/g, ' ');
      setTimeout(function () { showAuthError('Sign-in failed: ' + em); }, 60);
    } else if (supabase && hadAuthInUrl) {
      // Returning from Google / magic link: detectSessionInUrl exchanges the code
      // asynchronously (and SIGNED_IN may replay as INITIAL_SESSION before we
      // subscribe). Poll for the session, then forward into the app.
      var tries = 0;
      var iv = setInterval(function () {
        supabase.auth.getSession().then(function (r) {
          if (r && r.data && r.data.session) { clearInterval(iv); goToApp(); }
          else if (++tries > 40) { // ~10s with auth params but no session = exchange didn't land
            clearInterval(iv);
            setTimeout(function () { showAuthError('You signed in, but the session didn’t land in this browser — usually the Supabase Site URL / Redirect URLs don’t match ' + location.host + '.'); }, 0);
          }
        }).catch(function () {});
      }, 250);
    }

    if (supabase) {
      // Sign-in completed while the modal is open (in-modal OTP, or a fast OAuth).
      supabase.auth.onAuthStateChange(function (evt, session) {
        if (session && evt === 'SIGNED_IN' && !modal.hidden) goToApp();
      });
    }
  })();
</script>
