---
// Hero — the bright "world" slice. A luminous dawn (not dusk): warm horizon bloom,
// drifting accent orbs, rising motes. The headline "Your world. Built _ you." sits
// at the still centre while the product floats in orbit around it as light glass
// surfaces — Blak (proactive AI), Minit (a real listener), Nexus (a live tribe) —
// threaded by a faint memory strand (the Learning engine). A trust bar grounds it.
// Everything is transform/opacity only (60fps), parallaxes to pointer + scroll on
// wide screens, and collapses to a clean headline on mobile. Show-don't-tell.
import Greeting from './Greeting.astro';
---

<section class="hero" id="top">
  {/* ── living world backdrop ───────────────────────────────────────── */}
  <div class="world-stage" aria-hidden="true">
    <div class="sky" data-par="2.2"></div>
    <div class="horizon" data-par="3"></div>
    <div class="orbs" data-par="1.4">
      <span class="orb orb-1"></span>
      <span class="orb orb-2"></span>
      <span class="orb orb-3"></span>
    </div>
    <div class="motes" id="hero-motes"></div>
  </div>

  {/* ── floating glass surfaces + memory thread (the product, in orbit) ─ */}
  <div class="surfaces" aria-hidden="true">
    <div class="thread">
      <span class="thread-mote"></span>
      <span class="thread-mote tm2"></span>
    </div>

    <div class="surface-slot slot-blak">
      <div class="surface-px" data-depth="1.5">
        <article class="surface s-blak">
          <div class="surf-head">
            <span class="surf-orb warm"></span>
            <span class="surf-name">Blak</span>
            <span class="surf-live"><i></i>thinking ahead</span>
          </div>
          <p class="surf-line">Your 4&nbsp;pm shifted to evening. Want me to move the run to morning?</p>
          <span class="surf-chip">remembers you skip late workouts</span>
        </article>
      </div>
    </div>

    <div class="surface-slot slot-minit">
      <div class="surface-px" data-depth="1.0">
        <article class="surface s-minit">
          <div class="surf-head">
            <span class="surf-pic"></span>
            <span class="surf-who"><b>Aria</b><i>warm · here now</i></span>
            <span class="surf-rate">★ 4.9</span>
          </div>
          <div class="surf-status"><i></i>available now · ~30s</div>
          <span class="surf-go">Talk now</span>
        </article>
      </div>
    </div>

    <div class="surface-slot slot-nexus">
      <div class="surface-px" data-depth="1.9">
        <article class="surface s-nexus">
          <div class="surf-head">
            <span class="surf-orb cool"></span>
            <span class="surf-name">Nexus</span>
            <span class="surf-live"><i></i>122 here</span>
          </div>
          <p class="surf-room">Made It Through Today</p>
          <span class="surf-sub">a room that's live right now</span>
        </article>
      </div>
    </div>
  </div>

  {/* ── headline column ─────────────────────────────────────────────── */}
  <div class="hero-inner u-wrap">
    <Greeting />
    <p class="eyebrow">
      <span class="eyebrow-dot"></span>
      a new kind of life platform
    </p>

    {/* in-hero wordmark removed — the nav already carries it. Declutters the
        headline column so the headline clearly leads (one focal path). */}

    <h1 class="title">
      {/* one clean, canonical name for screen readers + crawlers — the animated
          version below is decorative (aria-hidden) so AT never reads "by around for". */}
      <span class="sr-only">Your world. Built around you.</span>
      <span class="title-vis" aria-hidden="true">
        <span class="line">Your world.</span>
        <span class="line line-2">Built <span class="rotator" id="hero-rotator"><span class="rotator-word is-active">by</span><span class="rotator-word">around</span><span class="rotator-word">for</span></span> you.</span>
      </span>
    </h1>

    <p class="sub">
      AI that knows you. People who show up.
      A world that's yours, and only yours.
    </p>

    <div class="ctas">
      <button type="button" class="btn btn-primary" data-open-auth data-tab="signup">
        <span>Get early access</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>
      <a href="#ai" class="btn btn-ghost">
        <span>Explore the world</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
      </a>
    </div>
    <p class="hero-microcopy">Free early access · we're still building — be first when it opens.</p>
  </div>

  {/* ── trust bar — four pillars, warm→cool ─────────────────────────── */}
  <ul class="trust-bar">
    <li class="trust-item ti-1">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
      <span class="trust-txt"><b>Yours alone</b><i>your world, your data</i></span>
    </li>
    <li class="trust-item ti-2">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0" /><path d="M16 6.2a3.2 3.2 0 0 1 0 6M17.5 19a5.5 5.5 0 0 0-2.6-4.7" /></svg>
      <span class="trust-txt"><b>Real people</b><i>connection, not metrics</i></span>
    </li>
    <li class="trust-item ti-3">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4" /><path d="M12 8.5l1.4 2.1 2.1 1.4-2.1 1.4L12 15.5l-1.4-2.1L8.5 12l2.1-1.4z" /></svg>
      <span class="trust-txt"><b>Evolves with you</b><i>learns you, gently</i></span>
    </li>
    <li class="trust-item ti-4">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6z" /><path d="M9 12l2 2 4-4" /></svg>
      <span class="trust-txt"><b>Safe by design</b><i>anonymous, transparent</i></span>
    </li>
  </ul>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex; flex-direction: column;
    overflow: hidden;
  }

  /* ═══════════ living world backdrop ═══════════ */
  .world-stage { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }

  /* dawn bloom rising from the horizon — warm centre, cool flanks */
  .sky {
    position: absolute; inset: -10% -5% 0; z-index: 0; will-change: transform;
    background:
      radial-gradient(115% 64% at 50% 116%, rgba(255, 182, 138, .30), rgba(255, 210, 122, .10) 42%, transparent 70%),
      radial-gradient(85% 50% at 73% 110%, rgba(201, 184, 255, .16), transparent 60%),
      radial-gradient(82% 48% at 24% 112%, rgba(106, 211, 184, .13), transparent 60%);
  }
  html[data-theme="light"] .sky {
    background:
      radial-gradient(120% 70% at 50% 118%, rgba(255, 198, 120, .58), rgba(255, 182, 138, .20) 42%, transparent 72%),
      radial-gradient(90% 52% at 73% 110%, rgba(201, 184, 255, .26), transparent 62%),
      radial-gradient(86% 50% at 22% 112%, rgba(106, 211, 184, .22), transparent 62%);
  }

  /* a single luminous horizon strand — implies a world without a literal vista */
  .horizon {
    position: absolute; left: -5%; right: -5%; top: 62%; height: 1px; z-index: 1; will-change: transform;
    background: linear-gradient(90deg, transparent, rgba(255, 210, 122, .5) 28%, rgba(201, 184, 255, .42) 64%, transparent);
    box-shadow: 0 0 46px 10px rgba(255, 200, 140, .10);
  }
  html[data-theme="light"] .horizon {
    background: linear-gradient(90deg, transparent, rgba(255, 184, 110, .6) 28%, rgba(150, 131, 230, .4) 64%, transparent);
    box-shadow: 0 0 50px 12px rgba(255, 188, 120, .16);
  }

  /* drifting accent orbs (atmospheric light over the world wash) */
  .orbs { position: absolute; inset: 0; z-index: 1; pointer-events: none; will-change: transform; }
  .orb { position: absolute; border-radius: 50%; filter: blur(52px); opacity: .34; will-change: transform; }
  .orb-1 {
    width: 50vw; height: 50vw; left: 2%; top: 4%;
    background: radial-gradient(circle at 40% 40%, var(--coral), transparent 68%);
    animation: drift-a 32s var(--ease-soft) infinite alternate;
  }
  .orb-2 {
    width: 48vw; height: 48vw; right: 0%; top: 10%;
    background: radial-gradient(circle at 60% 40%, var(--lavender), transparent 68%);
    animation: drift-b 36s var(--ease-soft) infinite alternate;
  }
  .orb-3 {
    width: 42vw; height: 42vw; left: 30%; top: 40%;
    opacity: .42;
    background: radial-gradient(circle at 50% 50%, var(--mint), transparent 70%);
    animation: drift-c 40s var(--ease-soft) infinite alternate;
  }
  /* Light theme: soft luminous colour blooms on cream. NO mix-blend multiply —
     that darkened the cream into a grey-mauve haze. Normal blend at lower opacity
     reads as gentle dawn light; coral (the loudest hue) is kept the softest. */
  html[data-theme="light"] .orb   { opacity: .26; mix-blend-mode: normal; }
  html[data-theme="light"] .orb-1 { opacity: .18; }
  html[data-theme="light"] .orb-3 { opacity: .24; }
  @keyframes drift-a { from { transform: translate3d(0,0,0) scale(1); } to { transform: translate3d(6%,4%,0) scale(1.12); } }
  @keyframes drift-b { from { transform: translate3d(0,0,0) scale(1.05); } to { transform: translate3d(-5%,6%,0) scale(.92); } }
  @keyframes drift-c { from { transform: translate3d(0,0,0) scale(.95); } to { transform: translate3d(4%,-5%,0) scale(1.15); } }

  /* rising motes — little lights drifting up, "the better future" optimism */
  .motes { position: absolute; inset: 0; z-index: 2; }
  .mote {
    position: absolute; border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, var(--gold) 45%, transparent 72%);
    box-shadow: 0 0 8px rgba(255, 210, 122, .7);
    will-change: transform, opacity; opacity: 0;
    animation: mote-rise linear infinite;
  }
  html[data-theme="light"] .mote { background: radial-gradient(circle, #fff 0%, var(--peach-deep) 45%, transparent 72%); }
  @keyframes mote-rise {
    0%   { transform: translateY(0) translateX(0); opacity: 0; }
    12%  { opacity: 1; }
    88%  { opacity: .85; }
    100% { transform: translateY(-118vh) translateX(var(--drift, 12px)); opacity: 0; }
  }

  /* ═══════════ floating glass surfaces ═══════════ */
  .surfaces { position: absolute; inset: 0; z-index: 2; pointer-events: none; }

  .surface-slot { position: absolute; opacity: 0; animation: surf-in 950ms var(--ease-out) forwards; }
  .slot-blak  { top: 13%;    left: 2.5%;  width: min(300px, 25vw); animation-delay: 1350ms; }
  .slot-minit { top: 33%;    right: 3%;   width: min(266px, 23vw); animation-delay: 1550ms; }
  .slot-nexus { bottom: 14%; left: 6%;    width: min(280px, 23vw); animation-delay: 1750ms; }
  @keyframes surf-in { from { opacity: 0; transform: translateY(32px) scale(.95); } to { opacity: 1; transform: none; } }

  .surface-px { will-change: transform; }

  .surface {
    position: relative;
    padding: 1rem 1.1rem 1.05rem;
    border-radius: var(--r-lg);
    background: var(--glass);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-soft), inset 0 1px 0 rgba(255, 255, 255, .45);
    will-change: transform;
  }
  /* a faint pillar-tinted edge so each surface reads as its world */
  .surface::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    padding: 1px; opacity: .5;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
  }
  .s-blak  { animation: float-a 7s   var(--ease-soft) infinite; }
  .s-minit { animation: float-b 8.5s var(--ease-soft) infinite .4s; }
  .s-nexus { animation: float-c 9.5s var(--ease-soft) infinite .2s; }
  .s-blak::after  { background: linear-gradient(150deg, rgba(255,210,122,.6), transparent 55%); }
  .s-minit::after { background: linear-gradient(150deg, rgba(106,211,184,.6), transparent 55%); }
  .s-nexus::after { background: linear-gradient(150deg, rgba(91,192,255,.55), transparent 55%); }
  @keyframes float-a { 0%,100% { transform: translateY(0) rotate(-.4deg); } 50% { transform: translateY(-12px) rotate(.3deg); } }
  @keyframes float-b { 0%,100% { transform: translateY(0) rotate(.5deg); }  50% { transform: translateY(-9px)  rotate(-.4deg); } }
  @keyframes float-c { 0%,100% { transform: translateY(0) rotate(-.3deg); } 50% { transform: translateY(-14px) rotate(.4deg); } }

  /* surface — shared head */
  .surf-head { display: flex; align-items: center; gap: .5rem; }
  .surf-orb {
    width: 22px; height: 22px; border-radius: 50%; flex: none;
    box-shadow: inset 0 1px 1px rgba(255,255,255,.5);
  }
  .surf-orb.warm { background: radial-gradient(circle at 38% 36%, #FFE7C4, var(--coral) 92%); }
  .surf-orb.cool { background: radial-gradient(circle at 38% 36%, #CFF3FF, var(--aqua) 92%); }
  .surf-name { font-weight: 700; font-size: var(--fs-base); color: var(--ink); letter-spacing: -.01em; }
  .surf-live {
    margin-left: auto; display: inline-flex; align-items: center; gap: .35rem;
    font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .06em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  .surf-live i { width: 6px; height: 6px; border-radius: 50%; background: var(--mint-deep); box-shadow: 0 0 7px var(--mint-deep); animation: surf-pulse 2.2s ease-in-out infinite; }
  @keyframes surf-pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .4; transform: scale(.65); } }

  /* Blak surface */
  .surf-line { margin-top: .7rem; font-size: var(--fs-md); line-height: 1.45; color: var(--ink); }
  .surf-chip {
    display: inline-block; margin-top: .7rem;
    font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .03em; text-transform: lowercase;
    color: var(--gold); padding: .26rem .55rem; border-radius: var(--r-pill);
    border: 1px solid rgba(255, 210, 122, .32); background: rgba(255, 210, 122, .08);
  }
  html[data-theme="light"] .surf-chip { color: var(--gold-ink); }

  /* Minit surface */
  .surf-pic {
    width: 30px; height: 30px; border-radius: 50%; flex: none;
    background: linear-gradient(135deg, var(--mint) 0%, var(--mint-deep) 60%, var(--aqua) 130%);
    box-shadow: inset 0 1px 2px rgba(255,255,255,.5);
  }
  .surf-who { display: flex; flex-direction: column; line-height: 1.2; }
  .surf-who b { font-size: var(--fs-md); color: var(--ink); font-weight: 600; }
  .surf-who i { font-style: normal; font-size: var(--fs-2xs); color: var(--ink-soft); }
  .surf-rate { margin-left: auto; font-size: var(--fs-xs); color: var(--gold); font-weight: 600; white-space: nowrap; }
  html[data-theme="light"] .surf-rate { color: var(--gold-ink); }
  .surf-status {
    display: inline-flex; align-items: center; gap: .42rem; margin-top: .85rem;
    font-size: var(--fs-xs); color: var(--ink-soft);
  }
  .surf-status i { width: 7px; height: 7px; border-radius: 50%; background: var(--mint-deep); box-shadow: 0 0 8px var(--mint-deep); animation: surf-pulse 2s ease-in-out infinite; }
  .surf-go {
    display: inline-block; margin-top: .85rem; padding: .45rem .95rem;
    border-radius: var(--r-pill); font-size: var(--fs-sm); font-weight: 600; color: #06231C;
    background: linear-gradient(135deg, var(--mint) 0%, var(--mint-deep) 70%, var(--aqua) 130%);
    box-shadow: 0 8px 22px rgba(106, 211, 184, .32);
  }

  /* Nexus surface */
  .surf-room { margin-top: .7rem; font-size: var(--fs-base); font-weight: 600; color: var(--ink); }
  .surf-sub { display: block; margin-top: .25rem; font-size: var(--fs-xs); color: var(--ink-faint); }

  /* memory thread — a faint living strand between Blak and Nexus (the Learning engine) */
  .thread {
    position: absolute; left: 8.5%; top: 30%; width: 1px; height: 30%;
    background: linear-gradient(180deg, transparent, rgba(255, 210, 122, .5) 18%, rgba(106, 211, 184, .45) 78%, transparent);
    opacity: .7; will-change: transform; animation: surf-in 950ms var(--ease-out) 1550ms forwards; opacity: 0;
  }
  .thread-mote {
    position: absolute; left: 50%; top: 0; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%;
    background: radial-gradient(circle, #fff, var(--gold) 92%); box-shadow: 0 0 9px var(--gold);
    animation: thread-travel 5.5s var(--ease-soft) infinite;
  }
  .thread-mote.tm2 { animation-delay: 2.7s; background: radial-gradient(circle, #fff, var(--mint-deep) 92%); box-shadow: 0 0 9px var(--mint-deep); }
  @keyframes thread-travel { 0% { transform: translateY(0); opacity: 0; } 12% { opacity: 1; } 86% { opacity: 1; } 100% { transform: translateY(28vh); opacity: 0; } }

  /* ═══════════ headline column ═══════════ */
  .hero-inner {
    position: relative; z-index: 3;
    flex: 1;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    text-align: center;
    padding-block: clamp(6rem, 13vh, 8.5rem) clamp(1rem, 3vh, 2rem);
  }

  .eyebrow {
    display: inline-flex; align-items: center; gap: .75rem;
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow); text-transform: uppercase; letter-spacing: .28em;
    color: var(--coral);
    margin-bottom: 1.6rem;
    opacity: 0; transform: translateY(20px);
    animation: rise 1000ms var(--ease-out) 150ms forwards;
  }
  .eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--coral); box-shadow: 0 0 12px var(--coral);
    animation: pulse-glow 2.4s ease-in-out infinite;
  }
  @keyframes pulse-glow {
    0%,100% { opacity: 1; transform: scale(1); box-shadow: 0 0 12px var(--coral); }
    50%     { opacity: .55; transform: scale(.82); box-shadow: 0 0 20px var(--coral); }
  }

  .hero-logo {
    position: relative;
    margin-bottom: 1.5rem;
    opacity: 0; transform: translateY(28px) scale(.96);
    animation: rise-logo 1300ms var(--ease-out) 350ms forwards;
  }
  .hero-logo .brand-mark {
    display: block; height: clamp(46px, 5.6vw, 68px); width: auto; aspect-ratio: 737 / 338;
    background: url('/assets/blaksyd-white.webp') center / contain no-repeat;
    filter: drop-shadow(0 8px 44px rgba(255, 182, 138, 0.45));
    animation: breathe 5s ease-in-out infinite;
  }
  html[data-theme="light"] .hero-logo .brand-mark {
    aspect-ratio: 758 / 329;
    background-image: url('/assets/blaksyd-black.webp');
    filter: drop-shadow(0 8px 40px rgba(255, 184, 122, 0.32));
  }
  html[data-theme="light"] .eyebrow { color: var(--coral-ink); }
  .hero-logo::before, .hero-logo::after {
    content: ''; position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none; z-index: -1;
  }
  .hero-logo::before { width: 260px; height: 260px; background: radial-gradient(circle, rgba(255,210,122,.24), transparent 70%); filter: blur(22px); animation: glow-pulse 4s ease-in-out infinite; }
  .hero-logo::after  { width: 170px; height: 170px; background: radial-gradient(circle, rgba(201,184,255,.20), transparent 70%); filter: blur(16px); animation: glow-pulse 4s ease-in-out infinite 2s; }
  @keyframes breathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.015); } }
  @keyframes glow-pulse { 0%,100% { opacity: .5; transform: translate(-50%,-50%) scale(1); } 50% { opacity: 1; transform: translate(-50%,-50%) scale(1.18); } }

  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-h1);
    line-height: .94;
    letter-spacing: -.04em;
    color: var(--ink);
  }
  .title .line { display: block; opacity: 0; transform: translateY(36px); animation: rise 1100ms var(--ease-out) 600ms forwards; }
  .title .line:nth-child(2) { animation-delay: 780ms; }
  .title .line-2 { white-space: nowrap; }
  /* layout-neutral wrapper: keeps the visible headline aria-hidden without changing
     how the two lines lay out (still behave as direct children of .title). */
  .title-vis { display: contents; }

  .rotator {
    display: inline-grid; grid-template-columns: minmax(0, 1fr);
    align-items: baseline; justify-items: center;
    vertical-align: baseline; transition: width 340ms var(--ease-out);
  }
  .rotator-word {
    grid-area: 1 / 1; width: max-content; justify-self: center;
    padding: .3em .18em .5em; margin: -.3em 0 -.5em;
    font-family: var(--font-serif); font-weight: 400; font-style: italic;
    font-size: 1.06em; letter-spacing: -.03em;
    background: var(--accent-grad); background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    /* clean vertical cross-fade — NO blur (a blurred swap turned the key word into
       an unreadable smear). The word stays crisp; only opacity + a small rise move. */
    opacity: 0; transform: translateY(.34em);
    transition: opacity 300ms var(--ease-out), transform 340ms var(--ease-out);
    will-change: opacity, transform;
  }
  .rotator-word.is-active {
    opacity: 1; transform: translateY(0);
  }
  .rotator-word.is-leaving {
    opacity: 0; transform: translateY(-.34em);
  }
  @keyframes rotator-shimmer { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

  .sub {
    margin: 1.7rem auto 0;
    max-width: 56ch;
    font-size: var(--t-lead);
    color: var(--ink-soft);
    line-height: 1.6;
    opacity: 0; animation: rise 1000ms var(--ease-out) 700ms forwards;
  }

  .ctas {
    display: flex; flex-wrap: wrap; justify-content: center; gap: .9rem;
    margin-top: 2.4rem;
    opacity: 0; animation: rise 1000ms var(--ease-out) 850ms forwards;
  }
  /* honest reality anchor — small + faint, fades in last (it's pre-launch context, not a focal element) */
  .hero-microcopy {
    margin-top: 1.1rem; font-size: var(--fs-sm); color: var(--ink-soft);
    opacity: 0; animation: rise 1000ms var(--ease-out) 1000ms forwards;
  }

  .btn {
    display: inline-flex; align-items: center; gap: .6rem;
    font-weight: 600; font-size: var(--fs-lg);
    padding: 1rem 1.6rem; border-radius: var(--r-pill);
    transition: transform 300ms var(--ease-magnet), box-shadow var(--t-base) var(--ease-out), background-position var(--t-slow) var(--ease-out), background var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  .btn svg { width: 1.1em; height: 1.1em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform var(--t-base) var(--ease-out); }

  .btn-primary {
    color: var(--cta-ink);
    background: var(--cta);
    background-size: 200% 200%; background-position: 0% 50%;
    box-shadow: var(--shadow-cta);
  }
  .btn-primary:hover { background-position: 100% 50%; transform: translateY(-2px); box-shadow: 0 22px 60px rgba(30,99,216,.5); }
  .btn-primary:hover svg { transform: translateX(5px); }

  .btn-ghost { color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line); }
  .btn-ghost svg { stroke-width: 1.7; }
  .btn-ghost:hover { background: var(--surface-strong); border-color: var(--ink-faint); transform: translateY(-2px); }
  .btn-ghost:hover svg { transform: translateY(3px); }

  /* ═══════════ trust bar ═══════════ */
  .trust-bar {
    position: relative; z-index: 3;
    list-style: none; margin: 0 auto;
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: clamp(.8rem, 2.6vw, 2rem);
    padding: .5rem clamp(1.25rem, 5vw, 4rem) clamp(1.4rem, 3.6vh, 2.4rem);
    opacity: 0; animation: rise 1000ms var(--ease-out) 1100ms forwards;
  }
  .trust-item { display: inline-flex; align-items: center; gap: .6rem; }
  .trust-item svg { width: 19px; height: 19px; flex: none; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .trust-txt { display: flex; flex-direction: column; line-height: 1.18; text-align: left; }
  .trust-txt b { font-size: var(--fs-md); font-weight: 600; color: var(--ink); letter-spacing: -.01em; }
  .trust-txt i { font-style: normal; font-size: var(--fs-2xs); color: var(--ink-faint); }
  .ti-1 svg { stroke: var(--gold); }
  .ti-2 svg { stroke: var(--coral); }
  .ti-3 svg { stroke: var(--mint-deep); }
  .ti-4 svg { stroke: var(--aqua); }
  html[data-theme="light"] .ti-1 svg { stroke: var(--gold-ink); }
  html[data-theme="light"] .ti-2 svg { stroke: var(--coral-ink); }
  html[data-theme="light"] .ti-3 svg { stroke: var(--mint-ink); }
  html[data-theme="light"] .ti-4 svg { stroke: var(--aqua-ink); }

  @keyframes rise { to { opacity: 1; transform: translateY(0); } }
  @keyframes rise-logo { to { opacity: 1; transform: translateY(0) scale(1); } }

  /* ═══════════ responsive ═══════════ */
  /* tighten the orbiting surfaces before they crowd the headline */
  @media (max-width: 1080px) {
    .slot-nexus, .thread { display: none; }
    .slot-blak  { width: min(264px, 30vw); top: 11%; left: 1.5%; }
    .slot-minit { width: min(240px, 28vw); top: 30%; right: 1.5%; }
    .surf-line { font-size: var(--fs-sm); }
  }
  /* below tablet: drop the world cards, keep a clean headline + trust */
  @media (max-width: 760px) {
    .surfaces { display: none; }
    .trust-txt i { display: none; }
    .trust-bar { gap: .7rem 1.3rem; }
  }
  @media (max-width: 600px) {
    .sub { padding-inline: .5rem; }
    .btn { width: 100%; justify-content: center; }
    .ctas { width: 100%; max-width: 360px; }
    .title .line-2 { white-space: normal; }
    .trust-item { flex: 0 0 calc(50% - .9rem); justify-content: center; }
  }

  /* pause ambient hero motion while the hero is scrolled out of view (GPU saver) */
  .hero.is-paused .orb,
  .hero.is-paused .mote,
  .hero.is-paused .surface,
  .hero.is-paused .thread-mote { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .orb, .mote, .surface, .thread-mote { animation: none !important; }
    /* surfaces must be present immediately — never gated behind a delayed entrance */
    .surface-slot, .thread { animation: none !important; opacity: 1 !important; transform: none !important; }
    .rotator { transition: none; }
    .rotator-word { transition: none; }
    .rotator-word.is-active { animation: none; }
  }
</style>

<script is:inline>
  /* Hero word-cycler — "Built by → around → for you." Each word cross-fades in
     (opacity + a small rise, always crisp — no blur) as the previous fades out;
     on desktop the inline-grid slot eases to the new word's width so "you." glides
     smoothly, while mobile pins a fixed slot (widest word) so wrapping never jumps.
     offsetWidth ignores transforms, so measurements stay correct; waits on fonts;
     respects reduced-motion (freezes on "around"). */
  (function () {
    var rot = document.getElementById('hero-rotator');
    if (!rot) return;
    var words = [].slice.call(rot.querySelectorAll('.rotator-word'));
    if (words.length < 2) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var widths = [], maxW = 0, mobile = false, i = 0;

    function measure() {
      widths = words.map(function (w) { return w.offsetWidth; });
      maxW = Math.max.apply(null, widths);
      mobile = window.matchMedia('(max-width: 600px)').matches;
    }
    function applyWidth() { rot.style.width = (mobile ? maxW : widths[i]) + 'px'; }

    function start() {
      measure();
      words.forEach(function (w) { w.classList.remove('is-active', 'is-leaving'); });

      if (reduce) {
        i = 1;                                           // freeze on "around"
        words[1].classList.add('is-active');
        applyWidth();
      } else {
        i = 0;
        words[0].classList.add('is-active');
        applyWidth();
        var steps = 0;
        var iv = setInterval(function () {
          var cur = words[i];
          var nextI = (i + 1) % words.length;
          cur.classList.remove('is-active');
          cur.classList.add('is-leaving');
          words[nextI].classList.add('is-active');
          i = nextI;
          applyWidth();
          (function (leaving) {
            setTimeout(function () { leaving.classList.remove('is-leaving'); }, 480);
          })(cur);
          // After one full pass, rest on "around" — the canonical "Built around you."
          // (No longer loops forever; the headline settles instead of perpetually moving.)
          if (++steps >= 4 && i === 1) clearInterval(iv);
        }, 2400);
      }

      // the headline is fluid (vw-sized) — re-measure the slot when the window resizes
      var rt;
      window.addEventListener('resize', function () {
        clearTimeout(rt);
        rt = setTimeout(function () { measure(); applyWidth(); }, 150);
      }, { passive: true });
    }

    if (document.fonts && document.fonts.ready) { document.fonts.ready.then(start); }
    else { setTimeout(start, 300); }
  })();
</script>

<script is:inline>
  /* World layer — spawns rising motes and parallaxes the floating surfaces (and the
     backdrop) to pointer + scroll. Transform-only, rAF-throttled, wide + motion only;
     untouched on mobile/touch and fully skipped under reduced-motion. */
  (function () {
    var hero = document.querySelector('.hero');
    if (!hero) return;
    // Pause the continuous ambient animations (orbs, motes, floating surfaces) once
    // the hero leaves the viewport — they're invisible then, so this just saves GPU.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) {
        hero.classList.toggle('is-paused', !es[0].isIntersecting);
      }).observe(hero);
    }
    var reduce = window.__blkLite || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    var wide = window.matchMedia('(min-width: 760px)').matches;

    // rising motes
    var box = document.getElementById('hero-motes');
    if (box && !reduce && wide) {
      for (var k = 0; k < 5; k++) {
        var m = document.createElement('span');
        m.className = 'mote';
        var dur = 16 + Math.random() * 14;
        var size = 2 + Math.random() * 3;
        m.style.left = (Math.random() * 100) + '%';
        m.style.bottom = (-4 - Math.random() * 12) + '%';
        m.style.width = m.style.height = size.toFixed(1) + 'px';
        m.style.setProperty('--drift', (Math.random() * 44 - 22).toFixed(0) + 'px');
        m.style.animationDuration = dur.toFixed(1) + 's';
        m.style.animationDelay = (-Math.random() * dur).toFixed(1) + 's';
        box.appendChild(m);
      }
    }

    if (reduce || !wide) return;

    // parallax
    var cards = [].slice.call(hero.querySelectorAll('.surface-px'));
    var bg = [].slice.call(hero.querySelectorAll('[data-par]'));
    var fine = window.matchMedia('(pointer: fine)').matches;
    var px = 0, py = 0, sy = 0, raf = 0;

    function apply() {
      for (var i = 0; i < cards.length; i++) {
        var d = parseFloat(cards[i].getAttribute('data-depth')) || 1;
        cards[i].style.transform = 'translate3d(' + (px * d).toFixed(1) + 'px,' + ((py * d) + (sy * d)).toFixed(1) + 'px,0)';
      }
      for (var j = 0; j < bg.length; j++) {
        var b = parseFloat(bg[j].getAttribute('data-par')) || 0;
        bg[j].style.transform = 'translate3d(' + (px * b * 0.4).toFixed(1) + 'px,' + ((py * b * 0.4) + (sy * b * 0.6)).toFixed(1) + 'px,0)';
      }
      raf = 0;
    }
    function schedule() { if (!raf) raf = requestAnimationFrame(apply); }

    if (fine) {
      hero.addEventListener('pointermove', function (e) {
        var r = hero.getBoundingClientRect();
        px = ((e.clientX - r.left) / r.width - 0.5) * -16;
        py = ((e.clientY - r.top) / r.height - 0.5) * -12;
        schedule();
      });
      hero.addEventListener('pointerleave', function () { px = 0; py = 0; schedule(); });
    }
    window.addEventListener('scroll', function () { sy = window.scrollY * -0.05; schedule(); }, { passive: true });
  })();
</script>
