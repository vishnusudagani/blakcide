---
import AppLayout from '../../layouts/AppLayout.astro';
// Account — the user's own space: details (name + WhatsApp), a tile into "what Blak
// knows", an apps teaser (future integrations), a Persona teaser, theme, and Log out.
// Opened from the profile avatar. Details persist to the auth user's metadata.
---
<AppLayout title="Account">
  <div class="ap-page ac">
    <header class="ac-top">
      <div class="ac-ava" id="ac-ava" aria-hidden="true">Y</div>
      <div class="ac-id">
        <h1 class="ac-hello" id="ac-hello">Your account</h1>
        <p class="ac-email" id="ac-email"></p>
      </div>
    </header>

    <section class="ac-card">
      <h2 class="ac-h">Your details</h2>
      <label class="ac-field"><span>Name</span><input id="ac-name" type="text" autocomplete="name" placeholder="What should we call you?" /></label>
      <label class="ac-field"><span>WhatsApp <i>so we can reach you when it matters</i></span><input id="ac-wa" type="tel" inputmode="tel" autocomplete="tel" placeholder="+91 98765 43210" /></label>
      <div class="ac-save-row"><button type="button" class="ac-save" id="ac-save">Save</button><span class="ac-saved" id="ac-saved"></span></div>
    </section>

    <a class="ac-tile" href="/beta/profile/">
      <span class="ac-tile-ic ac-coral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l1.7 5 5 1.7-5 1.7L12 17.4l-1.7-5L5.3 10.7l5-1.7z"/><path d="M18.8 3.6l.5 1.6 1.6.5-1.6.5-.5 1.6-.5-1.6-1.6-.5 1.6-.5z"/></svg></span>
      <span class="ac-tile-tx"><b>What Blak knows about you</b><i>Everything Blak has learned — see, edit, or delete any of it.</i></span>
      <span class="ac-tile-go">→</span>
    </a>

    <section class="ac-card ac-int-card">
      <div class="ac-head"><h2 class="ac-h">Your apps</h2></div>
      <p class="ac-sub">Connect the apps you live in. Blak learns what you love and — starting with cabs — gets things done for you.</p>
      <div id="ac-integrations" class="int-root"><div class="int-loading">Loading your apps…</div></div>
    </section>

    <div class="ac-tile ac-tile-soon" role="note">
      <span class="ac-tile-ic ac-lav"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="5.5"/><circle cx="12" cy="10" r="2.5"/><path d="M7.9 17.3a4.5 4.5 0 0 1 8.2 0"/></svg></span>
      <span class="ac-tile-tx"><b>Persona <span class="ac-soon">soon</span></b><i>Your evolving digital self — train it, and one day share it.</i></span>
    </div>

    <section class="ac-card">
      <div class="ac-row"><span>Appearance</span><button type="button" class="ac-pref" id="ac-theme">Theme</button></div>
    </section>

    <button type="button" class="ac-out" id="ac-out">Log out</button>
    <p class="ac-ver">Blaksyd beta</p>
  </div>

  <style is:global>
    .ac { max-width: 540px; margin: 0 auto; padding-bottom: 2rem; }
    .ac-top { display: flex; align-items: center; gap: .9rem; margin: .4rem 0 1.4rem; }
    .ac-ava { width: 58px; height: 58px; flex: none; border-radius: 50%; display: grid; place-items: center; font-size: var(--fs-2xl); font-weight: 650; color: #fff; background: var(--cta-grad); box-shadow: 0 8px 26px -6px rgba(255,107,157,.5); }
    .ac-hello { font-size: clamp(1.4rem, 1.1rem + 1.8vw, 1.9rem); font-weight: 600; letter-spacing: -.02em; color: var(--ink); }
    .ac-email { font-size: var(--fs-sm); color: var(--ink-faint); margin-top: .15rem; }
    .ac-card { background: var(--glass-strong); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1.1rem 1.2rem; margin-bottom: .8rem; }
    .ac-head { display: flex; align-items: center; gap: .6rem; }
    .ac-h { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
    .ac-sub { font-size: var(--fs-sm); color: var(--ink-soft); margin-top: .5rem; line-height: 1.5; }
    .ac-field { display: block; margin-top: .9rem; }
    .ac-field span { display: block; font-size: var(--fs-2xs); font-family: var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: .4rem; }
    .ac-field span i { font-style: normal; text-transform: none; letter-spacing: 0; font-family: var(--font-body); color: var(--ink-ghost); }
    .ac-field input { width: 100%; box-sizing: border-box; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-md); padding: .7rem .85rem; color: var(--ink); font: inherit; font-size: 16px; outline: none; transition: border-color var(--t-fast) var(--ease-out); }
    .ac-field input:focus { border-color: rgba(106,211,184,.55); }
    .ac-save-row { display: flex; align-items: center; gap: .8rem; margin-top: 1rem; }
    .ac-save { min-height: 44px; padding: .6rem 1.6rem; border: 0; border-radius: var(--r-pill); color: #06231C; font: inherit; font-weight: 650; cursor: pointer; background: linear-gradient(135deg, var(--mint), var(--mint-deep)); transition: transform var(--t-fast) var(--ease-out); }
    .ac-save:hover { transform: translateY(-1px); }
    .ac-save[disabled] { opacity: .55; cursor: default; transform: none; }
    .ac-saved { font-size: var(--fs-sm); color: var(--mint-deep); }
    html[data-theme="light"] .ac-saved { color: var(--mint-ink); }
    .ac-tile { display: flex; align-items: center; gap: .9rem; width: 100%; text-align: left; padding: 1rem 1.1rem; margin-bottom: .8rem; background: var(--glass-strong); border: 1px solid var(--line); border-radius: var(--r-lg); text-decoration: none; cursor: pointer; transition: border-color var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out); }
    a.ac-tile:hover { border-color: rgba(255,107,157,.4); transform: translateY(-1px); }
    .ac-tile-soon { cursor: default; opacity: .82; }
    .ac-tile-ic { width: 44px; height: 44px; flex: none; border-radius: 14px; display: grid; place-items: center; }
    .ac-tile-ic svg { width: 23px; height: 23px; }
    .ac-coral { color: var(--coral); background: rgba(255,107,157,.12); }
    html[data-theme="light"] .ac-coral { color: var(--coral-ink); }
    .ac-lav { color: var(--lavender); background: rgba(201,184,255,.14); }
    html[data-theme="light"] .ac-lav { color: var(--lavender-ink); }
    .ac-tile-tx { flex: 1; min-width: 0; }
    .ac-tile-tx b { display: block; font-size: var(--fs-md); color: var(--ink); font-weight: 600; }
    .ac-tile-tx i { font-style: normal; font-size: var(--fs-xs); color: var(--ink-soft); display: block; margin-top: .1rem; line-height: 1.45; }
    .ac-tile-go { color: var(--ink-faint); font-size: 1.1rem; flex: none; }
    .ac-soon { font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .08em; text-transform: uppercase; color: var(--gold); background: rgba(255,210,122,.12); border: 1px solid rgba(255,210,122,.3); border-radius: var(--r-pill); padding: .1rem .5rem; }
    html[data-theme="light"] .ac-soon { color: var(--gold-ink); border-color: rgba(138,100,16,.3); }
    .ac-apps { display: flex; gap: .6rem; margin-top: .9rem; }
    .ac-apps i { width: 42px; height: 42px; border-radius: 13px; background: var(--surface-strong); border: 1px solid var(--line); }
    .ac-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .ac-row > span { font-size: var(--fs-md); color: var(--ink); }
    .ac-pref { min-height: 44px; padding: .45rem 1.1rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-sm); cursor: pointer; }
    .ac-pref:hover { border-color: rgba(106,211,184,.5); }
    .ac-out { display: block; width: 100%; margin-top: 1.4rem; min-height: 48px; border-radius: var(--r-pill); background: var(--surface); border: 1px solid rgba(255,107,157,.3); color: var(--coral); font: inherit; font-size: var(--fs-md); font-weight: 600; cursor: pointer; transition: border-color var(--t-fast) var(--ease-out); }
    html[data-theme="light"] .ac-out { color: var(--coral-ink); }
    .ac-out:hover { border-color: rgba(255,107,157,.65); }
    .ac-ver { text-align: center; font-size: var(--fs-xs); color: var(--ink-ghost); margin-top: 1rem; }

    /* ---- App integrations — the "Your apps" grid ---- */
    .ac-int-card { padding-bottom: 1.3rem; }
    .int-root { display: flex; flex-direction: column; gap: 1.1rem; margin-top: 1rem; }
    .int-loading { color: var(--ink-faint); font-size: var(--fs-sm); padding: .4rem 0; }

    /* master: Gmail connect + manual taste */
    .int-master { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: .95rem 1rem; }
    .int-m-row { display: flex; align-items: center; gap: .7rem; }
    .int-m-ic { width: 38px; height: 38px; flex: none; border-radius: 11px; display: grid; place-items: center; color: var(--ink-faint); background: var(--surface-strong); border: 1px solid var(--line); }
    .int-m-ic svg { width: 20px; height: 20px; }
    .int-m-ic.on { color: var(--mint-deep); border-color: rgba(106,211,184,.35); background: rgba(106,211,184,.10); }
    html[data-theme="light"] .int-m-ic.on { color: var(--mint-ink); }
    .int-m-tx { flex: 1; min-width: 0; }
    .int-m-tx b { display: block; font-size: var(--fs-md); color: var(--ink); font-weight: 600; }
    .int-m-tx i { font-style: normal; display: block; font-size: var(--fs-xs); color: var(--ink-soft); margin-top: .1rem; line-height: 1.4; }
    .int-connect { flex: none; min-height: 44px; padding: .5rem 1.2rem; border-radius: var(--r-pill); border: 0; color: #06231C; font: inherit; font-size: var(--fs-sm); font-weight: 650; cursor: pointer; background: linear-gradient(135deg, var(--mint), var(--mint-deep)); }
    .int-connect[disabled] { opacity: .5; cursor: default; }
    .int-ghost { flex: none; min-height: 44px; padding: .5rem 1.1rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink-soft); font: inherit; font-size: var(--fs-sm); cursor: pointer; }
    .int-ghost:hover { border-color: rgba(255,107,157,.4); color: var(--coral); }
    html[data-theme="light"] .int-ghost:hover { color: var(--coral-ink); }
    .int-note { font-size: var(--fs-sm); color: var(--mint-deep); margin-top: .65rem; line-height: 1.45; }
    html[data-theme="light"] .int-note { color: var(--mint-ink); }
    .int-divider { height: 1px; background: var(--line); margin: .9rem 0; }
    .int-pref-label { display: block; font-size: var(--fs-2xs); font-family: var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: .4rem; }
    .int-pref, .int-book { display: flex; gap: .5rem; }
    .int-input { flex: 1; min-width: 0; background: var(--bg); border: 1px solid var(--line-strong); border-radius: var(--r-md); padding: .6rem .8rem; color: var(--ink); font: inherit; font-size: 16px; outline: none; }
    .int-input:focus { border-color: rgba(106,211,184,.55); }
    .int-pref-go, .int-book-go { flex: none; min-height: 44px; padding: .55rem 1.1rem; border-radius: var(--r-pill); background: var(--surface-strong); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-sm); font-weight: 600; cursor: pointer; }
    .int-pref-go:hover, .int-book-go:hover { border-color: rgba(106,211,184,.5); }
    .int-fwd { font-size: var(--fs-xs); color: var(--ink-faint); margin-top: .7rem; line-height: 1.45; }
    .int-fwd b { color: var(--ink-soft); font-weight: 600; }

    /* category block */
    .int-cat-head { display: flex; align-items: center; gap: .55rem; margin-bottom: .6rem; }
    .int-cat-ic { width: 30px; height: 30px; flex: none; border-radius: 9px; display: grid; place-items: center; background: var(--surface-strong); border: 1px solid var(--line); }
    .int-cat-ic svg { width: 18px; height: 18px; }
    .int-cat-ic.coral { color: var(--coral); }
    html[data-theme="light"] .int-cat-ic.coral { color: var(--coral-ink); }
    .int-cat-ic.gold { color: var(--gold); }
    html[data-theme="light"] .int-cat-ic.gold { color: var(--gold-ink); }
    .int-cat-ic.aqua { color: var(--aqua); }
    html[data-theme="light"] .int-cat-ic.aqua { color: var(--aqua-ink); }
    .int-cat-title { font-size: var(--fs-md); font-weight: 600; color: var(--ink); margin: 0; }

    /* Blak action banner */
    .int-action { border-radius: var(--r-md); padding: .8rem .9rem; margin-bottom: .7rem; border: 1px solid var(--line); background: var(--surface); }
    .int-action.is-live { border-color: rgba(91,192,255,.32); background: rgba(91,192,255,.06); }
    .int-action-main { display: flex; align-items: center; gap: .5rem; }
    .int-action-label { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
    .int-action-pill { margin-left: auto; font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .08em; text-transform: uppercase; padding: .15rem .55rem; border-radius: var(--r-pill); }
    .is-soon .int-action-pill { color: var(--gold); background: rgba(255,210,122,.12); border: 1px solid rgba(255,210,122,.3); }
    html[data-theme="light"] .is-soon .int-action-pill { color: var(--gold-ink); border-color: rgba(138,100,16,.3); }
    .is-live .int-action-pill { color: var(--aqua); background: rgba(91,192,255,.14); border: 1px solid rgba(91,192,255,.35); }
    html[data-theme="light"] .is-live .int-action-pill { color: var(--aqua-ink); }
    .int-action-note { font-size: var(--fs-xs); color: var(--ink-soft); margin: .35rem 0 0; line-height: 1.45; }
    .int-cta { margin-top: .7rem; min-height: 44px; padding: .55rem 1.2rem; border-radius: var(--r-pill); border: 0; color: var(--cta-ink); background: var(--cta); font: inherit; font-size: var(--fs-sm); font-weight: 650; cursor: pointer; box-shadow: var(--shadow-cta); transition: transform var(--t-fast) var(--ease-out); }
    .int-cta:hover { transform: translateY(-1px); }
    .int-book { margin-top: .7rem; }

    /* app grid + cards */
    .int-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(142px, 1fr)); gap: .55rem; }
    .int-app { background: var(--glass); border: 1px solid var(--line); border-radius: var(--r-md); padding: .7rem .75rem .65rem; display: flex; flex-direction: column; gap: .5rem; }
    .int-app-top { display: flex; align-items: center; gap: .5rem; min-width: 0; }
    .int-logo { width: 32px; height: 32px; flex: none; border-radius: 9px; display: grid; place-items: center; font-weight: 700; font-size: var(--fs-md); }
    .int-app-name { font-size: var(--fs-sm); color: var(--ink); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .int-badges { display: flex; flex-wrap: wrap; gap: .3rem; min-height: 18px; }
    .int-badge { font-family: var(--font-mono); font-size: 9px; letter-spacing: .03em; text-transform: uppercase; padding: 2px 6px; border-radius: var(--r-pill); border: 1px solid var(--line); }
    .int-badge.learn { color: var(--mint-deep); border-color: rgba(106,211,184,.3); }
    html[data-theme="light"] .int-badge.learn { color: var(--mint-ink); }
    .int-badge.muted { color: var(--ink-faint); }
    .int-app-actions { margin-top: auto; }
    .int-open { width: 100%; min-height: 38px; padding: .35rem .6rem; border-radius: var(--r-sm); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink-soft); font: inherit; font-size: var(--fs-xs); cursor: pointer; }
    .int-open:hover { color: var(--ink); border-color: var(--ink-faint); }

    .int-manage { display: inline-block; font-size: var(--fs-sm); color: var(--coral); margin-top: .2rem; }
    .int-manage:hover { text-decoration: underline; }
    html[data-theme="light"] .int-manage { color: var(--coral-ink); }

    /* cab booking flow (preview until ONDC sandbox is wired) */
    .int-book { align-items: center; }
    .int-pv { font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .08em; text-transform: uppercase; color: var(--aqua); border: 1px solid rgba(91,192,255,.35); border-radius: var(--r-pill); padding: .1rem .45rem; margin-left: .4rem }
    html[data-theme="light"] .int-pv { color: var(--aqua-ink) }
    .int-book-head { font-size: var(--fs-sm); color: var(--ink); font-weight: 600; margin: .2rem 0 .5rem; display: flex; align-items: center }
    .int-book-status { font-size: var(--fs-sm); color: var(--ink-soft); padding: .55rem 0 }
    .int-rides { display: flex; flex-direction: column; gap: .45rem; margin-top: .7rem }
    .int-ride { display: grid; grid-template-columns: 1fr auto; grid-template-areas: "mode fare" "meta fare"; gap: 0 .6rem; text-align: left; padding: .55rem .8rem; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line-strong); cursor: pointer; transition: border-color var(--t-fast) var(--ease-out) }
    .int-ride:hover { border-color: rgba(91,192,255,.5) }
    .int-ride-mode { grid-area: mode; font-size: var(--fs-sm); color: var(--ink); font-weight: 600 }
    .int-ride-meta { grid-area: meta; font-size: var(--fs-xs); color: var(--ink-faint) }
    .int-ride-fare { grid-area: fare; align-self: center; font-size: var(--fs-md); color: var(--ink); font-weight: 650 }
    .int-confirm { margin-top: .7rem }
    .int-confirm-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .6rem .8rem; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink) }
    .int-confirm-note { font-size: var(--fs-xs); color: var(--ink-soft); margin: .5rem 0 .7rem; line-height: 1.45 }
    .int-confirm-go { margin-top: 0 }
    .int-link { background: none; border: 0; color: var(--ink-faint); font: inherit; font-size: var(--fs-xs); cursor: pointer; padding: .5rem .2rem; text-decoration: underline; text-underline-offset: 2px }
    .int-link:hover { color: var(--ink-soft) }
    .int-booked { margin-top: .7rem }
  </style>

  <script>
    import { supabase } from '../../lib/supabaseClient';
    import { mountIntegrations } from '../../lib/integrations.mjs';
    const $ = (id) => document.getElementById(id);
    if (!supabase) {
      const h = $('ac-hello'); if (h) h.textContent = 'Sign-in isn’t configured here.';
    } else {
      (async () => {
        const { data } = await supabase.auth.getUser();
        const u = data?.user;
        if (!u) { location.replace('/?auth=1'); return; }
        const md = u.user_metadata || {};
        const name = (md.full_name || md.name || '').trim();
        const initial = (name || u.email || 'Y')[0].toUpperCase();
        $('ac-ava').textContent = initial;
        $('ac-hello').textContent = name ? `Hi ${name.split(' ')[0]}` : 'Your account';
        $('ac-email').textContent = u.email || '';
        $('ac-name').value = name;
        $('ac-wa').value = md.whatsapp || '';

        // App integrations — the category-grouped "Your apps" grid.
        const intEl = $('ac-integrations');
        if (intEl) {
          mountIntegrations({ supabase, user: u, container: intEl }).catch((e) => {
            intEl.innerHTML = '<p class="int-loading">Couldn’t load your apps.</p>';
            console.error(e);
          });
        }

        const save = $('ac-save'), saved = $('ac-saved');
        save.addEventListener('click', async () => {
          save.setAttribute('disabled', ''); saved.textContent = 'Saving…';
          const full_name = $('ac-name').value.trim(), whatsapp = $('ac-wa').value.trim();
          const { error } = await supabase.auth.updateUser({ data: { full_name, whatsapp } });
          save.removeAttribute('disabled');
          saved.textContent = error ? 'Couldn’t save — try again' : 'Saved ✓';
          if (!error) { $('ac-ava').textContent = (full_name || u.email || 'Y')[0].toUpperCase(); $('ac-hello').textContent = full_name ? `Hi ${full_name.split(' ')[0]}` : 'Your account'; setTimeout(() => { saved.textContent = ''; }, 2500); }
        });

        const theme = $('ac-theme');
        const paintTheme = () => { theme.textContent = (document.documentElement.getAttribute('data-theme') === 'light') ? 'Light' : 'Dark'; };
        paintTheme();
        theme.addEventListener('click', () => {
          const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          const m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', next === 'light' ? '#FAF4EC' : '#0B0D1F');
          paintTheme();
        });

        $('ac-out').addEventListener('click', async () => {
          $('ac-out').setAttribute('disabled', ''); $('ac-out').textContent = 'Logging out…';
          try { await supabase.auth.signOut(); } catch (e) {}
          location.href = '/';
        });
      })();
    }
  </script>
</AppLayout>
