---
import AppLayout from '../../layouts/AppLayout.astro';
// Minit — LIVE seeker experience. Start talking → find an available (fresh) listener
// → connect (realtime text chat on `messages`) or honest "no one free" capture.
// Anonymous by default; reconnect with a past listener; delivered/seen; typing.
---
<AppLayout active="minit" title="Minit">
  <div class="ap-page mnx" id="mnx-page">
    <div id="mnx-root" class="mnx-root" role="region" aria-live="polite">
      <div class="mnx-loading"><span class="mnx-spinner" aria-hidden="true"></span> Getting things ready…</div>
    </div>

    <p class="mnx-foot mnx-chrome"><button type="button" class="mnx-help-link crisis" id="mnx-crisis"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"/></svg>Urgent help</button></p>
    <audio id="mnx-rtc-audio" autoplay></audio>
  </div>

  <style is:global>
    .mnx-accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; background: linear-gradient(110deg, var(--mint), var(--mint-deep) 45%, var(--aqua)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    html[data-theme="light"] .mnx-accent { background: linear-gradient(110deg, var(--mint-ink), var(--aqua-ink)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .mnx.immersive .mnx-chrome { display: none; }

    .mnx-root { min-height: clamp(220px, 34vh, 360px); }
    .mnx-loading { display: flex; align-items: center; gap: .7rem; color: var(--ink-soft); font-size: var(--fs-base); padding: 1.4rem .2rem; }
    .mnx-spinner { width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--line-strong); border-top-color: var(--mint-deep); animation: mnx-spin 1s linear infinite; }
    @keyframes mnx-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .mnx-spinner { animation: none; } }
    .mnx-foot { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .55rem; margin: 1.6rem .2rem 0; font-size: var(--fs-xs); color: var(--ink-faint); }
    .mnx-foot-q { color: var(--ink-faint); }

    /* ---- Concierge entry panel (luminous) ---- */
    .mnx-stage { position: relative; max-width: 460px; margin: 0 auto; padding-top: clamp(.5rem, 3vh, 1.5rem); }
    .mnx-entry { position: relative; border-radius: 30px; padding: clamp(1.7rem, 4.5vw, 2.4rem) clamp(1.4rem, 4vw, 2rem) clamp(1.4rem, 4vw, 1.8rem); text-align: center; background: linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.02)); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); box-shadow: 0 30px 90px rgba(0,0,0,.5), 0 0 60px rgba(106,211,184,.1), inset 0 1px 0 rgba(255,255,255,.06); overflow: hidden; }
    html[data-theme="light"] .mnx-entry { background: linear-gradient(180deg, rgba(255,255,255,.9), rgba(255,255,255,.7)); box-shadow: 0 24px 70px rgba(60,40,20,.14), 0 0 50px rgba(106,211,184,.12); }
    .mnx-entry::before { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; background: linear-gradient(160deg, rgba(180,240,222,.55), rgba(91,192,255,.3) 32%, transparent 62%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
    .mnx-entry-glow { position: absolute; top: -40%; left: 50%; width: 70%; height: 70%; transform: translateX(-50%); pointer-events: none; background: radial-gradient(circle, rgba(106,211,184,.22), transparent 60%); filter: blur(10px); }
    .mnx-orb-wrap { position: relative; width: 76px; height: 76px; margin: 0 auto 1.2rem; display: grid; place-items: center; }
    .mnx-orb { width: 64px; height: 64px; border-radius: 50%; background: radial-gradient(circle at 34% 28%, #ffffff 0%, var(--mint) 34%, var(--mint-deep) 66%, var(--aqua) 120%); box-shadow: 0 0 30px rgba(106,211,184,.55), inset 0 -4px 10px rgba(6,35,28,.3); animation: mnx-breathe 4.2s var(--ease-soft) infinite; }
    .mnx-echo { position: absolute; inset: 0; border-radius: 50%; border: 1.5px solid rgba(106,211,184,.4); animation: mnx-echo 2.8s ease-out infinite; }
    .mnx-echo:nth-child(2) { animation-delay: 1.4s; }
    .mnx-kick2 { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .18em; text-transform: uppercase; color: var(--mint-deep); margin-bottom: .7rem; }
    html[data-theme="light"] .mnx-kick2 { color: var(--mint-ink); }
    .mnx-greet { font-size: clamp(1.55rem, 1.1rem + 2.2vw, 2.05rem); font-weight: 600; letter-spacing: -.02em; line-height: 1.12; color: var(--ink); }
    .mnx-greet em { font-family: var(--font-serif); font-style: italic; font-weight: 400; background: linear-gradient(110deg, var(--mint), var(--mint-deep) 45%, var(--aqua)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    html[data-theme="light"] .mnx-greet em { background: linear-gradient(110deg, var(--mint-ink), var(--aqua-ink)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .mnx-greet-sub { font-size: var(--fs-md); color: var(--ink-soft); margin: .7rem auto 0; max-width: 32ch; line-height: 1.55; }
    .mnx-live { display: inline-flex; align-items: center; gap: .5rem; margin: 1.2rem 0 1.3rem; padding: .4rem .9rem; font-size: var(--fs-sm); color: var(--ink-soft); background: rgba(106,211,184,.08); border: 1px solid rgba(106,211,184,.2); border-radius: var(--r-pill); }
    .mnx-live-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--mint-deep); box-shadow: 0 0 8px var(--mint-deep); animation: mnx-dot-pulse 2.2s var(--ease-soft) infinite; }
    .mnx-live.off .mnx-live-dot { background: var(--ink-faint); box-shadow: none; animation: none; }
    .mnx-cta-arrow { font-weight: 400; transition: transform var(--t-fast) var(--ease-out); }
    .mnx-go:hover .mnx-cta-arrow { transform: translateX(3px); }
    .mnx-anon-min { display: inline-flex; align-items: center; gap: .45rem; margin: .9rem auto 0; padding: .4rem .2rem; background: none; border: 0; font: inherit; font-size: var(--fs-sm); color: var(--ink-faint); cursor: pointer; }
    .mnx-anon-min i { font-style: normal; color: var(--ink-faint); font-weight: 600; }
    .mnx-anon-min.on i { color: var(--mint-deep); }
    html[data-theme="light"] .mnx-anon-min.on i { color: var(--mint-ink); }
    .mnx-anon-ico { display: inline-flex; } .mnx-anon-ico svg { width: 13px; height: 13px; }
    .mnx-sw2 { width: 30px; height: 17px; border-radius: var(--r-pill); background: var(--surface-strong); border: 1px solid var(--line-strong); position: relative; margin-left: .2rem; transition: background var(--t-fast) var(--ease-out); }
    .mnx-sw2::after { content: ''; position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: var(--ink-soft); transition: transform var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out); }
    .mnx-anon-min.on .mnx-sw2 { background: linear-gradient(135deg, var(--mint), var(--mint-deep)); border-color: transparent; }
    .mnx-anon-min.on .mnx-sw2::after { transform: translateX(13px); background: #06231C; }
    .mnx-meter { margin-top: 1.4rem; padding-top: 1.3rem; border-top: 1px solid var(--line); }
    .mnx-meter-top { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: .55rem; }
    .mnx-meter-label { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); }
    .mnx-meter-val { font-size: var(--fs-sm); font-weight: 650; color: var(--ink); }
    .mnx-pips { display: flex; gap: 5px; }
    .mnx-pip { flex: 1; height: 6px; border-radius: var(--r-pill); background: var(--surface-strong); }
    .mnx-pip.on { background: linear-gradient(90deg, var(--mint), var(--mint-deep)); box-shadow: 0 0 6px rgba(106,211,184,.4); }
    .mnx-meter-foot { font-size: var(--fs-xs); color: var(--ink-faint); margin-top: .6rem; text-align: left; }
    @keyframes mnx-dot-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(106,211,184,.55); } 60% { box-shadow: 0 0 0 6px rgba(106,211,184,0); } }
    @media (prefers-reduced-motion: reduce) { .mnx-orb, .mnx-echo, .mnx-live-dot { animation: none; } .mnx-echo { opacity: .25; } }
    .mnx-go { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; width: 100%; padding: 1rem 1.1rem; border: 0; border-radius: var(--r-pill); font: inherit; font-size: var(--fs-xl); font-weight: 650; color: #06231C; cursor: pointer; background: linear-gradient(135deg, var(--mint) 0%, var(--mint-deep) 70%, var(--aqua) 130%); box-shadow: 0 14px 38px rgba(106,211,184,.42); transition: transform var(--t-fast) var(--ease-out), opacity var(--t-fast) var(--ease-out); }
    .mnx-go:hover { transform: translateY(-1px); }
    .mnx-go[disabled] { opacity: .55; cursor: default; transform: none; }
    .mnx-reconnect { display: block; width: 100%; margin-top: .7rem; padding: .7rem 1rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-sm); cursor: pointer; }
    .mnx-reconnect:hover { border-color: rgba(106,211,184,.5); }
    .mnx-help-row { display: flex; gap: .6rem; flex-wrap: wrap; margin: clamp(1rem,3vh,1.4rem) 0 1.3rem; }
    .mnx-help-link { display: inline-flex; align-items: center; gap: .45rem; min-height: 40px; padding: .5rem .95rem; font-size: var(--fs-sm); color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); text-decoration: none; transition: border-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out); }
    .mnx-help-link svg { width: 15px; height: 15px; flex: none; }
    .mnx-help-link:hover { color: var(--ink); border-color: rgba(106,211,184,.5); }
    .mnx-help-link.wa { color: #25D366; border-color: rgba(37,211,102,.4); }
    .mnx-help-link.wa:hover { color: #25D366; border-color: rgba(37,211,102,.75); }
    html[data-theme="light"] .mnx-help-link.wa { color: #128C7E; border-color: rgba(18,140,126,.4); }
    .mnx-help-link.crisis { color: var(--coral); border-color: rgba(255,107,157,.4); }
    .mnx-help-link.crisis:hover { color: var(--coral); border-color: rgba(255,107,157,.75); }
    html[data-theme="light"] .mnx-help-link.crisis { color: var(--coral-ink); border-color: rgba(199,42,90,.4); }
    .mnx-crisis-routes { display: flex; flex-direction: column; gap: .5rem; margin: 1.1rem 0; }
    .mnx-crisis-line { display: flex; flex-direction: column; padding: .6rem .85rem; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line-strong); text-decoration: none; }
    .mnx-crisis-line b { font-size: var(--fs-md); color: var(--ink); }
    .mnx-crisis-line span { font-size: var(--fs-xs); color: var(--ink-soft); }
    .mnx-crisis-note { font-size: var(--fs-sm); color: var(--ink-faint); text-align: center; line-height: 1.5; margin: .2rem 0; }
    .mnx-threads { margin-top: 1.6rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
    .mnx-threads-label { font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: .7rem; }
    .mnx-thread { display: flex; align-items: center; gap: .8rem; width: 100%; text-align: left; padding: .8rem 1rem; margin-bottom: .5rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); cursor: pointer; font: inherit; }
    .mnx-thread:hover { border-color: rgba(106,211,184,.4); }
    .mnx-thread-orb { width: 32px; height: 32px; border-radius: 50%; flex: none; background: linear-gradient(135deg, var(--mint), var(--aqua)); }
    .mnx-thread-meta { flex: 1; min-width: 0; } .mnx-thread-meta b { font-size: var(--fs-md); color: var(--ink); font-weight: 600; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; } .mnx-thread-meta i { font-style: normal; font-size: var(--fs-xs); color: var(--ink-faint); }
    .mnx-thread-go { color: var(--ink-faint); font-size: 1.1rem; }

    .mnx-ring { text-align: center; padding: 2.2rem 1.4rem; }
    .mnx-ring-avatar { position: relative; width: 96px; height: 96px; margin: 0 auto 1.4rem; display: flex; align-items: center; justify-content: center; }
    .mnx-ring-avatar .core { width: 84px; height: 84px; border-radius: 50%; background: linear-gradient(135deg, var(--mint), var(--mint-deep) 70%, var(--aqua)); box-shadow: 0 0 24px rgba(106,211,184,.5); animation: mnx-breathe 4s var(--ease-soft) infinite; }
    .mnx-ring-avatar i { position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgba(106,211,184,.4); animation: mnx-echo 2.6s ease-out infinite; }
    .mnx-ring-avatar i:nth-child(2) { animation-delay: 1.3s; }
    @keyframes mnx-breathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @keyframes mnx-echo { 0% { transform: scale(.9); opacity: .7; } 100% { transform: scale(1.5); opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .mnx-ring-avatar .core, .mnx-ring-avatar i { animation: none; } .mnx-ring-avatar i { opacity: .25; } }
    .mnx-ring h3 { font-size: var(--fs-xl); font-weight: 600; color: var(--ink); }
    .mnx-ring p { font-size: var(--fs-md); color: var(--ink-soft); margin-top: .4rem; max-width: 38ch; margin-inline: auto; }
    .mnx-ring-actions { display: flex; gap: .6rem; justify-content: center; margin-top: 1.4rem; flex-wrap: wrap; }
    .mnx-cancel { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: .6rem 1.4rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink-soft); font: inherit; font-size: var(--fs-sm); cursor: pointer; }
    .mnx-cancel:hover { color: var(--ink); }
    .mnx-ring-check { width: 84px; height: 84px; border-radius: 50%; margin: 0 auto 1.2rem; display: grid; place-items: center; font-size: 2.4rem; color: #06231C; background: linear-gradient(135deg, var(--mint), var(--mint-deep)); }
    .mnx-steps { display: flex; align-items: center; justify-content: center; gap: .5rem; margin-top: 1.5rem; }
    .mnx-step { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-faint); transition: color var(--t-base) var(--ease-out); }
    .mnx-step.on { color: var(--mint-deep); }
    html[data-theme="light"] .mnx-step.on { color: var(--mint-ink); }
    .mnx-step-line { width: 22px; height: 2px; border-radius: 2px; background: var(--line-strong); transition: background var(--t-base) var(--ease-out); }
    .mnx-step-line.on { background: var(--mint-deep); }
    .mnx-skel { display: flex; flex-direction: column; gap: .5rem; padding: .5rem 0; }
    .mnx-skel i { height: 34px; border-radius: 14px; background: linear-gradient(90deg, var(--surface) 25%, var(--surface-strong) 37%, var(--surface) 63%); background-size: 400% 100%; animation: mnx-shimmer 1.4s ease infinite; }
    .mnx-skel i:nth-child(odd) { align-self: flex-end; width: 60%; } .mnx-skel i:nth-child(even) { width: 72%; }
    @keyframes mnx-shimmer { from { background-position: 100% 0; } to { background-position: 0 0; } }
    @media (prefers-reduced-motion: reduce) { .mnx-skel i { animation: none; } }

    .mnx-schedule { text-align: center; padding: 2rem 1.4rem; }
    .mnx-empty-orb { width: 56px; height: 56px; border-radius: 50%; margin: 0 auto 1rem; background: radial-gradient(circle at 35% 30%, rgba(255,255,255,.5), var(--mint-deep)); opacity: .55; box-shadow: 0 0 24px rgba(106,211,184,.3); }
    .mnx-schedule h3 { font-size: var(--fs-xl); font-weight: 600; color: var(--ink); }
    .mnx-schedule p { font-size: var(--fs-md); color: var(--ink-soft); margin-top: .4rem; max-width: 42ch; margin-inline: auto; }
    .mnx-times { display: flex; flex-wrap: wrap; justify-content: center; gap: .55rem; margin-top: 1.3rem; }
    .mnx-time { display: inline-flex; align-items: center; min-height: 40px; padding: .6rem 1rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-sm); cursor: pointer; }
    .mnx-time:hover { border-color: rgba(106,211,184,.5); }
    .mnx-timepick { display: flex; justify-content: center; margin: 1.4rem 0 .4rem; }
    .mnx-time-input { font: inherit; font-size: var(--fs-2xl); font-weight: 600; letter-spacing: .02em; color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-md); padding: .7rem 1.1rem; text-align: center; outline: none; }
    .mnx-time-input:focus { border-color: rgba(106,211,184,.6); }

    .mnx-chat { display: flex; flex-direction: column; width: 100%; max-width: 640px; margin-inline: auto; height: clamp(360px, 66dvh, 620px); background: var(--glass-strong); border: 1px solid var(--line-strong); border-radius: var(--r-lg); box-shadow: var(--shadow-soft); overflow: hidden; position: relative; }
    .mnx-chat-head { display: flex; align-items: center; gap: .7rem; padding: .8rem 1rem; border-bottom: 1px solid var(--line); flex: none; }
    .mnx-chat-pic { width: 36px; height: 36px; border-radius: 50%; flex: none; background: linear-gradient(135deg, var(--mint), var(--aqua)); display: grid; place-items: center; color: #06231C; }
    .mnx-chat-pic svg { width: 18px; height: 18px; }
    .mnx-chat-who b { font-size: var(--fs-md); color: var(--ink); font-weight: 600; display: block; }
    .mnx-chat-who i { font-style: normal; font-size: var(--fs-2xs); color: var(--mint-deep); display: inline-flex; align-items: center; gap: .3rem; }
    html[data-theme="light"] .mnx-chat-who i { color: var(--mint-ink); }
    .mnx-chat-end { margin-left: auto; padding: .4rem .9rem; border-radius: var(--r-pill); background: rgba(255,107,157,.1); border: 1px solid rgba(255,107,157,.25); color: var(--coral); font: inherit; font-size: var(--fs-sm); font-weight: 600; cursor: pointer; white-space: nowrap; }
    html[data-theme="light"] .mnx-chat-end { color: var(--coral-ink); }
    .mnx-chat-end.confirm { background: var(--coral); color: #fff; border-color: transparent; }
    .mnx-feed { flex: 1; overflow-y: auto; padding: 1rem .9rem; display: flex; flex-direction: column; gap: .35rem; justify-content: flex-start; }
    .mnx-sys { text-align: center; font-size: var(--fs-xs); color: var(--ink-faint); padding: .4rem 0; }
    .mnx-row { display: flex; flex-direction: column; }
    .mnx-row.me { align-items: flex-end; } .mnx-row.them { align-items: flex-start; }
    .mnx-bubble { max-width: 78%; padding: .6rem .85rem; border-radius: 16px; font-size: var(--fs-md); line-height: 1.5; word-wrap: break-word; overflow-wrap: anywhere; animation: mnx-bub .18s var(--ease-out) both; }
    @keyframes mnx-bub { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
    .mnx-row.me .mnx-bubble { background: linear-gradient(135deg, var(--mint), var(--mint-deep)); color: #06231C; border-bottom-right-radius: 5px; }
    .mnx-row.me.temp .mnx-bubble { opacity: .6; }
    .mnx-row.them .mnx-bubble { background: var(--surface-strong); border: 1px solid var(--line); color: var(--ink); border-bottom-left-radius: 5px; }
    html[data-theme="light"] .mnx-row.them .mnx-bubble { background: #fff; border-color: var(--line-strong); }
    .mnx-meta { display: flex; align-items: center; margin: .14rem .2rem 0; }
    .mnx-row.me .mnx-meta { justify-content: flex-end; }
    .mnx-mtime { font-size: var(--fs-3xs); color: var(--ink-faint); font-family: var(--font-mono); }
    .mnx-status { font-size: var(--fs-3xs); color: var(--ink-faint); font-family: var(--font-mono); }
    .mnx-status:not(:empty)::before { content: '·'; margin: 0 .3rem; color: var(--ink-ghost); }
    .mnx-typing { align-self: flex-start; display: inline-flex; gap: 4px; padding: .6rem .8rem; background: var(--surface-strong); border: 1px solid var(--line); border-radius: 16px; border-bottom-left-radius: 5px; }
    .mnx-typing span { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-faint); animation: mnx-typing 1.2s infinite; }
    .mnx-typing span:nth-child(2) { animation-delay: .2s; } .mnx-typing span:nth-child(3) { animation-delay: .4s; }
    @keyframes mnx-typing { 0%,60%,100% { opacity: .3; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }
    .mnx-newmsgs { position: absolute; left: 50%; transform: translateX(-50%); bottom: 78px; padding: .4rem .9rem; border-radius: var(--r-pill); background: var(--mint-deep); color: #06231C; font: inherit; font-size: var(--fs-sm); font-weight: 600; border: 0; cursor: pointer; box-shadow: var(--shadow-soft); display: none; }
    .mnx-newmsgs.show { display: block; }
    .mnx-input { display: flex; align-items: center; gap: .6rem; padding: .7rem .8rem; border-top: 1px solid var(--line); flex: none; }
    .mnx-input input { flex: 1; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .65rem 1rem; color: var(--ink); font: inherit; font-size: 16px; outline: none; }
    .mnx-input input:focus { border-color: rgba(106,211,184,.5); }
