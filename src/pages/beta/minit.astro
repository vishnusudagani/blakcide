        document.getElementById('mnx-capback')?.addEventListener('click', showEntry);
      }

      // ---- voice calling (WebRTC over Supabase Realtime signalling) ----
      const RTC_CFG = { iceServers: [{ urls: ['stun:stun.l.google.com:19302', 'stun:stun1.l.google.com:19302'] }] };
      let pc = null, localStream = null, callState = 'idle', callTimer = 0, callStart = 0, pendingCands = [], remoteOffer = null, callTimeout = 0, callMuted = false, chatReady = false, peerReady = false;
      function callSend(kind, data) { try { chatChannel?.send({ type: 'broadcast', event: 'call', payload: { from: user.id, kind, data } }); } catch (e) {} }
      function sendReady() { try { chatChannel?.send({ type: 'broadcast', event: 'ready', payload: { from: user.id } }); } catch (e) {} }
      function onPeerReady() { if (peerReady) return; peerReady = true; sendReady(); }
      function fmtDur(s) { const m = Math.floor(s / 60), x = s % 60; return m + ':' + String(x).padStart(2, '0'); }
      function renderCallBar(state) {
        const bar = document.getElementById('mnx-call'); if (!bar) return;
        if (!state) { bar.hidden = true; bar.innerHTML = ''; if (callTimer) { clearInterval(callTimer); callTimer = 0; } return; }
        bar.hidden = false;
        if (state === 'calling') bar.innerHTML = `<span class="mnx-call-status"><span class="mnx-call-dot"></span> Calling… <span class="mnx-call-sub">ringing your listener</span></span><button type="button" class="mnx-call-end" id="mnx-call-cancel">Cancel</button>`;
        else if (state === 'incoming') bar.innerHTML = `<span class="mnx-call-status"><span class="mnx-call-dot"></span> Incoming voice call</span><span class="mnx-call-actions"><button type="button" class="mnx-call-decline" id="mnx-call-decline">Decline</button><button type="button" class="mnx-call-accept" id="mnx-call-accept">Accept</button></span>`;
        else bar.innerHTML = `<span class="mnx-call-status"><span class="mnx-call-dot live"></span> On call · <span id="mnx-call-time">0:00</span></span><span class="mnx-call-actions"><button type="button" class="mnx-call-mute ${callMuted ? 'on' : ''}" id="mnx-call-mute">${callMuted ? 'Unmute' : 'Mute'}</button><button type="button" class="mnx-call-end" id="mnx-call-hang">End call</button></span>`;
        document.getElementById('mnx-call-cancel')?.addEventListener('click', () => endCall(true));
        document.getElementById('mnx-call-hang')?.addEventListener('click', () => endCall(true));
        document.getElementById('mnx-call-decline')?.addEventListener('click', declineCall);
        document.getElementById('mnx-call-accept')?.addEventListener('click', acceptCall);
        document.getElementById('mnx-call-mute')?.addEventListener('click', (e) => { callMuted = !callMuted; const tr = localStream?.getAudioTracks()[0]; if (tr) tr.enabled = !callMuted; e.currentTarget.textContent = callMuted ? 'Unmute' : 'Mute'; e.currentTarget.classList.toggle('on', callMuted); });
      }
      function createPC() {
        pc = new RTCPeerConnection(RTC_CFG);
        pc.onicecandidate = (e) => { if (e.candidate) callSend('ice', e.candidate); };
        pc.ontrack = (e) => { const a = document.getElementById('mnx-rtc-audio'); if (a) a.srcObject = e.streams[0]; };
        pc.onconnectionstatechange = () => { if (!pc) return; const st = pc.connectionState; if (st === 'connected') onCallConnected(); else if (st === 'failed' || st === 'disconnected' || st === 'closed') endCall(false); };
      }
      function onCallConnected() {
        if (callState === 'connected') return; callState = 'connected'; callStart = Date.now();
        if (callTimeout) { clearTimeout(callTimeout); callTimeout = 0; }
        renderCallBar('connected'); logEvent('call_connected');
        if (callTimer) clearInterval(callTimer);
        callTimer = setInterval(() => { const t = document.getElementById('mnx-call-time'); if (t) t.textContent = fmtDur(Math.floor((Date.now() - callStart) / 1000)); }, 1000);
      }
      const getMic = () => navigator.mediaDevices.getUserMedia({ audio: true, video: false });
      async function startCall() {
        if (callState !== 'idle' || !activeSessionId) return;
        // Wait for our channel AND the peer to be present. The auto-call fires the
        // instant the chat opens — before the other side may have subscribed — so the
        // first SDP offer would otherwise broadcast into the void (~6s fallback).
        for (let i = 0; i < 40 && (!chatReady || !peerReady); i++) await wait(150);
        try { localStream = await getMic(); } catch (e) { alert('Microphone access is needed for a voice call.'); return; }
        callState = 'calling'; renderCallBar('calling'); logEvent('call_started');
        createPC(); localStream.getTracks().forEach((t) => pc.addTrack(t, localStream));
        try { const offer = await pc.createOffer({ offerToReceiveAudio: true }); await pc.setLocalDescription(offer); callSend('offer', offer); } catch (e) { endCall(true); return; }
        if (callTimeout) clearTimeout(callTimeout);
        callTimeout = setTimeout(() => { if (callState === 'calling') endCall(true); }, 45000);
      }
      async function handleCallSignal(p) {
        const kind = p?.kind, data = p?.data, from = p?.from;
        if (kind === 'offer') {
          if (callState === 'calling') { if (String(user.id) < String(from)) return; endCall(false); remoteOffer = data; callState = 'incoming'; acceptCall(); return; }
          if (callState !== 'idle') return;
          remoteOffer = data; callState = 'incoming'; renderCallBar('incoming');
        } else if (kind === 'answer') {
          if (pc && callState === 'calling') { try { await pc.setRemoteDescription(new RTCSessionDescription(data)); for (const c of pendingCands.splice(0)) { try { await pc.addIceCandidate(new RTCIceCandidate(c)); } catch (e) {} } } catch (e) {} }
        } else if (kind === 'ice') { try { if (pc && pc.remoteDescription) await pc.addIceCandidate(new RTCIceCandidate(data)); else pendingCands.push(data); } catch (e) {} }
        else if (kind === 'end' || kind === 'decline') { endCall(false); }
      }
      async function acceptCall() {
        if (callState !== 'incoming' || !remoteOffer) return;
        try { localStream = await getMic(); } catch (e) { declineCall(); return; }
        createPC(); localStream.getTracks().forEach((t) => pc.addTrack(t, localStream));
        try {
          await pc.setRemoteDescription(new RTCSessionDescription(remoteOffer));
          for (const c of pendingCands.splice(0)) { try { await pc.addIceCandidate(new RTCIceCandidate(c)); } catch (e) {} }
          const ans = await pc.createAnswer(); await pc.setLocalDescription(ans); callSend('answer', ans);
          callState = 'connecting'; renderCallBar('connected'); logEvent('call_accepted');
        } catch (e) { endCall(true); }
      }
      function declineCall() { callSend('decline'); remoteOffer = null; callState = 'idle'; renderCallBar(null); }
      function endCall(notify) {
        if (callState === 'idle' && !pc) return;
        if (notify) callSend('end');
        logEvent('call_ended', { dur: callStart ? Math.floor((Date.now() - callStart) / 1000) : 0, connected: !!callStart });
        if (callTimeout) { clearTimeout(callTimeout); callTimeout = 0; }
        try { if (pc) { pc.onicecandidate = pc.ontrack = pc.onconnectionstatechange = null; pc.close(); } } catch (e) {}
        pc = null;
        try { localStream?.getTracks().forEach((t) => t.stop()); } catch (e) {}
        localStream = null; remoteOffer = null; pendingCands = []; callStart = 0; callState = 'idle'; callMuted = false;
        const a = document.getElementById('mnx-rtc-audio'); if (a) a.srcObject = null;
        renderCallBar(null);
      }

      async function init() {
        user = await getUser();
        if (!user) { showSessionExpired(); return; }
        try { const { data: lp } = await supabase.from('listeners').select('id').eq('user_id', user.id).maybeSingle(); if (lp) { window.location.replace('/beta/listen/'); return; } } catch (e) {}
        const { data: existing } = await supabase.from('connect_sessions').select('*').eq('user_id', user.id).in('status', ['pending', 'active']).order('created_at', { ascending: false }).limit(1);
        const s = existing && existing[0];
        if (s) { activeSessionId = s.id; activeListenerId = s.listener_id; watchSession(s.id); if (s.status === 'active') openChat(); else showConnecting(false); return; }
        showEntry();
      }

      async function availableCount() {
        try { const { data } = await supabase.rpc('minit_available_count'); return Math.max(0, Number(data) || 0); } catch { return 0; }
      }
      async function lastListenerId() {
        try { const { data } = await supabase.from('connect_sessions').select('listener_id').eq('user_id', user.id).eq('status', 'completed').not('listener_id', 'is', null).order('created_at', { ascending: false }).limit(1); return data && data[0] ? data[0].listener_id : null; } catch { return null; }
      }

      async function showEntry() {
        chatOpen = false; immersive(false); matchedName = '';
        root.innerHTML = '<div class="mnx-skel" style="margin-top:1rem"><i></i><i></i><i></i></div>';
        const [count, history, credits] = await Promise.all([availableCount(), loadHistory(), checkCredits()]);
        const anonPref = localStorage.getItem('mnx_anon') !== 'false';
        const fname = ((user && user.user_metadata && (user.user_metadata.full_name || user.user_metadata.name || user.user_metadata.given_name)) || '').trim().split(' ')[0];
        const hr = new Date().getHours();
        let gTitle, gSub;
        if (hr < 5) { gTitle = 'Still awake?'; gSub = history.length ? 'I’m glad you’re back.' : 'Someone’s here if you need them.'; }
        else if (hr < 12) { gTitle = 'Good morning'; gSub = 'How are you, really?'; }
        else if (hr < 17) { gTitle = 'Good afternoon'; gSub = 'What’s on your mind?'; }
        else if (hr < 21) { gTitle = 'Good evening'; gSub = history.length ? 'Good to see you again.' : 'Want to talk it through?'; }
        else { gTitle = 'Winding down?'; gSub = 'Here whenever you need someone.'; }
        const gTitleHtml = (hr >= 5 && hr < 21 && fname) ? `${gTitle}, <em>${esc(fname)}</em>` : gTitle;
        const live = count > 0
          ? '<div class="mnx-live"><span class="mnx-live-dot"></span> Someone’s available right now</div>'
          : '<div class="mnx-live off"><span class="mnx-live-dot"></span> Quiet right now — start anyway and we’ll look</div>';
        const pips = Array.from({ length: 10 }, (_, i) => `<i class="mnx-pip ${i < credits.leftToday ? 'on' : ''}"></i>`).join('');
        const threadItems = history.map((h) => `<button type="button" class="mnx-thread" data-id="${h.id}" data-lid="${h.listener_id || ''}"><span class="mnx-thread-orb" style="${orbStyle(h.listener_id)}"></span><span class="mnx-thread-meta"><b>${esc(h.snippet)}</b><i>${h.when}</i></span><span class="mnx-thread-go">→</span></button>`).join('');
        const historyBtn = history.length ? `<button type="button" class="mnx-history-btn" id="mnx-history">View past conversations <span>→</span></button>` : '';
        const drawer = history.length ? `<div class="mnx-drawer" id="mnx-drawer" hidden><div class="mnx-drawer-scrim" id="mnx-drawer-scrim"></div><aside class="mnx-drawer-panel"><div class="mnx-drawer-head"><b>Your conversations</b><button type="button" class="mnx-drawer-close" id="mnx-drawer-close" aria-label="Close">✕</button></div><div class="mnx-drawer-list">${threadItems}</div></aside></div>` : '';
        root.innerHTML = `<div class="mnx-stage">
          <div class="mnx-entry">
            <span class="mnx-entry-glow" aria-hidden="true"></span>
            <div class="mnx-orb-wrap" aria-hidden="true"><i class="mnx-echo"></i><i class="mnx-echo"></i><span class="mnx-orb"></span></div>
            <p class="mnx-kick2">Minit · real people</p>
            <h2 class="mnx-greet">${gTitleHtml}</h2>
            <p class="mnx-greet-sub">${gSub}</p>
            ${live}
            <button type="button" class="mnx-go" id="mnx-start"${credits.ok ? '' : ' disabled'}>Start talking <span class="mnx-cta-arrow">→</span></button>
            <button type="button" class="mnx-anon-min ${anonPref ? 'on' : ''}" id="mnx-anon" aria-pressed="${anonPref}"><span class="mnx-anon-ico">${LOCK_SVG}</span> Anonymous <i>${anonPref ? 'on' : 'off'}</i><span class="mnx-sw2"></span></button>
            <div class="mnx-meter">
              <div class="mnx-meter-top"><span class="mnx-meter-label">Today’s minits</span><span class="mnx-meter-val">${credits.leftToday} left</span></div>
              <div class="mnx-pips">${pips}</div>
              <p class="mnx-meter-foot">${credits.ok ? credits.leftWeek + ' of 30 left this week · resets daily' : 'No minits left — more at midnight'}</p>
            </div>
            ${historyBtn}
          </div>
        </div>${drawer}`;
        let anon = anonPref;
        const anonBtn = document.getElementById('mnx-anon');
        anonBtn?.addEventListener('click', () => { anon = !anon; localStorage.setItem('mnx_anon', anon ? 'true' : 'false'); anonBtn.classList.toggle('on', anon); anonBtn.setAttribute('aria-pressed', String(anon)); const i = anonBtn.querySelector('i'); if (i) i.textContent = anon ? 'on' : 'off'; });
        document.getElementById('mnx-start')?.addEventListener('click', async (e) => {
          if (busy) return; busy = true; e.currentTarget.setAttribute('disabled', '');
          const c = await checkCredits();
          if (!c.ok) { busy = false; showCapped(); return; }
          busy = false; logEvent('start_tapped', { anon }); startTalking(anon);
        });
        const drawerEl = document.getElementById('mnx-drawer');
        const openDrawer = () => { if (!drawerEl) return; drawerEl.hidden = false; requestAnimationFrame(() => drawerEl.classList.add('open')); };
        const closeDrawer = () => { if (!drawerEl) return; drawerEl.classList.remove('open'); setTimeout(() => { drawerEl.hidden = true; }, 320); };
        document.getElementById('mnx-history')?.addEventListener('click', openDrawer);
        document.getElementById('mnx-drawer-close')?.addEventListener('click', closeDrawer);
        document.getElementById('mnx-drawer-scrim')?.addEventListener('click', closeDrawer);
        root.querySelectorAll('.mnx-thread').forEach((t) => t.addEventListener('click', () => openThread(t.getAttribute('data-id'), t.getAttribute('data-lid'))));
      }

      async function loadHistory() {
        try {
          const { data } = await supabase.from('connect_sessions').select('id, listener_id, created_at').eq('user_id', user.id).eq('status', 'completed').order('created_at', { ascending: false }).limit(8);
          const sessions = data || [];
          if (!sessions.length) return [];
          const lastBy = {};
          try {
            const { data: msgs } = await supabase.from('messages').select('session_id, content, created_at').in('session_id', sessions.map((s) => s.id)).order('created_at', { ascending: true });
            (msgs || []).forEach((m) => { if (m.content && !String(m.content).startsWith('###')) lastBy[m.session_id] = m.content; });
          } catch (e) {}
          return sessions.map((s) => ({ id: s.id, listener_id: s.listener_id, when: relTime(s.created_at), snippet: lastBy[s.id] || 'No messages yet' }));
        } catch { return []; }
      }

      async function openThread(sessionId, listenerId) {
        immersive(true);
        root.innerHTML = `<div class="mnx-chat">
          <div class="mnx-chat-head"><div class="mnx-chat-pic">${PERSON_SVG}</div><div class="mnx-chat-who"><b>Past conversation</b><i>read-only</i></div><button type="button" class="mnx-chat-end" id="mnx-tback" style="background:var(--surface);border-color:var(--line-strong);color:var(--ink-soft)">Back</button></div>
          <div class="mnx-feed" id="mnx-feed" role="log"><div class="mnx-skel"><i></i><i></i><i></i></div></div>
          <div class="mnx-input" style="gap:.6rem"><button type="button" class="mnx-go" id="mnx-recon" style="flex:1;font-size:var(--fs-md)">↩ Reconnect</button><button type="button" class="mnx-cancel" id="mnx-newchat">New chat</button></div>
        </div>`;
        document.getElementById('mnx-tback')?.addEventListener('click', showEntry);
        document.getElementById('mnx-recon')?.addEventListener('click', () => startTalking(localStorage.getItem('mnx_anon') !== 'false', listenerId || undefined));
        document.getElementById('mnx-newchat')?.addEventListener('click', () => startTalking(localStorage.getItem('mnx_anon') !== 'false'));
        const feed = document.getElementById('mnx-feed');
        const { data: msgs } = await supabase.from('messages').select('*').eq('session_id', sessionId).order('created_at', { ascending: true });
        const real = (msgs || []).filter((m) => m.content && !String(m.content).startsWith('###'));
        feed.innerHTML = real.length ? '' : '<div class="mnx-schedule" style="padding:2.2rem 1rem"><div class="mnx-empty-orb"></div><p class="mnx-sys">No messages in this conversation.</p></div>';
        real.forEach((m) => { const me = m.sender_id === user.id; const row = document.createElement('div'); row.className = 'mnx-row ' + (me ? 'me' : 'them'); const b = document.createElement('div'); b.className = 'mnx-bubble'; b.textContent = m.content; row.appendChild(b); const meta = document.createElement('div'); meta.className = 'mnx-meta'; const tm = document.createElement('span'); tm.className = 'mnx-mtime'; tm.textContent = fmtTime(m.created_at); meta.appendChild(tm); row.appendChild(meta); feed.appendChild(row); });
        feed.scrollTop = feed.scrollHeight;
      }

      async function startTalking(isAnonymous, preferredId) {
        immersive(true);
        root.innerHTML = `<div class="mnx-ring"><div class="mnx-scan"><span class="mnx-scan-sweep"></span><span class="mnx-scan-core"></span></div><h3>Finding someone for you…</h3><p>${preferredId ? 'Looking for your listener.' : 'Connecting you with a real person who’s here.'}</p></div>`;
        const [res] = await Promise.all([supabase.rpc('minit_start_session', { preferred: preferredId || null, is_anon: !!isAnonymous }), wait(1400)]);
        busy = false;
        if (res.error) {
          console.error('[minit] start_session failed:', res.error?.code, res.error?.message);
          if (await sessionExpired() || res.error?.code === '42501') { showSessionExpired(); return; }
          showError('Couldn’t reach the room just now.', () => { busy = true; startTalking(isAnonymous, preferredId); }); return;
        }
        const row = Array.isArray(res.data) ? res.data[0] : res.data;
        const outcome = row && row.outcome;
        if (outcome === 'open' || outcome === 'queued') {
          activeSessionId = row.session_id; activeListenerId = row.listener_id;
          try { supabase.from('minit_callbacks').update({ status: 'fulfilled' }).eq('user_id', user.id).in('status', ['waiting', 'notified']); } catch (e) {}
          logEvent('listener_found', { outcome });
          matchedName = await fetchListenerName(activeSessionId);
          showMatched(outcome === 'queued');
        } else if (outcome === 'preferred_unavailable') { logEvent('preferred_unavailable'); showPreferredUnavailable(isAnonymous, preferredId); }
        else if (outcome === 'banned') { logEvent('banned'); showRestricted(); }
        else if (outcome === 'busy_full') { logEvent('busy_full'); showBusyAll(isAnonymous); }
        else { logEvent('no_listener'); showSchedule(isAnonymous); }
      }
      async function fetchListenerName(sid) {
        try { const { data } = await supabase.rpc('minit_session_listener', { sid }); const r = Array.isArray(data) ? data[0] : data; return (r && r.display_name) ? r.display_name : ''; } catch (e) { return ''; }
      }

      // Rapido-style: after matching, reveal who you got + Talk/Chat, then connect.
      function showMatched(queued) {
        immersive(true);
        const who = matchedName ? esc(matchedName) : 'a listener';
        root.innerHTML = `<div class="mnx-ring">
          <div class="mnx-ring-avatar"><i></i><i></i><span class="core"></span></div>
          <h3>${queued ? 'You’re next with ' : 'Connecting you to '}<span class="mnx-accent">${who}</span></h3>
          <p>${queued ? 'They’re just finishing another conversation — you’re first up.' : 'How would you like to talk?'}</p>
          <div class="mnx-choice">
            <button type="button" class="mnx-go" id="mnx-pick-chat">${CHAT_SVG} Chat</button>
            <button type="button" class="mnx-go mnx-go-alt" id="mnx-pick-call">${PHONE_SVG} Talk</button>
          </div>
          <div class="mnx-ring-actions"><button type="button" class="mnx-cancel" id="mnx-pick-back">Cancel</button></div>
        </div>`;
        const go = (call) => { if (busy) return; busy = true; pendingWithCall = call; watchSession(activeSessionId); showConnecting(queued); };
        document.getElementById('mnx-pick-chat')?.addEventListener('click', () => go(false));
        document.getElementById('mnx-pick-call')?.addEventListener('click', () => go(true));
        document.getElementById('mnx-pick-back')?.addEventListener('click', () => cancelPending().then(showEntry));
      }

      // Two-sided safety: a moderated user can't start a Minit session.
      function showRestricted() {
        immersive(false);
        root.innerHTML = `<div class="mnx-schedule"><div class="mnx-empty-orb"></div><h3>Your Minit access is paused</h3><p>Minit is built to stay safe for everyone on both sides, so it doesn’t run on “the customer is always right.” Talking with listeners is restricted on your account right now. If you think this is a mistake, reach out and we’ll take a look.</p><div class="mnx-ring-actions"><a class="mnx-go" href="https://wa.me/917702063434" target="_blank" rel="noopener" style="width:auto;padding:.7rem 1.4rem;text-decoration:none">Contact Blaksyd</a><button type="button" class="mnx-cancel" id="mnx-restricted-back">Back</button></div></div>`;
        document.getElementById('mnx-restricted-back')?.addEventListener('click', showEntry);
      }
      function showBusyAll(isAnonymous) {
        immersive(false);
        root.innerHTML = `<div class="mnx-schedule"><div class="mnx-empty-orb"></div><h3>Every listener’s with someone right now</h3><p>Rather than wait in a line, let us ping you the moment one’s free — you’ll be first up. Or text Blak in the meantime.</p><div class="mnx-choice"><button type="button" class="mnx-go" id="mnx-notify">Notify me when one’s free</button><a class="mnx-go mnx-go-alt" href="/beta/blak/" style="text-decoration:none">Text Blak instead</a></div><div class="mnx-ring-actions"><button type="button" class="mnx-cancel" id="mnx-busyback">Back</button></div></div>`;
        document.getElementById('mnx-notify')?.addEventListener('click', () => requestCallback(isAnonymous, null));
        document.getElementById('mnx-busyback')?.addEventListener('click', showEntry);
      }
      // Layer-1 placeholder: records intent in the scheduled pool so "notify me" isn't a
      // dead end. Layer 2 replaces this with a minit_callbacks row + real notifications
      // (in-app banner / web push / WhatsApp) fired when a listener frees up.
      async function requestCallback(isAnonymous, preferredId) {
        try { await supabase.rpc('minit_request_callback', { preferred: preferredId || null, is_anon: !!isAnonymous }); } catch (e) {}
        logEvent('callback_requested', { preferred: !!preferredId });
        root.innerHTML = `<div class="mnx-ring"><div class="mnx-ring-check">✓</div><h3>You’re on the priority list</h3><p>We’ll ping you the moment a listener’s free — you’ll be first up. Keep using Blaksyd in the meantime.</p><div class="mnx-ring-actions"><button type="button" class="mnx-cancel" id="mnx-cbdone">Done</button></div></div>`;
        document.getElementById('mnx-cbdone')?.addEventListener('click', showEntry);
      }
      // Reconnect to a specific past listener who isn't free — let the seeker choose
      // rather than silently handing them to a stranger.
      function showPreferredUnavailable(isAnonymous, preferredId) {
        immersive(false);
        root.innerHTML = `<div class="mnx-schedule"><div class="mnx-empty-orb"></div><h3>Your listener isn’t free right now</h3><p>They may be offline or with someone else. Talk with another listener who’s here, or we’ll let you know when yours is free.</p><div class="mnx-choice"><button type="button" class="mnx-go" id="mnx-someone">Talk with someone else</button><button type="button" class="mnx-go mnx-go-alt" id="mnx-pu-notify">Notify me when they’re free</button></div><div class="mnx-ring-actions"><button type="button" class="mnx-cancel" id="mnx-pu-back">Back</button></div></div>`;
        document.getElementById('mnx-someone')?.addEventListener('click', () => { if (busy) return; busy = true; startTalking(isAnonymous, null); });
        document.getElementById('mnx-pu-notify')?.addEventListener('click', () => requestCallback(isAnonymous, preferredId));
        document.getElementById('mnx-pu-back')?.addEventListener('click', showEntry);
      }

      function showConnecting(queued) {
        immersive(true);
        const who = matchedName ? esc(matchedName) : 'your listener';
        const head = queued ? ('You’re next with ' + who) : ('Connecting you to ' + who);
        const sub = queued
          ? 'They’re just finishing another conversation — hang tight, you’re first up.'
          : 'They’re joining you now. This is usually quick.';
        root.innerHTML = `<div class="mnx-ring"><div class="mnx-ring-avatar"><i></i><i></i><span class="core"></span></div><h3 id="mnx-conn-h">${head}</h3><p id="mnx-conn-p">${sub}</p>${stepsHTML(2)}<div class="mnx-ring-actions"><button type="button" class="mnx-cancel" id="mnx-cancel">Cancel</button></div></div>`;
        document.getElementById('mnx-cancel')?.addEventListener('click', () => cancelPending().then(showEntry));
        pollPosition();
        if (connectWatchdog) clearTimeout(connectWatchdog);
        connectWatchdog = setTimeout(() => {
          if (chatOpen) return;
          const h = document.getElementById('mnx-conn-h'), p = document.getElementById('mnx-conn-p'), a = root.querySelector('.mnx-ring-actions');
          if (h) h.textContent = 'Still here with you…';
          if (p) p.textContent = 'It’s taking longer than usual. Keep waiting, or pick a time and check back.';
          if (a) a.innerHTML = '<button type="button" class="mnx-cancel" id="mnx-cancel">Cancel</button><button type="button" class="mnx-go" id="mnx-sched2" style="width:auto;padding:.6rem 1.2rem">Pick a time</button>';
          document.getElementById('mnx-cancel')?.addEventListener('click', () => cancelPending().then(showEntry));
          document.getElementById('mnx-sched2')?.addEventListener('click', () => { cancelPending().then(() => showSchedule(localStorage.getItem('mnx_anon') !== 'false')); });
        }, 45000);
      }
      async function pollPosition() {
        if (!activeSessionId || chatOpen) return;
        try {
          const { data } = await supabase.rpc('minit_queue_position', { sid: activeSessionId });
          const row = Array.isArray(data) ? data[0] : data;
          const h = document.getElementById('mnx-conn-h'), p = document.getElementById('mnx-conn-p');
          if (!row || !h || !p || chatOpen) return;
          const who = matchedName || 'your listener';
          if (row.listener_busy) { const t = 'You’re next with ' + who; if (h.textContent !== t) h.textContent = t; }
          else { const t = 'Connecting you to ' + who; if (h.textContent !== t) { h.textContent = t; p.textContent = 'They’re free — bringing you in now.'; } }
        } catch (e) {}
      }

      function showError(text, retry) {
        immersive(false);
        root.innerHTML = `<div class="mnx-msg">${text}<div class="mnx-retry"><button type="button" class="mnx-go" id="mnx-retry" style="width:auto;padding:.7rem 1.4rem">Try again</button></div></div>`;
        document.getElementById('mnx-retry')?.addEventListener('click', () => retry && retry());
      }
      function showSessionExpired() {
        immersive(false);
        root.innerHTML = `<div class="mnx-msg">Your sign-in has expired. Please sign in again to keep talking.<div class="mnx-retry"><a href="/?auth=1" class="mnx-go" style="display:inline-flex;width:auto;padding:.7rem 1.4rem;text-decoration:none">Sign in again</a></div></div>`;
      }

      function showSchedule(isAnonymous) {
        immersive(false);
        let val = '';
        try { const d = new Date(Date.now() + 3600000); val = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); } catch (e) {}
        root.innerHTML = `<div class="mnx-schedule"><div class="mnx-empty-orb"></div><h3>No one’s free right now</h3><p>What time works for you? We’ll have someone ready.</p><div class="mnx-timepick"><input type="time" id="mnx-time-input" class="mnx-time-input" value="${val}" aria-label="Preferred time" /></div><div class="mnx-choice" style="margin-top:1.2rem"><button type="button" class="mnx-go" id="mnx-time-set">Set this time <span class="mnx-cta-arrow">→</span></button></div><div class="mnx-ring-actions"><button type="button" class="mnx-cancel" id="mnx-sback">Back</button></div></div>`;
        document.getElementById('mnx-time-set')?.addEventListener('click', () => { const v = document.getElementById('mnx-time-input')?.value; if (v) scheduleFor(v, isAnonymous); });
        document.getElementById('mnx-sback')?.addEventListener('click', showEntry);
      }
      function fmtClock(hhmm) { try { const [h, m] = String(hhmm).split(':').map(Number); const d = new Date(); d.setHours(h, m, 0, 0); return d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' }); } catch { return hhmm; } }
      async function scheduleFor(when, isAnonymous) {
        const pretty = fmtClock(when);
        try { await supabase.from('connect_sessions').insert([{ user_id: user.id, listener_id: null, session_type: 'chat', is_anonymous: isAnonymous, status: 'scheduled', listener_notes: 'requested: ' + pretty }]); } catch (e) {}
        logEvent('scheduled', { when });
        root.innerHTML = `<div class="mnx-ring"><div class="mnx-ring-check">✓</div><h3>Noted — thank you</h3><p>We’ll have someone ready around <b>${esc(pretty)}</b>. Check back then.</p><div class="mnx-ring-actions"><button type="button" class="mnx-cancel" id="mnx-sdone">Done</button></div></div>`;
        document.getElementById('mnx-sdone')?.addEventListener('click', showEntry);
      }

      function watchSession(id) {
        if (sessionChannel) supabase.removeChannel(sessionChannel);
        sessionChannel = supabase.channel('mnx_session_' + id).on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'connect_sessions', filter: `id=eq.${id}` }, syncSession).subscribe();
        if (sessionPoll) clearInterval(sessionPoll);
        sessionPoll = setInterval(syncSession, 1500);
      }
      async function syncSession() {
        if (!activeSessionId || isEnding) return;
        const { data: s, error } = await supabase.from('connect_sessions').select('status').eq('id', activeSessionId).maybeSingle();
        if (error || !s) return;
        if (s.status === 'active') openChat();
        else if (s.status === 'completed') endByOther();
        else if (s.status === 'rejected') { isEnding = true; teardown(); immersive(false); root.innerHTML = '<div class="mnx-msg">Your listener got pulled away. Please try again in a little while.<div class="mnx-retry"><button type="button" class="mnx-go" id="mnx-retry" style="width:auto;padding:.7rem 1.4rem">Back</button></div></div>'; document.getElementById('mnx-retry')?.addEventListener('click', resetToEntry); }
        else if (s.status === 'cancelled') resetToEntry();
        else if (s.status === 'pending' && !chatOpen) pollPosition();
      }
      function resetToEntry() { isEnding = false; teardown(); activeSessionId = null; activeListenerId = null; chatOpen = false; rendered.clear(); lastMsgAt = null; lastOwnStatusEl = null; showEntry(); }
      async function cancelPending() { if (!activeSessionId) return; isEnding = true; pendingWithCall = false; teardown(); await supabase.from('connect_sessions').update({ status: 'cancelled' }).eq('id', activeSessionId); activeSessionId = null; isEnding = false; }

      function nearBottom(f) { return f.scrollHeight - f.scrollTop - f.clientHeight < 90; }

      async function openChat() {
        if (chatOpen) return; chatOpen = true; immersive(true);
        if (connectWatchdog) clearTimeout(connectWatchdog);
        root.innerHTML = `<div class="mnx-chat">
          <div class="mnx-chat-head"><div class="mnx-chat-pic">${PERSON_SVG}</div><div class="mnx-chat-who"><b id="mnx-who">${matchedName ? esc(matchedName) : 'Your listener'}</b><i><span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block"></span> here with you · private</i></div><button type="button" class="mnx-icon-btn" id="mnx-call-btn" style="margin-left:auto" aria-label="Voice call" title="Voice call">${PHONE_SVG}</button><button type="button" class="mnx-chat-end" id="mnx-end">End</button></div>
          <div class="mnx-call" id="mnx-call" hidden></div>
          <div class="mnx-feed" id="mnx-feed" role="log" aria-live="polite"><div class="mnx-sys">🔒 You’re connected to a real person. Say what’s on your mind.</div></div>
          <button type="button" class="mnx-newmsgs" id="mnx-newmsgs">↓ New messages</button>
          <div class="mnx-input"><input type="text" id="mnx-text" placeholder="Message your listener…" autocomplete="off" aria-label="Message" /><button type="button" class="mnx-send" id="mnx-send" aria-label="Send">${SEND_SVG}</button></div>
        </div>`;
        const input = document.getElementById('mnx-text'), feed = document.getElementById('mnx-feed');
        document.getElementById('mnx-send')?.addEventListener('click', sendMessage);
        document.getElementById('mnx-end')?.addEventListener('click', confirmEnd);
        document.getElementById('mnx-call-btn')?.addEventListener('click', startCall);
        if (!matchedName) fetchListenerName(activeSessionId).then((n) => { if (n) { matchedName = n; const w = document.getElementById('mnx-who'); if (w) w.textContent = n; } });
        document.getElementById('mnx-newmsgs')?.addEventListener('click', () => { feed.scrollTop = feed.scrollHeight; document.getElementById('mnx-newmsgs').classList.remove('show'); });
        feed.addEventListener('scroll', () => { if (nearBottom(feed)) document.getElementById('mnx-newmsgs')?.classList.remove('show'); });
        input?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); sendMessage(); } });
        input?.addEventListener('input', sendTyping);
        input?.addEventListener('focus', () => setTimeout(() => input.scrollIntoView({ block: 'center' }), 200));

        const { data: msgs } = await supabase.from('messages').select('*').eq('session_id', activeSessionId).order('created_at', { ascending: true });
        (msgs || []).forEach(renderMessage);
        if (msgs && msgs.length) lastMsgAt = msgs[msgs.length - 1].created_at;
        feed.scrollTop = feed.scrollHeight;

        chatReady = false; peerReady = false;
        chatChannel = supabase.channel('minit_sig_' + activeSessionId)
          .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages', filter: `session_id=eq.${activeSessionId}` }, (p) => renderMessage(p.new))
          .on('broadcast', { event: 'typing' }, (p) => { if (p.payload?.from !== user.id) showTyping(); })
          .on('broadcast', { event: 'seen' }, (p) => { if (p.payload?.from !== user.id) markSeen(); })
          .on('broadcast', { event: 'ready' }, (p) => { if (p.payload?.from !== user.id) onPeerReady(); })
          .on('broadcast', { event: 'call' }, (p) => { if (p.payload?.from !== user.id) handleCallSignal(p.payload); })
          .subscribe((s) => { chatReady = (s === 'SUBSCRIBED'); if (chatReady) sendReady(); });
        if (msgPoll) clearInterval(msgPoll);
        msgPoll = setInterval(pollMessages, 1800);
        logEvent('connected');
        input?.focus();
        if (pendingWithCall) { pendingWithCall = false; startCall(); }
      }

      function sendTyping() { const n = Date.now(); if (n - lastTypingSent < 1500) return; lastTypingSent = n; chatChannel?.send({ type: 'broadcast', event: 'typing', payload: { from: user.id } }); }
      function showTyping() { const feed = document.getElementById('mnx-feed'); if (!feed) return; let t = document.getElementById('mnx-typing'); if (!t) { t = document.createElement('div'); t.id = 'mnx-typing'; t.className = 'mnx-typing'; t.innerHTML = '<span></span><span></span><span></span>'; feed.appendChild(t); if (nearBottom(feed)) feed.scrollTop = feed.scrollHeight; } if (typingTimer) clearTimeout(typingTimer); typingTimer = setTimeout(() => document.getElementById('mnx-typing')?.remove(), 2400); }
      function markSeen() { if (lastOwnStatusEl) lastOwnStatusEl.textContent = 'Seen'; }

      async function pollMessages() {
        if (!activeSessionId) return;
        let q = supabase.from('messages').select('*').eq('session_id', activeSessionId).order('created_at', { ascending: true });
        if (lastMsgAt) q = q.gte('created_at', lastMsgAt);
        const { data: msgs } = await q;
        if (msgs && msgs.length) msgs.forEach(renderMessage);
      }

      function renderMessage(m) {
        if (!m || rendered.has(m.id)) return;
        if (m.content && String(m.content).startsWith('###')) { rendered.add(m.id); return; }
        rendered.add(m.id);
        if (m.created_at && (!lastMsgAt || m.created_at > lastMsgAt)) lastMsgAt = m.created_at;
        const feed = document.getElementById('mnx-feed'); if (!feed) return;
        const me = m.sender_id === user.id;
        const stick = nearBottom(feed);
        if (me) feed.querySelectorAll('.mnx-row.me.temp').forEach((el) => el.remove());
        document.getElementById('mnx-typing')?.remove();
        const row = document.createElement('div'); row.className = 'mnx-row ' + (me ? 'me' : 'them');
        const b = document.createElement('div'); b.className = 'mnx-bubble'; b.textContent = m.content; row.appendChild(b);
        const meta = document.createElement('div'); meta.className = 'mnx-meta';
        const tm = document.createElement('span'); tm.className = 'mnx-mtime'; tm.textContent = fmtTime(m.created_at); meta.appendChild(tm);
        if (me) { const st = document.createElement('span'); st.className = 'mnx-status'; st.textContent = 'Delivered'; meta.appendChild(st); if (lastOwnStatusEl) lastOwnStatusEl.textContent = ''; lastOwnStatusEl = st; }
        row.appendChild(meta);
        feed.appendChild(row);
        if (stick || me) feed.scrollTop = feed.scrollHeight; else document.getElementById('mnx-newmsgs')?.classList.add('show');
        if (!me) chatChannel?.send({ type: 'broadcast', event: 'seen', payload: { from: user.id } });
      }

      async function sendMessage() {
        if (sending) return;
        const input = document.getElementById('mnx-text'); const text = input?.value.trim();
        if (!text || !activeSessionId) return;
        sending = true;
        const sendBtn = document.getElementById('mnx-send'); sendBtn?.setAttribute('disabled', '');
        try {
          input.value = '';
          const feed = document.getElementById('mnx-feed');
          let temp;
          if (feed) { temp = document.createElement('div'); temp.className = 'mnx-row me temp'; temp.innerHTML = '<div class="mnx-bubble"></div>'; temp.querySelector('.mnx-bubble').textContent = text; feed.appendChild(temp); feed.scrollTop = feed.scrollHeight; setTimeout(() => temp && temp.classList.remove('temp'), 4000); }
          if (feed && !boundaryNudged && CONTACT_RE.test(text)) { boundaryNudged = true; const bn = document.createElement('div'); bn.className = 'mnx-sys'; bn.textContent = '🔒 Minit stays on-platform and anonymous — please don’t share personal contacts or arrange to meet offline.'; feed.appendChild(bn); feed.scrollTop = feed.scrollHeight; }
          const { error } = await supabase.from('messages').insert([{ session_id: activeSessionId, sender_id: user.id, content: text }]);
          if (error) { temp?.remove(); input.value = text; if (await sessionExpired()) showSessionExpired(); }
        } finally { sending = false; sendBtn?.removeAttribute('disabled'); }
      }

      let endArmed = false;
      function confirmEnd(e) { const btn = e.currentTarget; if (!endArmed) { endArmed = true; btn.classList.add('confirm'); btn.textContent = 'Tap to confirm'; setTimeout(() => { endArmed = false; btn.classList.remove('confirm'); btn.textContent = 'End'; }, 3000); return; } endSession(); }
      async function endSession() { if (!activeSessionId) return; const sid = activeSessionId, lid = activeListenerId; isEnding = true; endCall(true); logEvent('ended', { by: 'seeker' }); teardown(); await supabase.from('connect_sessions').update({ status: 'completed', ended_at: new Date().toISOString() }).eq('id', sid); showReview(sid, lid); }
      function endByOther() { if (isEnding) return; isEnding = true; logEvent('ended', { by: 'listener' }); teardown(); showReview(activeSessionId, activeListenerId); }

      function showReview(sessionId, listenerId) {
        immersive(false);
        let stars = 0, feel = null;
        const modal = document.createElement('div'); modal.className = 'mnx-modal';
        modal.innerHTML = `<div class="mnx-modal-card"><div style="font-size:1.6rem">✨</div><h3>How do you feel now?</h3><p>Compared to when you came in.</p>
          <div class="mnx-feel" id="mnx-feel"><button data-f="lighter" title="Lighter">🙂</button><button data-f="same" title="About the same">😐</button><button data-f="heavy" title="Still heavy">😔</button></div>
          <p style="margin-top:.8rem">And your listener?</p>
          <div class="mnx-stars" id="mnx-stars">${[1,2,3,4,5].map((n) => `<span data-n="${n}">★</span>`).join('')}</div>
          <div class="mnx-modal-actions"><button type="button" class="mnx-btn-ghost" id="mnx-skip">Skip</button><button type="button" class="mnx-btn-go" id="mnx-submit">Done</button></div></div>`;
        document.body.appendChild(modal);
        modal.querySelectorAll('#mnx-feel button').forEach((bn) => bn.addEventListener('click', () => { feel = bn.getAttribute('data-f'); modal.querySelectorAll('#mnx-feel button').forEach((x) => x.classList.toggle('on', x === bn)); }));
        modal.querySelectorAll('#mnx-stars span').forEach((s) => s.addEventListener('click', () => { stars = Number(s.getAttribute('data-n')); modal.querySelectorAll('#mnx-stars span').forEach((x) => x.classList.toggle('on', Number(x.getAttribute('data-n')) <= stars)); }));
        const finish = () => { modal.remove(); resetToEntry(); };
        modal.querySelector('#mnx-skip').addEventListener('click', finish);
        modal.querySelector('#mnx-submit').addEventListener('click', async () => { if (stars) { try { await supabase.from('listener_reviews').insert([{ session_id: sessionId, listener_id: listenerId, user_id: user.id, rating: stars, review_text: feel ? ('felt: ' + feel) : null }]); } catch (e) {} } try { logEvent('reviewed', { stars, feel }); } catch (e) {} finish(); });
        modal.addEventListener('click', (e) => { if (e.target === modal) finish(); });
      }

      init();
    }
  </script>
</AppLayout>
