---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout active="blak" title="Blak">
  <div class="bx">
    <header class="bx-head">
      <span class="bx-orb"></span>
      <span class="bx-who"><b>Blak</b><i><span class="bx-live"></span>with you · always</i></span>
      <div class="bx-head-actions">
        <button type="button" class="bx-call" id="bx-call" title="Voice call with Blak" aria-label="Voice call with Blak">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </button>
        <a class="bx-human" href="/beta/minit/" title="Talk to a real person">Talk to a human</a>
        <button type="button" class="bx-clear" id="bx-clear" title="Start a fresh chat" aria-label="Start a fresh chat">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></svg>
        </button>
        <button type="button" class="bx-hist" id="bx-history" title="Your chats" aria-label="Your chats">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
        </button>
      </div>
    </header>

    <div class="bx-stream" id="bx-stream" aria-live="polite"></div>

    <button type="button" class="bx-jump" id="bx-jump" aria-label="Jump to latest" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
    </button>

    <div class="bx-chips" id="bx-chips">
      <button type="button" class="bx-chip" data-msg="I'm overwhelmed">I'm overwhelmed</button>
      <button type="button" class="bx-chip" data-msg="Plan my weekend">Plan my weekend</button>
      <button type="button" class="bx-chip" data-msg="Help me focus">Help me focus</button>
    </div>

    <form class="bx-composer" id="bx-form">
      <textarea id="bx-input" rows="1" placeholder="Message Blak…" autocomplete="off"></textarea>
      <button type="submit" id="bx-send" aria-label="Send">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
      <button type="button" id="bx-stop" aria-label="Stop" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="7" width="10" height="10" rx="2"/></svg>
      </button>
    </form>
    <p class="bx-note">Beta — the real Blak. Talks, listens, remembers you, any language. Be kind, it's still learning. 🤍</p>

    <!-- Voice call (turn-based: tap-to-talk) -->
    <div class="bx-call-ov" id="bx-call-overlay" hidden>
      <div class="bx-call-bar">
        <select class="bx-call-lang" id="bx-call-lang" aria-label="Call language">
          <option value="auto">Auto detect</option><option value="en">English</option><option value="hi">हिन्दी</option><option value="te">తెలుగు</option><option value="ta">தமிழ்</option><option value="kn">ಕನ್ನಡ</option><option value="ml">മലയാളം</option><option value="bn">বাংলা</option><option value="mr">मराठी</option><option value="gu">ગુજરાતી</option><option value="pa">ਪੰਜਾਬੀ</option>
        </select>
        <button type="button" class="bx-call-end" id="bx-call-end">End call</button>
      </div>
      <div class="bx-call-stage">
        <div class="bx-call-orb" id="bx-call-orb"></div>
        <p class="bx-call-status" id="bx-call-status">tap the mic and talk</p>
        <div class="bx-call-cap" id="bx-call-caption"></div>
      </div>
      <button type="button" class="bx-call-mic" id="bx-call-mic" aria-label="Tap to talk">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
      </button>
    </div>

    <!-- Chat history drawer -->
    <div class="bx-cv-drawer" id="bx-convos" hidden>
      <div class="bx-cv-scrim" id="bx-cv-scrim"></div>
      <aside class="bx-cv-panel">
        <div class="bx-cv-head"><b>Your chats</b><button type="button" class="bx-cv-new" id="bx-cv-new">＋ New chat</button></div>
        <div class="bx-cv-list" id="bx-cv-list"></div>
      </aside>
    </div>
  </div>

  <style is:global>
    .bx { display: flex; flex-direction: column; height: calc(100svh - 0px); max-width: 820px; margin-inline: auto; padding: 0 clamp(.8rem, 3vw, 1.5rem); position: relative; }
    @media (max-width: 820px) { .bx { height: calc(100svh - 124px); } }
    .bx-head { display: flex; align-items: center; gap: .7rem; padding: 1rem .3rem .9rem; border-bottom: 1px solid var(--line); }
    .bx-orb { width: 38px; height: 38px; border-radius: 50%; flex: none; background: var(--cta-grad); box-shadow: 0 0 16px rgba(255,107,157,.45); animation: bx-breathe 5s ease-in-out infinite; }
    @keyframes bx-breathe { 0%,100%{transform:scale(1)} 50%{transform:scale(1.06)} }
    .bx-who { display: flex; flex-direction: column; line-height: 1.25; }
    .bx-who b { font-size: var(--fs-lg); font-weight: 650; }
    .bx-who i { font-style: normal; font-size: var(--fs-sm); color: var(--ink-faint); display: inline-flex; align-items: center; gap: .35rem; }
    .bx-live { width: 7px; height: 7px; border-radius: 50%; background: var(--mint-deep); box-shadow: 0 0 8px var(--mint-deep); }
    .bx-head-actions { margin-left: auto; display: flex; align-items: center; gap: .6rem; }
    .bx-human { font-size: var(--fs-xs); color: var(--mint); text-decoration: none; border: 1px solid rgba(106,211,184,.3); border-radius: var(--r-pill); padding: .3rem .7rem; transition: .18s var(--ease-out); white-space: nowrap; }
    .bx-human:hover { background: rgba(106,211,184,.12); border-color: var(--mint-deep); }
    .bx-clear { width: 34px; height: 34px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--ink-faint); background: var(--surface); border: 1px solid var(--line-strong); cursor: pointer; transition: .18s var(--ease-out); }
    .bx-clear:hover { color: var(--coral); border-color: var(--coral); }
    .bx-clear svg { width: 16px; height: 16px; }
    html[data-theme="light"] .bx-human { color: var(--mint-ink); }

    .bx-stream { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: .7rem; padding: 1.1rem .3rem 1.4rem; scrollbar-width: thin; scroll-behavior: smooth; }
    .bx-row { display: flex; align-items: flex-end; gap: .5rem; max-width: 84%; animation: bx-in .28s var(--ease-out) both; }
    .bx-row.them { align-self: flex-start; } .bx-row.me { align-self: flex-end; flex-direction: row-reverse; }
    @keyframes bx-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    .bx-av { width: 26px; height: 26px; border-radius: 50%; flex: none; background: var(--cta-grad); box-shadow: 0 0 10px rgba(255,107,157,.4); }
    .bx-col { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .bx-row.me .bx-col { align-items: flex-end; }
    .bx-bub { padding: .7rem .95rem; border-radius: 16px; font-size: var(--fs-base); line-height: 1.5; white-space: pre-wrap; word-wrap: break-word; }
    .bx-row.them .bx-bub { background: rgba(255,107,157,.14); border: 1px solid rgba(255,107,157,.24); border-bottom-left-radius: 5px; color: var(--ink); }
    .bx-row.me .bx-bub { background: rgba(91,192,255,.16); border: 1px solid rgba(91,192,255,.28); border-bottom-right-radius: 5px; color: var(--ink); }
    .bx-time { font-family: var(--font-mono); font-size: var(--fs-3xs); color: var(--ink-faint); padding: 0 .35rem; opacity: .8; }
    .bx-meta { display: flex; gap: .6rem; align-items: center; padding: 0 .35rem; }
    .bx-regen { font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .04em; color: var(--ink-faint); background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; gap: .25rem; padding: 0; transition: color .18s; }
    .bx-regen:hover { color: var(--coral); }
    .bx-regen svg { width: 12px; height: 12px; }
    .bx-retry { margin-top: .4rem; align-self: flex-start; font-family: inherit; font-size: var(--fs-sm); color: var(--coral); background: rgba(255,107,157,.1); border: 1px solid rgba(255,107,157,.3); border-radius: var(--r-pill); padding: .35rem .8rem; cursor: pointer; transition: .18s; }
    .bx-retry:hover { background: rgba(255,107,157,.18); }
    .bx-row.err .bx-bub { color: var(--ink-soft); background: var(--surface); border-color: var(--line-strong); }

    .bx-typing { display: inline-flex; gap: 4px; padding: .1rem 0; } .bx-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--coral); animation: bx-blink 1.2s infinite; } .bx-dot:nth-child(2){animation-delay:.18s} .bx-dot:nth-child(3){animation-delay:.36s}
    @keyframes bx-blink { 0%,100%{opacity:.3; transform: translateY(0)} 50%{opacity:1; transform: translateY(-2px)} }

    .bx-jump { position: absolute; right: clamp(1rem, 4vw, 2rem); bottom: 150px; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-strong); background: var(--surface-strong); color: var(--ink); cursor: pointer; box-shadow: var(--shadow-soft); z-index: 4; animation: bx-in .2s var(--ease-out) both; }
    .bx-jump svg { width: 18px; height: 18px; }
    .bx-jump[hidden] { display: none; }

    .bx-chips { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0 .3rem .6rem; transition: opacity .25s var(--ease-out); }
    .bx-chips[hidden] { display: none; }
    .bx-chip { font-family: inherit; font-size: var(--fs-sm); color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .5rem .85rem; cursor: pointer; transition: .18s var(--ease-out); }
    .bx-chip:hover { color: var(--ink); border-color: var(--coral); transform: translateY(-1px); }
    .bx-chip:active { transform: translateY(0); }

    .bx-composer { display: flex; gap: .5rem; padding: 0 .3rem .5rem; align-items: flex-end; }
    .bx-composer textarea { flex: 1; min-width: 0; resize: none; max-height: 140px; padding: .8rem 1.1rem; border-radius: 22px; background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-lg); line-height: 1.4; transition: border-color .18s, background .18s; }
    .bx-composer textarea:focus { outline: none; border-color: var(--coral); background: var(--surface-strong); }
    .bx-composer button { flex: none; width: 48px; height: 48px; border-radius: 50%; border: 0; cursor: pointer; color: var(--cta-ink); background: var(--cta); box-shadow: var(--shadow-cta); display: grid; place-items: center; transition: transform .16s var(--ease-out), opacity .16s; }
    .bx-composer button:hover { transform: scale(1.06); } .bx-composer button:active { transform: scale(.94); }
    .bx-composer button[hidden] { display: none; }
    #bx-stop { background: var(--surface-strong); color: var(--ink); border: 1px solid var(--line-strong); box-shadow: none; }
    .bx-composer button svg { width: 20px; height: 20px; }
    .bx-note { margin: 0 .3rem; padding-bottom: .8rem; font-size: var(--fs-xs); color: var(--ink-faint); text-align: center; }
    html[data-theme="light"] .bx-tag { color: var(--coral-ink); }

    /* ── Voice call ── */
    .bx-call { width: 34px; height: 34px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--mint); background: var(--surface); border: 1px solid rgba(106,211,184,.3); cursor: pointer; transition: .18s var(--ease-out); }
    .bx-call:hover { color: var(--mint-deep); border-color: var(--mint-deep); background: rgba(106,211,184,.12); }
    .bx-call svg { width: 16px; height: 16px; }
    .bx-call-ov { position: fixed; inset: 0; z-index: 50; display: flex; flex-direction: column; align-items: center; background: radial-gradient(120% 80% at 50% 0%, rgba(255,107,157,.12), var(--bg) 60%); backdrop-filter: blur(8px); animation: bx-in .25s var(--ease-out) both; }
    .bx-call-ov[hidden] { display: none; }
    .bx-call-bar { width: 100%; max-width: 820px; display: flex; align-items: center; justify-content: space-between; padding: 1rem clamp(.8rem,3vw,1.5rem); }
    .bx-call-lang { font: inherit; font-size: var(--fs-sm); color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .4rem .8rem; }
    .bx-call-end { font: inherit; font-size: var(--fs-sm); color: #ff7a7a; background: rgba(255,107,107,.1); border: 1px solid rgba(255,107,107,.35); border-radius: var(--r-pill); padding: .45rem 1rem; cursor: pointer; }
    .bx-call-stage { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.4rem; text-align: center; padding: 1rem; }
    .bx-call-orb { width: 130px; height: 130px; border-radius: 50%; background: var(--cta-grad); box-shadow: 0 0 60px rgba(255,107,157,.45); animation: bx-breathe 4s ease-in-out infinite; }
    .bx-call-ov.speaking .bx-call-orb { animation: bx-breathe 1.1s ease-in-out infinite; }
    .bx-call-ov.listening .bx-call-orb { background: radial-gradient(circle at 40% 35%, #fff, var(--aqua)); box-shadow: 0 0 60px rgba(91,192,255,.6); }
    .bx-call-status { font-size: var(--fs-lg); color: var(--ink-soft); margin: 0; }
    .bx-call-cap { max-width: 600px; display: flex; flex-direction: column; gap: .5rem; }
    .bx-call-cap .cc-you { color: var(--ink-faint); font-size: var(--fs-sm); margin: 0; }
    .bx-call-cap .cc-blak { color: var(--ink); font-size: var(--fs-lg); margin: 0; }
    .bx-call-mic { width: 76px; height: 76px; margin: 0 auto 2.4rem; border-radius: 50%; border: 0; cursor: pointer; color: #fff; background: var(--cta); box-shadow: var(--shadow-cta); display: grid; place-items: center; transition: transform .15s var(--ease-out); }
    .bx-call-mic:hover { transform: scale(1.05); }
    .bx-call-mic.rec { background: #ff6b6b; animation: bx-callpulse 1.2s ease-in-out infinite; }
    .bx-call-mic.muted { background: var(--surface-strong); color: var(--ink-faint); box-shadow: none; }
    .bx-call-mic svg { width: 30px; height: 30px; }
    @keyframes bx-callpulse { 0%,100%{box-shadow:0 0 0 6px rgba(255,107,107,.18)} 50%{box-shadow:0 0 0 16px rgba(255,107,107,.05)} }

    /* ── Chat history drawer ── */
    .bx-hist { width: 34px; height: 34px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--ink-faint); background: var(--surface); border: 1px solid var(--line-strong); cursor: pointer; transition: .18s var(--ease-out); }
    .bx-hist:hover { color: var(--ink); border-color: var(--coral); }
    .bx-hist svg { width: 16px; height: 16px; }
    .bx-cv-drawer { position: fixed; inset: 0; z-index: 60; }
    .bx-cv-drawer[hidden] { display: none; }
    .bx-cv-scrim { position: absolute; inset: 0; background: rgba(0,0,0,.4); animation: bx-in .2s var(--ease-out) both; }
    .bx-cv-panel { position: absolute; top: 0; left: 0; bottom: 0; width: min(300px, 82vw); background: var(--bg); border-right: 1px solid var(--line); box-shadow: var(--shadow-soft); display: flex; flex-direction: column; padding: 1rem .8rem; animation: bx-slidein .22s var(--ease-out) both; }
    @keyframes bx-slidein { from { transform: translateX(-100%); } to { transform: none; } }
    .bx-cv-head { display: flex; align-items: center; justify-content: space-between; padding: .3rem .3rem 1rem; }
    .bx-cv-head b { font-size: var(--fs-lg); }
    .bx-cv-new { font: inherit; font-size: var(--fs-sm); color: var(--cta-ink); background: var(--cta); border: 0; border-radius: var(--r-pill); padding: .45rem .85rem; cursor: pointer; }
    .bx-cv-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: .25rem; }
    .bx-cv-item { display: flex; align-items: center; border-radius: var(--r-sm); transition: background .15s; }
    .bx-cv-item:hover { background: var(--surface); }
    .bx-cv-item.on { background: var(--surface-strong); }
    .bx-cv-open { flex: 1; min-width: 0; text-align: left; font: inherit; font-size: var(--fs-sm); color: var(--ink); background: none; border: 0; padding: .6rem; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bx-cv-del { flex: none; font-size: var(--fs-xs); color: var(--ink-faint); background: none; border: 0; padding: .4rem .6rem; cursor: pointer; opacity: 0; transition: opacity .15s, color .15s; }
    .bx-cv-item:hover .bx-cv-del { opacity: 1; }
    .bx-cv-del:hover { color: var(--coral); }
    .bx-cv-empty { color: var(--ink-faint); font-size: var(--fs-sm); padding: 1rem .6rem; }
  </style>

  <script>
    // Real Blak — streams from the Groq-backed open-source chat via the
    // authenticated Blaksyd→Symp proxy (/api/blaksyd/symp/chat).
    // History persists per-user in localStorage; auto-retry + graceful recovery
    // mean a hiccup never leaves the user with a dead "…".
    import { supabase } from '../../lib/supabaseClient';

    const $ = (id) => document.getElementById(id);
    const stream = $('bx-stream'), form = $('bx-form'), input = $('bx-input'),
          chips = $('bx-chips'), sendBtn = $('bx-send'), stopBtn = $('bx-stop'),
          jumpBtn = $('bx-jump'), clearBtn = $('bx-clear'),
          historyBtn = $('bx-history'), convoDrawer = $('bx-convos'),
          convoList = $('bx-cv-list'), cvNew = $('bx-cv-new'), cvScrim = $('bx-cv-scrim');

    const GREETING = "Hey — good to see you. What's going on for you right now?";
    const MAX_TURNS = 24; // how many recent messages to send as context

    let history = [];          // [{role, content, ts}]
    let userId = 'anon';
    let activeId = 'default';
    let storeKey = 'blak_chat_anon';   // = convoKey(activeId)
    let sending = false;
    let controller = null;
    let atBottom = true;

    // ── Conversations (multi-chat history, per-user, in localStorage) ────
    const idxKey   = () => 'blak_convos_' + userId;
    const convoKey = (id) => 'blak_chat_' + userId + '_' + id;
    const newId    = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
    const loadIndex = () => { try { return JSON.parse(localStorage.getItem(idxKey()) || '[]') || []; } catch (e) { return []; } };
    const saveIndex = (arr) => { try { localStorage.setItem(idxKey(), JSON.stringify(arr.slice(0, 100))); } catch (e) {} };
    const titleOf   = (hist) => { const u = (hist || []).find(m => m.role === 'user'); return u ? u.content.slice(0, 42) : 'New chat'; };
    function touchIndex() {
      const arr = loadIndex();
      const existing = arr.find(c => c.id === activeId);
      const rest = arr.filter(c => c.id !== activeId);
      // Preserve a real title once set (first-message fallback, then upgraded to
      // the smart LLM title); only (re)derive while it's still "New chat".
      const title = (existing && existing.title && existing.title !== 'New chat') ? existing.title : titleOf(history);
      rest.unshift({ id: activeId, title, ts: Date.now() });
      saveIndex(rest);
    }
    // Smart thread name: after the first exchange, ask the free Groq title
    // endpoint for a 2–5 word name in the user's language; overwrite the index.
    let titledConvos = {};
    async function maybeTitleConvo() {
      if (titledConvos[activeId]) return;
      if (history.filter(m => m.role === 'user').length !== 1) return; // only after the first user turn
      const id = activeId; titledConvos[id] = true;
      const jwt = await getToken(); if (!jwt) return;
      try {
        const r = await fetch('/api/blaksyd/symp/title', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
          body: JSON.stringify({ messages: history.filter(m => m.role !== 'system').slice(0, 4).map(({ role, content }) => ({ role, content })) }),
        });
        const j = await r.json().catch(() => null);
        const t = j && j.data && j.data.title;
        if (t) {
          const rest = loadIndex().filter(c => c.id !== id);
          rest.unshift({ id, title: t, ts: Date.now() });
          saveIndex(rest);
        }
      } catch (e) { /* keep the first-message fallback title */ }
    }

    const fmtTime = (ts) => { try { return new Date(ts).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); } catch { return ''; } };
    const save = () => { try { localStorage.setItem(storeKey, JSON.stringify(history.slice(-100))); touchIndex(); } catch (e) {} };

    function nearBottom() { return stream.scrollHeight - stream.scrollTop - stream.clientHeight < 80; }
    function scrollToBottom(force) { if (force || atBottom) stream.scrollTop = stream.scrollHeight; }
    stream.addEventListener('scroll', () => { atBottom = nearBottom(); jumpBtn.hidden = atBottom; });
    jumpBtn.addEventListener('click', () => { atBottom = true; stream.scrollTop = stream.scrollHeight; jumpBtn.hidden = true; });

    // Render one message row. Returns handles for live updating (streaming).
    function addRow(side, text, opts = {}) {
      const ts = opts.ts || Date.now();
      const row = document.createElement('div');
      row.className = 'bx-row ' + side + (opts.err ? ' err' : '');
      const av = side === 'them' ? '<span class="bx-av"></span>' : '';
      row.innerHTML = av + '<div class="bx-col"><div class="bx-bub"></div></div>';
      const col = row.querySelector('.bx-col');
      const bub = row.querySelector('.bx-bub');
      if (opts.typing) {
        bub.innerHTML = '<span class="bx-typing"><span class="bx-dot"></span><span class="bx-dot"></span><span class="bx-dot"></span></span>';
      } else {
        bub.textContent = text;
        const time = document.createElement('time');
        time.className = 'bx-time';
        time.textContent = fmtTime(ts);
        col.appendChild(time);
      }
      stream.appendChild(row);
      scrollToBottom(side === 'me');
      return { row, col, bub, ts };
    }

    function stamp(handle) {
      if (handle.col.querySelector('.bx-time')) return;
      const time = document.createElement('time');
      time.className = 'bx-time'; time.textContent = fmtTime(handle.ts);
      handle.col.appendChild(time);
    }

    function render() {
      stream.innerHTML = '';
      for (const m of history) addRow(m.role === 'user' ? 'me' : 'them', m.content, { ts: m.ts });
      attachRegen();
      scrollToBottom(true);
    }

    // A small "regenerate" control under the latest Blak message.
    function attachRegen() {
      stream.querySelectorAll('.bx-regen').forEach(b => b.remove());
      const rows = [...stream.querySelectorAll('.bx-row.them')];
      const last = rows[rows.length - 1];
      if (!last || sending || history.length < 2) return;
      if (history[history.length - 1].role !== 'assistant') return;
      const btn = document.createElement('button');
      btn.className = 'bx-regen';
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 109-9 9 9 0 00-7 3.3M3 4v3.3h3.3"/></svg>regenerate';
      btn.onclick = regenerate;
      last.querySelector('.bx-col').appendChild(btn);
    }

    function updateChips() {
      // Starter prompts only matter before the first real exchange.
      const hasUserMsg = history.some(m => m.role === 'user');
      chips.hidden = hasUserMsg;
    }

    function setBusy(b) {
      sending = b;
      sendBtn.hidden = b; stopBtn.hidden = !b;
      input.disabled = false;
      if (b) { stream.querySelectorAll('.bx-regen').forEach(x => x.remove()); }
      else { attachRegen(); }
    }

    async function getToken() {
      if (!supabase) return null;
      try { return (await supabase.auth.getSession()).data?.session?.access_token || null; }
      catch { return null; }
    }

    function payload() {
      return history.filter(m => m.role === 'user' || m.role === 'assistant')
                    .slice(-MAX_TURNS)
                    .map(({ role, content }) => ({ role, content }));
    }

    // One streaming attempt. Throws on transport error; returns accumulated text.
    async function attempt(typing) {
      controller = new AbortController();
      const jwt = await getToken();
      if (!jwt) { const e = new Error('no_auth'); e.code = 'no_auth'; throw e; }
      const res = await fetch('/api/blaksyd/symp/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
        body: JSON.stringify({ messages: payload(), stream: true }),
        signal: controller.signal,
      });
      if (!res.ok || !res.body) throw new Error('http_' + res.status);
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let acc = '', buf = '';
      typing.bub.textContent = '';
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        const lines = buf.split('\n'); buf = lines.pop() || '';
        for (const line of lines) {
          const t = line.trim();
          if (!t.startsWith('data:')) continue;
          const p = t.slice(5).trim();
          if (!p || p === '[DONE]') continue;
          let obj; try { obj = JSON.parse(p); } catch { continue; }
          if (obj.delta) { acc += obj.delta; typing.bub.textContent = acc; scrollToBottom(); }
          if (obj.error) throw new Error(String(obj.error));
        }
      }
      return acc.trim();
    }

    function showError(typing, srcText) {
      typing.row.classList.add('err');
      typing.bub.textContent = "I lost my train of thought for a second — your message is safe.";
      const retry = document.createElement('button');
      retry.className = 'bx-retry'; retry.textContent = 'Try again';
      retry.onclick = () => { typing.row.remove(); runTurn(srcText); };
      typing.col.appendChild(retry);
      setBusy(false);
    }

    // Drive one assistant turn for the already-appended user message `srcText`.
    async function runTurn(srcText) {
      setBusy(true);
      const typing = addRow('them', '', { typing: true });
      try {
        let acc = '';
        try { acc = await attempt(typing); }
        catch (e) {
          if (e.name === 'AbortError') throw e;
          if (e.code === 'no_auth') {
            typing.bub.textContent = "Sign in first and I'm all yours — log in from the menu and come back.";
            stamp(typing); setBusy(false); return;
          }
          acc = ''; // fall through to one auto-retry
        }
        if (!acc) {
          typing.bub.innerHTML = '<span class="bx-typing"><span class="bx-dot"></span><span class="bx-dot"></span><span class="bx-dot"></span></span>';
          await new Promise(r => setTimeout(r, 700)); // let a rate-limited provider's window breathe before the backstop retry
          acc = await attempt(typing);
        }
        acc = acc.trim();
        typing.bub.textContent = acc || "Mmm — I didn't catch that. Say it once more?";
        stamp(typing);
        history.push({ role: 'assistant', content: acc, ts: typing.ts }); save();
        maybeTitleConvo();
        setBusy(false);
      } catch (e) {
        if (e.name === 'AbortError') {
          const partial = (typing.bub.textContent || '').trim();
          if (partial) { stamp(typing); history.push({ role: 'assistant', content: partial, ts: typing.ts }); save(); }
          else typing.row.remove();
          setBusy(false);
        } else {
          showError(typing, srcText);
        }
      } finally {
        controller = null;
      }
    }

    async function send(text) {
      text = (text || '').trim();
      if (!text || sending) return;
      history.push({ role: 'user', content: text, ts: Date.now() });
      addRow('me', text); save();
      updateChips();
      await runTurn(text);
    }

    function regenerate() {
      if (sending || history.length < 2) return;
      // drop the last assistant turn (history + DOM) and re-ask the prior user msg
      if (history[history.length - 1].role === 'assistant') history.pop();
      const lastThem = [...stream.querySelectorAll('.bx-row.them')].pop();
      if (lastThem) lastThem.remove();
      save();
      const lastUser = [...history].reverse().find(m => m.role === 'user');
      if (lastUser) runTurn(lastUser.content);
    }

    // ── Composer behaviour ───────────────────────────────────────────────
    function autogrow() { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 140) + 'px'; }
    input.addEventListener('input', autogrow);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
    });
    form.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value; input.value = ''; autogrow(); send(v); });
    chips.addEventListener('click', (e) => { const b = e.target.closest('.bx-chip'); if (b) send(b.getAttribute('data-msg')); });
    stopBtn.addEventListener('click', () => { if (controller) controller.abort(); });
    clearBtn.addEventListener('click', () => {
      if (sending && controller) controller.abort();
      history = [{ role: 'assistant', content: GREETING, ts: Date.now() }];
      save(); render(); updateChips(); input.focus();
    });

    // ── Conversation switching + history drawer ──────────────────────────
    function loadConvo(id) {
      activeId = id; storeKey = convoKey(id);
      let saved = null; try { saved = JSON.parse(localStorage.getItem(storeKey) || 'null'); } catch (e) {}
      history = (Array.isArray(saved) && saved.length) ? saved : [{ role: 'assistant', content: GREETING, ts: Date.now() }];
      render(); updateChips();
    }
    function renderConvoList() {
      const arr = loadIndex();
      convoList.innerHTML = '';
      if (!arr.length) { convoList.innerHTML = '<p class="bx-cv-empty">No chats yet</p>'; return; }
      for (const c of arr) {
        const row = document.createElement('div');
        row.className = 'bx-cv-item' + (c.id === activeId ? ' on' : '');
        row.innerHTML = '<button class="bx-cv-open" type="button"></button><button class="bx-cv-del" type="button" aria-label="Delete chat">✕</button>';
        row.querySelector('.bx-cv-open').textContent = c.title || 'New chat';
        row.querySelector('.bx-cv-open').onclick = () => { if (c.id !== activeId) loadConvo(c.id); closeDrawer(); };
        row.querySelector('.bx-cv-del').onclick = (e) => { e.stopPropagation(); deleteConvo(c.id); };
        convoList.appendChild(row);
      }
    }
    function deleteConvo(id) {
      try { localStorage.removeItem(convoKey(id)); } catch (e) {}
      const arr = loadIndex().filter(c => c.id !== id); saveIndex(arr);
      if (id === activeId) { if (arr.length) loadConvo(arr[0].id); else { loadConvo(newId()); save(); } }
      renderConvoList();
    }
    function newConvo() {
      if (sending && controller) controller.abort();
      loadConvo(newId()); save(); closeDrawer(); input.focus();
    }
    function openDrawer() { renderConvoList(); convoDrawer.hidden = false; }
    function closeDrawer() { convoDrawer.hidden = true; }
    if (historyBtn) historyBtn.addEventListener('click', openDrawer);
    if (cvNew) cvNew.addEventListener('click', newConvo);
    if (cvScrim) cvScrim.addEventListener('click', closeDrawer);

    // ── Voice call (HANDS-FREE: in-browser VAD → Whisper → Blak → Sarvam) ─
    // Continuous listening with energy-based voice-activity detection: just talk,
    // it auto-sends when you pause, plays the reply, then listens again — no
    // tapping. Cheap cascaded pipeline (no audio-token S2S). Mic = mute toggle.
    const callBtn = $('bx-call'), callOv = $('bx-call-overlay'), callMic = $('bx-call-mic'),
          callEnd = $('bx-call-end'), callStatus = $('bx-call-status'),
          callCap = $('bx-call-caption'), callLang = $('bx-call-lang');
    let micStream = null, actx = null, analyser = null, vadTimer = null, callSrc = null;
    let callState = 'idle';   // idle | listening | recording | thinking | speaking
    let mrec = null, recChunks = [], speechFrames = 0, silenceFrames = 0, recStartAt = 0, muted = false;
    const escHtml = (s) => { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; };
    const setCall = (cls, status) => { callOv.className = 'bx-call-ov' + (cls ? ' ' + cls : ''); if (status != null) callStatus.textContent = status; };

    const SPEECH_RMS = 0.020, SILENCE_RMS = 0.013, START_FRAMES = 3, SILENCE_END_MS = 1100, FRAME_MS = 60, MAX_UTTER_MS = 14000;

    async function openCall() {
      callOv.hidden = false; callCap.innerHTML = ''; muted = false; callMic.classList.remove('muted');
      try { micStream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true } }); }
      catch (e) { setCall('', 'mic blocked — allow microphone access'); return; }
      try { actx = actx || new (window.AudioContext || window.webkitAudioContext)(); if (actx.state === 'suspended') await actx.resume(); } catch (e) {}
      const src = actx.createMediaStreamSource(micStream);
      analyser = actx.createAnalyser(); analyser.fftSize = 1024; src.connect(analyser);
      startListening(); vadLoop();
    }
    function endCall() {
      callState = 'idle';
      if (vadTimer) { clearTimeout(vadTimer); vadTimer = null; }
      if (mrec && mrec.state !== 'inactive') { try { mrec.stop(); } catch (e) {} }
      if (callSrc) { try { callSrc.stop(); } catch (e) {} callSrc = null; }
      if (micStream) { micStream.getTracks().forEach(t => t.stop()); micStream = null; }
      callOv.hidden = true; setCall('', '');
    }
    function startListening() { callState = 'listening'; speechFrames = 0; silenceFrames = 0; callMic.classList.remove('rec'); setCall('', muted ? 'muted — tap mic to resume' : 'listening… just talk'); }
    function rmsLevel() {
      const buf = new Float32Array(analyser.fftSize); analyser.getFloatTimeDomainData(buf);
      let s = 0; for (let i = 0; i < buf.length; i++) s += buf[i] * buf[i];
      return Math.sqrt(s / buf.length);
    }
    function vadLoop() {
      if (callState === 'idle') return;
      const level = analyser ? rmsLevel() : 0;
      if (!muted && callState === 'listening') {
        if (level > SPEECH_RMS) { if (++speechFrames >= START_FRAMES) beginRec(); } else speechFrames = 0;
      } else if (callState === 'recording') {
        if (level < SILENCE_RMS) { if (++silenceFrames * FRAME_MS >= SILENCE_END_MS) finishRec(); } else silenceFrames = 0;
        if (Date.now() - recStartAt > MAX_UTTER_MS) finishRec();
      } else if (callState === 'speaking') {
        if (!muted && level > SPEECH_RMS) { if (callSrc) { try { callSrc.stop(); } catch (e) {} callSrc = null; } beginRec(); } // barge-in
      }
      vadTimer = setTimeout(vadLoop, FRAME_MS);
    }
    function beginRec() {
      if (!micStream) return;
      callState = 'recording'; silenceFrames = 0; recStartAt = Date.now(); recChunks = [];
      const mime = (window.MediaRecorder && MediaRecorder.isTypeSupported('audio/webm')) ? 'audio/webm' : '';
      mrec = new MediaRecorder(micStream, mime ? { mimeType: mime } : undefined);
      mrec.ondataavailable = (e) => { if (e.data && e.data.size) recChunks.push(e.data); };
      mrec.start(); callMic.classList.add('rec'); setCall('listening', 'listening…');
    }
    function finishRec() {
      if (callState !== 'recording') return;
      callState = 'thinking'; callMic.classList.remove('rec'); setCall('', 'thinking…');
      const mime = mrec ? (mrec.mimeType || 'audio/webm') : 'audio/webm';
      if (mrec && mrec.state !== 'inactive') { mrec.onstop = () => sendTurn(mime); try { mrec.stop(); } catch (e) { sendTurn(mime); } }
      else sendTurn(mime);
    }
    function blobB64(blob) { return new Promise(r => { const fr = new FileReader(); fr.onloadend = () => r(String(fr.result).split(',')[1]); fr.readAsDataURL(blob); }); }
    async function playChunks(arr) {
      if (!arr || !arr.length || !actx) return;
      for (const b64 of arr) {
        if (callState !== 'speaking') return;        // barge-in interrupted us
        let buf; try { buf = await actx.decodeAudioData(Uint8Array.from(atob(b64), c => c.charCodeAt(0)).buffer); } catch (e) { continue; }
        await new Promise(r => { const s = actx.createBufferSource(); s.buffer = buf; s.connect(actx.destination); callSrc = s; s.onended = r; s.start(); });
      }
    }
    async function sendTurn(mimetype) {
      try {
        const blob = new Blob(recChunks, { type: mimetype });
        if (blob.size < 1400) { startListening(); return; }   // too short → ignore noise blip
        const audio = await blobB64(blob);
        const jwt = await getToken();
        if (!jwt) { setCall('', 'sign in first to call'); return; }
        const body = { audio, mimetype };
        if (callLang.value && callLang.value !== 'auto') body.lane = callLang.value;
        const res = await fetch('/api/blaksyd/symp/voice', { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt }, body: JSON.stringify(body) });
        const j = await res.json().catch(() => null);
        if (!j || !j.ok) { startListening(); return; }
        const { transcript, reply, audio: out } = j.data;
        callCap.innerHTML = '<p class="cc-you">' + escHtml(transcript) + '</p><p class="cc-blak">' + escHtml(reply) + '</p>';
        callState = 'speaking'; setCall('speaking', 'speaking…');
        await playChunks(out);
        if (callState === 'speaking') startListening();   // resume unless barge-in changed state
      } catch (e) { startListening(); }
    }
    if (callBtn) callBtn.addEventListener('click', openCall);
    if (callEnd) callEnd.addEventListener('click', endCall);
    if (callMic) callMic.addEventListener('click', () => {   // mute / unmute
      muted = !muted; callMic.classList.toggle('muted', muted);
      if (muted) { if (mrec && mrec.state !== 'inactive') { try { mrec.stop(); } catch (e) {} } if (callSrc) { try { callSrc.stop(); } catch (e) {} } }
      startListening();
    });

    // ── Proactive opener: Blak reaches out first, aware of the user ──────
    async function maybeProactiveOpener() {
      if (history.length > 1) return;           // only on a fresh conversation
      const jwt = await getToken(); if (!jwt) return;
      try {
        const r = await fetch('/api/blaksyd/symp/proactive-checkin', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
          body: JSON.stringify({ trigger: 'app_open' }),
        });
        const j = await r.json().catch(() => null);
        const msg = j && j.data && j.data.message;
        if (msg && history.length <= 1) {
          history = [{ role: 'assistant', content: msg, ts: Date.now() }];
          save(); render(); updateChips();
        }
      } catch (e) { /* fall back to the static greeting already shown */ }
    }

    // ── Boot: restore this user's conversation (or greet) ────────────────
    (async () => {
      try { const u = (await supabase?.auth.getUser())?.data?.user; if (u?.id) userId = u.id; } catch (e) {}
      let idx = loadIndex();
      if (!idx.length) {
        // First run for this user — migrate any legacy single-thread store.
        const id = newId();
        let legacy = null; try { legacy = JSON.parse(localStorage.getItem('blak_chat_' + userId) || 'null'); } catch (e) {}
        if (Array.isArray(legacy) && legacy.length) { try { localStorage.setItem(convoKey(id), JSON.stringify(legacy)); } catch (e) {} }
        saveIndex([{ id, title: titleOf(Array.isArray(legacy) ? legacy : []), ts: Date.now() }]);
        idx = loadIndex();
      }
      loadConvo(idx[0].id);
      save();
      maybeProactiveOpener();
    })();
  </script>
</AppLayout>
