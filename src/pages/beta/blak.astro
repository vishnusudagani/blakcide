---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout active="blak" title="Blak">
  <div class="bx">
    <header class="bx-head">
      <button type="button" class="bx-icon" id="bx-burger" aria-label="Chats & menu" title="Chats & menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <button type="button" class="bx-icon" id="bx-persona" aria-label="Personas" title="Personas">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.1"/><path d="M3.6 19a5.4 5.4 0 0 1 10.8 0"/><path d="M16 6.6a3 3 0 0 1 0 5.4M18.6 19a5.2 5.2 0 0 0-3-4.8"/></svg>
      </button>
      <div class="bx-head-actions">
        <button type="button" class="bx-avatar" id="bx-profile" aria-label="Your profile" title="Your profile">Y</button>
      </div>
    </header>

    <div class="bx-stream" id="bx-stream" aria-live="polite"></div>

    <!-- Resting / home state — shown (via pure CSS) only when #bx-stream is empty -->
    <div class="bx-home" id="bx-home">
      <div class="bx-hero">
        <span class="bx-hero-mark"><span class="bx-hero-spark">✦</span></span>
        <h1 class="bx-greet" id="bx-greet">Hey there</h1>
        <p class="bx-greet-sub" id="bx-greet-sub">what's on your mind?</p>
      </div>

      <div class="bx-nudges" id="bx-nudges" hidden data-noswipe></div>

      <a class="bx-insight-card" id="bx-insight" href="/beta/profile/">
        <span class="bx-insight-ic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12a4 4 0 100-8 4 4 0 000 8zM5 20a7 7 0 0114 0"/></svg>
        </span>
        <span class="bx-insight-tx">
          <b id="bx-insight-title">Blak is getting to know you</b>
          <i id="bx-insight-sub">the more you talk, the more it learns →</i>
        </span>
      </a>

      <div class="bx-reminders" id="bx-reminders" hidden data-noswipe></div>

      <div class="bx-mood" id="bx-mood">
        <span class="bx-mood-q">How are you feeling today?</span>
        <div class="bx-mood-row" data-noswipe>
          <button type="button" class="bx-mood-b" data-mood="great" aria-label="Great">😄</button>
          <button type="button" class="bx-mood-b" data-mood="okay" aria-label="Okay">🙂</button>
          <button type="button" class="bx-mood-b" data-mood="low" aria-label="Low">😔</button>
          <button type="button" class="bx-mood-b" data-mood="anxious" aria-label="Anxious">😰</button>
          <button type="button" class="bx-mood-b" data-mood="angry" aria-label="Frustrated">😤</button>
        </div>
      </div>

      <div class="bx-chips" id="bx-chips" data-noswipe>
        <button type="button" class="bx-chip" data-msg="I'm overwhelmed">I'm overwhelmed</button>
        <button type="button" class="bx-chip" data-msg="Help me focus">Help me focus</button>
        <button type="button" class="bx-chip" data-msg="Plan my day">Plan my day</button>
      </div>
    </div>

    <button type="button" class="bx-jump" id="bx-jump" aria-label="Jump to latest" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
    </button>

    <div class="bx-dock">
      <div class="bx-add-menu" id="bx-add-menu" hidden data-noswipe>
        <button type="button" id="bx-add-photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg> Photo</button>
        <button type="button" id="bx-add-group"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg> New group with Blak</button>
        <button type="button" id="bx-add-incognito"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 4.2A9 9 0 0 1 12 4c5 0 9 4.5 9 8a12 12 0 0 1-2 3M6.6 6.6A12.4 12.4 0 0 0 3 12c0 3.5 4 8 9 8a9 9 0 0 0 4-1M1 1l22 22"/></svg> Incognito chat</button>
        <button type="button" id="bx-add-summary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg> Summarize this chat</button>
        <button type="button" id="bx-add-doc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg> Document / PDF</button>
        <button type="button" id="bx-add-export"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M8 11l4 4 4-4M5 21h14"/></svg> Export this chat</button>
      </div>
      <div class="bx-edit-pill" id="bx-edit-pill" hidden data-noswipe>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
        <span>Editing your message — Blak will reply again</span>
        <button type="button" id="bx-edit-cancel" aria-label="Cancel edit">✕</button>
      </div>
      <div class="bx-incog-pill" id="bx-incog-pill" hidden data-noswipe>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 4.2A9 9 0 0 1 12 4c5 0 9 4.5 9 8a12 12 0 0 1-2 3M6.6 6.6A12.4 12.4 0 0 0 3 12c0 3.5 4 8 9 8a9 9 0 0 0 4-1M1 1l22 22"/></svg>
        <span>Incognito — this chat isn't saved or learned from</span>
        <button type="button" id="bx-incog-exit" aria-label="Exit incognito">Exit</button>
      </div>
      <div class="bx-attach-preview" id="bx-attach-preview" hidden data-noswipe></div>
      <div class="bx-vn" id="bx-vn" hidden data-noswipe></div>
      <form class="bx-composer" id="bx-form">
        <div class="bx-field">
          <button type="button" class="bx-add" id="bx-add" aria-label="Add an image" title="Add an image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          </button>
          <input type="file" id="bx-file" accept="image/*" hidden />
          <input type="file" id="bx-doc-file" accept=".pdf,.txt,.md,.markdown,.csv,.json,.log,.rtf,text/*,application/pdf" hidden />
          <textarea id="bx-input" rows="1" placeholder="Message Blak…" autocomplete="off"></textarea>
          <button type="button" class="bx-act" id="bx-send" aria-label="Send or record a voice note">
            <svg class="bx-ic-mic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
            <svg class="bx-ic-send" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <button type="button" id="bx-stop" aria-label="Stop" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="7" width="10" height="10" rx="2"/></svg>
          </button>
        </div>
        <button type="button" class="bx-call" id="bx-call" title="Voice call with Blak" aria-label="Voice call with Blak">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </button>
      </form>
    </div>

    <!-- Voice call (turn-based: tap-to-talk) -->
    <div class="bx-call-ov" id="bx-call-overlay" hidden>
      <div class="bx-call-bar">
        <select class="bx-call-lang" id="bx-call-lang" aria-label="Call language">
          <option value="auto">Auto detect</option><option value="en">English</option><option value="hi">हिन्दी</option><option value="te">తెలుగు</option><option value="ta">தமிழ்</option><option value="kn">ಕನ್ನಡ</option><option value="ml">മലയാളം</option><option value="bn">বাংলা</option><option value="mr">मराठी</option><option value="gu">ગુજરાતી</option><option value="pa">ਪੰਜਾਬੀ</option>
        </select>
        <button type="button" class="bx-call-end" id="bx-call-end">End call</button>
      </div>
      <div class="bx-call-stage">
        <div class="bx-call-orb" id="bx-call-orb"></div>
        <p class="bx-call-status" id="bx-call-status">starting…</p>
        <div class="bx-call-cap" id="bx-call-caption"></div>
      </div>
      <button type="button" class="bx-call-mic" id="bx-call-mic" aria-label="Mute microphone" title="Mute">
        <svg class="bx-ic-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
        <svg class="bx-ic-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l22 22"/><path d="M9 9v3a3 3 0 0 0 5.1 2.1M15 9.3V4a3 3 0 0 0-5.9-.6"/><path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.1 1.2"/><path d="M12 19v4"/></svg>
      </button>
      <p class="bx-call-hint" id="bx-call-hint">just talk — Blak is listening</p>
    </div>

    <!-- Chat history drawer -->
    <div class="bx-cv-drawer" id="bx-convos" hidden>
      <div class="bx-cv-scrim" id="bx-cv-scrim"></div>
      <aside class="bx-cv-panel">
        <div class="bx-cv-head"><b>Your chats</b><button type="button" class="bx-cv-new" id="bx-cv-new">＋ New chat</button></div>
        <input type="search" class="bx-cv-search" id="bx-cv-search" placeholder="Search your chats…" autocomplete="off" />
        <div class="bx-cv-list" id="bx-cv-list"></div>
        <div class="bx-cv-foot">
          <a class="bx-cv-foot-link" href="/beta/">Home</a>
          <a class="bx-cv-foot-link" href="/beta/account/">Your profile</a>
          <button type="button" class="bx-cv-foot-link" id="bx-cv-theme">Theme</button>
          <button type="button" class="bx-cv-foot-link" id="bx-cv-signout">Sign out</button>
        </div>
      </aside>
    </div>

    <!-- Thread summary — slides up -->
    <div class="bx-sum" id="bx-sum" hidden data-noswipe>
      <div class="bx-sum-scrim" id="bx-sum-scrim"></div>
      <div class="bx-sum-sheet" role="dialog" aria-label="Chat recap">
        <div class="bx-sum-grip"></div>
        <div class="bx-sum-head"><b id="bx-sum-title">Recap</b><button type="button" class="bx-sum-x" id="bx-sum-x" aria-label="Close">✕</button></div>
        <div class="bx-sum-body" id="bx-sum-body"></div>
      </div>
    </div>
  </div>

  <style is:global>
    .bx { display: flex; flex-direction: column; height: calc(100svh - 0px); max-width: 760px; margin-inline: auto; padding: 0 clamp(.9rem, 3vw, 1.5rem); position: relative; }
    @media (max-width: 820px) { .bx { height: calc(100svh - 138px - env(safe-area-inset-bottom, 0px)); } html.bx-kb .bx { height: var(--vvh, calc(100svh - 138px)); } }

    /* ── Header (minimal) ── */
    .bx-head { display: flex; align-items: center; gap: .6rem; padding: 1rem .2rem .8rem; }
    .bx-orb { position: relative; width: 30px; height: 30px; border-radius: 50%; flex: none; display: grid; place-items: center; background: var(--cta-grad); box-shadow: 0 0 14px rgba(255,107,157,.4); animation: bx-breathe 5s ease-in-out infinite; }
    .bx-orb-spark { font-size: 11px; line-height: 1; color: #fff; opacity: .92; }
    @keyframes bx-breathe { 0%,100%{transform:scale(1)} 50%{transform:scale(1.07)} }
    .bx-who { display: flex; flex-direction: column; line-height: 1.2; }
    .bx-who b { font-size: var(--fs-lg); font-weight: 650; letter-spacing: -.01em; }
    .bx-who i { font-style: normal; font-size: var(--fs-xs); color: var(--ink-faint); display: inline-flex; align-items: center; gap: .35rem; }
    .bx-live { width: 6px; height: 6px; border-radius: 50%; background: var(--mint-deep); box-shadow: 0 0 8px var(--mint-deep); animation: bx-pulse 2.4s ease-in-out infinite; }
    @keyframes bx-pulse { 0%,100%{opacity:1} 50%{opacity:.45} }
    .bx-head-actions { margin-left: auto; display: flex; align-items: center; gap: .55rem; }
    .bx-human { font-size: var(--fs-xs); color: var(--mint); text-decoration: none; border: 1px solid rgba(106,211,184,.3); border-radius: var(--r-pill); padding: .35rem .75rem; transition: .18s var(--ease-out); white-space: nowrap; }
    .bx-human:hover { background: rgba(106,211,184,.12); border-color: var(--mint-deep); }
    .bx-hist { width: 36px; height: 36px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--ink-faint); background: var(--surface); border: 1px solid var(--line); cursor: pointer; transition: .18s var(--ease-out); }
    .bx-hist:hover { color: var(--ink); border-color: var(--line-strong); background: var(--surface-strong); }
    .bx-hist svg { width: 17px; height: 17px; }
    html[data-theme="light"] .bx-human { color: var(--mint-ink); }

    /* ── Conversation stream ── */
    .bx-stream { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: .7rem; padding: 1rem .2rem 1.4rem; scrollbar-width: thin; scroll-behavior: smooth; }
    .bx-stream:empty { display: none; }                                   /* no messages → collapse, home shows */
    .bx-stream:not(:empty) ~ .bx-home { display: none; }                  /* messages exist → hide the home hero */
    .bx-row { display: flex; align-items: flex-end; gap: .5rem; max-width: 84%; animation: bx-in .28s var(--ease-out) both; }
    .bx-row.them { align-self: flex-start; } .bx-row.me { align-self: flex-end; flex-direction: row-reverse; }
    @keyframes bx-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    .bx-av { position: relative; width: 26px; height: 26px; border-radius: 50%; flex: none; background: var(--cta-grad); box-shadow: 0 0 10px rgba(255,107,157,.4); }
    .bx-col { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .bx-row.me .bx-col { align-items: flex-end; }
    .bx-bub { padding: .72rem .98rem; border-radius: var(--r-md); font-size: var(--fs-base); line-height: 1.55; white-space: pre-wrap; word-wrap: break-word; overflow-wrap: anywhere; }
    .bx-bub ul.bx-md, .bx-bub ol.bx-md { margin: .3rem 0 .15rem; padding-left: 1.3rem; }
    .bx-bub ul.bx-md li, .bx-bub ol.bx-md li { margin: .12rem 0; }
    .bx-bub code { font-family: var(--font-mono); font-size: .88em; background: var(--surface-strong); padding: .05em .35em; border-radius: 5px; }
    .bx-bub strong { font-weight: 700; }
    .bx-vn-cap { margin: .4rem 0 0; font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.45; font-style: italic; }
    .bx-doc { display: inline-flex; align-items: center; gap: .5rem; color: var(--ink); }
    .bx-doc svg { width: 22px; height: 22px; color: var(--coral); flex: none; }
    .bx-doc-nm { font-size: var(--fs-sm); font-weight: 600; word-break: break-word; }
    .bx-calloffer { margin-top: .45rem; display: inline-flex; align-items: center; gap: .45rem; border: none; border-radius: var(--r-pill); padding: .5rem 1rem; font: inherit; font-size: var(--fs-sm); font-weight: 700; cursor: pointer; background: var(--cta); color: var(--cta-ink); box-shadow: var(--shadow-cta); transition: transform .15s var(--ease-out); }
    .bx-calloffer svg { width: 16px; height: 16px; }
    .bx-calloffer:active { transform: scale(.96); }
    .bx-calloffer:disabled { opacity: .6; cursor: default; }
    .bx-call-turn .bx-bub::after { content: ' 📞'; font-size: .78em; opacity: .4; }
    .bx-row.them .bx-bub { background: var(--surface-strong); border: 1px solid var(--line); border-bottom-left-radius: 6px; color: var(--ink); }
    .bx-row.me .bx-bub { background: rgba(91,192,255,.14); border: 1px solid rgba(91,192,255,.26); border-bottom-right-radius: 6px; color: var(--ink); }
    html[data-theme="light"] .bx-row.me .bx-bub { background: rgba(24,114,176,.1); border-color: rgba(24,114,176,.22); }
    .bx-time { font-family: var(--font-mono); font-size: var(--fs-3xs); color: var(--ink-faint); padding: 0 .35rem; opacity: .8; }
    .bx-meta { display: flex; gap: .6rem; align-items: center; padding: 0 .35rem; }
    .bx-regen { font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .04em; color: var(--ink-faint); background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; gap: .25rem; padding: 0; transition: color .18s; }
    .bx-regen:hover { color: var(--coral); }
    .bx-regen svg { width: 12px; height: 12px; }
    .bx-meta .bx-time { padding: 0; }
    .bx-copy { color: var(--ink-faint); background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; padding: 0; transition: color .18s; -webkit-tap-highlight-color: transparent; }
    .bx-copy:hover { color: var(--coral); }
    .bx-copy.done { color: var(--mint, #6fcf97); }
    .bx-copy svg { width: 13px; height: 13px; display: block; }
    .bx-edit { color: var(--ink-faint); background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; padding: 0; transition: color .18s; -webkit-tap-highlight-color: transparent; }
    .bx-edit:hover { color: var(--coral); }
    .bx-edit svg { width: 13px; height: 13px; display: block; }
    .bx-edit-pill { display: flex; align-items: center; gap: .5rem; margin: 0 6px 6px; padding: .45rem .7rem; border-radius: 12px; background: rgba(255,107,157,.1); border: 1px solid rgba(255,107,157,.28); color: var(--ink-soft); font-size: var(--fs-xs); animation: bx-in .15s var(--ease-out) both; }
    .bx-edit-pill[hidden] { display: none; }
    .bx-edit-pill svg { width: 14px; height: 14px; color: var(--coral); flex: none; }
    .bx-edit-pill span { flex: 1; min-width: 0; }
    .bx-edit-pill button { background: none; border: 0; color: var(--ink-faint); cursor: pointer; font-size: .95rem; padding: 0 .2rem; min-width: 28px; }
    .bx-edit-pill button:hover { color: var(--coral); }
    .bx-incog-pill { display: flex; align-items: center; gap: .5rem; margin: 0 6px 6px; padding: .45rem .7rem; border-radius: 12px; background: var(--surface-strong); border: 1px solid var(--line-strong); color: var(--ink-soft); font-size: var(--fs-xs); }
    .bx-incog-pill[hidden] { display: none; }
    .bx-incog-pill svg { width: 14px; height: 14px; flex: none; }
    .bx-incog-pill span { flex: 1; min-width: 0; }
    .bx-incog-pill button { background: none; border: 1px solid var(--line-strong); color: var(--ink-soft); border-radius: var(--r-pill); cursor: pointer; font: inherit; font-size: var(--fs-2xs); padding: .2rem .65rem; }
    .bx-incog-pill button:hover { color: var(--ink); border-color: var(--ink-faint); }
    .bx-speak { color: var(--ink-faint); background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; padding: 0; transition: color .18s; -webkit-tap-highlight-color: transparent; }
    .bx-speak:hover { color: var(--coral); }
    .bx-speak.playing { color: var(--coral); }
    .bx-speak svg { width: 14px; height: 14px; display: block; }
    .bx-speak.loading svg { animation: bx-spin .8s linear infinite; }
    @keyframes bx-spin { to { transform: rotate(360deg); } }
    .bx-retry { margin-top: .4rem; align-self: flex-start; font-family: inherit; font-size: var(--fs-sm); color: var(--coral); background: rgba(255,107,157,.1); border: 1px solid rgba(255,107,157,.3); border-radius: var(--r-pill); padding: .35rem .8rem; cursor: pointer; transition: .18s; }
    .bx-retry:hover { background: rgba(255,107,157,.18); }
    .bx-row.err .bx-bub { color: var(--ink-soft); background: var(--surface); border-color: var(--line-strong); }

    .bx-typing { display: inline-flex; gap: 4px; padding: .1rem 0; } .bx-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--coral); animation: bx-blink 1.2s infinite; } .bx-dot:nth-child(2){animation-delay:.18s} .bx-dot:nth-child(3){animation-delay:.36s}
    @keyframes bx-blink { 0%,100%{opacity:.3; transform: translateY(0)} 50%{opacity:1; transform: translateY(-2px)} }

    .bx-jump { position: absolute; right: clamp(1rem, 4vw, 2rem); bottom: 180px; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-strong); background: var(--surface-strong); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); color: var(--ink); cursor: pointer; box-shadow: var(--shadow-soft); z-index: 4; animation: bx-in .2s var(--ease-out) both; }
    .bx-jump svg { width: 18px; height: 18px; }
    .bx-jump[hidden] { display: none; }

    /* ── Resting / home state (presence hero) ── */
    .bx-home { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: clamp(1.1rem, 3.5vh, 1.8rem); text-align: center; padding: clamp(1rem, 4vh, 2rem) .2rem 1.4rem; animation: bx-in .4s var(--ease-out) both; }
    .bx-home[hidden] { display: none; }

    .bx-tag { display: inline-flex; align-items: center; gap: .4rem; font-size: var(--fs-xs); font-weight: 550; letter-spacing: .01em; padding: .38rem .9rem; border-radius: var(--r-pill); color: var(--ink-soft); background: var(--glass); border: 1px solid var(--line-strong); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
    .bx-tag-spark { background: var(--accent-grad); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; font-size: .9em; }

    /* insights card — glassy, glowing gradient border + outer glow */
    .bx-insights { width: 100%; max-width: 420px; border: 1px solid transparent; border-radius: var(--r-lg); background: linear-gradient(var(--glass-strong), var(--glass-strong)) padding-box, var(--line-grad) border-box; box-shadow: 0 0 38px -8px rgba(255,182,138,.32), var(--shadow-soft); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); overflow: hidden; }
    .bx-insight { display: flex; align-items: center; gap: .85rem; text-align: left; padding: 1rem 1.1rem; }
    .bx-insight + .bx-insight { border-top: 1px solid var(--line); }
    .bx-insight-ic { flex: none; width: 38px; height: 38px; border-radius: var(--r-sm); display: grid; place-items: center; }
    .bx-insight-ic svg { width: 20px; height: 20px; }
    .bx-insight-why { display: block; font-style: normal; font-size: var(--fs-xs); color: var(--coral); margin-top: .4rem; line-height: 1.45; animation: bx-in .2s var(--ease-out) both; }
    html[data-theme="light"] .bx-insight-why { color: var(--coral-ink); }
    .bx-mood { width: 100%; max-width: 420px; display: flex; flex-direction: column; align-items: center; gap: .7rem; }
    .bx-mood-q { font-size: var(--fs-sm); color: var(--ink-soft); transition: color var(--t-base) var(--ease-out); }
    .bx-mood-done .bx-mood-q { color: var(--coral); }
    html[data-theme="light"] .bx-mood-done .bx-mood-q { color: var(--coral-ink); }
    .bx-mood-row { display: flex; gap: .5rem; }
    .bx-mood-b { width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--line-strong); background: var(--surface); font-size: 1.45rem; line-height: 1; cursor: pointer; display: grid; place-items: center; transition: transform var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out); }
    .bx-mood-b:hover { transform: translateY(-2px); }
    .bx-mood-b.on { border-color: var(--coral); background: rgba(255,107,157,.14); transform: translateY(-2px); }
    .bx-insight-ic.ic-mint { color: var(--mint-deep); background: rgba(106,211,184,.14); border: 1px solid rgba(106,211,184,.26); }
    .bx-insight-ic.ic-coral { color: var(--coral); background: rgba(255,107,157,.13); border: 1px solid rgba(255,107,157,.26); }
    html[data-theme="light"] .bx-insight-ic.ic-mint { color: var(--mint-ink); }
    html[data-theme="light"] .bx-insight-ic.ic-coral { color: var(--coral-ink); }
    .bx-insight-tx { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .bx-insight-tx b { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
    .bx-insight-tx i { font-style: normal; font-size: var(--fs-xs); color: var(--ink-faint); line-height: 1.45; }

    /* central presence orb */
    .bx-presence { display: grid; place-items: center; padding: .4rem 0 .2rem; }
    .bx-presence-orb { position: relative; width: clamp(116px, 32vw, 136px); aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; background: var(--cta-grad); box-shadow: 0 0 60px -4px rgba(255,107,157,.5), 0 0 120px -20px rgba(255,210,122,.4), inset 0 2px 14px rgba(255,255,255,.35); animation: bx-breathe 4.5s ease-in-out infinite; }
    .bx-presence-spark { font-size: 30px; line-height: 1; color: #fff; opacity: .95; filter: drop-shadow(0 1px 6px rgba(255,255,255,.5)); }

    /* quick-prompt pills */
    .bx-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; transition: opacity .25s var(--ease-out); }
    .bx-chips[hidden] { display: none; }
    .bx-chip { font-family: inherit; font-size: var(--fs-sm); color: var(--ink-soft); background: var(--glass); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .5rem .95rem; cursor: pointer; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); transition: .18s var(--ease-out); }
    .bx-chip:hover { color: var(--ink); border-color: var(--coral); transform: translateY(-1px); }
    .bx-chip:active { transform: translateY(0); }

    /* ── Composer dock ── */
    .bx-dock { position: relative; padding-bottom: .5rem; }
    .bx-add-menu { position: absolute; left: 6px; bottom: 58px; z-index: 6; display: flex; flex-direction: column; gap: 2px; padding: 5px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-soft, 0 8px 30px rgba(0,0,0,.18)); animation: bx-in .15s var(--ease-out) both; }
    .bx-add-menu[hidden] { display: none; }
    .bx-add-menu button { display: flex; align-items: center; gap: .55rem; background: none; border: none; color: var(--ink); font: inherit; font-size: var(--fs-sm); font-weight: 600; padding: .55rem .7rem; border-radius: 10px; cursor: pointer; white-space: nowrap; text-align: left; }
    .bx-add-menu button:hover { background: var(--surface-strong); }
    .bx-add-menu svg { width: 18px; height: 18px; color: var(--coral); flex: none; }
    /* Outward brand aura: the colour pools behind the bar and rises ~42% up the
       empty space above it (soft, breathing; brighter on focus/send). It lives
       BEHIND the bar — the bar interior stays clean glass. */
    .bx-dock::before {
      content: ''; position: absolute; z-index: -1; pointer-events: none;
      left: 50%; bottom: 0; transform: translateX(-50%); transform-origin: 50% 100%;
      width: min(760px, 106%); height: 42vh;
      background: radial-gradient(ellipse 64% 56% at 50% 93%,
        rgba(255, 107, 157, .24), rgba(255, 210, 122, .15) 38%, rgba(201, 184, 255, .13) 62%, transparent 80%);
      filter: blur(46px); opacity: .85;
      transition: opacity .85s var(--ease-out), transform .9s var(--ease-spring), filter .85s var(--ease-out);
    }
    .bx-dock:focus-within::before { opacity: 1; }
    .bx-dock:has(.bx-composer.bx-sending)::before { opacity: 1; }
    /* DARK MODE: the colour is CAPTURED into the bar — the aura collapses inward
       and the bar itself lights up. Toggling back to light RELEASES it outward. */
    html[data-theme="dark"] .bx-dock::before { transform: translateX(-50%) scale(.26); opacity: .34; filter: blur(26px); }
    html[data-theme="dark"] .bx-field { box-shadow: 0 0 22px -2px rgba(255,107,157,.5), 0 0 48px -12px rgba(255,210,122,.42), 0 0 34px -10px rgba(201,184,255,.4); }
    .bx-composer { display: flex; gap: .55rem; padding: 0 .1rem .45rem; align-items: flex-end; }
    /* glowing rounded field wrapping the textarea + trailing send/stop */
    /* Clean glass interior + a thin brand-gradient edge. The colour is NOT inside
       the bar — it radiates outward from it via the aura on .bx-dock below. */
    .bx-field { position: relative; flex: 1; min-width: 0; min-height: 50px; display: flex; align-items: center; gap: .25rem; padding: .2rem .35rem .2rem .25rem; border: 1px solid transparent; border-radius: var(--r-pill); background: linear-gradient(var(--glass-strong), var(--glass-strong)) padding-box, var(--line-grad) border-box; -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); transition: box-shadow .85s var(--ease-out), border-color .85s var(--ease-out); }
    .bx-field textarea { flex: 1; min-width: 0; resize: none; max-height: 140px; padding: .5rem .4rem .5rem .9rem; background: transparent; border: 0; color: var(--ink); font: inherit; font-size: var(--fs-lg); line-height: 1.4; }
    .bx-field textarea:focus { outline: none; }
    .bx-field button { flex: none; width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer; color: var(--cta-ink); background: var(--cta); box-shadow: var(--shadow-cta); display: grid; place-items: center; transition: transform .16s var(--ease-out), opacity .16s; }
    .bx-field button:hover { transform: scale(1.06); } .bx-field button:active { transform: scale(.94); }
    .bx-field button[hidden] { display: none; }
    .bx-field button svg { width: 19px; height: 19px; }
    #bx-stop { background: var(--surface-strong); color: var(--ink); border: 1px solid var(--line-strong); box-shadow: none; }

    /* composer tools (attach image + voice note) — quiet, leading the field */
    .bx-field .bx-tool { flex: none; width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer; color: var(--ink-faint); background: transparent; box-shadow: none; display: grid; place-items: center; align-self: flex-end; transition: color .16s var(--ease-out), background .16s; }
    .bx-field .bx-tool:hover { color: var(--coral); background: var(--surface); transform: none; }
    .bx-field .bx-tool svg { width: 18px; height: 18px; }
    .bx-field .bx-tool.rec { color: #fff; background: #ff6b6b; box-shadow: none; animation: bx-callpulse 1.2s ease-in-out infinite; }
    .bx-field .bx-tool.busy { opacity: .5; pointer-events: none; }
    .bx-attach-preview { display: flex; align-items: center; gap: .6rem; padding: .2rem .2rem .5rem; }
    .bx-attach-preview[hidden] { display: none; }
    .bx-attach-preview img { width: 56px; height: 56px; object-fit: cover; border-radius: var(--r-sm); border: 1px solid var(--line-strong); }
    .bx-attach-x { font: inherit; font-size: var(--fs-sm); color: var(--ink-faint); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-pill); padding: .25rem .7rem; cursor: pointer; }
    .bx-attach-x:hover { color: var(--coral); }
    .bx-img { max-width: 240px; max-height: 240px; border-radius: var(--r-sm); display: block; margin-bottom: .35rem; }
    .bx-bub .bx-img + span { display: block; }

    /* composer: + (add) on the left + a transparent button that is a mic when
       empty and morphs into Send once text is typed (WhatsApp/Gemini pattern) */
    .bx-field .bx-add { background: transparent !important; box-shadow: none !important; width: 40px; height: 40px; color: var(--ink-faint); align-self: center; }
    .bx-field .bx-add:hover { color: var(--coral); background: var(--surface) !important; transform: none; }
    .bx-field .bx-add svg { width: 21px; height: 21px; }
    .bx-field .bx-act { background: transparent !important; box-shadow: none !important; color: var(--coral); align-self: center; }
    .bx-field .bx-act svg { width: 23px; height: 23px; }
    .bx-act .bx-ic-send { display: none; }
    .bx-act .bx-ic-mic  { display: block; color: var(--ink-soft); }
    .bx-composer.has-text .bx-act .bx-ic-mic  { display: none; }
    .bx-composer.has-text .bx-act .bx-ic-send { display: block; color: var(--coral); }
    .bx-field .bx-act.rec { color: #ff6b6b; }
    .bx-field .bx-act.rec .bx-ic-mic { color: #ff6b6b; animation: bx-callpulse 1.2s ease-in-out infinite; }
    .bx-act { touch-action: none; -webkit-user-select: none; user-select: none; }
    /* Voice-note bar: status while recording, then a play/delete/send preview */
    .bx-composer.bx-vn-active { display: none; }
    .bx-vn { display: flex; align-items: center; gap: .55rem; padding: .5rem .7rem; margin: 0 .2rem .4rem;
             background: var(--surface-strong); border: 1px solid var(--line); border-radius: var(--r-pill); }
    .bx-vn .bx-vn-dot { width: 11px; height: 11px; border-radius: 50%; background: #ff5b5b; flex: none; animation: bx-callpulse 1.1s ease-in-out infinite; }
    .bx-vn .bx-vn-time { font-size: var(--fs-sm); color: var(--ink); font-variant-numeric: tabular-nums; min-width: 2.6em; }
    .bx-vn .bx-vn-hint { font-size: var(--fs-xs); color: var(--ink-faint); margin-left: auto; }
    .bx-vn button { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: none; cursor: pointer; flex: none; background: transparent; color: var(--ink-soft); }
    .bx-vn button svg { width: 21px; height: 21px; }
    .bx-vn .bx-vn-play { background: var(--surface); color: var(--ink); }
    .bx-vn .bx-vn-del { color: #ff6b6b; }
    .bx-vn .bx-vn-send { background: var(--coral); color: #fff; margin-left: auto; }
    .bx-vn .bx-vn-audio { display: none; }
    .bx-bub .bx-audio { display: block; width: 230px; max-width: 58vw; height: 40px; margin: 2px 0; }

    /* circular call (teal/mint glow) + new-chat (coral glow) buttons */
    .bx-call, .bx-clear { flex: none; width: 50px; height: 50px; border-radius: 50%; display: grid; place-items: center; border: 1px solid transparent; cursor: pointer; transition: transform .16s var(--ease-out), box-shadow .2s var(--ease-out); }
    .bx-call:active, .bx-clear:active { transform: scale(.94); }
    .bx-call { color: var(--mint-deep); background: linear-gradient(var(--glass-strong), var(--glass-strong)) padding-box, linear-gradient(135deg, var(--mint), var(--aqua)) border-box; box-shadow: 0 0 22px -8px rgba(106,211,184,.5); }
    .bx-call:hover { box-shadow: 0 0 28px -6px rgba(106,211,184,.65); }
    .bx-clear { color: var(--coral); background: linear-gradient(var(--glass-strong), var(--glass-strong)) padding-box, linear-gradient(135deg, var(--coral), var(--lavender)) border-box; box-shadow: 0 0 22px -8px rgba(255,107,157,.5); }
    .bx-clear:hover { box-shadow: 0 0 28px -6px rgba(255,107,157,.65); }
    .bx-call svg, .bx-clear svg { width: 19px; height: 19px; }
    html[data-theme="light"] .bx-call { color: var(--mint-ink); }
    html[data-theme="light"] .bx-clear { color: var(--coral-ink); }

    .bx-note { margin: 0 .2rem; padding-bottom: .7rem; font-size: var(--fs-xs); color: var(--ink-faint); text-align: center; }

    /* ── Voice call overlay ── (the trigger button .bx-call lives in the composer above) */
    .bx-call-ov { position: fixed; inset: 0; z-index: 50; display: flex; flex-direction: column; align-items: center; background: radial-gradient(120% 80% at 50% 0%, rgba(255,107,157,.12), var(--bg) 60%); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); animation: bx-in .25s var(--ease-out) both; }
    .bx-call-ov[hidden] { display: none; }
    .bx-call-bar { width: 100%; max-width: 820px; display: flex; align-items: center; justify-content: space-between; padding: 1rem clamp(.8rem,3vw,1.5rem); }
    .bx-call-lang { font: inherit; font-size: var(--fs-sm); color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .4rem .8rem; }
    .bx-call-end { font: inherit; font-size: var(--fs-sm); color: #ff7a7a; background: rgba(255,107,107,.1); border: 1px solid rgba(255,107,107,.35); border-radius: var(--r-pill); padding: .45rem 1rem; cursor: pointer; }
    .bx-call-stage { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.4rem; text-align: center; padding: 1rem; }
    .bx-call-orb { width: 130px; height: 130px; border-radius: 50%; background: var(--cta-grad); box-shadow: 0 0 60px rgba(255,107,157,.45); animation: bx-breathe 4s ease-in-out infinite; }
    .bx-call-ov.speaking .bx-call-orb { animation: bx-breathe 1.1s ease-in-out infinite; }
    .bx-call-ov.listening .bx-call-orb { background: radial-gradient(circle at 40% 35%, #fff, var(--aqua)); box-shadow: 0 0 60px rgba(91,192,255,.6); }
    .bx-call-status { font-size: var(--fs-lg); color: var(--ink-soft); margin: 0; }
    .bx-call-cap { max-width: 600px; display: flex; flex-direction: column; gap: .5rem; }
    .bx-call-cap .cc-you { color: var(--ink-faint); font-size: var(--fs-sm); margin: 0; }
    .bx-call-cap .cc-blak { color: var(--ink); font-size: var(--fs-lg); margin: 0; }
    .bx-call-mic { width: 76px; height: 76px; margin: 0 auto 2.4rem; border-radius: 50%; border: 0; cursor: pointer; color: #fff; background: var(--cta); box-shadow: var(--shadow-cta); display: grid; place-items: center; transition: transform .15s var(--ease-out); }
    .bx-call-mic:hover { transform: scale(1.05); }
    .bx-call-mic.rec { background: #ff6b6b; animation: bx-callpulse 1.2s ease-in-out infinite; }
    .bx-call-mic.muted { background: var(--surface-strong); color: var(--ink-faint); box-shadow: none; }
    .bx-call-mic svg { width: 30px; height: 30px; }
    .bx-call-mic .bx-ic-off { display: none; }
    .bx-call-mic.muted .bx-ic-on { display: none; }
    .bx-call-mic.muted .bx-ic-off { display: block; }
    .bx-call-hint { text-align: center; color: var(--ink-faint); font-size: var(--fs-xs); margin: -1.7rem 0 1.6rem; transition: opacity .2s; }
    .bx-call-ov.muted-on .bx-call-hint { opacity: 0; }
    @keyframes bx-callpulse { 0%,100%{box-shadow:0 0 0 6px rgba(255,107,107,.18)} 50%{box-shadow:0 0 0 16px rgba(255,107,107,.05)} }

    /* ── Chat history drawer ── (the trigger button .bx-hist lives in the header above) */
    .bx-cv-drawer { position: fixed; inset: 0; z-index: 60; }
    .bx-cv-drawer[hidden] { display: none; }
    .bx-cv-scrim { position: absolute; inset: 0; background: rgba(0,0,0,.4); -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); animation: bx-in .2s var(--ease-out) both; }
    .bx-cv-panel { position: absolute; top: 0; left: 0; bottom: 0; width: min(300px, 82vw); background: var(--glass-strong); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); border-right: 1px solid var(--line-strong); box-shadow: var(--shadow-soft); display: flex; flex-direction: column; padding: 1rem .8rem; animation: bx-slidein .22s var(--ease-out) both; }
    @keyframes bx-slidein { from { transform: translateX(-100%); } to { transform: none; } }
    .bx-cv-head { display: flex; align-items: center; justify-content: space-between; padding: .3rem .3rem 1rem; }
    .bx-cv-head b { font-size: var(--fs-lg); }
    .bx-cv-new { font: inherit; font-size: var(--fs-sm); color: var(--cta-ink); background: var(--cta); border: 0; border-radius: var(--r-pill); padding: .45rem .85rem; cursor: pointer; }
    .bx-cv-search { margin: .1rem 0 .5rem; width: 100%; border: 1px solid var(--line); border-radius: var(--r-pill); padding: .5rem .85rem; background: var(--surface); color: var(--ink); font: inherit; font-size: 16px; }
    .bx-cv-search:focus { outline: none; border-color: var(--coral); }
    .bx-cv-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: .25rem; }
    .bx-cv-item { display: flex; align-items: center; border-radius: var(--r-sm); transition: background .15s; }
    .bx-cv-item:hover { background: var(--surface); }
    .bx-cv-item.on { background: var(--surface-strong); }
    .bx-cv-open { flex: 1; min-width: 0; text-align: left; font: inherit; font-size: var(--fs-sm); color: var(--ink); background: none; border: 0; padding: .6rem; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bx-cv-del { flex: none; font-size: var(--fs-xs); color: var(--ink-faint); background: none; border: 0; padding: .55rem .7rem; cursor: pointer; opacity: 0; transition: opacity .15s, color .15s; }
    .bx-cv-item:hover .bx-cv-del { opacity: 1; }
    .bx-cv-del:hover { color: var(--coral); }
    @media (hover: none) { .bx-cv-del { opacity: .55; } }
    .bx-cv-ren { flex: none; display: inline-flex; align-items: center; color: var(--ink-faint); background: none; border: 0; padding: .5rem .4rem; cursor: pointer; opacity: .55; transition: opacity .15s, color .15s; }
    .bx-cv-ren:hover { opacity: 1; color: var(--coral); }
    .bx-cv-ren svg { width: 14px; height: 14px; }
    .bx-cv-pin { flex: none; display: inline-flex; align-items: center; color: var(--ink-faint); background: none; border: 0; padding: .5rem .35rem .5rem .45rem; cursor: pointer; opacity: .5; transition: opacity .15s, color .15s; }
    .bx-cv-pin:hover, .bx-cv-pin.on { opacity: 1; color: var(--gold); }
    .bx-cv-pin svg { width: 15px; height: 15px; }
    .bx-cv-renin { flex: 1; min-width: 0; font: inherit; font-size: var(--fs-sm); color: var(--ink); background: var(--bg); border: 1px solid var(--coral); border-radius: var(--r-sm); padding: .5rem .6rem; }
    .bx-cv-renin:focus { outline: none; }
    .bx-cv-empty { color: var(--ink-faint); font-size: var(--fs-sm); padding: 1rem .6rem; }
    .bx-cv-sum { flex: none; display: inline-flex; align-items: center; color: var(--ink-faint); background: none; border: 0; padding: .5rem .45rem; cursor: pointer; opacity: .55; transition: opacity .15s, color .15s; }
