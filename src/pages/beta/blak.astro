    .bx-sum-sheet { position: relative; width: 100%; max-width: 760px; max-height: 82vh; overflow-y: auto; -webkit-overflow-scrolling: touch; background: var(--surface); border: 1px solid var(--line); border-bottom: 0; border-radius: 20px 20px 0 0; padding: .4rem clamp(1rem, 4vw, 1.35rem) calc(1.4rem + env(safe-area-inset-bottom)); box-shadow: 0 -12px 44px rgba(0,0,0,.32); animation: bx-sheet-up .26s var(--ease-out) both; }
    @keyframes bx-sheet-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
    @keyframes bx-fade { from { opacity: 0; } to { opacity: 1; } }
    .bx-sum-grip { width: 38px; height: 4px; border-radius: 999px; background: var(--line-strong); margin: .4rem auto .15rem; }
