    .bx-icon-soon::after { content: 'soon'; position: absolute; top: -5px; right: -6px; font-family: var(--font-mono); font-size: 7px; letter-spacing: .04em; text-transform: uppercase; color: var(--gold); background: var(--bg); border: 1px solid rgba(255,210,122,.4); border-radius: 999px; padding: 0 3px; line-height: 1.5; }
    html[data-theme="light"] .bx-icon-soon::after { color: var(--gold-ink); }
    .bx-avatar { width: 44px; height: 44px; flex: none; border-radius: 50%; border: 0; cursor: pointer; background: var(--cta-grad); color: #1b1030; font-weight: 700; font-size: var(--fs-md); box-shadow: 0 0 16px rgba(255,107,157,.4); }

    /* ── Gemini-style home hero ── */
