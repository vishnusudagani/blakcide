    /* ── Header: burger · persona · profile ── */
    .bx-icon { width: 44px; height: 44px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line); cursor: pointer; position: relative; transition: .18s var(--ease-out); }
