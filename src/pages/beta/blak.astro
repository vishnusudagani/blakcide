    }
    async function maybeProactiveOpener() {
      if (history.length > 0 || !activeChatId) return;   // only into an empty chat
      if (!proactiveGateOk()) return;                    // at most once per day
      const jwt = await getToken(); if (!jwt) return;
      try {
        const r = await fetch('/api/blaksyd/symp/proactive-checkin', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
          body: JSON.stringify({ trigger: 'app_open' }),
        });
        const j = await r.json().catch(() => null);
        const msg = j && j.data && j.data.message;
        if (msg && history.length === 0) {
          const am = { role: 'assistant', content: msg, ts: Date.now() };
          history = [am];
          render(); updateChips();
          dbInsertMessage('assistant', msg).then((id) => { if (id) am.id = id; });
        }
      } catch (e) { /* no opener — the home hero already welcomes them */ }
    }

    // ── Header wiring + Gemini-style greeting ────────────────────────────
    if (profileBtn) profileBtn.addEventListener('click', () => { window.location.href = '/beta/account/'; });
    if (personaBtn) personaBtn.addEventListener('click', () => { window.location.href = '/beta/personas/'; });

    // Burger drawer account footer (theme toggle + sign out).
    const cvTheme = $('bx-cv-theme'), cvSignout = $('bx-cv-signout');
    if (cvTheme) cvTheme.addEventListener('click', () => {
      const t = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
      try { localStorage.setItem('theme', t); } catch (e) {}
      const mc = document.querySelector('meta[name="theme-color"]'); if (mc) mc.setAttribute('content', t === 'light' ? '#FAF4EC' : '#0B0D1F');
    });
    if (cvSignout) cvSignout.addEventListener('click', () => {
      try { Object.keys(localStorage).forEach((k) => { if (k.indexOf('supabase') > -1 || k.indexOf('-auth-token') > -1) localStorage.removeItem(k); }); } catch (e) {}
      window.location.href = '/';
    });

    // Mobile: while typing, pin the input above the keyboard and tuck the rest.
    // The on-screen keyboard shrinks visualViewport (svh does NOT track it), so we
    // mirror its live height into --vvh and the chat height follows it while the
    // keyboard is open (see `html.bx-kb .bx`), keeping the composer in view.
    const isMobile = () => !!(window.matchMedia && window.matchMedia('(max-width: 820px)').matches);
    const vv = window.visualViewport;
    if (vv) {
      const syncVV = () => { document.documentElement.style.setProperty('--vvh', Math.round(vv.height) + 'px'); };
      vv.addEventListener('resize', syncVV); syncVV();
    }
    input.addEventListener('focus', () => { if (isMobile()) document.documentElement.classList.add('bx-kb'); });
    input.addEventListener('blur',  () => { document.documentElement.classList.remove('bx-kb'); });

    function timeGreeting() {
      const h = new Date().getHours();
      if (h < 5)  return 'Still up';
      if (h < 12) return 'Morning';
      if (h < 17) return 'Afternoon';
      if (h < 22) return 'Evening';
      return 'Late one';
    }
    // Daily mood check-in → mood_logs → feeds blak_insights(). The warm little ritual.
    async function setupMood() {
      const wrap = document.getElementById('bx-mood'); if (!wrap || !supabase) return;
      const done = (m) => { wrap.querySelectorAll('.bx-mood-b').forEach((x) => x.classList.toggle('on', x.getAttribute('data-mood') === m)); wrap.classList.add('bx-mood-done'); const q = wrap.querySelector('.bx-mood-q'); if (q) q.textContent = 'Noted — Blak’s listening 💛'; };
      try {
        const since = new Date(); since.setHours(0, 0, 0, 0);
        const { data } = await supabase.from('mood_logs').select('mood').gte('created_at', since.toISOString()).order('created_at', { ascending: false }).limit(1);
        if (data && data[0]) done(data[0].mood);
      } catch (e) {}
      wrap.querySelectorAll('.bx-mood-b').forEach((b) => b.addEventListener('click', async () => {
        const mood = b.getAttribute('data-mood'); done(mood);
        try { const u = (await supabase.auth.getUser())?.data?.user; if (u) await supabase.from('mood_logs').insert([{ user_id: u.id, mood }]); } catch (e) {}
      }));
    }
    async function loadGreetingAndInsight() {
      let name = '';
      try {
        const u = (await supabase?.auth.getUser())?.data?.user;
        const meta = (u && u.user_metadata) || {};
        name = String(meta.full_name || meta.name || (u && u.email ? u.email.split('@')[0] : '') || '').trim().split(' ')[0];
        if (profileBtn && (name || (u && u.email))) profileBtn.textContent = (name || u.email)[0].toUpperCase();
      } catch (e) {}
      const g = $('bx-greet'); if (g) g.textContent = timeGreeting() + (name ? ', ' + name : '');
      if (!supabase || !userId) return;
      try {
        const { data } = await supabase.from('symp_knowledge_facts').select('area,key,value').eq('user_id', userId);
        const facts = data || [];
        let pool = buildInsights(facts);
        // Fold in Blak's live mood insight as one more rotating card.
        try {
          const { data: ins } = await supabase.rpc('blak_insights');
          if (ins && ins.kind === 'mood_day' && ins.title) pool.unshift({ title: ins.title, sub: 'see your day →' });
        } catch (e) {}
        showInsight(pool);
      } catch (e) {}
    }

    // Build a pool of warm, human one-liners from the user's own facts. One is
    // shown at a time and rotates on every visit, so the home never goes stale.
    function buildInsights(facts) {
      const out = [];
      const seen = new Set();
      const strip = (v) => String(v || '').replace(/^(likes?|loves?|enjoys?|has|is|wants? to|wants?|interested in|prefers?)\s+/i, '').replace(/\.$/, '').trim();
      const flourish = (v) => {
        const s = v.toLowerCase();
        if (/\bcars?\b|driving|automobile/.test(s)) return ' — all the best with the next one! 🚗';
        if (/\bbikes?\b|motorcycle/.test(s)) return ' 🏍️';
        if (/sing|music|guitar|piano/.test(s)) return ' 🎤';
        if (/travel|trip|goa|beach|vacation|holiday/.test(s)) return ' — hope you get there ✈️';
        if (/gym|fitness|run|workout/.test(s)) return ' 💪';
        if (/cook|food|biryani|eat/.test(s)) return ' 🍛';
        if (/code|coding|program|develop|build/.test(s)) return ' 👩‍💻';
        return ' ✨';
      };
      const add = (title, sub) => { const t = String(title || '').trim(); if (t && !seen.has(t)) { seen.add(t); out.push({ title: t.slice(0, 110), sub: sub || 'see & shape your profile →' }); } };
      const get = (area, key) => facts.find(f => f.area === area && f.key === key);
      const any = (key) => facts.find(f => f.key === key);

      const interests = get('tastes', 'interests'); if (interests) add('You’re into ' + strip(interests.value) + flourish(interests.value));
      const colour = any('favourite_colour') || any('favorite_colour') || any('favourite_color'); if (colour) add(strip(colour.value).replace(/^favourite colou?r is\s*/i, 'Team ') );
      const food = get('other', 'favorite_food') || any('food_preferences') || get('tastes', 'media_tastes'); if (food) add(strip(food.value) + ' — good taste 🍛');
      const goal = get('goals', 'short_term_goals'); if (goal) add(strip(goal.value) + ' — rooting for you 🤞');
      const win = get('goals', 'wins'); if (win) add(strip(win.value) + ' — nice one! 🎉');
      const sit = get('world', 'current_situation'); if (sit) add(strip(sit.value) + ' — how’s that going?');
      const lifts = get('inner', 'lifts_them'); if (lifts) add(strip(lifts.value) + ' 🌟');
      const langs = get('identity', 'languages'); if (langs) add(strip(langs.value) + ' — love the range 🌍');
      const work = get('world', 'work'); if (work) add(strip(work.value));
      // A couple of open-bucket gems too.
      for (const f of facts.filter(f => f.area === 'other').slice(0, 4)) add(strip(f.value) + flourish(f.value));
      return out;
    }

    function showInsight(pool) {
      const it = $('bx-insight-title'), is = $('bx-insight-sub');
      if (!pool || !pool.length) {
        if (it) it.textContent = 'Blak is getting to know you';
        if (is) is.textContent = 'the more you talk, the more it learns →';
        return;
      }
      // Rotate: advance a stored index every visit so it changes frequently.
      let i = 0;
      try { i = (parseInt(localStorage.getItem('bx-insight-i') || '-1', 10) + 1); if (!Number.isFinite(i) || i < 0) i = 0; localStorage.setItem('bx-insight-i', String(i)); } catch (e) {}
      const pick = pool[i % pool.length];
      if (it) it.textContent = pick.title;
      if (is) is.textContent = pick.sub;
    }

    // ── Boot: land on Blak's home — never auto-open a past thread ─────────
    // The home hero (greeting + insight + mood) is the resting state. We do NOT
    // restore the last conversation on open — doing so buried the home and felt
    // like the app was "stuck" inside an old chat. activeChatId stays null; the
    // first message lazily creates a fresh, auto-titled thread (see send()).
    // Past conversations live in the History drawer; ?c=<id> still deep-links to
    // a specific thread, and ?q=<text> prefills the composer.
    (async () => {
      try { const u = (await supabase?.auth.getUser())?.data?.user; if (u?.id) userId = u.id; } catch (e) {}
      if (!userId) return;   // not signed in — AppLayout's auth gate redirects to login
      let params; try { params = new URLSearchParams(location.search); } catch (e) { params = null; }
      const want = params && params.get('c');
      if (want) {
        const chats = await dbListChats();
        if (chats.some((c) => c.id === want)) await openChat(want);
      }
      try {
        const q = params && params.get('q');
        if (q) { input.value = q; autogrow(); input.focus(); }   // they tap send (no auto-fire)
        if (params && (q || want)) window.history.replaceState(null, '', location.pathname);
      } catch (e) {}
      loadGreetingAndInsight();
      loadReminders();
      loadNudges();
      setupMood();
    })();
  </script>
</AppLayout>
