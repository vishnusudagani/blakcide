---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout active="blak" title="Blak">
  <div class="bx">
    <header class="bx-head">
      <span class="bx-orb"><span class="bx-orb-spark">✦</span></span>
      <span class="bx-who"><b>Blak</b><i><span class="bx-live"></span>with you · always</i></span>
      <div class="bx-head-actions">
        <a class="bx-human" href="/beta/minit/" title="Talk to a real person">Talk to a human</a>
        <button type="button" class="bx-hist" id="bx-history" title="Your chats" aria-label="Your chats">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
        </button>
      </div>
    </header>

    <div class="bx-stream" id="bx-stream" aria-live="polite"></div>

    <!-- Resting / home state — shown (via pure CSS) only when #bx-stream is empty -->
    <div class="bx-home" id="bx-home">
      <span class="bx-tag"><span class="bx-tag-spark">✦</span>Learning quietly</span>

      <div class="bx-insights">
        <div class="bx-insight">
          <span class="bx-insight-ic ic-mint">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h2.5l2-7 4 16 3-11 1.5 4H21"/></svg>
          </span>
          <span class="bx-insight-tx">
            <b>Blak is getting to know you</b>
            <i>the more you talk, the more it remembers</i>
          </span>
        </div>
        <div class="bx-insight">
          <span class="bx-insight-ic ic-coral">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="17" rx="2.5"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4M7.5 14h2M14.5 14h2M7.5 18h2M14.5 18h2"/></svg>
          </span>
          <span class="bx-insight-tx">
            <b>Your patterns &amp; nudges land here</b>
            <i>moods, reminders, the things that matter to you</i>
          </span>
        </div>
      </div>

      <div class="bx-presence" aria-hidden="true">
        <span class="bx-presence-orb"><span class="bx-presence-spark">✦</span></span>
      </div>

      <div class="bx-chips" id="bx-chips">
        <button type="button" class="bx-chip" data-msg="I'm overwhelmed">I'm overwhelmed</button>
        <button type="button" class="bx-chip" data-msg="Plan my weekend">Plan my weekend</button>
        <button type="button" class="bx-chip" data-msg="Help me focus">Help me focus</button>
      </div>
    </div>

    <button type="button" class="bx-jump" id="bx-jump" aria-label="Jump to latest" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
    </button>

    <div class="bx-dock">
      <form class="bx-composer" id="bx-form">
        <div class="bx-field">
          <textarea id="bx-input" rows="1" placeholder="Message Blak…" autocomplete="off"></textarea>
          <button type="submit" id="bx-send" aria-label="Send">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <button type="button" id="bx-stop" aria-label="Stop" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="7" width="10" height="10" rx="2"/></svg>
          </button>
        </div>
        <button type="button" class="bx-call" id="bx-call" title="Voice call with Blak" aria-label="Voice call with Blak">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </button>
        <button type="button" class="bx-clear" id="bx-clear" title="New chat" aria-label="Start a fresh chat">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        </button>
      </form>
      <p class="bx-note">Beta — the real Blak. Talks, listens, remembers you, any language. Be kind, it's still learning. 🤍</p>
    </div>

    <!-- Voice call (turn-based: tap-to-talk) -->
    <div class="bx-call-ov" id="bx-call-overlay" hidden>
      <div class="bx-call-bar">
        <select class="bx-call-lang" id="bx-call-lang" aria-label="Call language">
          <option value="auto">Auto detect</option><option value="en">English</option><option value="hi">हिन्दी</option><option value="te">తెలుగు</option><option value="ta">தமிழ்</option><option value="kn">ಕನ್ನಡ</option><option value="ml">മലയാളം</option><option value="bn">বাংলা</option><option value="mr">मराठी</option><option value="gu">ગુજરાતી</option><option value="pa">ਪੰਜਾਬੀ</option>
        </select>
        <button type="button" class="bx-call-end" id="bx-call-end">End call</button>
      </div>
      <div class="bx-call-stage">
        <div class="bx-call-orb" id="bx-call-orb"></div>
        <p class="bx-call-status" id="bx-call-status">tap the mic and talk</p>
        <div class="bx-call-cap" id="bx-call-caption"></div>
      </div>
      <button type="button" class="bx-call-mic" id="bx-call-mic" aria-label="Tap to talk">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
      </button>
    </div>

    <!-- Chat history drawer -->
    <div class="bx-cv-drawer" id="bx-convos" hidden>
      <div class="bx-cv-scrim" id="bx-cv-scrim"></div>
      <aside class="bx-cv-panel">
        <div class="bx-cv-head"><b>Your chats</b><button type="button" class="bx-cv-new" id="bx-cv-new">＋ New chat</button></div>
        <div class="bx-cv-list" id="bx-cv-list"></div>
      </aside>
    </div>
  </div>

  <style is:global>
    .bx { display: flex; flex-direction: column; height: calc(100svh - 0px); max-width: 760px; margin-inline: auto; padding: 0 clamp(.9rem, 3vw, 1.5rem); position: relative; }
    @media (max-width: 820px) { .bx { height: calc(100svh - 124px); } }

    /* ── Header (minimal) ── */
    .bx-head { display: flex; align-items: center; gap: .6rem; padding: 1rem .2rem .8rem; }
    .bx-orb { position: relative; width: 30px; height: 30px; border-radius: 50%; flex: none; display: grid; place-items: center; background: var(--cta-grad); box-shadow: 0 0 14px rgba(255,107,157,.4); animation: bx-breathe 5s ease-in-out infinite; }
    .bx-orb-spark { font-size: 11px; line-height: 1; color: #fff; opacity: .92; }
    @keyframes bx-breathe { 0%,100%{transform:scale(1)} 50%{transform:scale(1.07)} }
    .bx-who { display: flex; flex-direction: column; line-height: 1.2; }
    .bx-who b { font-size: var(--fs-lg); font-weight: 650; letter-spacing: -.01em; }
    .bx-who i { font-style: normal; font-size: var(--fs-xs); color: var(--ink-faint); display: inline-flex; align-items: center; gap: .35rem; }
    .bx-live { width: 6px; height: 6px; border-radius: 50%; background: var(--mint-deep); box-shadow: 0 0 8px var(--mint-deep); animation: bx-pulse 2.4s ease-in-out infinite; }
    @keyframes bx-pulse { 0%,100%{opacity:1} 50%{opacity:.45} }
    .bx-head-actions { margin-left: auto; display: flex; align-items: center; gap: .55rem; }
    .bx-human { font-size: var(--fs-xs); color: var(--mint); text-decoration: none; border: 1px solid rgba(106,211,184,.3); border-radius: var(--r-pill); padding: .35rem .75rem; transition: .18s var(--ease-out); white-space: nowrap; }
    .bx-human:hover { background: rgba(106,211,184,.12); border-color: var(--mint-deep); }
    .bx-hist { width: 36px; height: 36px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--ink-faint); background: var(--surface); border: 1px solid var(--line); cursor: pointer; transition: .18s var(--ease-out); }
    .bx-hist:hover { color: var(--ink); border-color: var(--line-strong); background: var(--surface-strong); }
    .bx-hist svg { width: 17px; height: 17px; }
    html[data-theme="light"] .bx-human { color: var(--mint-ink); }

    /* ── Conversation stream ── */
    .bx-stream { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: .7rem; padding: 1rem .2rem 1.4rem; scrollbar-width: thin; scroll-behavior: smooth; }
    .bx-stream:empty { display: none; }                                   /* no messages → collapse, home shows */
    .bx-stream:not(:empty) ~ .bx-home { display: none; }                  /* messages exist → hide the home hero */
    .bx-row { display: flex; align-items: flex-end; gap: .5rem; max-width: 84%; animation: bx-in .28s var(--ease-out) both; }
    .bx-row.them { align-self: flex-start; } .bx-row.me { align-self: flex-end; flex-direction: row-reverse; }
    @keyframes bx-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    .bx-av { position: relative; width: 26px; height: 26px; border-radius: 50%; flex: none; background: var(--cta-grad); box-shadow: 0 0 10px rgba(255,107,157,.4); }
    .bx-col { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .bx-row.me .bx-col { align-items: flex-end; }
    .bx-bub { padding: .72rem .98rem; border-radius: var(--r-md); font-size: var(--fs-base); line-height: 1.55; white-space: pre-wrap; word-wrap: break-word; }
    .bx-row.them .bx-bub { background: var(--surface-strong); border: 1px solid var(--line); border-bottom-left-radius: 6px; color: var(--ink); }
    .bx-row.me .bx-bub { background: rgba(91,192,255,.14); border: 1px solid rgba(91,192,255,.26); border-bottom-right-radius: 6px; color: var(--ink); }
    html[data-theme="light"] .bx-row.me .bx-bub { background: rgba(24,114,176,.1); border-color: rgba(24,114,176,.22); }
    .bx-time { font-family: var(--font-mono); font-size: var(--fs-3xs); color: var(--ink-faint); padding: 0 .35rem; opacity: .8; }
    .bx-meta { display: flex; gap: .6rem; align-items: center; padding: 0 .35rem; }
    .bx-regen { font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .04em; color: var(--ink-faint); background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; gap: .25rem; padding: 0; transition: color .18s; }
    .bx-regen:hover { color: var(--coral); }
    .bx-regen svg { width: 12px; height: 12px; }
    .bx-retry { margin-top: .4rem; align-self: flex-start; font-family: inherit; font-size: var(--fs-sm); color: var(--coral); background: rgba(255,107,157,.1); border: 1px solid rgba(255,107,157,.3); border-radius: var(--r-pill); padding: .35rem .8rem; cursor: pointer; transition: .18s; }
    .bx-retry:hover { background: rgba(255,107,157,.18); }
    .bx-row.err .bx-bub { color: var(--ink-soft); background: var(--surface); border-color: var(--line-strong); }

    .bx-typing { display: inline-flex; gap: 4px; padding: .1rem 0; } .bx-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--coral); animation: bx-blink 1.2s infinite; } .bx-dot:nth-child(2){animation-delay:.18s} .bx-dot:nth-child(3){animation-delay:.36s}
    @keyframes bx-blink { 0%,100%{opacity:.3; transform: translateY(0)} 50%{opacity:1; transform: translateY(-2px)} }

    .bx-jump { position: absolute; right: clamp(1rem, 4vw, 2rem); bottom: 180px; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-strong); background: var(--surface-strong); backdrop-filter: blur(10px); color: var(--ink); cursor: pointer; box-shadow: var(--shadow-soft); z-index: 4; animation: bx-in .2s var(--ease-out) both; }
    .bx-jump svg { width: 18px; height: 18px; }
    .bx-jump[hidden] { display: none; }

    /* ── Resting / home state (presence hero) ── */
    .bx-home { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: clamp(1.1rem, 3.5vh, 1.8rem); text-align: center; padding: clamp(1rem, 4vh, 2rem) .2rem 1.4rem; animation: bx-in .4s var(--ease-out) both; }
    .bx-home[hidden] { display: none; }

    .bx-tag { display: inline-flex; align-items: center; gap: .4rem; font-size: var(--fs-xs); font-weight: 550; letter-spacing: .01em; padding: .38rem .9rem; border-radius: var(--r-pill); color: var(--ink-soft); background: var(--glass); border: 1px solid var(--line-strong); backdrop-filter: blur(8px); }
    .bx-tag-spark { background: var(--accent-grad); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; font-size: .9em; }

    /* insights card — glassy, glowing gradient border + outer glow */
    .bx-insights { width: 100%; max-width: 420px; border: 1px solid transparent; border-radius: var(--r-lg); background: linear-gradient(var(--glass-strong), var(--glass-strong)) padding-box, var(--line-grad) border-box; box-shadow: 0 0 38px -8px rgba(255,182,138,.32), var(--shadow-soft); backdrop-filter: blur(16px); overflow: hidden; }
    .bx-insight { display: flex; align-items: center; gap: .85rem; text-align: left; padding: 1rem 1.1rem; }
    .bx-insight + .bx-insight { border-top: 1px solid var(--line); }
    .bx-insight-ic { flex: none; width: 38px; height: 38px; border-radius: var(--r-sm); display: grid; place-items: center; }
    .bx-insight-ic svg { width: 20px; height: 20px; }
    .bx-insight-ic.ic-mint { color: var(--mint-deep); background: rgba(106,211,184,.14); border: 1px solid rgba(106,211,184,.26); }
    .bx-insight-ic.ic-coral { color: var(--coral); background: rgba(255,107,157,.13); border: 1px solid rgba(255,107,157,.26); }
    html[data-theme="light"] .bx-insight-ic.ic-mint { color: var(--mint-ink); }
    html[data-theme="light"] .bx-insight-ic.ic-coral { color: var(--coral-ink); }
    .bx-insight-tx { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .bx-insight-tx b { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
    .bx-insight-tx i { font-style: normal; font-size: var(--fs-xs); color: var(--ink-faint); line-height: 1.45; }

    /* central presence orb */
    .bx-presence { display: grid; place-items: center; padding: .4rem 0 .2rem; }
    .bx-presence-orb { position: relative; width: clamp(116px, 32vw, 136px); aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; background: var(--cta-grad); box-shadow: 0 0 60px -4px rgba(255,107,157,.5), 0 0 120px -20px rgba(255,210,122,.4), inset 0 2px 14px rgba(255,255,255,.35); animation: bx-breathe 4.5s ease-in-out infinite; }
    .bx-presence-spark { font-size: 30px; line-height: 1; color: #fff; opacity: .95; filter: drop-shadow(0 1px 6px rgba(255,255,255,.5)); }

    /* quick-prompt pills */
    .bx-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; transition: opacity .25s var(--ease-out); }
    .bx-chips[hidden] { display: none; }
    .bx-chip { font-family: inherit; font-size: var(--fs-sm); color: var(--ink-soft); background: var(--glass); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .5rem .95rem; cursor: pointer; backdrop-filter: blur(8px); transition: .18s var(--ease-out); }
    .bx-chip:hover { color: var(--ink); border-color: var(--coral); transform: translateY(-1px); }
    .bx-chip:active { transform: translateY(0); }

    /* ── Composer dock ── */
    .bx-dock { padding-bottom: .5rem; }
    .bx-composer { display: flex; gap: .55rem; padding: 0 .1rem .45rem; align-items: flex-end; }
    /* glowing rounded field wrapping the textarea + trailing send/stop */
    .bx-field { flex: 1; min-width: 0; display: flex; align-items: flex-end; gap: .35rem; padding: .35rem .4rem .35rem 0; border: 1px solid transparent; border-radius: var(--r-lg); background: linear-gradient(var(--glass-strong), var(--glass-strong)) padding-box, var(--line-grad) border-box; box-shadow: 0 0 24px -10px rgba(255,182,138,.4); backdrop-filter: blur(14px); transition: box-shadow .2s var(--ease-out); }
    .bx-field:focus-within { box-shadow: 0 0 30px -8px rgba(255,107,157,.45); }
    .bx-field textarea { flex: 1; min-width: 0; resize: none; max-height: 140px; padding: .72rem .4rem .72rem 1.1rem; background: transparent; border: 0; color: var(--ink); font: inherit; font-size: var(--fs-lg); line-height: 1.45; }
    .bx-field textarea:focus { outline: none; }
    .bx-field button { flex: none; width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer; color: var(--cta-ink); background: var(--cta); box-shadow: var(--shadow-cta); display: grid; place-items: center; transition: transform .16s var(--ease-out), opacity .16s; }
    .bx-field button:hover { transform: scale(1.06); } .bx-field button:active { transform: scale(.94); }
    .bx-field button[hidden] { display: none; }
    .bx-field button svg { width: 19px; height: 19px; }
    #bx-stop { background: var(--surface-strong); color: var(--ink); border: 1px solid var(--line-strong); box-shadow: none; }

    /* circular call (teal/mint glow) + new-chat (coral glow) buttons */
    .bx-call, .bx-clear { flex: none; width: 50px; height: 50px; border-radius: 50%; display: grid; place-items: center; border: 1px solid transparent; cursor: pointer; transition: transform .16s var(--ease-out), box-shadow .2s var(--ease-out); }
    .bx-call:active, .bx-clear:active { transform: scale(.94); }
    .bx-call { color: var(--mint-deep); background: linear-gradient(var(--glass-strong), var(--glass-strong)) padding-box, linear-gradient(135deg, var(--mint), var(--aqua)) border-box; box-shadow: 0 0 22px -8px rgba(106,211,184,.5); }
    .bx-call:hover { box-shadow: 0 0 28px -6px rgba(106,211,184,.65); }
    .bx-clear { color: var(--coral); background: linear-gradient(var(--glass-strong), var(--glass-strong)) padding-box, linear-gradient(135deg, var(--coral), var(--lavender)) border-box; box-shadow: 0 0 22px -8px rgba(255,107,157,.5); }
    .bx-clear:hover { box-shadow: 0 0 28px -6px rgba(255,107,157,.65); }
    .bx-call svg, .bx-clear svg { width: 19px; height: 19px; }
    html[data-theme="light"] .bx-call { color: var(--mint-ink); }
    html[data-theme="light"] .bx-clear { color: var(--coral-ink); }

    .bx-note { margin: 0 .2rem; padding-bottom: .7rem; font-size: var(--fs-xs); color: var(--ink-faint); text-align: center; }

    /* ── Voice call overlay ── (the trigger button .bx-call lives in the composer above) */
    .bx-call-ov { position: fixed; inset: 0; z-index: 50; display: flex; flex-direction: column; align-items: center; background: radial-gradient(120% 80% at 50% 0%, rgba(255,107,157,.12), var(--bg) 60%); backdrop-filter: blur(8px); animation: bx-in .25s var(--ease-out) both; }
    .bx-call-ov[hidden] { display: none; }
    .bx-call-bar { width: 100%; max-width: 820px; display: flex; align-items: center; justify-content: space-between; padding: 1rem clamp(.8rem,3vw,1.5rem); }
    .bx-call-lang { font: inherit; font-size: var(--fs-sm); color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .4rem .8rem; }
    .bx-call-end { font: inherit; font-size: var(--fs-sm); color: #ff7a7a; background: rgba(255,107,107,.1); border: 1px solid rgba(255,107,107,.35); border-radius: var(--r-pill); padding: .45rem 1rem; cursor: pointer; }
    .bx-call-stage { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.4rem; text-align: center; padding: 1rem; }
    .bx-call-orb { width: 130px; height: 130px; border-radius: 50%; background: var(--cta-grad); box-shadow: 0 0 60px rgba(255,107,157,.45); animation: bx-breathe 4s ease-in-out infinite; }
    .bx-call-ov.speaking .bx-call-orb { animation: bx-breathe 1.1s ease-in-out infinite; }
    .bx-call-ov.listening .bx-call-orb { background: radial-gradient(circle at 40% 35%, #fff, var(--aqua)); box-shadow: 0 0 60px rgba(91,192,255,.6); }
    .bx-call-status { font-size: var(--fs-lg); color: var(--ink-soft); margin: 0; }
    .bx-call-cap { max-width: 600px; display: flex; flex-direction: column; gap: .5rem; }
    .bx-call-cap .cc-you { color: var(--ink-faint); font-size: var(--fs-sm); margin: 0; }
    .bx-call-cap .cc-blak { color: var(--ink); font-size: var(--fs-lg); margin: 0; }
    .bx-call-mic { width: 76px; height: 76px; margin: 0 auto 2.4rem; border-radius: 50%; border: 0; cursor: pointer; color: #fff; background: var(--cta); box-shadow: var(--shadow-cta); display: grid; place-items: center; transition: transform .15s var(--ease-out); }
    .bx-call-mic:hover { transform: scale(1.05); }
    .bx-call-mic.rec { background: #ff6b6b; animation: bx-callpulse 1.2s ease-in-out infinite; }
    .bx-call-mic.muted { background: var(--surface-strong); color: var(--ink-faint); box-shadow: none; }
    .bx-call-mic svg { width: 30px; height: 30px; }
    @keyframes bx-callpulse { 0%,100%{box-shadow:0 0 0 6px rgba(255,107,107,.18)} 50%{box-shadow:0 0 0 16px rgba(255,107,107,.05)} }

    /* ── Chat history drawer ── (the trigger button .bx-hist lives in the header above) */
    .bx-cv-drawer { position: fixed; inset: 0; z-index: 60; }
    .bx-cv-drawer[hidden] { display: none; }
    .bx-cv-scrim { position: absolute; inset: 0; background: rgba(0,0,0,.4); backdrop-filter: blur(2px); animation: bx-in .2s var(--ease-out) both; }
    .bx-cv-panel { position: absolute; top: 0; left: 0; bottom: 0; width: min(300px, 82vw); background: var(--glass-strong); backdrop-filter: blur(18px); border-right: 1px solid var(--line-strong); box-shadow: var(--shadow-soft); display: flex; flex-direction: column; padding: 1rem .8rem; animation: bx-slidein .22s var(--ease-out) both; }
    @keyframes bx-slidein { from { transform: translateX(-100%); } to { transform: none; } }
    .bx-cv-head { display: flex; align-items: center; justify-content: space-between; padding: .3rem .3rem 1rem; }
    .bx-cv-head b { font-size: var(--fs-lg); }
    .bx-cv-new { font: inherit; font-size: var(--fs-sm); color: var(--cta-ink); background: var(--cta); border: 0; border-radius: var(--r-pill); padding: .45rem .85rem; cursor: pointer; }
    .bx-cv-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: .25rem; }
    .bx-cv-item { display: flex; align-items: center; border-radius: var(--r-sm); transition: background .15s; }
    .bx-cv-item:hover { background: var(--surface); }
    .bx-cv-item.on { background: var(--surface-strong); }
    .bx-cv-open { flex: 1; min-width: 0; text-align: left; font: inherit; font-size: var(--fs-sm); color: var(--ink); background: none; border: 0; padding: .6rem; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bx-cv-del { flex: none; font-size: var(--fs-xs); color: var(--ink-faint); background: none; border: 0; padding: .4rem .6rem; cursor: pointer; opacity: 0; transition: opacity .15s, color .15s; }
    .bx-cv-item:hover .bx-cv-del { opacity: 1; }
    .bx-cv-del:hover { color: var(--coral); }
    .bx-cv-empty { color: var(--ink-faint); font-size: var(--fs-sm); padding: 1rem .6rem; }

    /* ── Mobile (the screen is mostly used on phones) ── */
    @media (max-width: 480px) {
      .bx { padding: 0 .8rem; }
      .bx-head { padding: .8rem .1rem .7rem; }
      .bx-home { gap: 1.1rem; }
      .bx-call, .bx-clear { width: 46px; height: 46px; }
      .bx-composer { gap: .45rem; }
      .bx-row { max-width: 90%; }
    }

    /* ── Respect reduced-motion: no infinite breathing/pulsing ── */
    @media (prefers-reduced-motion: reduce) {
      .bx-orb, .bx-presence-orb, .bx-call-orb { animation: none !important; }
      .bx-live { animation: none !important; opacity: 1; }
      .bx-call-mic.rec { animation: none !important; }
    }
  </style>

  <script>
    // Real Blak — streams from the Groq-backed open-source chat via the
    // authenticated Blaksyd→Symp proxy (/api/blaksyd/symp/chat).
    // History persists per-user in localStorage; auto-retry + graceful recovery
    // mean a hiccup never leaves the user with a dead "…".
    import { supabase } from '../../lib/supabaseClient';

    const $ = (id) => document.getElementById(id);
    const stream = $('bx-stream'), form = $('bx-form'), input = $('bx-input'),
          chips = $('bx-chips'), sendBtn = $('bx-send'), stopBtn = $('bx-stop'),
          jumpBtn = $('bx-jump'), clearBtn = $('bx-clear'),
          historyBtn = $('bx-history'), convoDrawer = $('bx-convos'),
          convoList = $('bx-cv-list'), cvNew = $('bx-cv-new'), cvScrim = $('bx-cv-scrim');

    const MAX_TURNS = 24; // how many recent messages to send as context

    let history = [];          // [{role, content, ts, id?}] — current thread, in memory
    let userId = null;
    let activeChatId = null;   // uuid of the open chat (server-persisted in `chats`)
    let sending = false;
    let controller = null;
    let atBottom = true;
    let titled = {};           // chatId -> true once auto-titled

    // ── Server-persisted threads (chats + messages tables, owner-only RLS) ──
    // The browser client reads/writes the signed-in user's own rows directly —
    // no localStorage — so threads are durable, real, and cross-device.
    const titleOf = (hist) => { const u = (hist || []).find(m => m.role === 'user'); return u ? u.content.slice(0, 42) : 'New chat'; };

    async function dbListChats() {
      if (!supabase || !userId) return [];
      try {
        const { data } = await supabase.from('chats').select('id,title,created_at')
          .eq('user_id', userId).order('created_at', { ascending: false }).limit(100);
        return data || [];
      } catch (e) { return []; }
    }
    async function dbCreateChat(title) {
      if (!supabase || !userId) return null;
      try {
        const { data } = await supabase.from('chats')
          .insert({ user_id: userId, title: title || 'New chat' }).select('id,title,created_at').single();
        return data || null;
      } catch (e) { return null; }
    }
    async function dbLoadMessages(chatId) {
      try {
        const { data } = await supabase.from('messages')
          .select('id,role,content,created_at,media_url,media_type')
          .eq('chat_id', chatId).order('created_at', { ascending: true }).limit(500);
        return (data || []).map(m => ({
          id: m.id, role: m.role === 'user' ? 'user' : 'assistant',
          content: m.content || '', ts: m.created_at ? new Date(m.created_at).getTime() : Date.now(),
          media_url: m.media_url || null, media_type: m.media_type || null,
        }));
      } catch (e) { return []; }
    }
    async function dbInsertMessage(role, content, media) {
      if (!supabase || !activeChatId) return null;
      const row = { chat_id: activeChatId, role, content: content || (media ? '📎' : '') };
      if (role === 'user') row.sender_id = userId;
      if (media) { row.media_url = media.url || null; row.media_type = media.type || null; }
      try { const { data } = await supabase.from('messages').insert(row).select('id').single(); return data ? data.id : null; }
      catch (e) { return null; }
    }
    async function dbDeleteMessage(id) { if (supabase && id) { try { await supabase.from('messages').delete().eq('id', id); } catch (e) {} } }
    async function dbDeleteChat(chatId) {
      if (!supabase) return;
      try { await supabase.from('messages').delete().eq('chat_id', chatId); } catch (e) {}
      try { await supabase.from('chats').delete().eq('id', chatId); } catch (e) {}
    }
    async function dbSetTitle(chatId, title) { if (supabase && chatId && title) { try { await supabase.from('chats').update({ title }).eq('id', chatId); } catch (e) {} } }

    // Smart thread name after the first user turn (free Groq title endpoint).
    async function maybeTitleConvo() {
      if (!activeChatId || titled[activeChatId]) return;
      if (history.filter(m => m.role === 'user').length !== 1) return;
      const id = activeChatId; titled[id] = true;
      const jwt = await getToken(); if (!jwt) return;
      try {
        const r = await fetch('/api/blaksyd/symp/title', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
          body: JSON.stringify({ messages: history.filter(m => m.role !== 'system').slice(0, 4).map(({ role, content }) => ({ role, content })) }),
        });
        const j = await r.json().catch(() => null);
        const t = j && j.data && j.data.title;
        if (t) await dbSetTitle(id, t);
      } catch (e) { /* the chat keeps its first-message title */ }
    }

    const fmtTime = (ts) => { try { return new Date(ts).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); } catch { return ''; } };

    function nearBottom() { return stream.scrollHeight - stream.scrollTop - stream.clientHeight < 80; }
    function scrollToBottom(force) { if (force || atBottom) stream.scrollTop = stream.scrollHeight; }
    stream.addEventListener('scroll', () => { atBottom = nearBottom(); jumpBtn.hidden = atBottom; });
    jumpBtn.addEventListener('click', () => { atBottom = true; stream.scrollTop = stream.scrollHeight; jumpBtn.hidden = true; });

    // Render one message row. Returns handles for live updating (streaming).
    function addRow(side, text, opts = {}) {
      const ts = opts.ts || Date.now();
      const row = document.createElement('div');
      row.className = 'bx-row ' + side + (opts.err ? ' err' : '');
      const av = side === 'them' ? '<span class="bx-av"></span>' : '';
      row.innerHTML = av + '<div class="bx-col"><div class="bx-bub"></div></div>';
      const col = row.querySelector('.bx-col');
      const bub = row.querySelector('.bx-bub');
      if (opts.typing) {
        bub.innerHTML = '<span class="bx-typing"><span class="bx-dot"></span><span class="bx-dot"></span><span class="bx-dot"></span></span>';
      } else {
        bub.textContent = text;
        const time = document.createElement('time');
        time.className = 'bx-time';
        time.textContent = fmtTime(ts);
        col.appendChild(time);
      }
      stream.appendChild(row);
      scrollToBottom(side === 'me');
      return { row, col, bub, ts };
    }

    function stamp(handle) {
      if (handle.col.querySelector('.bx-time')) return;
      const time = document.createElement('time');
      time.className = 'bx-time'; time.textContent = fmtTime(handle.ts);
      handle.col.appendChild(time);
    }

    function render() {
      stream.innerHTML = '';
      for (const m of history) addRow(m.role === 'user' ? 'me' : 'them', m.content, { ts: m.ts });
      attachRegen();
      scrollToBottom(true);
    }

    // A small "regenerate" control under the latest Blak message.
    function attachRegen() {
      stream.querySelectorAll('.bx-regen').forEach(b => b.remove());
      const rows = [...stream.querySelectorAll('.bx-row.them')];
      const last = rows[rows.length - 1];
      if (!last || sending || history.length < 2) return;
      if (history[history.length - 1].role !== 'assistant') return;
      const btn = document.createElement('button');
      btn.className = 'bx-regen';
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 109-9 9 9 0 00-7 3.3M3 4v3.3h3.3"/></svg>regenerate';
      btn.onclick = regenerate;
      last.querySelector('.bx-col').appendChild(btn);
    }

    function updateChips() {
      // Starter prompts only matter before the first real exchange.
      const hasUserMsg = history.some(m => m.role === 'user');
      chips.hidden = hasUserMsg;
    }

    function setBusy(b) {
      sending = b;
      sendBtn.hidden = b; stopBtn.hidden = !b;
      input.disabled = false;
      if (b) { stream.querySelectorAll('.bx-regen').forEach(x => x.remove()); }
      else { attachRegen(); }
    }

    async function getToken() {
      if (!supabase) return null;
      try { return (await supabase.auth.getSession()).data?.session?.access_token || null; }
      catch { return null; }
    }

    function payload() {
      return history.filter(m => m.role === 'user' || m.role === 'assistant')
                    .slice(-MAX_TURNS)
                    .map(({ role, content }) => ({ role, content }));
    }

    // One streaming attempt. Throws on transport error; returns accumulated text.
    async function attempt(typing) {
      controller = new AbortController();
      const jwt = await getToken();
      if (!jwt) { const e = new Error('no_auth'); e.code = 'no_auth'; throw e; }
      const res = await fetch('/api/blaksyd/symp/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
        body: JSON.stringify({ messages: payload(), stream: true }),
        signal: controller.signal,
      });
      if (!res.ok || !res.body) throw new Error('http_' + res.status);
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let acc = '', buf = '';
      typing.bub.textContent = '';
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        const lines = buf.split('\n'); buf = lines.pop() || '';
        for (const line of lines) {
          const t = line.trim();
          if (!t.startsWith('data:')) continue;
          const p = t.slice(5).trim();
          if (!p || p === '[DONE]') continue;
          let obj; try { obj = JSON.parse(p); } catch { continue; }
          if (obj.delta) { acc += obj.delta; typing.bub.textContent = acc; scrollToBottom(); }
          if (obj.error) throw new Error(String(obj.error));
        }
      }
      return acc.trim();
    }

    function showError(typing, srcText) {
      typing.row.classList.add('err');
      typing.bub.textContent = "I lost my train of thought for a second — your message is safe.";
      const retry = document.createElement('button');
      retry.className = 'bx-retry'; retry.textContent = 'Try again';
      retry.onclick = () => { typing.row.remove(); runTurn(srcText); };
      typing.col.appendChild(retry);
      setBusy(false);
    }

    // Drive one assistant turn for the already-appended user message `srcText`.
    async function runTurn(srcText) {
      setBusy(true);
      const typing = addRow('them', '', { typing: true });
      try {
        let acc = '';
        try { acc = await attempt(typing); }
        catch (e) {
          if (e.name === 'AbortError') throw e;
          if (e.code === 'no_auth') {
            typing.bub.textContent = "Sign in first and I'm all yours — log in from the menu and come back.";
            stamp(typing); setBusy(false); return;
          }
          acc = ''; // fall through to one auto-retry
        }
        if (!acc) {
          typing.bub.innerHTML = '<span class="bx-typing"><span class="bx-dot"></span><span class="bx-dot"></span><span class="bx-dot"></span></span>';
          await new Promise(r => setTimeout(r, 700)); // let a rate-limited provider's window breathe before the backstop retry
          acc = await attempt(typing);
        }
        acc = acc.trim();
        typing.bub.textContent = acc || "Mmm — I didn't catch that. Say it once more?";
        stamp(typing);
        const am = { role: 'assistant', content: acc, ts: typing.ts };
        history.push(am);
        dbInsertMessage('assistant', acc).then((id) => { if (id) am.id = id; });
        maybeTitleConvo();
        setBusy(false);
      } catch (e) {
        if (e.name === 'AbortError') {
          const partial = (typing.bub.textContent || '').trim();
          if (partial) { stamp(typing); const am = { role: 'assistant', content: partial, ts: typing.ts }; history.push(am); dbInsertMessage('assistant', partial).then((id) => { if (id) am.id = id; }); }
          else typing.row.remove();
          setBusy(false);
        } else {
          showError(typing, srcText);
        }
      } finally {
        controller = null;
      }
    }

    async function send(text) {
      text = (text || '').trim();
      if (!text || sending) return;
      if (!activeChatId) { const c = await dbCreateChat(text.slice(0, 42)); if (c) activeChatId = c.id; }
      const um = { role: 'user', content: text, ts: Date.now() };
      history.push(um);
      addRow('me', text);
      updateChips();
      dbInsertMessage('user', text).then((id) => { if (id) um.id = id; });
      await runTurn(text);
    }

    function regenerate() {
      if (sending || history.length < 2) return;
      // drop the last assistant turn (history + DOM + server) and re-ask the prior user msg
      if (history[history.length - 1].role === 'assistant') { const dropped = history.pop(); dbDeleteMessage(dropped && dropped.id); }
      const lastThem = [...stream.querySelectorAll('.bx-row.them')].pop();
      if (lastThem) lastThem.remove();
      const lastUser = [...history].reverse().find(m => m.role === 'user');
      if (lastUser) runTurn(lastUser.content);
    }

    // ── Composer behaviour ───────────────────────────────────────────────
    function autogrow() { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 140) + 'px'; }
    input.addEventListener('input', autogrow);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
    });
    form.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value; input.value = ''; autogrow(); send(v); });
    chips.addEventListener('click', (e) => { const b = e.target.closest('.bx-chip'); if (b) send(b.getAttribute('data-msg')); });
    stopBtn.addEventListener('click', () => { if (controller) controller.abort(); });
    clearBtn.addEventListener('click', () => { newConvo(); });

    // ── Conversation switching + history drawer (server-backed) ───────────
    async function openChat(id) {
      activeChatId = id;
      history = await dbLoadMessages(id);
      render(); updateChips();
    }
    async function newConvo() {
      if (sending && controller) controller.abort();
      const c = await dbCreateChat('New chat');
      activeChatId = c ? c.id : null;
      history = [];
      render(); updateChips(); closeDrawer(); input.focus();
    }
    async function renderConvoList() {
      convoList.innerHTML = '<p class="bx-cv-empty">Loading…</p>';
      const arr = await dbListChats();
      convoList.innerHTML = '';
      if (!arr.length) { convoList.innerHTML = '<p class="bx-cv-empty">No chats yet</p>'; return; }
      for (const c of arr) {
        const row = document.createElement('div');
        row.className = 'bx-cv-item' + (c.id === activeChatId ? ' on' : '');
        row.innerHTML = '<button class="bx-cv-open" type="button"></button><button class="bx-cv-del" type="button" aria-label="Delete chat">✕</button>';
        row.querySelector('.bx-cv-open').textContent = c.title || 'New chat';
        row.querySelector('.bx-cv-open').onclick = () => { if (c.id !== activeChatId) openChat(c.id); closeDrawer(); };
        row.querySelector('.bx-cv-del').onclick = (e) => { e.stopPropagation(); deleteConvo(c.id); };
        convoList.appendChild(row);
      }
    }
    async function deleteConvo(id) {
      await dbDeleteChat(id);
      if (id === activeChatId) {
        const arr = await dbListChats();
        if (arr.length) await openChat(arr[0].id);
        else await newConvo();
      }
      renderConvoList();
    }
    function openDrawer() { renderConvoList(); convoDrawer.hidden = false; }
    function closeDrawer() { convoDrawer.hidden = true; }
    if (historyBtn) historyBtn.addEventListener('click', openDrawer);
    if (cvNew) cvNew.addEventListener('click', newConvo);
    if (cvScrim) cvScrim.addEventListener('click', closeDrawer);

    // ── Voice call (HANDS-FREE: in-browser VAD → Whisper → Blak → Sarvam) ─
    // Continuous listening with energy-based voice-activity detection: just talk,
    // it auto-sends when you pause, plays the reply, then listens again — no
    // tapping. Cheap cascaded pipeline (no audio-token S2S). Mic = mute toggle.
    const callBtn = $('bx-call'), callOv = $('bx-call-overlay'), callMic = $('bx-call-mic'),
          callEnd = $('bx-call-end'), callStatus = $('bx-call-status'),
          callCap = $('bx-call-caption'), callLang = $('bx-call-lang');
    let micStream = null, actx = null, analyser = null, vadTimer = null, callSrc = null;
    let callState = 'idle';   // idle | listening | recording | thinking | speaking
    let mrec = null, recChunks = [], speechFrames = 0, silenceFrames = 0, recStartAt = 0, muted = false;
    const escHtml = (s) => { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; };
    const setCall = (cls, status) => { callOv.className = 'bx-call-ov' + (cls ? ' ' + cls : ''); if (status != null) callStatus.textContent = status; };

    const SPEECH_RMS = 0.020, SILENCE_RMS = 0.013, START_FRAMES = 3, SILENCE_END_MS = 1100, FRAME_MS = 60, MAX_UTTER_MS = 14000;

    // ── Realtime Gemini Live (speech-to-speech) ──────────────────────────
    // Preferred when the Vertex bridge is configured; falls back to the
    // turn-based cascade below if it isn't reachable (unset env / billing /
    // error). Mic 16kHz PCM in, 24kHz PCM out, full-duplex with barge-in.
    let gws = null, gproc = null, gsrcNode = null, gNextPlay = 0, gAiSpeaking = false, liveMode = false, gCap = '', gDuckTimer = null;
    function gPlay(b64) {
      if (!actx || callState === 'idle') return;
      const bin = atob(b64), bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const i16 = new Int16Array(bytes.buffer), f32 = new Float32Array(i16.length);
      for (let i = 0; i < i16.length; i++) f32[i] = i16[i] / 32768;
      const b = actx.createBuffer(1, f32.length, 24000); b.copyToChannel(f32, 0);
      const s = actx.createBufferSource(); s.buffer = b;
      const now = actx.currentTime;
      // Fresh utterance → short lead-in (low latency) with a 30ms fade-in that
      // masks any first-phoneme clip (so "what" doesn't become "hat").
      const fresh = gNextPlay <= now + 0.02;
      const t = fresh ? now + 0.10 : gNextPlay;
      if (fresh) { const g = actx.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(1, t + 0.03); s.connect(g); g.connect(actx.destination); }
      else { s.connect(actx.destination); }
      s.start(t); gNextPlay = t + b.duration; gsrcNode = s;
      if (!gAiSpeaking) { gAiSpeaking = true; setCall('speaking', 'speaking…'); }
      // Keep the mic DUCKED until the audio truly finishes (not just until
      // turnComplete) — otherwise the speaker output echoes into the mic and
      // Gemini's VAD fires a false "barge-in" that cuts the reply short.
      if (gDuckTimer) clearTimeout(gDuckTimer);
      gDuckTimer = setTimeout(() => {
        gAiSpeaking = false;
        if (callState !== 'idle' && !muted) setCall('listening', 'listening… just talk');
      }, Math.max(0, (gNextPlay - now) * 1000) + 300);
    }
    function gHandle(o) {
      if (!o) return;
      const sc = o.serverContent; if (!sc) return;
      if (sc.interrupted) {
        if (gsrcNode) { try { gsrcNode.stop(); } catch (e) {} }
        gNextPlay = actx ? actx.currentTime : 0;
        if (gDuckTimer) { clearTimeout(gDuckTimer); gDuckTimer = null; }
        gAiSpeaking = false; setCall('listening', 'listening…'); return;
      }
      if (sc.modelTurn && sc.modelTurn.parts) sc.modelTurn.parts.forEach((p) => {
        if (p.inlineData && p.inlineData.data && String(p.inlineData.mimeType || '').indexOf('audio') === 0) gPlay(p.inlineData.data);
      });
      if (sc.outputTranscription && sc.outputTranscription.text) gCap += sc.outputTranscription.text;
      if (sc.inputTranscription && sc.inputTranscription.text) callCap.innerHTML = '<p class="cc-you">' + escHtml(sc.inputTranscription.text) + '</p>' + (gCap ? '<p class="cc-blak">' + escHtml(gCap) + '</p>' : '');
      if (sc.turnComplete) {
        if (gCap.trim()) { const you = callCap.querySelector('.cc-you'); callCap.innerHTML = (you ? you.outerHTML : '') + '<p class="cc-blak">' + escHtml(gCap.trim()) + '</p>'; }
        gCap = '';
        // Do NOT un-duck here — audio is still scheduled ahead. The duck timer
        // in gPlay flips back to "listening" once playback actually drains.
      }
    }
    function gStartMic() {
      const sr = actx.sampleRate, srcN = actx.createMediaStreamSource(micStream);
      gproc = actx.createScriptProcessor(2048, 1, 1);
      gproc.onaudioprocess = (e) => {
        if (!liveMode || muted || !gws || gws.readyState !== 1 || gAiSpeaking) return;
        const inp = e.inputBuffer.getChannelData(0), ratio = sr / 16000, n = Math.floor(inp.length / ratio);
        const pcm = new Int16Array(n);
        for (let i = 0; i < n; i++) { const v = inp[Math.round(i * ratio)] || 0; pcm[i] = Math.max(-32768, Math.min(32767, Math.round(v * 32767))); }
        const u8 = new Uint8Array(pcm.buffer); let str = '';
        for (let i = 0; i < u8.length; i += 8192) str += String.fromCharCode.apply(null, u8.subarray(i, i + 8192));
        gws.send(JSON.stringify({ realtimeInput: { audio: { data: btoa(str), mimeType: 'audio/pcm;rate=16000' } } }));
      };
      srcN.connect(gproc); gproc.connect(actx.destination);
    }
    async function geminiLiveTry() {
      let cfg;
      try { const r = await fetch('/api/gemini-live-session', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }); if (!r.ok) return false; cfg = await r.json(); }
      catch (e) { return false; }
      if (!cfg || !cfg.wsUrl) return false;
      const jwt = await getToken(); if (!jwt) return false;
      return await new Promise((resolve) => {
        let ws; try { ws = new WebSocket(cfg.wsUrl, ['blak.v1', 'blak.jwt.' + jwt]); } catch (e) { return resolve(false); }
        gws = ws; gNextPlay = 0; gAiSpeaking = false; gCap = ''; let settled = false;
        const done = (v) => { if (settled) return; settled = true; resolve(v); };
        const to = setTimeout(() => { if (!settled) { try { ws.close(); } catch (e) {} done(false); } }, 9000);
        const langSel = (callLang && callLang.value && callLang.value !== 'auto') ? ('\nThe user picked ' + callLang.value + ' for this call — speak that language.') : '';
        ws.onopen = () => { setCall('', 'connecting…'); ws.send(JSON.stringify({ setup: {
          model: cfg.model,
          generationConfig: { responseModalities: ['AUDIO'], temperature: 0.9, speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: cfg.voice || 'Aoede' } } } },
          systemInstruction: { parts: [{ text: (cfg.instructions || '') + langSel }] },
          // Snappy turn-taking → lower perceived latency + natural flow.
          realtimeInputConfig: { automaticActivityDetection: { startOfSpeechSensitivity: 'START_SENSITIVITY_HIGH', endOfSpeechSensitivity: 'END_SENSITIVITY_HIGH', silenceDurationMs: 350, prefixPaddingMs: 60 } },
          inputAudioTranscription: {}, outputAudioTranscription: {},
        } })); };
        const onObj = (o) => { if (o && o.setupComplete && !settled) { clearTimeout(to); liveMode = true; gStartMic(); setCall('listening', 'listening… just talk'); done(true); } gHandle(o); };
        ws.onmessage = (ev) => { if (typeof ev.data === 'string') { try { onObj(JSON.parse(ev.data)); } catch (e) {} } else if (ev.data && ev.data.text) { ev.data.text().then((t) => { try { onObj(JSON.parse(t)); } catch (e) {} }); } };
        ws.onerror = () => { clearTimeout(to); done(false); };
        ws.onclose = (e) => { clearTimeout(to); if (!settled) done(false); else if (liveMode && callState !== 'idle') { liveMode = false; setCall('', e.reason ? ('call ended — ' + e.reason) : 'call ended'); } };
      });
    }

    async function openCall() {
      callOv.hidden = false; callCap.innerHTML = ''; muted = false; callMic.classList.remove('muted'); liveMode = false;
      try { micStream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true } }); }
      catch (e) { setCall('', 'mic blocked — allow microphone access'); return; }
      try { actx = actx || new (window.AudioContext || window.webkitAudioContext)(); if (actx.state === 'suspended') await actx.resume(); } catch (e) {}
      callState = 'listening'; setCall('', 'connecting…');
      if (await geminiLiveTry()) return;   // realtime Gemini Live running
      // Fallback — turn-based cascade (Whisper STT → LLM → Sarvam TTS).
      const src = actx.createMediaStreamSource(micStream);
      analyser = actx.createAnalyser(); analyser.fftSize = 1024; src.connect(analyser);
      startListening(); vadLoop();
    }
    function endCall() {
      callState = 'idle'; liveMode = false;
      if (gws) { try { gws.close(); } catch (e) {} gws = null; }
      if (gproc) { try { gproc.disconnect(); } catch (e) {} gproc = null; }
      if (gsrcNode) { try { gsrcNode.stop(); } catch (e) {} gsrcNode = null; }
      if (vadTimer) { clearTimeout(vadTimer); vadTimer = null; }
      if (mrec && mrec.state !== 'inactive') { try { mrec.stop(); } catch (e) {} }
      if (callSrc) { try { callSrc.stop(); } catch (e) {} callSrc = null; }
      if (micStream) { micStream.getTracks().forEach(t => t.stop()); micStream = null; }
      callOv.hidden = true; setCall('', '');
    }
    function startListening() { callState = 'listening'; speechFrames = 0; silenceFrames = 0; callMic.classList.remove('rec'); setCall('', muted ? 'muted — tap mic to resume' : 'listening… just talk'); }
    function rmsLevel() {
      const buf = new Float32Array(analyser.fftSize); analyser.getFloatTimeDomainData(buf);
      let s = 0; for (let i = 0; i < buf.length; i++) s += buf[i] * buf[i];
      return Math.sqrt(s / buf.length);
    }
    function vadLoop() {
      if (callState === 'idle') return;
      const level = analyser ? rmsLevel() : 0;
      if (!muted && callState === 'listening') {
        if (level > SPEECH_RMS) { if (++speechFrames >= START_FRAMES) beginRec(); } else speechFrames = 0;
      } else if (callState === 'recording') {
        if (level < SILENCE_RMS) { if (++silenceFrames * FRAME_MS >= SILENCE_END_MS) finishRec(); } else silenceFrames = 0;
        if (Date.now() - recStartAt > MAX_UTTER_MS) finishRec();
      } else if (callState === 'speaking') {
        if (!muted && level > SPEECH_RMS) { if (callSrc) { try { callSrc.stop(); } catch (e) {} callSrc = null; } beginRec(); } // barge-in
      }
      vadTimer = setTimeout(vadLoop, FRAME_MS);
    }
    function beginRec() {
      if (!micStream) return;
      callState = 'recording'; silenceFrames = 0; recStartAt = Date.now(); recChunks = [];
      const mime = (window.MediaRecorder && MediaRecorder.isTypeSupported('audio/webm')) ? 'audio/webm' : '';
      mrec = new MediaRecorder(micStream, mime ? { mimeType: mime } : undefined);
      mrec.ondataavailable = (e) => { if (e.data && e.data.size) recChunks.push(e.data); };
      mrec.start(); callMic.classList.add('rec'); setCall('listening', 'listening…');
    }
    function finishRec() {
      if (callState !== 'recording') return;
      callState = 'thinking'; callMic.classList.remove('rec'); setCall('', 'thinking…');
      const mime = mrec ? (mrec.mimeType || 'audio/webm') : 'audio/webm';
      if (mrec && mrec.state !== 'inactive') { mrec.onstop = () => sendTurn(mime); try { mrec.stop(); } catch (e) { sendTurn(mime); } }
      else sendTurn(mime);
    }
    function blobB64(blob) { return new Promise(r => { const fr = new FileReader(); fr.onloadend = () => r(String(fr.result).split(',')[1]); fr.readAsDataURL(blob); }); }
    async function playChunks(arr) {
      if (!arr || !arr.length || !actx) return;
      for (const b64 of arr) {
        if (callState !== 'speaking') return;        // barge-in interrupted us
        let buf; try { buf = await actx.decodeAudioData(Uint8Array.from(atob(b64), c => c.charCodeAt(0)).buffer); } catch (e) { continue; }
        await new Promise(r => { const s = actx.createBufferSource(); s.buffer = buf; s.connect(actx.destination); callSrc = s; s.onended = r; s.start(); });
      }
    }
    async function sendTurn(mimetype) {
      try {
        const blob = new Blob(recChunks, { type: mimetype });
        if (blob.size < 1400) { startListening(); return; }   // too short → ignore noise blip
        const audio = await blobB64(blob);
        const jwt = await getToken();
        if (!jwt) { setCall('', 'sign in first to call'); return; }
        const body = { audio, mimetype };
        if (callLang.value && callLang.value !== 'auto') body.lane = callLang.value;
        const res = await fetch('/api/blaksyd/symp/voice', { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt }, body: JSON.stringify(body) });
        const j = await res.json().catch(() => null);
        if (!j || !j.ok) { startListening(); return; }
        const { transcript, reply, audio: out } = j.data;
        callCap.innerHTML = '<p class="cc-you">' + escHtml(transcript) + '</p><p class="cc-blak">' + escHtml(reply) + '</p>';
        callState = 'speaking'; setCall('speaking', 'speaking…');
        await playChunks(out);
        if (callState === 'speaking') startListening();   // resume unless barge-in changed state
      } catch (e) { startListening(); }
    }
    if (callBtn) callBtn.addEventListener('click', openCall);
    if (callEnd) callEnd.addEventListener('click', endCall);
    if (callMic) callMic.addEventListener('click', () => {   // mute / unmute
      muted = !muted; callMic.classList.toggle('muted', muted);
      if (liveMode) { setCall(muted ? '' : 'listening', muted ? 'muted — tap mic to resume' : 'listening… just talk'); return; }
      if (muted) { if (mrec && mrec.state !== 'inactive') { try { mrec.stop(); } catch (e) {} } if (callSrc) { try { callSrc.stop(); } catch (e) {} } }
      startListening();
    });

    // ── Proactive opener: Blak reaches out first, aware of the user ──────
    // Fires AT MOST once/day, and only into a genuinely empty chat — so it's a
    // welcome, not a wall you hit on every single open. The endpoint grounds it
    // in the user's Vault + profile; if there's nothing real to say it stays a
    // soft check-in, which we still show only once a day.
    function proactiveGateOk() {
      try {
        const k = 'blak_proactive_' + userId;
        const today = new Date().toISOString().slice(0, 10);
        if (localStorage.getItem(k) === today) return false;
        localStorage.setItem(k, today);
        return true;
      } catch (e) { return true; }
    }
    async function maybeProactiveOpener() {
      if (history.length > 0 || !activeChatId) return;   // only into an empty chat
      if (!proactiveGateOk()) return;                    // at most once per day
      const jwt = await getToken(); if (!jwt) return;
      try {
        const r = await fetch('/api/blaksyd/symp/proactive-checkin', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
          body: JSON.stringify({ trigger: 'app_open' }),
        });
        const j = await r.json().catch(() => null);
        const msg = j && j.data && j.data.message;
        if (msg && history.length === 0) {
          const am = { role: 'assistant', content: msg, ts: Date.now() };
          history = [am];
          render(); updateChips();
          dbInsertMessage('assistant', msg).then((id) => { if (id) am.id = id; });
        }
      } catch (e) { /* no opener — the home hero already welcomes them */ }
    }

    // ── Boot: restore this user's chats from the server (or start one) ────
    (async () => {
      try { const u = (await supabase?.auth.getUser())?.data?.user; if (u?.id) userId = u.id; } catch (e) {}
      if (!userId) return;   // not signed in — AppLayout's auth gate redirects to login
      let chats = await dbListChats();
      if (!chats.length) { const c = await dbCreateChat('New chat'); if (c) chats = [c]; }
      // Deep links: ?c=<id> opens that chat; ?q=<text> prefills the composer.
      let params; try { params = new URLSearchParams(location.search); } catch (e) { params = null; }
      const want = params && params.get('c');
      const startId = (want && chats.some((c) => c.id === want)) ? want : (chats[0] && chats[0].id);
      if (startId) await openChat(startId);
      try {
        const q = params && params.get('q');
        if (q) { input.value = q; autogrow(); input.focus(); }   // they tap send (no auto-fire)
        if (params && (q || want)) window.history.replaceState(null, '', location.pathname);
      } catch (e) {}
      maybeProactiveOpener();
    })();
  </script>
</AppLayout>
