    .bx-hero-spark { font-size: 20px; line-height: 1; color: #fff; opacity: .95; }
    .bx-greet { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.7rem, 1.2rem + 3.2vw, 2.6rem); letter-spacing: -.02em; margin: 0; line-height: 1.1; background: var(--accent-grad); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
    .bx-greet-sub { color: var(--ink-soft); font-size: var(--fs-lg); margin: 0; max-width: 30ch; }
    .bx-reminders { width: 100%; max-width: 420px; display: flex; flex-direction: column; gap: .5rem; }
