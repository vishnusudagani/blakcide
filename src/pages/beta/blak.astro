    .bx-rem svg { width: 18px; height: 18px; color: var(--gold); flex: none; }
    .bx-rem-tx { flex: 1; min-width: 0; font-size: var(--fs-sm); color: var(--ink); }
    .bx-rem-done { flex: none; background: none; border: 1px solid var(--line-strong); color: var(--ink-soft); border-radius: var(--r-pill); font: inherit; font-size: var(--fs-xs); padding: .3rem .7rem; cursor: pointer; }
    .bx-rem-done:hover { color: var(--ink); border-color: var(--gold); }
    html[data-theme="light"] .bx-rem { background: rgba(138,100,16,.07); }
    .bx-nudges { width: 100%; max-width: 420px; display: flex; flex-direction: column; gap: .5rem; }
    .bx-nudges[hidden] { display: none; }
    .bx-nudge { display: flex; align-items: flex-start; gap: .7rem; padding: .8rem .95rem; border-radius: var(--r-md); background: rgba(255,107,157,.1); border: 1px solid rgba(255,107,157,.28); text-align: left; animation: bx-in .25s var(--ease-out) both; }
    .bx-nudge-mark { flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--cta-grad); color: #fff; font-size: 13px; }
    .bx-nudge-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .55rem; }
    .bx-nudge-tx { font-size: var(--fs-sm); color: var(--ink); line-height: 1.5; }
    .bx-nudge-acts { display: flex; gap: .5rem; }
    .bx-nudge-acts button { background: none; border: 1px solid var(--line-strong); color: var(--ink-soft); border-radius: var(--r-pill); font: inherit; font-size: var(--fs-xs); padding: .32rem .85rem; cursor: pointer; }
    .bx-nudge-acts button:hover { color: var(--ink); }
    .bx-nudge-reply { color: var(--cta-ink) !important; background: var(--cta) !important; border-color: transparent !important; }
    .bx-insight-card { display: inline-flex; align-items: center; gap: .7rem; padding: .7rem .95rem; border-radius: var(--r-md); background: var(--glass-strong); border: 1px solid var(--line-strong); box-shadow: var(--shadow-soft); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); transition: .18s var(--ease-out); }
    .bx-insight-card:hover { border-color: var(--coral); transform: translateY(-1px); }
    .bx-insight-card .bx-insight-ic { flex: none; width: 34px; height: 34px; border-radius: var(--r-sm); display: grid; place-items: center; color: var(--mint-deep); background: rgba(106,211,184,.14); border: 1px solid rgba(106,211,184,.26); }
    .bx-insight-card .bx-insight-ic svg { width: 18px; height: 18px; }
    .bx-insight-card .bx-insight-tx { display: flex; flex-direction: column; gap: 1px; text-align: left; }
    .bx-insight-card .bx-insight-tx b { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
    .bx-insight-card .bx-insight-tx i { font-style: normal; font-size: var(--fs-xs); color: var(--ink-faint); }
    html[data-theme="light"] .bx-insight-card .bx-insight-ic { color: var(--mint-ink); }

    /* ── Burger drawer: account footer ── */
    .bx-cv-foot { border-top: 1px solid var(--line); padding-top: .4rem; margin-top: .4rem; display: flex; flex-direction: column; gap: .05rem; }
    .bx-cv-foot-link { text-align: left; font: inherit; font-size: var(--fs-sm); color: var(--ink-soft); background: none; border: 0; padding: .55rem .6rem; border-radius: var(--r-sm); cursor: pointer; }
    .bx-cv-foot-link:hover { background: var(--surface); color: var(--ink); }

    /* ── Mobile keyboard: pin the input, tuck the rest ── */
    @media (max-width: 820px) {
      html.bx-kb .ap-nav { display: none !important; }
      html.bx-kb .bx-call, html.bx-kb .bx-clear, html.bx-kb .bx-note { display: none; }
    }
  </style>

  <script>
    // Real Blak — streams from the Groq-backed open-source chat via the
    // authenticated Blaksyd→Symp proxy (/api/blaksyd/symp/chat).
    // History persists per-user in localStorage; auto-retry + graceful recovery
    // mean a hiccup never leaves the user with a dead "…".
    import { supabase } from '../../lib/supabaseClient';
    import { computeCompleteness } from '../../../symp-core/lib/knowledge-schema.mjs';

    const $ = (id) => document.getElementById(id);
    const stream = $('bx-stream'), form = $('bx-form'), input = $('bx-input'),
          chips = $('bx-chips'), sendBtn = $('bx-send'), stopBtn = $('bx-stop'),
          jumpBtn = $('bx-jump'),
          historyBtn = $('bx-burger'), convoDrawer = $('bx-convos'),
          convoList = $('bx-cv-list'), cvNew = $('bx-cv-new'), cvScrim = $('bx-cv-scrim'),
          profileBtn = $('bx-profile'), personaBtn = $('bx-persona');

    const MAX_TURNS = 24; // how many recent messages to send as context

    let history = [];          // [{role, content, ts, id?}] — current thread, in memory
    let userId = null;
    let activeChatId = null;   // uuid of the open chat (server-persisted in `chats`)
    let sending = false;
    let controller = null;
    let atBottom = true;
    let titled = {};           // chatId -> true once auto-titled

    // ── Server-persisted threads (chats + messages tables, owner-only RLS) ──
    // The browser client reads/writes the signed-in user's own rows directly —
    // no localStorage — so threads are durable, real, and cross-device.
    const titleOf = (hist) => { const u = (hist || []).find(m => m.role === 'user'); return u ? u.content.slice(0, 42) : 'New chat'; };

    async function dbListChats() {
      if (!supabase || !userId) return [];
      try {
        const { data } = await supabase.from('chats').select('id,title,created_at,pinned_at')
          .eq('user_id', userId).is('persona_id', null)
          .order('pinned_at', { ascending: false, nullsFirst: false })
          .order('created_at', { ascending: false }).limit(100);
        return data || [];
      } catch (e) { return []; }
    }
    async function dbCreateChat(title) {
      if (!supabase || !userId) return null;
      try {
        const { data } = await supabase.from('chats')
          .insert({ user_id: userId, title: title || 'New chat' }).select('id,title,created_at').single();
        return data || null;
      } catch (e) { return null; }
    }
    async function dbLoadMessages(chatId) {
      try {
        const { data } = await supabase.from('messages')
          .select('id,role,content,created_at,media_url,media_type,media_description')
          .eq('chat_id', chatId).order('created_at', { ascending: true }).limit(500);
        return (data || []).map(m => ({
          id: m.id, role: m.role === 'user' ? 'user' : 'assistant',
          content: m.content || '', ts: m.created_at ? new Date(m.created_at).getTime() : Date.now(),
          media_url: m.media_url || null, media_type: m.media_type || null, media_description: m.media_description || null,
        }));
      } catch (e) { return []; }
    }
    async function dbInsertMessage(role, content, media) {
      if (!supabase || !activeChatId) return null;
      const row = { chat_id: activeChatId, role, content: content || '' };
      if (role === 'user') row.sender_id = userId;
      if (media) { row.media_url = media.url || null; row.media_type = media.type || null; if (media.description) row.media_description = media.description; }
      try { const { data } = await supabase.from('messages').insert(row).select('id').single(); return data ? data.id : null; }
      catch (e) { return null; }
    }
    async function dbDeleteMessage(id) { if (supabase && id) { try { await supabase.from('messages').delete().eq('id', id); } catch (e) {} } }
    async function dbDeleteChat(chatId) {
      if (!supabase) return;
      try { await supabase.from('messages').delete().eq('chat_id', chatId); } catch (e) {}
      try { await supabase.from('chats').delete().eq('id', chatId); } catch (e) {}
    }
    async function dbSetTitle(chatId, title) { if (supabase && chatId && title) { try { await supabase.from('chats').update({ title }).eq('id', chatId); } catch (e) {} } }
    async function dbSetPinned(chatId, on) { if (supabase && chatId) { try { await supabase.from('chats').update({ pinned_at: on ? new Date().toISOString() : null }).eq('id', chatId); } catch (e) {} } }

    // Smart thread name after the first user turn (free Groq title endpoint).
    async function maybeTitleConvo() {
      if (!activeChatId || titled[activeChatId]) return;
      if (history.filter(m => m.role === 'user').length !== 1) return;
      const id = activeChatId; titled[id] = true;
      const jwt = await getToken(); if (!jwt) return;
      try {
        const r = await fetch('/api/blaksyd/symp/title', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
          body: JSON.stringify({ messages: history.filter(m => m.role !== 'system').slice(0, 4).map(({ role, content }) => ({ role, content })) }),
        });
        const j = await r.json().catch(() => null);
        const t = j && j.data && j.data.title;
        if (t) await dbSetTitle(id, t);
      } catch (e) { /* the chat keeps its first-message title */ }
    }

    const fmtTime = (ts) => { try { return new Date(ts).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); } catch { return ''; } };

    function nearBottom() { return stream.scrollHeight - stream.scrollTop - stream.clientHeight < 80; }
    function scrollToBottom(force) { if (force || atBottom) stream.scrollTop = stream.scrollHeight; }
    stream.addEventListener('scroll', () => { atBottom = nearBottom(); jumpBtn.hidden = atBottom; });
    jumpBtn.addEventListener('click', () => { atBottom = true; stream.scrollTop = stream.scrollHeight; jumpBtn.hidden = true; });

    // Safe, minimal markdown for Blak's replies — Blak stays conversational, but
    // can use a clean list / **bold** / `code` when it genuinely helps (steps,
    // a plan, a recipe). HTML is escaped FIRST, so this can't inject markup.
    function renderRich(text) {
      const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      const inline = (s) => esc(s)
        .replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>')
        .replace(/`([^`\n]+)`/g, '<code>$1</code>')
        .replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');
      const lines = String(text || '').split('\n');
      let html = '', list = null;
      const closeList = () => { if (list) { html += list === 'ul' ? '</ul>' : '</ol>'; list = null; } };
      for (const raw of lines) {
        const ul = raw.match(/^\s*[-•]\s+(.+)$/);
        const ol = raw.match(/^\s*\d+[.)]\s+(.+)$/);
        if (ul) { if (list !== 'ul') { closeList(); html += '<ul class="bx-md">'; list = 'ul'; } html += '<li>' + inline(ul[1]) + '</li>'; continue; }
        if (ol) { if (list !== 'ol') { closeList(); html += '<ol class="bx-md">'; list = 'ol'; } html += '<li>' + inline(ol[1]) + '</li>'; continue; }
        closeList();
        html += inline(raw) + '\n';
      }
      closeList();
      return html.replace(/\n+$/, '');
    }

    // Render one message row. Returns handles for live updating (streaming).
    function addRow(side, text, opts = {}) {
      const ts = opts.ts || Date.now();
      const row = document.createElement('div');
      row.className = 'bx-row ' + side + (opts.err ? ' err' : '') + (opts.media_type === 'call' ? ' bx-call-turn' : '');
      const av = side === 'them' ? '<span class="bx-av"></span>' : '';
      row.innerHTML = av + '<div class="bx-col"><div class="bx-bub"></div></div>';
      const col = row.querySelector('.bx-col');
      const bub = row.querySelector('.bx-bub');
      if (opts.typing) {
        bub.innerHTML = '<span class="bx-typing"><span class="bx-dot"></span><span class="bx-dot"></span><span class="bx-dot"></span></span>';
      } else {
        if (opts.media_type === 'audio' && opts.media_url) {
          const au = document.createElement('audio'); au.className = 'bx-audio'; au.controls = true; au.preload = 'metadata'; au.src = opts.media_url; bub.appendChild(au);
          if (opts.media_description) { const cap = document.createElement('p'); cap.className = 'bx-vn-cap'; cap.textContent = '“' + opts.media_description + '”'; bub.appendChild(cap); }
        } else if (opts.media_type === 'doc') {
          const chip = document.createElement('span'); chip.className = 'bx-doc';
          chip.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg>';
          const nm = document.createElement('span'); nm.className = 'bx-doc-nm'; nm.textContent = text || 'Document'; chip.appendChild(nm);
          bub.appendChild(chip);
        } else if (opts.media_url) {
          const im = document.createElement('img'); im.className = 'bx-img'; im.src = opts.media_url; im.alt = 'shared image'; im.loading = 'lazy'; bub.appendChild(im);
        }
        if (opts.media_type !== 'doc' && (text || !opts.media_url)) {
          const tx = document.createElement('span');
          if (side === 'them' && text) tx.innerHTML = renderRich(text); else tx.textContent = text;
          bub.appendChild(tx);
        }
        addMeta(col, ts, side, opts.media_url && !text ? '' : text, opts.msg || null);
      }
      stream.appendChild(row);
      scrollToBottom(side === 'me');
      return { row, col, bub, ts };
    }

    function stamp(handle) {
      if (handle.col.querySelector('.bx-meta')) return;
      const side = handle.row && handle.row.classList.contains('them') ? 'them' : 'me';
      const isErr = handle.row && handle.row.classList.contains('err');
      const text = (side === 'them' && !isErr && handle.bub) ? (handle.bub.textContent || '') : '';
      addMeta(handle.col, handle.ts, side, text);
    }

    function render() {
      stream.innerHTML = '';
      for (const m of history) {
        if (!m.content && !m.media_url) continue;   // skip empty/failed turns (don't render blank bubbles)
        addRow(m.role === 'user' ? 'me' : 'them', m.content, { ts: m.ts, media_url: m.media_url, media_type: m.media_type, media_description: m.media_description, msg: m });
      }
      attachRegen();
      scrollToBottom(true);
    }

    // A small "regenerate" control under the latest Blak message.
    function attachRegen() {
      stream.querySelectorAll('.bx-regen').forEach(b => b.remove());
      const rows = [...stream.querySelectorAll('.bx-row.them')];
      const last = rows[rows.length - 1];
      if (!last || sending || history.length < 2) return;
      if (history[history.length - 1].role !== 'assistant') return;
      const btn = document.createElement('button');
      btn.className = 'bx-regen';
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 109-9 9 9 0 00-7 3.3M3 4v3.3h3.3"/></svg>regenerate';
      btn.onclick = regenerate;
      last.querySelector('.bx-col').appendChild(btn);
    }

    function updateChips() {
      // Starter prompts only matter before the first real exchange.
      const hasUserMsg = history.some(m => m.role === 'user');
      chips.hidden = hasUserMsg;
    }

    function setBusy(b) {
      sending = b;
      form.classList.toggle('bx-sending', b);
      sendBtn.hidden = b; stopBtn.hidden = !b;
      input.disabled = false;
      if (b) { stream.querySelectorAll('.bx-regen').forEach(x => x.remove()); }
      else { attachRegen(); }
    }

    async function getToken() {
      if (!supabase) return null;
      try { return (await supabase.auth.getSession()).data?.session?.access_token || null; }
      catch { return null; }
    }

    // ── Read aloud: speak a Blak message in Blak's voice ──────────────────────
    // Reuses the call's Gemini voice via the bridge /tts endpoint (POST {voice,
    // text} → {audio: base64 wav}). The bridge hard-caps text at 240 chars, so we
    // chunk long messages at sentence boundaries and play them gaplessly,
    // prefetching the next clip while the current one plays.
    const SPK = {
      spk:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>',
      stop: '<svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><rect x="6" y="6" width="12" height="12" rx="2.5"/></svg>',
      spin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3a9 9 0 1 0 9 9"/></svg>',
    };
    let ttsCfg = null;          // { url, voice } — derived once from the call session
    let speakAudio = null;      // the <audio> currently playing
    let speakBtn = null;        // the button driving the active read-aloud
    let speakSeq = 0;           // bumped to cancel any in-flight read-aloud

    // Copy a message to the clipboard, with a brief ✓ confirmation on the button.
    const ICON_COPY = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>';
    const ICON_CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
    async function copyMsg(text, btn) {
      try { await navigator.clipboard.writeText(text); }
      catch (e) {
        try { const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.focus(); ta.select(); document.execCommand('copy'); ta.remove(); } catch (_) { return; }
      }
      btn.classList.add('done'); btn.innerHTML = ICON_CHECK;
      setTimeout(() => { btn.classList.remove('done'); btn.innerHTML = ICON_COPY; }, 1200);
    }

    async function ensureTts() {
      if (ttsCfg) return ttsCfg;
      try {
        const jwt = await getToken();
        const r = await fetch('/api/gemini-live-session', { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (jwt || '') }, body: '{}' });
        const j = await r.json().catch(() => null);
        if (j && j.wsUrl) ttsCfg = { url: j.wsUrl.replace(/^wss:/, 'https:').replace(/\/live$/, '/tts'), voice: j.voice || 'Aoede' };
      } catch (e) { /* read-aloud unavailable */ }
      return ttsCfg;
    }

    function stripForSpeech(t) {
      return String(t || '')
        .replace(/```[\s\S]*?```/g, ' ')                 // code blocks
        .replace(/`([^`]+)`/g, '$1')                     // inline code
        .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')           // images
        .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')         // links → label
        .replace(/https?:\/\/\S+/g, ' ')                 // raw urls
        .replace(/[*_#>~|]/g, '')                        // markdown symbols
        .replace(/[\u{1F000}-\u{1FAFF}\u{2600}-\u{27BF}\u{2190}-\u{21FF}\u{2B00}-\u{2BFF}\u{FE0F}\u{200D}]/gu, '') // emoji
        .replace(/\s+/g, ' ').trim();
    }

    function chunkForTts(text, max = 230) {
      const clean = stripForSpeech(text);
      if (!clean) return [];
      if (clean.length <= max) return [clean];
      const sentences = clean.match(/[^.!?]+[.!?]+(?:["')\]]+)?|\S[^.!?]*$/g) || [clean];
      const chunks = []; let cur = '';
      for (let s of sentences) {
        s = s.trim(); if (!s) continue;
        while (s.length > max) {                          // a single over-long sentence
          let cut = s.lastIndexOf(' ', max); if (cut < max * 0.6) cut = max;
          chunks.push(s.slice(0, cut).trim()); s = s.slice(cut).trim();
        }
        if (!cur) cur = s;
        else if ((cur + ' ' + s).length <= max) cur += ' ' + s;
        else { chunks.push(cur); cur = s; }
      }
      if (cur) chunks.push(cur);
      return chunks;
    }

    async function synthClip(text) {
      try {
        const cfg = await ensureTts(); if (!cfg) return null;
        const jwt = await getToken();
        const r = await fetch(cfg.url, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (jwt || '') }, body: JSON.stringify({ voice: cfg.voice, text }) });
        const j = await r.json().catch(() => null);
        return (j && j.audio) ? 'data:audio/wav;base64,' + j.audio : null;
      } catch (e) { return null; }
    }

    function playClip(src, seq) {
      return new Promise((resolve) => {
        const a = new Audio(src); speakAudio = a;
        const done = () => { if (speakAudio === a) speakAudio = null; resolve(); };
        a.onended = done; a.onerror = done;
        a.play().catch(done);
        if (seq !== speakSeq) { try { a.pause(); } catch (e) {} done(); }
      });
    }

    function setSpeakIcon(btn, state) {
      if (!btn) return;
      btn.classList.toggle('playing', state === 'playing');
      btn.classList.toggle('loading', state === 'loading');
      btn.innerHTML = state === 'loading' ? SPK.spin : state === 'playing' ? SPK.stop : SPK.spk;
    }

    function stopSpeak() {
      speakSeq++;                                          // cancel any in-flight loop
      if (speakAudio) { try { speakAudio.pause(); } catch (e) {} speakAudio = null; }
      if (speakBtn) { setSpeakIcon(speakBtn, 'idle'); speakBtn = null; }
    }

    async function speakMessage(rawText, btn) {
      if (speakBtn === btn) { stopSpeak(); return; }       // tap again → stop
      stopSpeak();                                         // stop anything else first
      const chunks = chunkForTts(rawText);
      if (!chunks.length) return;
      const seq = ++speakSeq;
      speakBtn = btn; setSpeakIcon(btn, 'loading');
      const jobs = new Array(chunks.length).fill(null);
      const job = (i) => { if (i < chunks.length && !jobs[i]) jobs[i] = synthClip(chunks[i]); return jobs[i]; };
      job(0);                                              // kick off the first clip
      for (let i = 0; i < chunks.length; i++) {
        const src = await job(i);
        if (seq !== speakSeq) return;                      // stopped or replaced
        job(i + 1);                                        // prefetch next while this plays
        if (!src) continue;                                // skip a failed clip
        setSpeakIcon(btn, 'playing');
        await playClip(src, seq);
        if (seq !== speakSeq) return;
      }
      if (seq === speakSeq) { speakBtn = null; setSpeakIcon(btn, 'idle'); }
    }

    // Build the meta row under a bubble: timestamp + copy + (Blak) read-aloud +
    // (your text messages) edit. Idempotent — safe from both addRow and stamp().
    function addMeta(col, ts, side, text, msg) {
      if (!col || col.querySelector('.bx-meta')) return;
      const meta = document.createElement('div'); meta.className = 'bx-meta';
      const time = document.createElement('time'); time.className = 'bx-time'; time.textContent = fmtTime(ts);
      meta.appendChild(time);
      if (text && text.trim()) {
        const cp = document.createElement('button');
        cp.type = 'button'; cp.className = 'bx-copy'; cp.title = 'Copy'; cp.setAttribute('aria-label', 'Copy message');
        cp.innerHTML = ICON_COPY;
        const txt = text;
        cp.addEventListener('click', () => copyMsg(txt, cp));
        meta.appendChild(cp);
      }
      if (side === 'them' && text && text.trim()) {
        const sp = document.createElement('button');
        sp.type = 'button'; sp.className = 'bx-speak'; sp.title = 'Read aloud'; sp.setAttribute('aria-label', 'Read aloud');
        sp.innerHTML = SPK.spk;
        const say = text;
        sp.addEventListener('click', () => speakMessage(say, sp));
        meta.appendChild(sp);
      }
      // Edit & resend — only your own TEXT messages (no media to re-run).
      if (side === 'me' && msg && text && text.trim() && !msg.media_url) {
        const ed = document.createElement('button');
        ed.type = 'button'; ed.className = 'bx-edit'; ed.title = 'Edit & resend'; ed.setAttribute('aria-label', 'Edit & resend');
        ed.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>';
        ed.addEventListener('click', () => startEdit(msg));
        meta.appendChild(ed);
      }
      col.appendChild(meta);
    }

    function payload() {
      return history.filter(m => m.role === 'user' || m.role === 'assistant')
                    .slice(-MAX_TURNS)
                    .map((m) => {
                      let c = m.content || '';
                      if (m.media_type === 'audio') {
                        if (m.media_description) c = (c ? c + '\n\n' : '') + '[Voice note I sent — transcript: ' + m.media_description + ']';
                        else if (!c) c = '[I sent a voice note.]';
                      } else if (m.media_type === 'doc') {
                        c = '[Document I shared' + (c ? ' (' + c + ')' : '') + ' — contents:\n' + String(m.media_description || '').slice(0, 12000) + ']';
                      } else if (m.media_description) {
                        c = (c ? c + '\n\n' : '') + '[Image I shared — it shows: ' + m.media_description + ']';
                      } else if (!c && m.media_url) {
                        c = '[I shared an image.]';
                      }
                      if (m.visionContext) c = (c ? c + '\n\n' : '') + '[Looking again at that image, I checked: ' + m.visionContext + ']';
                      return { role: m.role, content: c };
                    });
    }

    // One streaming attempt. Throws on transport error; returns accumulated text.
    async function attempt(typing) {
      controller = new AbortController();
      const jwt = await getToken();
      if (!jwt) { const e = new Error('no_auth'); e.code = 'no_auth'; throw e; }
      const res = await fetch('/api/blaksyd/symp/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
        body: JSON.stringify({ messages: payload(), stream: true, no_learn: incognito }),
        signal: controller.signal,
      });
      if (!res.ok || !res.body) throw new Error('http_' + res.status);
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let acc = '', buf = '';
      typing.bub.textContent = '';
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        const lines = buf.split('\n'); buf = lines.pop() || '';
        for (const line of lines) {
          const t = line.trim();
          if (!t.startsWith('data:')) continue;
          const p = t.slice(5).trim();
          if (!p || p === '[DONE]') continue;
          let obj; try { obj = JSON.parse(p); } catch { continue; }
          if (obj.delta) { acc += obj.delta; typing.bub.textContent = acc; scrollToBottom(); }
          if (obj.error) throw new Error(String(obj.error));
        }
      }
      return acc.trim();
    }

    function showError(typing, srcText) {
      typing.row.classList.add('err');
      typing.bub.textContent = "I lost my train of thought for a second — your message is safe.";
      const retry = document.createElement('button');
      retry.className = 'bx-retry'; retry.textContent = 'Try again';
      retry.onclick = () => { typing.row.remove(); runTurn(srcText); };
      typing.col.appendChild(retry);
      setBusy(false);
    }

    // Drive one assistant turn for the already-appended user message `srcText`.
    async function runTurn(srcText, preTyping) {
      setBusy(true);
      const typing = preTyping || addRow('them', '', { typing: true });
      try {
        let acc = '';
        try { acc = await attempt(typing); }
        catch (e) {
          if (e.name === 'AbortError') throw e;
          if (e.code === 'no_auth') {
            typing.bub.textContent = "Sign in first and I'm all yours — log in from the menu and come back.";
            stamp(typing); setBusy(false); return;
          }
          acc = ''; // fall through to one auto-retry
        }
        if (!acc) {
          typing.bub.innerHTML = '<span class="bx-typing"><span class="bx-dot"></span><span class="bx-dot"></span><span class="bx-dot"></span></span>';
          await new Promise(r => setTimeout(r, 700)); // let a rate-limited provider's window breathe before the backstop retry
          acc = await attempt(typing);
        }
        acc = acc.trim();
        const shown = acc || "Mmm — I didn't catch that. Say it once more?";
        typing.bub.innerHTML = renderRich(shown);   // light markdown for the final reply
        stamp(typing);
        const am = { role: 'assistant', content: shown, ts: typing.ts };
        history.push(am);
        dbInsertMessage('assistant', shown).then((id) => { if (id) am.id = id; });
        maybeTitleConvo();
        setBusy(false);
      } catch (e) {
        if (e.name === 'AbortError') {
          const partial = (typing.bub.textContent || '').trim();
          if (partial) { stamp(typing); const am = { role: 'assistant', content: partial, ts: typing.ts }; history.push(am); dbInsertMessage('assistant', partial).then((id) => { if (id) am.id = id; }); }
          else typing.row.remove();
          setBusy(false);
        } else {
          showError(typing, srcText);
        }
      } finally {
        controller = null;
      }
    }

    // Call-on-request — if the user asks Blak to call (typed or in a voice note),
    // confirm first with a tap-to-call offer instead of a text reply.
    const CALL_INTENT = /\b(call me|call now|gimme a call|give me a call|can you call me|can we (call|talk)|could you call|wanna call|want to call|let'?s (call|hop on)|voice call|hop on a call|jump on a call|ring me|call you now)\b/i;
    function offerCall() {
      const h = addRow('them', '');
      h.bub.textContent = 'want me to call you now?';
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'bx-calloffer';
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg> Call now';
      btn.onclick = () => { btn.disabled = true; openCall(); };
      h.col.appendChild(btn);
      stamp(h);
      requestAnimationFrame(() => scrollToBottom(true));   // after layout, keep the offer + button above the composer
    }

    // ── In-app reminders: "remind me to … [when]" → saved + surfaced on home ───
    const REMIND_INTENT = /\b(remind me|set a reminder|reminder to)\b/i;
    function applyClock(d, m) {
      let h = parseInt(m[1], 10); const min = m[3] ? parseInt(m[3], 10) : 0; const ap = (m[4] || '').toLowerCase();
      if (ap === 'pm' && h < 12) h += 12; if (ap === 'am' && h === 12) h = 0;
      d.setHours(h, min, 0, 0); return d;
    }
    function parseRemindAt(text) {
      const now = new Date(); const s = text.toLowerCase(); let d = null, m;
      if ((m = s.match(/in (\d+)\s*(min|minute|minutes|hour|hours|hr|hrs|day|days|week|weeks)/))) {
        const n = parseInt(m[1], 10); d = new Date(now);
        if (/min/.test(m[2])) d.setMinutes(d.getMinutes() + n);
        else if (/h(ou)?r/.test(m[2])) d.setHours(d.getHours() + n);
        else if (/day/.test(m[2])) d.setDate(d.getDate() + n);
        else d.setDate(d.getDate() + 7 * n);
      } else if (/tomorrow/.test(s)) {
        d = new Date(now); d.setDate(d.getDate() + 1); d.setHours(9, 0, 0, 0);
        const tm = s.match(/at (\d{1,2})(:(\d{2}))?\s*(am|pm)?/); if (tm) applyClock(d, tm);
      } else if (/tonight|this evening/.test(s)) {
        d = new Date(now); d.setHours(20, 0, 0, 0); if (d <= now) d.setDate(d.getDate() + 1);
      } else if (/next week/.test(s)) {
        d = new Date(now); d.setDate(d.getDate() + 7); d.setHours(9, 0, 0, 0);
      } else if ((m = s.match(/at (\d{1,2})(:(\d{2}))?\s*(am|pm)?/))) {
        d = applyClock(new Date(now), m); if (d <= now) d.setDate(d.getDate() + 1);
      }
      if (!d) { d = new Date(now); d.setDate(d.getDate() + 1); d.setHours(9, 0, 0, 0); }   // default: tomorrow 9am
      return d;
    }
    function parseReminderText(text) {
      let t = text.replace(/^\s*(please\s+|hey\s+|can you\s+|could you\s+)*(remind me|set a reminder|reminder)\s*(to|that|about|:)?\s*/i, '');
      t = t.replace(/\b(tomorrow|tonight|this evening|next week|in \d+\s*(min|minute|minutes|hour|hours|hr|hrs|day|days|week|weeks)|at \d{1,2}(:\d{2})?\s*(am|pm)?)\b/gi, '').replace(/\s+/g, ' ').replace(/[\s,]+$/, '').trim();
      return t || 'this';
    }
    function friendlyWhen(d) {
      const now = new Date(); const ms = d - now;
      const time = d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
      const tmrw = new Date(now); tmrw.setDate(tmrw.getDate() + 1);
      if (ms > 0 && ms < 5400000) return 'in a bit';
      if (d.toDateString() === now.toDateString()) return 'later today (' + time + ')';
      if (d.toDateString() === tmrw.toDateString()) return 'tomorrow (' + time + ')';
      return 'on ' + d.toLocaleDateString([], { weekday: 'long' }) + ' (' + time + ')';
    }
    async function handleReminder(text) {
      const remindAt = parseRemindAt(text);
      const task = parseReminderText(text);
      let saved = false;
      try { const { error } = await supabase.from('blak_reminders').insert({ user_id: userId, text: task, remind_at: remindAt.toISOString() }); saved = !error; } catch (e) {}
      const reply = saved
        ? ("got it — i'll nudge you to " + task + ' ' + friendlyWhen(remindAt) + ' ⏰')
        : "hmm, i couldn't save that reminder just now — mind trying again?";
      const am = { role: 'assistant', content: reply, ts: Date.now() };
      history.push(am); addRow('them', reply, { msg: am });
      if (saved) dbInsertMessage('assistant', reply).then((id) => { if (id) am.id = id; });
    }
    async function loadReminders() {
      const wrap = $('bx-reminders'); if (!wrap || !supabase || !userId) return;
      try {
        const { data } = await supabase.from('blak_reminders')
          .select('id,text,remind_at').eq('user_id', userId).eq('done', false)
          .lte('remind_at', new Date().toISOString()).order('remind_at', { ascending: true }).limit(5);
        const due = data || [];
        if (!due.length) { wrap.hidden = true; wrap.innerHTML = ''; return; }
        wrap.hidden = false; wrap.innerHTML = '';
        for (const r of due) {
          const el = document.createElement('div'); el.className = 'bx-rem';
          el.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M9 2h6"/></svg><span class="bx-rem-tx"></span><button type="button" class="bx-rem-done">Done</button>';
          el.querySelector('.bx-rem-tx').textContent = r.text;
          el.querySelector('.bx-rem-done').onclick = async () => {
            el.remove(); if (!wrap.querySelector('.bx-rem')) wrap.hidden = true;
            try { await supabase.from('blak_reminders').update({ done: true }).eq('id', r.id); } catch (e) {}
          };
          wrap.appendChild(el);
        }
      } catch (e) {}
    }

    // ── Proactive nudges: Blak reaching out (surfaced on the home screen) ──────
    async function loadNudges() {
      const wrap = $('bx-nudges'); if (!wrap || !supabase || !userId) return;
      try {
        const now = new Date();
        const floor = new Date(now.getTime() - 3 * 86400000).toISOString();   // hide nudges that went stale (>3d)
        const { data } = await supabase.from('blak_nudges')
          .select('id,text,kind,due_at').eq('user_id', userId).eq('status', 'pending')
          .lte('due_at', now.toISOString()).gte('due_at', floor)
          .order('due_at', { ascending: false }).limit(3);
        const due = data || [];
        if (!due.length) { wrap.hidden = true; wrap.innerHTML = ''; return; }
        wrap.hidden = false; wrap.innerHTML = '';
        for (const n of due) {
          const el = document.createElement('div'); el.className = 'bx-nudge';
          el.innerHTML = '<span class="bx-nudge-mark">✦</span><div class="bx-nudge-body"><div class="bx-nudge-tx"></div><div class="bx-nudge-acts"><button type="button" class="bx-nudge-reply">Reply</button><button type="button" class="bx-nudge-x">Dismiss</button></div></div>';
          el.querySelector('.bx-nudge-tx').textContent = n.text;
          el.querySelector('.bx-nudge-reply').onclick = () => startNudgeChat(n);
          el.querySelector('.bx-nudge-x').onclick = async () => {
            el.remove(); if (!wrap.querySelector('.bx-nudge')) wrap.hidden = true;
            try { await supabase.from('blak_nudges').update({ status: 'dismissed' }).eq('id', n.id); } catch (e) {}
          };
          wrap.appendChild(el);
        }
      } catch (e) {}
    }
    async function startNudgeChat(n) {
      try { await supabase.from('blak_nudges').update({ status: 'acted' }).eq('id', n.id); } catch (e) {}
      const c = await dbCreateChat((n.text || 'Blak').slice(0, 42));
      activeChatId = c ? c.id : null;
      const am = { role: 'assistant', content: n.text, ts: Date.now() };
      history = [am];
      render(); updateChips();
      if (activeChatId) dbInsertMessage('assistant', n.text).then((id) => { if (id) am.id = id; });
      input.focus();
    }

    async function send(text) {
      text = (text || '').trim();
      const img = pendingImage;
      if ((!text && !img) || sending) return;   // empty, or a turn is already in flight
      pendingImage = null; showPreview(null);
      setBusy(true);                             // synchronous in-flight guard — blocks a 2nd send during the awaits below
      try {
        // Edit & resend: drop the message being edited + everything after it
        // (history + DOM + server), then send the edited text as a fresh turn.
        if (editing) {
          const em = editing; editing = null; hideEditPill();
          const idx = history.indexOf(em);
          if (idx >= 0) {
            const removed = history.splice(idx);
            for (const r of removed) if (r && r.id) dbDeleteMessage(r.id);
            render();
          }
        }
        if (!incognito && !activeChatId) { const c = await dbCreateChat((text || 'Shared an image').slice(0, 42)); if (c) activeChatId = c.id; }
        const um = { role: 'user', content: text, ts: Date.now(), media_url: img ? img.url : null, media_type: img ? img.type : null, media_description: null };
        history.push(um);
        addRow('me', text, { media_url: um.media_url, msg: um });
        updateChips();
        // For an image: show the typing indicator immediately (describing can be
        // slow — without this the app looks frozen), and cap the describe so a
        // slow/failed vision call can never hang the turn.
        let typing = null;
        if (img) {
          typing = addRow('them', '', { typing: true });
          const desc = await Promise.race([
            visionDescribe(img.url),
            new Promise((r) => setTimeout(() => r(null), 12000)),
          ]);
          um.media_description = desc || null;
        }
        dbInsertMessage('user', text, img ? { url: img.url, type: img.type, description: um.media_description } : null).then((id) => { if (id) um.id = id; });
        if (text && !img && REMIND_INTENT.test(text)) { await handleReminder(text); setBusy(false); return; }   // "remind me to…" → save it
        if (text && !img && CALL_INTENT.test(text)) { setBusy(false); offerCall(); return; }   // they asked to call → offer it
        // Re-examine a recently shared image when the message clearly asks about it.
        if (text && !img && IMG_REF.test(text) && isImgQuestion(text)) {
          const recentImg = history.slice(0, -1).slice(-6).reverse().find((m) => m.media_type === 'image' && m.media_url);
          if (recentImg) { const ans = await visionAsk(recentImg.media_url, text); if (ans) um.visionContext = ans; }
        }
        await runTurn(text, typing);
      } catch (e) {
        setBusy(false);
      }
    }

    function regenerate() {
      if (sending || history.length < 2) return;
      // drop the last assistant turn (history + DOM + server) and re-ask the prior user msg
      if (history[history.length - 1].role === 'assistant') { const dropped = history.pop(); dbDeleteMessage(dropped && dropped.id); }
      const lastThem = [...stream.querySelectorAll('.bx-row.them')].pop();
      if (lastThem) lastThem.remove();
      const lastUser = [...history].reverse().find(m => m.role === 'user');
      if (lastUser) runTurn(lastUser.content);
    }

    // ── Composer behaviour ───────────────────────────────────────────────
    function autogrow() { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 140) + 'px'; }
    function syncComposer() { form.classList.toggle('has-text', input.value.trim().length > 0); }
    input.addEventListener('input', () => { autogrow(); syncComposer(); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
    });
    form.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value; input.value = ''; autogrow(); syncComposer(); send(v); });
    chips.addEventListener('click', (e) => { const b = e.target.closest('.bx-chip'); if (b) send(b.getAttribute('data-msg')); });
    stopBtn.addEventListener('click', () => { if (controller) controller.abort(); });
    // Trailing button: a click Sends when there's text. With no text it's the mic —
    // press-and-hold to record (wired below), so a click alone does nothing.
    sendBtn.addEventListener('click', () => { if (input.value.trim()) form.requestSubmit(); });

    // ── Image attach + voice note (text composer) ─────────────────────────
    const addBtn = $('bx-add'), fileInput = $('bx-file'), attachPreview = $('bx-attach-preview');
    let pendingImage = null;   // { url, type } once uploaded to storage

    async function processImage(file) {
      // Re-encode via canvas to STRIP EXIF (incl. GPS) and cap dimensions.
      try {
        const bmp = await createImageBitmap(file);
        const max = 1600; let w = bmp.width, h = bmp.height;
        if (w > max || h > max) { const s = max / Math.max(w, h); w = Math.round(w * s); h = Math.round(h * s); }
        const c = document.createElement('canvas'); c.width = w; c.height = h;
        c.getContext('2d').drawImage(bmp, 0, 0, w, h);
        const blob = await new Promise((res) => c.toBlob(res, 'image/jpeg', 0.85));
        return blob || file;
      } catch (e) { return file; }
    }
    async function uploadChatImage(file) {
      if (!supabase || !file) return null;
      // No size cap — processImage re-encodes to a dimension-capped JPEG, so even a
      // big phone photo uploads small. Let people share whatever they want.
      const blob = await processImage(file);
      const path = (userId || 'anon') + '/' + ((window.crypto && crypto.randomUUID) ? crypto.randomUUID() : (Date.now() + '-' + Math.round(Math.random() * 1e9))) + '.jpg';
      const { error } = await supabase.storage.from('chat_images').upload(path, blob, { contentType: blob.type || 'image/jpeg', upsert: false });
      if (error) { alert('Image upload failed — try again.'); return null; }
      return supabase.storage.from('chat_images').getPublicUrl(path).data.publicUrl;
    }
    function showPreview(url) {
      if (!attachPreview) return;
      if (!url) { attachPreview.hidden = true; attachPreview.innerHTML = ''; return; }
      attachPreview.hidden = false;
      attachPreview.innerHTML = '<img alt="attachment"/><button type="button" class="bx-attach-x">remove</button>';
      attachPreview.querySelector('img').src = url;
      attachPreview.querySelector('.bx-attach-x').onclick = () => { pendingImage = null; showPreview(null); };
    }
    async function visionDescribe(url) {
      try {
        const jwt = await getToken(); if (!jwt) return '';
        const r = await fetch('/api/blaksyd/symp/vision', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
          body: JSON.stringify({ imageUrl: url }),
        });
        const j = await r.json().catch(() => null);
        return (j && j.data && (j.data.description || j.data.text)) || '';
      } catch (e) { return ''; }
    }
    // The "+" opens a small menu: Photo (existing attach) or New group with Blak.
    const addMenu = $('bx-add-menu');
    const closeAddMenu = () => { if (addMenu) addMenu.hidden = true; };
    if (addBtn) addBtn.addEventListener('click', (e) => { e.stopPropagation(); if (addMenu) addMenu.hidden = !addMenu.hidden; });
    const addPhoto = $('bx-add-photo'), addGroup = $('bx-add-group');
    if (addPhoto) addPhoto.addEventListener('click', () => { closeAddMenu(); if (fileInput) fileInput.click(); });
    if (addGroup) addGroup.addEventListener('click', () => { closeAddMenu(); window.location.href = '/beta/group/'; });
    // ── Incognito: a private chat that isn't saved or learned from ────────────
    let incognito = false;
    const incogPill = $('bx-incog-pill');
    function setIncognito(on) { incognito = on; if (incogPill) incogPill.hidden = !on; }
    function enterIncognito() {
      if (sending && controller) { try { controller.abort(); } catch (e) {} }
      activeChatId = null; history = []; cancelEdit();
      setIncognito(true);
      render(); updateChips(); closeDrawer(); input.focus();
    }
    const addIncog = $('bx-add-incognito');
    if (addIncog) addIncog.addEventListener('click', () => { closeAddMenu(); enterIncognito(); });
    { const ix = $('bx-incog-exit'); if (ix) ix.addEventListener('click', () => { newConvo(); }); }
    const addSummary = $('bx-add-summary');
    if (addSummary) addSummary.addEventListener('click', () => { closeAddMenu(); summarizeThread(activeChatId, null); });
    const addExport = $('bx-add-export');
    if (addExport) addExport.addEventListener('click', () => { closeAddMenu(); exportChat(); });
    document.addEventListener('click', (e) => { if (addMenu && !addMenu.hidden && !addMenu.contains(e.target) && !addBtn.contains(e.target)) closeAddMenu(); });

    // ── Export this chat as a .txt download ───────────────────────────────────
    function exportChat() {
      const msgs = (history || []).filter(m => (m.role === 'user' || m.role === 'assistant') && ((m.content && m.content.trim()) || m.media_url));
      if (msgs.length < 1) return;
      const lines = ['Blak — Blaksyd', new Date().toLocaleString(), ''];
      for (const m of msgs) {
        const who = m.role === 'user' ? 'You' : 'Blak';
        let c = String(m.content || '').trim();
        if (!c && m.media_type === 'audio') c = m.media_description ? '[voice note: ' + m.media_description + ']' : '[voice note]';
        else if (!c && m.media_type === 'call') c = '[voice call]';
        else if (!c && m.media_url) c = '[image]';
        else if (m.media_url && m.media_type === 'image') c = c + ' [image]';
        const t = m.ts ? ' (' + fmtTime(m.ts) + ')' : '';
        lines.push(who + t + ': ' + c);
      }
      const blob = new Blob([lines.join('\n')], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const slug = (history.length && activeChatId) ? 'chat' : 'chat';
      a.href = url; a.download = 'blak-' + slug + '-' + new Date().toISOString().slice(0, 10) + '.txt';
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
    }

    // ── Edit & resend: load a past message back into the composer ──────────────
    let editing = null;                       // the history message object being edited
    const editPill = $('bx-edit-pill');
    function hideEditPill() { if (editPill) editPill.hidden = true; }
    function startEdit(msg) {
      if (sending || !msg) return;
      editing = msg;
      input.value = msg.content || '';
      autogrow(); syncComposer(); input.focus();
      if (editPill) editPill.hidden = false;
      try { input.setSelectionRange(input.value.length, input.value.length); } catch (e) {}
    }
    function cancelEdit() { editing = null; input.value = ''; autogrow(); syncComposer(); hideEditPill(); }
    { const ec = $('bx-edit-cancel'); if (ec) ec.addEventListener('click', cancelEdit); }

    // ── Summarize a thread → warm recap in a slide-up sheet ───────────────────
    const sumSheet = $('bx-sum'), sumScrim = $('bx-sum-scrim'), sumX = $('bx-sum-x'),
          sumBody = $('bx-sum-body'), sumTitle = $('bx-sum-title');
    function closeSum() { try { stopSpeak(); } catch (e) {} if (sumSheet) sumSheet.hidden = true; }
    if (sumScrim) sumScrim.addEventListener('click', closeSum);
    if (sumX) sumX.addEventListener('click', closeSum);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && sumSheet && !sumSheet.hidden) closeSum(); });

    function renderSum(summary) {
      sumBody.className = 'bx-sum-body';
      sumBody.textContent = summary;
      const acts = document.createElement('div'); acts.className = 'bx-sum-actions';
      const rd = document.createElement('button'); rd.type = 'button'; rd.className = 'bx-speak'; rd.title = 'Read aloud'; rd.setAttribute('aria-label', 'Read aloud'); rd.innerHTML = SPK.spk;
      rd.addEventListener('click', () => speakMessage(summary, rd));
      const lbl = document.createElement('span'); lbl.className = 'bx-sum-rdlbl'; lbl.textContent = 'Read aloud';
      lbl.addEventListener('click', () => speakMessage(summary, rd));
      acts.appendChild(rd); acts.appendChild(lbl);
      sumBody.appendChild(acts);
    }

    async function summarizeThread(chatId, title) {
      if (!chatId || !sumSheet) return;
      let msgs = (chatId === activeChatId) ? history : await dbLoadMessages(chatId);
      const real = (msgs || []).filter((m) => (m.role === 'user' || m.role === 'assistant') && ((m.content && m.content.trim()) || m.media_url || m.media_type));
      sumTitle.textContent = title || 'Recap';
      sumBody.className = 'bx-sum-body loading';
      sumBody.textContent = 'Reading back through this chat…';
      sumSheet.hidden = false;
      if (real.length < 2) { sumBody.className = 'bx-sum-body'; sumBody.textContent = "There's not much here yet — chat a little more and I'll recap it for you."; return; }
      try {
        const jwt = await getToken();
        const payloadMsgs = real.slice(-80).map((m) => ({ role: m.role, content: m.content || '', media_type: m.media_type || null, media_description: m.media_description || null, media_url: m.media_url || null }));
        const r = await fetch('/api/blaksyd/symp/summarize', { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (jwt || '') }, body: JSON.stringify({ messages: payloadMsgs, title: title || null }) });
        const j = await r.json().catch(() => null);
        const summary = j && j.data && j.data.summary;
        if (!summary) throw new Error('no_summary');
        renderSum(summary);
      } catch (e) {
        sumBody.className = 'bx-sum-body'; sumBody.textContent = "I couldn't pull that together just now — try again in a moment.";
      }
    }
    if (fileInput) fileInput.addEventListener('change', async () => {
      const file = fileInput.files && fileInput.files[0]; fileInput.value = '';
      if (!file) return;
      addBtn.classList.add('busy');
      const url = await uploadChatImage(file);
      addBtn.classList.remove('busy');
      if (url) { pendingImage = { url, type: 'image' }; showPreview(url); input.focus(); }
    });

    // ── Documents / PDFs: extract text in the browser, feed it to Blak ─────────
    const docInput = $('bx-doc-file');
    const addDoc = $('bx-add-doc');
    if (addDoc) addDoc.addEventListener('click', () => { closeAddMenu(); if (docInput) docInput.click(); });
    async function extractDocText(file) {
      const ext = (String(file.name || '').split('.').pop() || '').toLowerCase();
      if (ext === 'pdf' || file.type === 'application/pdf') {
        try {
          const pdfjs = await import(/* @vite-ignore */ 'https://cdn.jsdelivr.net/npm/pdfjs-dist@4.7.76/build/pdf.min.mjs');
          try { pdfjs.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@4.7.76/build/pdf.worker.min.mjs'; } catch (e) {}
          const buf = await file.arrayBuffer();
          const doc = await pdfjs.getDocument({ data: buf }).promise;
          const pages = Math.min(doc.numPages, 40);
          let text = '';
          for (let i = 1; i <= pages; i++) { const pg = await doc.getPage(i); const tc = await pg.getTextContent(); text += tc.items.map((it) => it.str).join(' ') + '\n'; }
          return text.replace(/\s+\n/g, '\n').trim();
        } catch (e) { return ''; }
      }
      try { return (await file.text()).slice(0, 60000); } catch (e) { return ''; }   // text-based files
    }
    async function sendDoc(file) {
      if (!file || sending) return;
      const name = (file.name || 'document').slice(0, 80);
      setBusy(true); addBtn.classList.add('busy');
      try {
        const docText = await extractDocText(file);
        addBtn.classList.remove('busy');
        if (!docText) { const h = addRow('them', ''); h.bub.textContent = "i couldn't read that one — try a PDF or a text file?"; stamp(h); setBusy(false); return; }
        if (!incognito && !activeChatId) { const c = await dbCreateChat(name); if (c) activeChatId = c.id; }
        const um = { role: 'user', content: name, ts: Date.now(), media_type: 'doc', media_description: docText };
        history.push(um); addRow('me', name, { media_type: 'doc', msg: um }); updateChips();
        dbInsertMessage('user', name, { type: 'doc', description: docText }).then((id) => { if (id) um.id = id; });
        await runTurn('');   // Blak replies about the doc (its text is in context)
      } catch (e) { setBusy(false); }
    }
    if (docInput) docInput.addEventListener('change', () => { const f = docInput.files && docInput.files[0]; docInput.value = ''; if (f) sendDoc(f); });

    // ── Re-examine a shared image: a follow-up question re-looks at the photo ──
    const IMG_REF = /\b(image|photo|pic|picture|screenshot|selfie|that|this|it|sign|menu|text|says?|written|colou?r|wearing|background)\b/i;
    const isImgQuestion = (t) => /\?\s*$/.test(t) || /^(what|whats|who|where|when|why|how|which|does|do|is|are|can|could|read|tell me|describe|any)\b/i.test(String(t).trim());
    async function visionAsk(url, q) {
      try {
        const jwt = await getToken(); if (!jwt) return '';
        const r = await fetch('/api/blaksyd/symp/vision', { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt }, body: JSON.stringify({ imageUrl: url, question: q }) });
        const j = await r.json().catch(() => null);
        return (j && j.data && j.data.description) || '';
      } catch (e) { return ''; }
    }

    // ── Voice notes: hold-to-record → release → preview → delete / send ───────
    // WhatsApp-style. Hold the mic to record, release to stop, then play it back
    // and either delete or send. Sent as a playable voice message that Blak also
    // transcribes (Groq Whisper) so it can reply.
    const vnBar = $('bx-vn');
    let vnRec = null, vnChunks = [], vnStream = null, vnStartT = 0, vnTimer = null, vnBlob = null, vnUrl = null, vnHolding = false, vnDur = 0;

    const VN_IC = {
      play:  '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>',
      pause: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>',
      trash: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>',
      send:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
    };
    const vnFmt = (ms) => { const s = Math.max(0, Math.round(ms / 1000)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };

    function vnReset() {
      if (vnTimer) { clearInterval(vnTimer); vnTimer = null; }
      if (vnStream) { try { vnStream.getTracks().forEach(t => t.stop()); } catch (e) {} vnStream = null; }
      if (vnUrl) { try { URL.revokeObjectURL(vnUrl); } catch (e) {} vnUrl = null; }
      vnRec = null; vnChunks = []; vnBlob = null; vnHolding = false;
      sendBtn.classList.remove('rec');
      if (vnBar) { vnBar.hidden = true; vnBar.innerHTML = ''; }
      form.classList.remove('bx-vn-active');
    }

    async function vnStartRec() {
      if (sending || !vnBar) return;
      try { vnStream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true } }); }
      catch (e) { alert('Allow microphone access to record a voice note.'); vnReset(); return; }
      if (!vnHolding) { try { vnStream.getTracks().forEach(t => t.stop()); } catch (e) {} vnStream = null; return; }   // released during the permission prompt
      vnChunks = [];
      const mime = (window.MediaRecorder && MediaRecorder.isTypeSupported('audio/webm')) ? 'audio/webm'
                 : (window.MediaRecorder && MediaRecorder.isTypeSupported('audio/mp4')) ? 'audio/mp4' : '';
      vnRec = new MediaRecorder(vnStream, mime ? { mimeType: mime } : undefined);
      vnRec.ondataavailable = (e) => { if (e.data && e.data.size) vnChunks.push(e.data); };
      vnRec.onstop = vnOnStop;
      vnRec.start(); vnStartT = Date.now();
      sendBtn.classList.add('rec');
      vnBar.hidden = false;   // status above the composer; composer stays so the held mic doesn't vanish
      vnBar.innerHTML = '<span class="bx-vn-dot"></span><span class="bx-vn-time">0:00</span><span class="bx-vn-hint">release to stop</span>';
      const t = vnBar.querySelector('.bx-vn-time');
      vnTimer = setInterval(() => { if (t) t.textContent = vnFmt(Date.now() - vnStartT); }, 200);
    }

    function vnStopRec() {
      if (vnRec && vnRec.state === 'recording') { try { vnRec.stop(); } catch (e) { vnReset(); } }
      else if (!vnRec) { vnReset(); }
    }

    function vnOnStop() {
      if (vnTimer) { clearInterval(vnTimer); vnTimer = null; }
      if (vnStream) { try { vnStream.getTracks().forEach(t => t.stop()); } catch (e) {} vnStream = null; }
      sendBtn.classList.remove('rec');
      vnDur = Date.now() - vnStartT;
      const type = (vnRec && vnRec.mimeType) || 'audio/webm';
      vnBlob = new Blob(vnChunks, { type });
      if (vnBlob.size < 1400 || vnDur < 700) { vnReset(); return; }   // too short — ignore an accidental tap
      vnUrl = URL.createObjectURL(vnBlob);
      form.classList.add('bx-vn-active'); vnBar.hidden = false;       // now hide the composer, show the preview
      vnBar.innerHTML =
        '<button type="button" class="bx-vn-del" aria-label="Delete">' + VN_IC.trash + '</button>' +
        '<button type="button" class="bx-vn-play" aria-label="Play">' + VN_IC.play + '</button>' +
        '<span class="bx-vn-time">' + vnFmt(vnDur) + '</span>' +
        '<audio class="bx-vn-audio" src="' + vnUrl + '" preload="metadata"></audio>' +
        '<button type="button" class="bx-vn-send" aria-label="Send voice note">' + VN_IC.send + '</button>';
      const audio = vnBar.querySelector('.bx-vn-audio'), playBtn = vnBar.querySelector('.bx-vn-play');
      playBtn.onclick = () => { if (audio.paused) { audio.play(); playBtn.innerHTML = VN_IC.pause; } else { audio.pause(); playBtn.innerHTML = VN_IC.play; } };
      audio.onended = () => { playBtn.innerHTML = VN_IC.play; };
      vnBar.querySelector('.bx-vn-del').onclick = () => vnReset();
      vnBar.querySelector('.bx-vn-send').onclick = () => { const b = vnBlob; const d = vnDur; vnBlob = null; vnReset(); sendVoiceNote(b, d); };
    }

    async function uploadVoiceNote(blob) {
      if (!supabase || !blob) return null;
      const ext = (blob.type && blob.type.includes('mp4')) ? 'mp4' : (blob.type && blob.type.includes('ogg')) ? 'ogg' : 'webm';
      const path = (userId || 'anon') + '/' + ((window.crypto && crypto.randomUUID) ? crypto.randomUUID() : (Date.now() + '-' + Math.round(Math.random() * 1e9))) + '.' + ext;
      const { error } = await supabase.storage.from('voice_notes').upload(path, blob, { contentType: blob.type || 'audio/webm', upsert: false });
      if (error) { alert('Voice note upload failed — try again.'); return null; }
      return supabase.storage.from('voice_notes').getPublicUrl(path).data.publicUrl;
    }

    async function transcribeBlob(blob) {
      try {
        const b64 = await new Promise(r => { const fr = new FileReader(); fr.onloadend = () => r(String(fr.result).split(',')[1]); fr.readAsDataURL(blob); });
        const jwt = await getToken(); if (!jwt) return '';
        const r = await fetch('/api/blaksyd/symp/transcribe', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + jwt },
          body: JSON.stringify({ audioBase64: b64, mimeType: blob.type || 'audio/webm' }),
        });
        const j = await r.json().catch(() => null);
        return ((j && j.data && j.data.text) || (j && j.text) || '').trim();
      } catch (e) { return ''; }
    }

    async function sendVoiceNote(blob, durMs) {
      if (!blob || sending) return;
      if (!incognito && !activeChatId) { const c = await dbCreateChat('Voice note'); if (c) activeChatId = c.id; }
      const localUrl = URL.createObjectURL(blob);
      const um = { role: 'user', content: '', ts: Date.now(), media_url: localUrl, media_type: 'audio', media_description: null };
      history.push(um);
      const vh = addRow('me', '', { media_url: localUrl, media_type: 'audio' });   // instant playable bubble
      updateChips();
      const [url, txt] = await Promise.all([uploadVoiceNote(blob), transcribeBlob(blob)]);
      if (url) um.media_url = url;                                       // persist the storage URL
      um.media_description = txt || null;
      if (txt && vh && vh.bub && !vh.bub.querySelector('.bx-vn-cap')) { const cap = document.createElement('p'); cap.className = 'bx-vn-cap'; cap.textContent = '“' + txt + '”'; vh.bub.appendChild(cap); }   // show what Blak heard
      dbInsertMessage('user', '', { url: url || null, type: 'audio', description: txt || null }).then((id) => { if (id) um.id = id; });
      if (txt && CALL_INTENT.test(txt)) { offerCall(); return; }   // voice note asked to call → offer it
      await runTurn(txt || '');
    }

    // Press-and-hold the mic to record (only when there's no typed text — then it's Send).
    sendBtn.addEventListener('pointerdown', (e) => {
      if (input.value.trim()) return;
      if (vnHolding || vnRec) return;
      if (vnBar && !vnBar.hidden) return;          // a preview is already open
      e.preventDefault();
      try { sendBtn.setPointerCapture(e.pointerId); } catch (e2) {}
      vnHolding = true; vnStartRec();
    });
    const vnRelease = () => { if (!vnHolding) return; vnHolding = false; vnStopRec(); };
    window.addEventListener('pointerup', vnRelease);
    window.addEventListener('pointercancel', vnRelease);

    // ── Conversation switching + history drawer (server-backed) ───────────
    async function openChat(id) {
      cancelEdit(); setIncognito(false);
      activeChatId = id;
      history = await dbLoadMessages(id);
      render(); updateChips();
    }
    async function newConvo() {
      if (sending && controller) controller.abort();
      cancelEdit(); setIncognito(false);
      const c = await dbCreateChat('New chat');
      activeChatId = c ? c.id : null;
      history = [];
      render(); updateChips(); closeDrawer(); input.focus();
    }
    async function renderConvoList(query) {
      query = (query || '').trim();
      convoList.innerHTML = '<p class="bx-cv-empty">' + (query ? 'Searching…' : 'Loading…') + '</p>';
      let arr;
      if (query) {
        const ids = new Set();
        try { const { data } = await supabase.from('messages').select('chat_id').ilike('content', '%' + query + '%').limit(100); (data || []).forEach((m) => ids.add(m.chat_id)); } catch (e) {}
        const ql = query.toLowerCase();
        arr = (await dbListChats()).filter((c) => ids.has(c.id) || (c.title || '').toLowerCase().includes(ql));
      } else {
        arr = await dbListChats();
      }
      convoList.innerHTML = '';
      if (!arr.length) { convoList.innerHTML = '<p class="bx-cv-empty">' + (query ? 'No matches' : 'No chats yet') + '</p>'; return; }
      for (const c of arr) {
        const row = document.createElement('div');
        row.className = 'bx-cv-item' + (c.id === activeChatId ? ' on' : '');
        const pinned = !!c.pinned_at;
