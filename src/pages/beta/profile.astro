---
// Your profile — the user-visible "what Blak knows about you" page.
// Blak fills it silently from conversation (server-side extractor v2: facts +
// people/pets + dated events); here the user can see, edit, control visibility,
// see WHY Blak believes each thing, and delete/forget anything (owner-only RLS,
// so the browser client reads/writes its own rows directly). Reached from the
// avatar button + the Blak home insight card.
//
// All page logic lives in ../../lib/profile/profile-app.js (external module,
// one-line import below): a large inline Astro <script> can be bundled but not
// injected, which renders the page blank — the external-module import avoids it.
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout active="profile" title="Profile">
  <div class="ap-page">
    <header class="pf-head">
      <p class="ap-kicker">Your profile</p>
      <h1 class="ap-h1">What Blak knows about you</h1>
      <p class="ap-sub">Blak fills this in as you talk — quietly, never prying. It's all yours: see why Blak believes anything, choose who sees it, edit or forget anything. The more complete it is, the better Blak knows you.</p>

      <div class="pf-meter">
        <span class="pf-meter-label" id="pf-pct">Getting to know you…</span>
      </div>
      <a class="pf-talk" href="/beta/blak/">Talk to Blak →</a>
    </header>

    <a class="ap-card pf-archive" href="/beta/archive/">
      <svg class="pf-archive-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><path d="M10 12h4"/></svg>
      <span class="pf-archive-main"><b>Your archive</b><span class="pf-archive-sub">Images & voice notes you’ve shared, and a day-by-day calendar</span></span>
      <span class="pf-archive-arr" aria-hidden="true">→</span>
    </a>

    <div id="pf-root" class="pf-root">
      <div class="pf-loading">Loading your profile…</div>
    </div>
  </div>

  <style is:global>
    .pf-head { margin-bottom: 1.4rem; }
    .pf-meter { margin-top: 1.1rem; display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }
    .pf-meter-label { font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: .04em; color: var(--ink-soft); white-space: nowrap; }
    .pf-talk { display: inline-block; margin-top: .9rem; font-size: var(--fs-sm); color: var(--coral); }
    .pf-talk:hover { text-decoration: underline; }

    .pf-loading { color: var(--ink-faint); padding: 2rem 0; }
    .pf-root { display: flex; flex-direction: column; gap: 1rem; }
    .pf-faint { color: var(--ink-faint); font-style: italic; }

    /* Archive entry button */
    .pf-archive { display: flex; align-items: center; gap: .9rem; padding: 1rem 1.15rem; margin-bottom: 1rem; text-decoration: none; color: var(--ink); transition: border-color .15s; }
    .pf-archive:hover { border-color: var(--line-strong); }
    .pf-archive-ic { width: 26px; height: 26px; color: var(--coral); flex: none; }
    .pf-archive-main { display: flex; flex-direction: column; gap: .12rem; min-width: 0; flex: 1; }
    .pf-archive-main b { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-lg); }
    .pf-archive-sub { color: var(--ink-faint); font-size: var(--fs-sm); }
    .pf-archive-arr { color: var(--ink-faint); font-size: 1.2rem; flex: none; }

    /* How Blak sees you (mirror) */
    .pf-mirror { padding: 1.2rem 1.3rem; background: linear-gradient(180deg, rgba(255,107,157,.06), transparent 70%); }
    .pf-mirror-head { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .08em; text-transform: uppercase; color: var(--coral); margin-bottom: .55rem; }
    .pf-mirror-text { font-family: var(--font-display); font-size: var(--fs-lg); line-height: 1.5; color: var(--ink); margin: 0 0 .7rem; }
    .pf-mirror-empty { color: var(--ink-faint); font-size: var(--fs-md); margin: 0 0 .8rem; }
    .pf-mirror-foot { display: flex; align-items: center; justify-content: space-between; gap: .6rem; font-family: var(--font-mono); font-size: var(--fs-2xs); color: var(--ink-faint); }

    /* Energy map */
    .pf-energy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
    .pf-energy-col { padding: .7rem .8rem; border-radius: var(--r-sm); border: 1px solid var(--line); }
    .pf-energy-col.up { background: rgba(120,220,180,.06); }
    .pf-energy-col.down { background: rgba(255,210,122,.06); }
    .pf-energy-label { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .04em; margin: 0 0 .3rem; color: var(--ink-soft); }
    .pf-energy-val { font-size: var(--fs-sm); color: var(--ink); margin: 0; }

    .pf-area { padding: 1.1rem 1.2rem 1.25rem; }
    .pf-area-head { display: flex; align-items: baseline; gap: .6rem; margin-bottom: .35rem; }
    .pf-area-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); margin: 0; color: var(--ink); }
    .pf-area-count { font-family: var(--font-mono); font-size: var(--fs-2xs); color: var(--ink-faint); margin-left: auto; }
    .pf-area-blurb { color: var(--ink-faint); font-size: var(--fs-sm); margin: 0 0 .8rem; }

    .pf-row { display: flex; align-items: flex-start; gap: .75rem; padding: .6rem 0; border-top: 1px solid var(--line); }
    .pf-row:first-of-type { border-top: 0; }
    .pf-row.ev.soon .pf-row-val { color: var(--coral); }
    .pf-row-main { min-width: 0; flex: 1; }
    .pf-row-label { font-size: var(--fs-xs); color: var(--ink-faint); margin: 0 0 .15rem; }
    .pf-row-val { font-size: var(--fs-md); color: var(--ink); margin: 0; word-wrap: break-word; }
    .pf-row.is-empty .pf-row-val { color: var(--ink-faint); font-style: italic; }

    .pf-chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .35rem; }
    .pf-chip { font-family: var(--font-mono); font-size: 9px; letter-spacing: .04em; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line); }
    .pf-chip.you { color: var(--mint); border-color: rgba(120,220,180,.3); }
    .pf-chip.hunch { color: var(--gold); border-color: rgba(255,210,122,.3); }
    .pf-chip.lock { color: var(--ink-soft); }
    .pf-chip.stale { color: var(--gold); border-color: rgba(255,210,122,.3); }

    /* micro action bar under a fact */
    .pf-microbar { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: .45rem; }
    .pf-link { background: none; border: 0; padding: 0; cursor: pointer; font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .03em; color: var(--ink-faint); }
    .pf-link:hover { color: var(--coral); }
    .pf-link.ok { color: var(--mint); }
    .pf-why { margin-top: .4rem; font-size: var(--fs-sm); color: var(--ink-soft); background: var(--surface); border-left: 2px solid var(--coral); padding: .4rem .6rem; border-radius: 0 var(--r-sm) var(--r-sm) 0; }
    .pf-hist { margin-top: .4rem; display: flex; flex-direction: column; gap: .25rem; }
    .pf-hist-row { font-size: var(--fs-sm); color: var(--ink-soft); }
    .pf-hist-row s { color: var(--ink-faint); }

    .pf-actions { display: flex; gap: .5rem; flex: none; }
    .pf-btn { background: none; border: 1px solid var(--line); color: var(--ink-faint); border-radius: var(--r-sm); cursor: pointer; font-family: inherit; font-size: var(--fs-xs); padding: .25rem .55rem; min-height: 44px; transition: color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out); }
    .pf-btn:hover { color: var(--ink); border-color: var(--line-strong); }
    .pf-btn.danger:hover { color: var(--coral); border-color: rgba(255,107,157,.4); }
    .pf-btn.add { color: var(--coral); border-color: rgba(255,107,157,.3); }
    .pf-btn:disabled { opacity: .5; cursor: default; }

    .pf-form { display: flex; gap: .5rem; align-items: center; flex: 1; flex-wrap: wrap; }
    .pf-form.col { flex-direction: column; align-items: stretch; }
    .pf-input { flex: 1 1 180px; min-width: 0; background: var(--bg); border: 1px solid var(--line-strong); border-radius: var(--r-sm); color: var(--ink); font-family: inherit; font-size: 16px; padding: .45rem .6rem; }
    .pf-input:focus { outline: none; border-color: var(--coral); }
    .pf-input.key { flex: 0 1 150px; }
    select.pf-input { -webkit-appearance: none; appearance: none; }
    .pf-mini { display: inline-flex; align-items: center; gap: .3rem; font-size: var(--fs-xs); color: var(--ink-faint); white-space: nowrap; }

    /* entities (people & pets) */
    .pf-ent { display: flex; align-items: center; gap: .7rem; padding: .55rem 0; border-top: 1px solid var(--line); }
    .pf-ent:first-of-type { border-top: 0; }
    .pf-ent.editing { align-items: stretch; }
    .pf-ent-ava { width: 34px; height: 34px; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--surface); border: 1px solid var(--line); font-size: 16px; }
    .pf-ent-main { min-width: 0; flex: 1; display: flex; flex-direction: column; }
    .pf-ent-main b { font-size: var(--fs-md); color: var(--ink); }
    .pf-ent-sub { font-size: var(--fs-sm); color: var(--ink-faint); }
    .pf-ent-add { margin-top: .5rem; }
    img.pf-ent-ava { object-fit: cover; }
    .pf-ent-photo-row { display: flex; align-items: center; gap: .6rem; }
    .pf-dupe { border-left: 2px solid var(--gold); padding-left: .6rem; margin-bottom: .5rem; }

    /* privacy & control */
    .pf-toggle { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-top: 1px solid var(--line); }
    .pf-toggle:first-of-type { border-top: 0; }
    .pf-toggle b { font-size: var(--fs-md); display: block; }
    .pf-switch { position: relative; width: 46px; height: 28px; border-radius: 999px; border: 1px solid var(--line-strong); background: var(--surface); cursor: pointer; flex: none; transition: background .2s; }
    .pf-switch span { position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: var(--ink-faint); transition: transform .2s, background .2s; }
    .pf-switch.on { background: var(--cta-grad); border-color: transparent; }
    .pf-switch.on span { transform: translateX(18px); background: #fff; }

    /* recently picked up */
    .pf-recent-row { display: flex; align-items: center; gap: .5rem; padding: .4rem 0; border-top: 1px solid var(--line); }
    .pf-recent-row:first-of-type { border-top: 0; }
    .pf-recent-tx { flex: 1; min-width: 0; font-size: var(--fs-sm); color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* search */
    .pf-search { position: relative; display: flex; align-items: center; gap: .6rem; }
    .pf-search .pf-input { flex: 1; }

    /* goals */
    .pf-row.goal-done .pf-row-val { color: var(--ink-faint); }
    .pf-wins { margin-top: .4rem; }
    .pf-wins-h { margin: .6rem 0 .3rem; color: var(--mint); }
    .pf-link:disabled { opacity: .55; cursor: default; }

    /* curiosity */
    .pf-curio { padding: 1rem 1.15rem; border-color: rgba(255,107,157,.25); }
    .pf-curio-head { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-md); color: var(--ink); margin-bottom: .2rem; }
    .pf-curio-chips { display: flex; flex-wrap: wrap; gap: .4rem; }

    /* sharing & minit brief */
    .pf-sub-h { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-faint); margin: 1.1rem 0 .1rem; }
    .pf-brief { margin: .5rem 0 .2rem; padding: .7rem .85rem; border: 1px dashed var(--line-strong); border-radius: var(--r-sm); background: var(--surface); }
    .pf-brief-h { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .04em; color: var(--coral); margin-bottom: .45rem; }
    .pf-brief-row { font-size: var(--fs-sm); color: var(--ink); padding: .16rem 0; }
    .pf-brief-foot { font-size: var(--fs-xs); color: var(--ink-faint); margin-top: .45rem; }
  </style>

  <script>
    import '../../lib/profile/profile-app.js';
  </script>
</AppLayout>
