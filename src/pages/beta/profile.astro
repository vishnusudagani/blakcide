---
// Your profile — the user-visible "what Blak knows about you" page.
// Blak fills it silently from conversation (server-side extractor); here the
// user can see, edit, and delete everything (owner-only RLS, so the browser
// client reads/writes its own rows directly). Reached from the avatar button.
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout active="profile" title="Profile">
  <div class="ap-page">
    <header class="pf-head">
      <p class="ap-kicker">Your profile</p>
      <h1 class="ap-h1">What Blaksyd understands about you</h1>
      <p class="ap-sub">Blaksyd quietly learns from your chats with Blak, your activity on Nexus, and how you reflect after Minit — never prying. It's all yours: edit anything, delete anything, or tell it “this isn't me.”</p>

      <div class="pf-meter" role="img" aria-label="Profile completeness">
        <div class="pf-meter-bar"><span class="pf-meter-fill" id="pf-fill" style="width:0%"></span></div>
        <span class="pf-meter-label" id="pf-pct">Blaksyd understands about 0% of you</span>
      </div>
      <a class="pf-talk" href="/beta/blak/">Talk to Blak →</a>
    </header>

    <section class="ap-card pf-cal" id="pf-cal" hidden>
      <div class="pf-cal-head">
        <button type="button" class="pf-cal-nav" id="pf-cal-prev" aria-label="Previous month">‹</button>
        <h2 class="pf-cal-title" id="pf-cal-title">—</h2>
        <button type="button" class="pf-cal-nav" id="pf-cal-next" aria-label="Next month">›</button>
      </div>
      <p class="pf-cal-blurb">Your days, remembered. Pick one to see what Blaksyd saved — chats, moods, journals and more.</p>
      <div class="pf-cal-grid" id="pf-cal-grid"></div>
      <div class="pf-day" id="pf-day" hidden></div>
    </section>

    <div id="pf-root" class="pf-root">
      <div class="pf-loading">Loading your profile…</div>
    </div>
  </div>

  <style is:global>
    .pf-head { margin-bottom: 1.6rem; }
    .pf-meter { margin-top: 1.1rem; display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }
    .pf-meter-bar { flex: 1 1 240px; height: 8px; border-radius: 999px; background: var(--surface-strong); overflow: hidden; border: 1px solid var(--line); }
    .pf-meter-fill { display: block; height: 100%; border-radius: 999px; background: var(--cta-grad); box-shadow: 0 0 12px rgba(255,107,157,.4); transition: width .6s var(--ease-out); }
    .pf-meter-label { font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: .04em; color: var(--ink-soft); white-space: nowrap; }
    .pf-talk { display: inline-block; margin-top: .9rem; font-size: var(--fs-sm); color: var(--coral); }
    .pf-talk:hover { text-decoration: underline; }

    .pf-loading { color: var(--ink-faint); padding: 2rem 0; }
    .pf-root { display: flex; flex-direction: column; gap: 1rem; }

    /* Day-in-review calendar */
    .pf-cal { padding: 1.1rem 1.2rem 1.25rem; margin-bottom: 1rem; }
    .pf-cal[hidden] { display: none; }
    .pf-cal-head { display: flex; align-items: center; gap: .5rem; }
    .pf-cal-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); margin: 0; flex: 1; text-align: center; color: var(--ink); }
    .pf-cal-nav { background: none; border: 1px solid var(--line); color: var(--ink); border-radius: var(--r-sm); width: 44px; height: 44px; cursor: pointer; font-size: 1.2rem; line-height: 1; flex: none; }
    .pf-cal-nav:hover:not(:disabled) { border-color: var(--line-strong); color: var(--coral); }
    .pf-cal-nav:disabled { opacity: .35; cursor: default; }
    .pf-cal-blurb { color: var(--ink-faint); font-size: var(--fs-sm); margin: .55rem 0 .85rem; }
    .pf-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
    .pf-cal-wd { text-align: center; font-family: var(--font-mono); font-size: var(--fs-2xs); color: var(--ink-faint); padding: .15rem 0 .3rem; }
    .pf-cal-cell { position: relative; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; background: none; border: 0; border-radius: var(--r-sm); color: var(--ink-soft); font: inherit; font-size: var(--fs-sm); cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .pf-cal-cell.blank { visibility: hidden; cursor: default; }
    .pf-cal-cell:hover:not(.blank):not(:disabled) { background: var(--surface-strong); color: var(--ink); }
    .pf-cal-cell.today { box-shadow: inset 0 0 0 1px var(--line-strong); }
    .pf-cal-cell.sel { background: var(--cta); color: var(--cta-ink); }
    .pf-cal-cell:disabled { color: var(--ink-faint); opacity: .35; cursor: default; }
    .pf-cal-dot { position: absolute; bottom: 5px; left: 50%; transform: translateX(-50%); width: 5px; height: 5px; border-radius: 50%; background: var(--coral); }
    .pf-cal-cell.sel .pf-cal-dot { background: var(--cta-ink); }
    .pf-day { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
    .pf-day[hidden] { display: none; }
    .pf-day-date { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-faint); margin: 0 0 .45rem; letter-spacing: .03em; }
    .pf-day-body { font-size: var(--fs-md); line-height: 1.62; color: var(--ink); white-space: pre-wrap; word-wrap: break-word; margin: 0; }
    .pf-day-body.loading, .pf-day-empty { color: var(--ink-faint); margin: 0; }
    .pf-day-counts { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .75rem; }
    .pf-day-count { font-family: var(--font-mono); font-size: 9px; letter-spacing: .04em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line); }

    .pf-area { padding: 1.1rem 1.2rem 1.25rem; }
    .pf-area-head { display: flex; align-items: baseline; gap: .6rem; margin-bottom: .35rem; }
    .pf-area-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); margin: 0; color: var(--ink); }
    .pf-area-count { font-family: var(--font-mono); font-size: var(--fs-2xs); color: var(--ink-faint); margin-left: auto; }
    .pf-area-blurb { color: var(--ink-faint); font-size: var(--fs-sm); margin: 0 0 .8rem; }

    .pf-row { display: flex; align-items: flex-start; gap: .75rem; padding: .6rem 0; border-top: 1px solid var(--line); }
    .pf-row:first-of-type { border-top: 0; }
    .pf-row-main { min-width: 0; flex: 1; }
    .pf-row-label { font-size: var(--fs-xs); color: var(--ink-faint); margin: 0 0 .15rem; }
    .pf-row-val { font-size: var(--fs-md); color: var(--ink); margin: 0; word-wrap: break-word; }
    .pf-row.is-empty .pf-row-val { color: var(--ink-faint); font-style: italic; }
    .pf-chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .35rem; }
    .pf-chip { font-family: var(--font-mono); font-size: 9px; letter-spacing: .04em; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line); }
    .pf-chip.you { color: var(--mint); border-color: rgba(120,220,180,.3); }
    .pf-chip.hunch { color: var(--gold); border-color: rgba(255,210,122,.3); }
    .pf-chip.nexus { color: var(--aqua); border-color: rgba(91,192,255,.3); }
    .pf-chip.minit { color: var(--mint); border-color: rgba(106,211,184,.3); }
    .pf-chip.multi { color: var(--coral); border-color: rgba(255,107,157,.3); }
    .pf-forget { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin: 1.3rem 0 .3rem; }
    .pf-forget > span { font-size: var(--fs-sm); color: var(--ink-faint); }
    .pf-forget button { font: inherit; font-size: var(--fs-xs); color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); border-radius: 999px; padding: .4rem .85rem; min-height: 44px; cursor: pointer; }
    .pf-forget button:hover { border-color: rgba(255,107,157,.4); color: var(--coral); }

    .pf-actions { display: flex; gap: .5rem; flex: none; }
    .pf-btn { background: none; border: 1px solid var(--line); color: var(--ink-faint); border-radius: var(--r-sm); cursor: pointer; font-family: inherit; font-size: var(--fs-xs); padding: .25rem .55rem; min-height: 44px; transition: color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out); }
    .pf-btn:hover { color: var(--ink); border-color: var(--line-strong); }
    .pf-btn.danger:hover { color: var(--coral); border-color: rgba(255,107,157,.4); }
    .pf-btn.add { color: var(--coral); border-color: rgba(255,107,157,.3); }

    .pf-form { display: flex; gap: .5rem; align-items: center; flex: 1; flex-wrap: wrap; }
    .pf-input { flex: 1 1 180px; min-width: 0; background: var(--bg); border: 1px solid var(--line-strong); border-radius: var(--r-sm); color: var(--ink); font-family: inherit; font-size: 16px; padding: .45rem .6rem; }
    .pf-input:focus { outline: none; border-color: var(--coral); }
    .pf-input.key { flex: 0 1 150px; }

    .pf-empty-note { color: var(--ink-faint); font-size: var(--fs-sm); padding: .4rem 0 0; }
  </style>

  <script>
    import { supabase } from '../../lib/supabaseClient';
    import {
      KNOWLEDGE_AREAS, OPEN_AREA, OPEN_AREA_ID, computeCompleteness,
    } from '../../../symp-core/lib/knowledge-schema.mjs';

    const root = document.getElementById('pf-root');
    const fillEl = document.getElementById('pf-fill');
    const pctEl = document.getElementById('pf-pct');

    let user = null;
    let facts = [];
    let editing = null; // "area:key" while an inline editor is open

    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const slug = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 40);
    const relTime = (iso) => {
      try {
        const diff = Date.now() - new Date(iso).getTime();
        const m = Math.floor(diff / 60000), h = Math.floor(m / 60), d = Math.floor(h / 24);
        if (d > 30) return new Date(iso).toLocaleDateString(undefined, { month: 'short', year: 'numeric' });
        if (d >= 1) return d + (d === 1 ? ' day ago' : ' days ago');
        if (h >= 1) return h + (h === 1 ? ' hr ago' : ' hrs ago');
        if (m >= 1) return m + ' min ago';
        return 'just now';
      } catch (e) { return ''; }
    };

    const factFor = (area, key) => facts.find((f) => f.area === area && f.key === key) || null;

    function chipsFor(f) {
      const chips = [];
      const s = f.source;
      if (s === 'user') chips.push('<span class="pf-chip you">you said</span>');
      else if (s === 'nexus') chips.push('<span class="pf-chip nexus">from Nexus</span>');
      else if (s === 'minit') chips.push('<span class="pf-chip minit">from Minit</span>');
      else if (s === 'multi') chips.push('<span class="pf-chip multi">across Blaksyd</span>');
      else if ((f.confidence ?? 1) < 0.5) chips.push('<span class="pf-chip hunch">a hunch</span>');
      else chips.push('<span class="pf-chip">from Blak</span>');
      chips.push('<span class="pf-chip">' + esc(relTime(f.updated_at || f.last_seen_at)) + '</span>');
      return '<div class="pf-chips">' + chips.join('') + '</div>';
    }

    function rowFilled(f, label) {
      const id = f.area + ':' + f.key;
      if (editing === id) return editorRow(f.area, f.key, label, f.value);
      return (
        '<div class="pf-row">' +
          '<div class="pf-row-main">' +
            '<p class="pf-row-label">' + esc(label) + '</p>' +
            '<p class="pf-row-val">' + esc(f.value) + '</p>' +
            chipsFor(f) +
          '</div>' +
          '<div class="pf-actions">' +
            '<button class="pf-btn" data-act="edit" data-area="' + esc(f.area) + '" data-key="' + esc(f.key) + '">Edit</button>' +
            (f.source && f.source !== 'user' ? '<button class="pf-btn" data-act="notme" data-id="' + esc(f.id) + '">Not me</button>' : '') +
            '<button class="pf-btn danger" data-act="delete" data-id="' + esc(f.id) + '">Delete</button>' +
          '</div>' +
        '</div>'
      );
    }

    function rowEmpty(area, key, label) {
      const id = area + ':' + key;
      if (editing === id) return editorRow(area, key, label, '');
      return (
        '<div class="pf-row is-empty">' +
          '<div class="pf-row-main">' +
            '<p class="pf-row-label">' + esc(label) + '</p>' +
            '<p class="pf-row-val">Blak hasn’t picked this up yet</p>' +
          '</div>' +
          '<div class="pf-actions">' +
            '<button class="pf-btn add" data-act="edit" data-area="' + esc(area) + '" data-key="' + esc(key) + '">+ Add</button>' +
          '</div>' +
        '</div>'
      );
    }

    function editorRow(area, key, label, value) {
      return (
        '<div class="pf-row">' +
          '<div class="pf-form">' +
            '<input class="pf-input" id="pf-edit-input" value="' + esc(value) + '" placeholder="' + esc(label) + '" />' +
            '<div class="pf-actions">' +
              '<button class="pf-btn add" data-act="save" data-area="' + esc(area) + '" data-key="' + esc(key) + '" data-label="' + esc(label) + '">Save</button>' +
              '<button class="pf-btn" data-act="cancel">Cancel</button>' +
            '</div>' +
          '</div>' +
        '</div>'
      );
    }

    function openAddRow() {
      if (editing !== 'open:__new__') {
        return '<div class="pf-row"><div class="pf-actions"><button class="pf-btn add" data-act="open-new">+ Add something Blak should know</button></div></div>';
      }
      return (
        '<div class="pf-row">' +
          '<div class="pf-form">' +
            '<input class="pf-input key" id="pf-open-label" placeholder="What is it? (e.g. Favourite team)" />' +
            '<input class="pf-input" id="pf-open-value" placeholder="The detail" />' +
            '<div class="pf-actions">' +
              '<button class="pf-btn add" data-act="open-save">Save</button>' +
              '<button class="pf-btn" data-act="cancel">Cancel</button>' +
            '</div>' +
          '</div>' +
        '</div>'
      );
    }

    const STRUCT_IDS = new Set(KNOWLEDGE_AREAS.map((a) => a.id));
    const niceLabel = (f) => f.label || String(f.key).replace(/^[a-z]+:/, '').replace(/[_-]/g, ' ');
    function renderArea(area) {
      let rows, count;
      if (area.id === OPEN_AREA_ID) {
        // Catch-all: facts explicitly in 'other', plus any learned fact whose area isn't a structured group.
        const mine = facts.filter((f) => f.area === OPEN_AREA_ID || !STRUCT_IDS.has(f.area));
        count = mine.length;
        rows = mine.map((f) => rowFilled(f, niceLabel(f))).join('') + openAddRow();
      } else {
        const fieldKeys = new Set(area.fields.map((fl) => fl.key));
        // Learned facts (Nexus/Minit) have free-form keys — render them under their area too.
        const extra = facts.filter((f) => f.area === area.id && !fieldKeys.has(f.key));
        const filled = area.fields.filter((fl) => factFor(area.id, fl.key)).length;
        count = filled + '/' + area.fields.length + (extra.length ? ' · +' + extra.length + ' learned' : '');
        rows = area.fields.map((fl) => {
          const f = factFor(area.id, fl.key);
          return f ? rowFilled(f, fl.label) : rowEmpty(area.id, fl.key, fl.label);
        }).join('') + extra.map((f) => rowFilled(f, niceLabel(f))).join('');
      }
      return (
        '<section class="ap-card pf-area">' +
          '<div class="pf-area-head">' +
            '<h2 class="pf-area-title">' + esc(area.label) + '</h2>' +
            '<span class="pf-area-count">' + esc(count) + '</span>' +
          '</div>' +
          (area.blurb ? '<p class="pf-area-blurb">' + esc(area.blurb) + '</p>' : '') +
          rows +
        '</section>'
      );
    }

    function render() {
      const pct = computeCompleteness(facts);
      if (fillEl) fillEl.style.width = pct + '%';
      if (pctEl) pctEl.textContent = 'Blaksyd understands about ' + pct + '% of you';
      const areas = KNOWLEDGE_AREAS.concat([OPEN_AREA]);
      const bySrc = (s) => facts.some((f) => f.source === s);
      const footer = (bySrc('nexus') || bySrc('minit') || bySrc('blak'))
        ? '<div class="pf-forget"><span>Forget what Blaksyd learned from:</span>'
          + (bySrc('nexus') ? '<button data-act="forget" data-source="nexus">Nexus</button>' : '')
          + (bySrc('minit') ? '<button data-act="forget" data-source="minit">Minit</button>' : '')
          + (bySrc('blak') ? '<button data-act="forget" data-source="blak">Blak chats</button>' : '')
          + '</div>'
        : '';
      root.innerHTML = areas.map(renderArea).join('') + footer;
      const input = document.getElementById('pf-edit-input') || document.getElementById('pf-open-label');
      if (input) input.focus();
    }

    async function reload() {
      const { data, error } = await supabase
        .from('symp_knowledge_facts')
        .select('id,area,key,label,value,source,confidence,status,updated_at,last_seen_at')
        .eq('user_id', user.id)
        .order('updated_at', { ascending: false });
      facts = error ? [] : (data || []).filter((f) => f.status !== 'suppressed');
      render();
    }

    async function saveFact(area, key, label, value) {
      const v = String(value || '').trim();
      if (!v) { editing = null; render(); return; }
      const row = {
        user_id: user.id, area, key,
        label: label || null, value: v,
        source: 'user', status: 'user_edited', confidence: 1,
        last_seen_at: new Date().toISOString(),
      };
      const { error } = await supabase.from('symp_knowledge_facts').upsert(row, { onConflict: 'user_id,area,key' });
      if (error) { alert('Could not save: ' + error.message); return; }
      editing = null;
      await reload();
    }

    async function deleteFact(id) {
      if (!confirm('Delete this? Blak will forget it.')) return;
      const { error } = await supabase.from('symp_knowledge_facts').delete().eq('id', id);
      if (error) { alert('Could not delete: ' + error.message); return; }
      await reload();
    }

    async function notMe(id) {
      // Suppress: hide it AND stop it being re-learned (the upsert skips 'suppressed').
      const { error } = await supabase.from('symp_knowledge_facts').update({ status: 'suppressed' }).eq('id', id);
      if (error) { alert('Could not update: ' + error.message); return; }
      await reload();
    }

    async function forgetSource(src) {
      const names = { nexus: 'Nexus', minit: 'Minit', blak: 'your Blak chats' };
      if (!confirm('Forget everything Blaksyd learned from ' + (names[src] || src) + '? Things you typed yourself stay.')) return;
      const { error } = await supabase.from('symp_knowledge_facts').delete().eq('user_id', user.id).eq('source', src);
      if (error) { alert('Could not clear: ' + error.message); return; }
      await reload();
    }

    root.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-act]');
      if (!btn) return;
      const act = btn.dataset.act;
      if (act === 'edit') { editing = btn.dataset.area + ':' + btn.dataset.key; render(); }
      else if (act === 'cancel') { editing = null; render(); }
      else if (act === 'delete') { deleteFact(btn.dataset.id); }
      else if (act === 'notme') { notMe(btn.dataset.id); }
      else if (act === 'forget') { forgetSource(btn.dataset.source); }
      else if (act === 'open-new') { editing = 'open:__new__'; render(); }
      else if (act === 'save') {
        const input = document.getElementById('pf-edit-input');
        saveFact(btn.dataset.area, btn.dataset.key, btn.dataset.label || null, input ? input.value : '');
      } else if (act === 'open-save') {
        const labEl = document.getElementById('pf-open-label');
        const valEl = document.getElementById('pf-open-value');
        const label = labEl ? labEl.value.trim() : '';
        const value = valEl ? valEl.value.trim() : '';
        if (!label || !value) { editing = null; render(); return; }
        const key = slug(label) || ('note_' + Date.now());
        saveFact(OPEN_AREA_ID, key, label, value);
      }
    });

    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const saveBtn = root.querySelector('button[data-act="save"], button[data-act="open-save"]');
      if (saveBtn && (e.target.id === 'pf-edit-input' || e.target.id === 'pf-open-value' || e.target.id === 'pf-open-label')) {
        e.preventDefault(); saveBtn.click();
      }
    });

    // ── Day-in-review calendar ────────────────────────────────────────────
    const calCard = document.getElementById('pf-cal');
    const calGrid = document.getElementById('pf-cal-grid');
    const calTitle = document.getElementById('pf-cal-title');
    const calPrev = document.getElementById('pf-cal-prev');
    const calNext = document.getElementById('pf-cal-next');
    const dayEl = document.getElementById('pf-day');
    const MO = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    const WD = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
    const pad = (n) => String(n).padStart(2, '0');
    const ymd = (y, m, d) => `${y}-${pad(m + 1)}-${pad(d)}`;
    const tzo = () => new Date().getTimezoneOffset();
    let calY, calM, selDate = null, activeDates = new Set();

    async function token() { try { return (await supabase.auth.getSession()).data?.session?.access_token || null; } catch (e) { return null; } }

    function renderGrid() {
      const now = new Date();
      const todayStr = ymd(now.getFullYear(), now.getMonth(), now.getDate());
      const first = new Date(calY, calM, 1).getDay();
      const days = new Date(calY, calM + 1, 0).getDate();
      let html = WD.map((w) => `<div class="pf-cal-wd">${w}</div>`).join('');
      for (let i = 0; i < first; i++) html += '<button class="pf-cal-cell blank" tabindex="-1"></button>';
      for (let d = 1; d <= days; d++) {
        const ds = ymd(calY, calM, d);
        const future = ds > todayStr;
        const cls = ['pf-cal-cell'];
        if (ds === todayStr) cls.push('today');
        if (ds === selDate) cls.push('sel');
        const dot = activeDates.has(ds) ? '<span class="pf-cal-dot"></span>' : '';
        html += `<button class="${cls.join(' ')}" data-d="${ds}"${future ? ' disabled' : ''}>${d}${dot}</button>`;
      }
      calGrid.innerHTML = html;
    }

    async function loadMonth(y, m) {
      calY = y; calM = m;
      calTitle.textContent = MO[m] + ' ' + y;
      activeDates = new Set();
      renderGrid();
      // disable "next" when we're at the current month
      const now = new Date();
      calNext.disabled = (y > now.getFullYear()) || (y === now.getFullYear() && m >= now.getMonth());
      try {
        const jwt = await token();
        const r = await fetch('/api/blaksyd/symp/day-review', { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (jwt || '') }, body: JSON.stringify({ month: `${y}-${pad(m + 1)}`, tzo: tzo() }) });
        const j = await r.json().catch(() => null);
        const dates = j && j.data && j.data.dates;
        if (Array.isArray(dates)) { activeDates = new Set(dates); renderGrid(); }
      } catch (e) { /* dots best-effort */ }
    }

    async function openDay(ds) {
      dayEl.hidden = false;
      const human = new Date(ds + 'T00:00:00').toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
      dayEl.innerHTML = `<p class="pf-day-date">${esc(human)}</p><p class="pf-day-body loading">Looking back at your day…</p>`;
      try {
        const jwt = await token();
        const r = await fetch('/api/blaksyd/symp/day-review', { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (jwt || '') }, body: JSON.stringify({ date: ds, tzo: tzo() }) });
        const j = await r.json().catch(() => null);
        const data = j && j.data;
        if (!data) throw new Error('x');
        const body = (data.empty || !data.summary)
          ? '<p class="pf-day-empty">Nothing saved for this day — a quiet one, or before you joined.</p>'
          : `<p class="pf-day-body">${esc(data.summary)}</p>`;
        const c = data.counts || {};
        const chips = [];
        if (c.chats) chips.push(c.chats + ' message' + (c.chats > 1 ? 's' : '') + ' with Blak');
        if (c.moods) chips.push(c.moods + ' mood' + (c.moods > 1 ? 's' : ''));
        if (c.journals) chips.push(c.journals + ' journal' + (c.journals > 1 ? 's' : ''));
        if (c.minit) chips.push(c.minit + ' Minit');
        if (c.nexus) chips.push(c.nexus + ' Nexus');
        const counts = chips.length ? `<div class="pf-day-counts">${chips.map((x) => `<span class="pf-day-count">${esc(x)}</span>`).join('')}</div>` : '';
        dayEl.innerHTML = `<p class="pf-day-date">${esc(human)}</p>${body}${counts}`;
      } catch (e) {
        dayEl.innerHTML = `<p class="pf-day-date">${esc(human)}</p><p class="pf-day-empty">Couldn’t load this day — try again in a moment.</p>`;
      }
    }

    if (calGrid) calGrid.addEventListener('click', (e) => {
      const btn = e.target.closest('.pf-cal-cell[data-d]');
      if (!btn || btn.disabled) return;
      selDate = btn.dataset.d; renderGrid(); openDay(selDate);
    });
    if (calPrev) calPrev.addEventListener('click', () => { let m = calM - 1, y = calY; if (m < 0) { m = 11; y--; } loadMonth(y, m); });
    if (calNext) calNext.addEventListener('click', () => { if (calNext.disabled) return; let m = calM + 1, y = calY; if (m > 11) { m = 0; y++; } loadMonth(y, m); });

    function initCalendar() {
      if (!calCard) return;
      calCard.hidden = false;
      const n = new Date();
      loadMonth(n.getFullYear(), n.getMonth());
    }

    (async () => {
      if (!supabase) { root.innerHTML = '<div class="pf-loading">Sign-in isn’t configured in this environment yet.</div>'; return; }
      try {
        const { data } = await supabase.auth.getSession();
        user = data?.session?.user || null;
      } catch (e) { user = null; }
      if (!user) { return; } // AppLayout's auth gate will bounce to sign-in
      await reload();
      initCalendar();
    })();
  </script>
</AppLayout>
