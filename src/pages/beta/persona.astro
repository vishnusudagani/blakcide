---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout active="persona" title="Persona">
  <div class="ap-page px">
    <p class="ap-kicker">Persona · your digital self</p>
    <h1 class="ap-h1">A you that speaks <span class="px-accent">in your own voice.</span></h1>
    <p class="ap-sub">Record your voice once per language. Then talk — and your persona answers back, in your voice, in whichever language you speak.</p>

    <div id="px-app" hidden>
      <!-- ── 1. YOUR VOICE — enrollment ─────────────────────────── -->
      <section class="ap-card px-card">
        <div class="px-card-head">
          <h2 class="px-card-title">Your voice</h2>
          <span class="px-card-tag" id="px-voice-tag">not recorded yet</span>
        </div>

        <div class="px-langs" id="px-enroll-langs" role="tablist" aria-label="Language to record"></div>

        <p class="px-phrase-label">Read this aloud, clearly, once:</p>
        <blockquote class="px-phrase" id="px-phrase"></blockquote>

        <div class="px-rec">
          <button type="button" class="px-mic" id="px-rec-btn" aria-label="Record">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
          </button>
          <div class="px-rec-meta">
            <span class="px-rec-state" id="px-rec-state">Tap to record</span>
            <span class="px-rec-timer" id="px-rec-timer">0:00</span>
          </div>
        </div>

        <div class="px-review" id="px-review" hidden>
          <audio id="px-review-audio" controls></audio>
          <div class="px-review-actions">
            <button type="button" class="px-btn px-btn-go" id="px-save">Save my voice</button>
            <button type="button" class="px-btn px-btn-ghost" id="px-redo">Re-record</button>
          </div>
        </div>

        <p class="px-msg" id="px-enroll-msg" role="status"></p>

        <div class="px-enrolled" id="px-enrolled" hidden>
          <p class="px-enrolled-label">Your recorded voices</p>
          <ul class="px-enrolled-list" id="px-enrolled-list"></ul>
          <button type="button" class="px-btn px-btn-danger" id="px-delete">Delete my voice</button>
        </div>
      </section>

      <!-- ── 2. TALK TO YOUR PERSONA ────────────────────────────── -->
      <section class="ap-card px-card">
        <div class="px-card-head">
          <h2 class="px-card-title">Talk to your persona</h2>
          <div class="px-talk-lang">
            <label for="px-talk-select">Voice</label>
            <select id="px-talk-select"></select>
          </div>
        </div>

        <div class="px-thread" id="px-thread" aria-live="polite">
          <div class="px-bubble px-bubble-ai">Record your voice above, then say something here — I’ll answer back in your voice.</div>
        </div>

        <form class="px-composer" id="px-form">
          <button type="button" class="px-mic-sm" id="px-voicein" aria-label="Speak" title="Speak">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
          </button>
          <input type="text" id="px-input" placeholder="Say something to your persona…" autocomplete="off" />
          <button type="submit" class="px-send" aria-label="Send"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
        <audio id="px-talk-audio" hidden></audio>
      </section>

      <p class="px-note">Your voice is stored privately, only for you, and only after you read the phrase aloud (so it’s really you). One‑tap delete any time. Nothing is ever sent as you without your approval.</p>
    </div>
  </div>

  <style>
    .px-accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; background: linear-gradient(110deg, var(--lavender), var(--lavender-deep)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    html[data-theme="light"] .px-accent { background: linear-gradient(110deg, var(--lavender-ink), #5b46ad); -webkit-background-clip: text; background-clip: text; }

    .px-gate { padding: 1.4rem 1.5rem; margin-top: 1.6rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .px-gate p { margin: 0; color: var(--ink-soft); font-size: var(--fs-lg); }

    .px-card { padding: 1.3rem 1.4rem 1.5rem; margin-top: 1.6rem; }
    .px-card-head { display: flex; align-items: center; gap: .8rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); margin-bottom: 1.1rem; }
    .px-card-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); margin: 0; }
    .px-card-tag { margin-left: auto; font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .12em; text-transform: uppercase; color: var(--lavender); border: 1px solid rgba(201,184,255,.4); border-radius: 999px; padding: .2rem .6rem; }
    .px-card-tag.is-ready { color: var(--mint); border-color: rgba(127, 224, 183, .45); }

    .px-langs { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.2rem; }
    .px-lang { font: inherit; font-size: var(--fs-md); font-weight: 500; color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .5rem 1rem; cursor: pointer; transition: .18s; display: inline-flex; align-items: center; gap: .45rem; }
    .px-lang:hover { color: var(--ink); transform: translateY(-1px); }
    .px-lang.is-on { color: var(--ink); background: var(--surface-strong); box-shadow: inset 0 0 0 1px var(--lavender); }
    .px-lang .px-check { width: 7px; height: 7px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 6px var(--mint); }

    .px-phrase-label { margin: 0 0 .5rem; font-size: var(--fs-sm); color: var(--ink-faint); }
    .px-phrase { margin: 0 0 1.3rem; padding: 1rem 1.15rem; border-radius: 6px 16px 16px 16px; background: rgba(201,184,255,.10); border: 1px solid rgba(201,184,255,.22); font-size: var(--fs-lg); line-height: 1.55; color: var(--ink); }

    .px-rec { display: flex; align-items: center; gap: 1rem; }
    .px-mic { flex: none; width: 64px; height: 64px; border-radius: 50%; border: 0; cursor: pointer; color: #fff; background: linear-gradient(135deg, var(--lavender-deep), var(--lavender)); box-shadow: 0 0 22px rgba(201,184,255,.45); transition: transform .15s; display: grid; place-items: center; }
    .px-mic:hover { transform: scale(1.04); }
    .px-mic svg { width: 26px; height: 26px; }
    .px-mic.is-rec { background: linear-gradient(135deg, #F4458C, #FF6B9D); box-shadow: 0 0 0 0 rgba(244,69,140,.5); animation: px-pulse 1.4s infinite; }
    @keyframes px-pulse { 0% { box-shadow: 0 0 0 0 rgba(244,69,140,.5); } 70% { box-shadow: 0 0 0 14px rgba(244,69,140,0); } 100% { box-shadow: 0 0 0 0 rgba(244,69,140,0); } }
    .px-rec-meta { display: flex; flex-direction: column; line-height: 1.3; }
    .px-rec-state { font-size: var(--fs-md); color: var(--ink); font-weight: 500; }
    .px-rec-timer { font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--ink-faint); }

    .px-review { margin-top: 1.2rem; }
    .px-review audio { width: 100%; height: 40px; }
    .px-review-actions { display: flex; gap: .6rem; margin-top: .8rem; }

    .px-btn { font: inherit; font-size: var(--fs-md); font-weight: 550; border-radius: var(--r-pill); padding: .6rem 1.2rem; cursor: pointer; border: 1px solid transparent; transition: .15s; }
    .px-btn-go { color: #1b1030; background: var(--cta-grad); box-shadow: 0 0 16px rgba(255,107,157,.3); border: 0; }
    .px-btn-go:hover { transform: translateY(-1px); }
    .px-btn-ghost { background: var(--surface); border-color: var(--line-strong); color: var(--ink-soft); }
    .px-btn-ghost:hover { color: var(--ink); }
    .px-btn-danger { background: none; border-color: rgba(244,69,140,.4); color: var(--coral); margin-top: 1rem; }
    .px-btn-danger:hover { background: rgba(244,69,140,.08); }
    .px-btn:disabled { opacity: .5; cursor: progress; transform: none; }

    .px-msg { margin: 1rem 0 0; font-size: var(--fs-sm); min-height: 1.2em; }
    .px-msg.is-err { color: var(--coral); }
    .px-msg.is-ok { color: var(--mint); }
    .px-msg.is-busy { color: var(--ink-faint); }

    .px-enrolled { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
    .px-enrolled-label { margin: 0 0 .6rem; font-size: var(--fs-sm); color: var(--ink-faint); }
    .px-enrolled-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
    .px-enrolled-list li { font-size: var(--fs-sm); color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .35rem .8rem; display: inline-flex; align-items: center; gap: .4rem; }
    .px-enrolled-list li .px-check { width: 7px; height: 7px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 6px var(--mint); }

    /* talk */
    .px-talk-lang { margin-left: auto; display: flex; align-items: center; gap: .5rem; }
    .px-talk-lang label { font-size: var(--fs-sm); color: var(--ink-faint); }
    .px-talk-lang select { font: inherit; font-size: var(--fs-md); color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-md); padding: .4rem .6rem; }
    .px-thread { display: flex; flex-direction: column; gap: .7rem; max-height: 320px; overflow-y: auto; padding: .3rem .1rem .6rem; }
    .px-bubble { max-width: 85%; padding: .75rem 1rem; border-radius: 16px; font-size: var(--fs-base); line-height: 1.55; }
    .px-bubble-ai { align-self: flex-start; border-radius: 6px 16px 16px 16px; background: rgba(201,184,255,.12); border: 1px solid rgba(201,184,255,.22); color: var(--ink); }
    .px-bubble-me { align-self: flex-end; border-radius: 16px 16px 6px 16px; background: var(--surface-strong); border: 1px solid var(--line-strong); color: var(--ink); }
    .px-bubble-ai.is-speaking { box-shadow: 0 0 0 1px rgba(201,184,255,.4); }
    .px-bubble.is-thinking { color: var(--ink-faint); font-style: italic; }

    .px-composer { display: flex; gap: .5rem; margin-top: 1.1rem; align-items: center; }
    .px-composer input { flex: 1; min-width: 0; padding: .8rem 1.05rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-md); }
    .px-composer input:focus { outline: none; border-color: var(--lavender); }
    .px-mic-sm, .px-send { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer; display: grid; place-items: center; color: #fff; }
    .px-mic-sm { background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink-soft); }
    .px-mic-sm:hover { color: var(--ink); }
    .px-mic-sm.is-rec { background: linear-gradient(135deg, #F4458C, #FF6B9D); color: #fff; border: 0; animation: px-pulse 1.4s infinite; }
    .px-send { background: linear-gradient(135deg, var(--lavender-deep), var(--lavender)); }
    .px-mic-sm svg, .px-send svg { width: 18px; height: 18px; }

    .px-note { margin: 1.2rem .2rem 0; font-size: var(--fs-xs); color: var(--ink-faint); text-align: center; line-height: 1.6; }
  </style>

  <script>
    import { supabase } from '../../lib/supabaseClient';

    // Same-origin '/api' in production (Netlify proxies to the backend). For local
    // dev against a running symp-backend, set PUBLIC_API_BASE=http://localhost:4000.
    const API = (import.meta.env.PUBLIC_API_BASE || '').replace(/\/+$/, '');

    const LANGS = [
      { code: 'en', label: 'English', stt: 'en-US',
        phrase: 'Hello, this is my own voice, and today I am recording it to create my persona.' },
      { code: 'hi', label: 'हिन्दी', stt: 'hi-IN',
        phrase: 'नमस्ते, यह मेरी अपनी आवाज़ है। आज मैं इसे रिकॉर्ड कर रहा हूँ।' },
      { code: 'te', label: 'తెలుగు', stt: 'te-IN',
        phrase: 'నమస్తే, ఇది నా సొంత గొంతు. ఈ రోజు నేను దీన్ని రికార్డ్ చేస్తున్నాను.' },
    ];

    const $ = (id) => document.getElementById(id);
    let session = null;          // { token, userId }
    let enrolled = new Set();    // languages with a ready clone
    let enrollLang = 'en';
    let recBlob = null;          // last recorded WAV blob
    const history = [];          // chat history for /api/chat

    // ── auth ──────────────────────────────────────────────────────────────
    async function getSession() {
      if (!supabase) return null;
      try {
        const { data } = await supabase.auth.getSession();
        const s = data && data.session;
        if (!s) return null;
        return { token: s.access_token, userId: s.user.id, email: s.user.email };
      } catch { return null; }
    }

    // ── recording → 24kHz mono 16-bit WAV (clean reference for every engine) ──
    let mediaRecorder = null, chunks = [], micStream = null, recTimer = null, recStart = 0;

    async function startRec() {
      micStream = await navigator.mediaDevices.getUserMedia({ audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true } });
      chunks = [];
      mediaRecorder = new MediaRecorder(micStream);
      mediaRecorder.ondataavailable = (e) => { if (e.data && e.data.size) chunks.push(e.data); };
      mediaRecorder.start();
      recStart = Date.now();
      recTimer = setInterval(updateTimer, 200);
    }
    function stopRec() {
      return new Promise((resolve) => {
        mediaRecorder.onstop = async () => {
          clearInterval(recTimer);
          if (micStream) micStream.getTracks().forEach((t) => t.stop());
          const raw = new Blob(chunks, { type: mediaRecorder.mimeType || 'audio/webm' });
          resolve(await toWav24kMono(raw));
        };
        mediaRecorder.stop();
      });
    }
    function updateTimer() {
      const s = Math.floor((Date.now() - recStart) / 1000);
      $('px-rec-timer').textContent = Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
    }

    async function toWav24kMono(blob) {
      const AC = window.AudioContext || window.webkitAudioContext;
      const ctx = new AC();
      const decoded = await ctx.decodeAudioData(await blob.arrayBuffer());
      ctx.close && ctx.close();
      const SR = 24000, len = decoded.length, ch = decoded.numberOfChannels;
      const mono = new Float32Array(len);
      for (let c = 0; c < ch; c++) { const d = decoded.getChannelData(c); for (let i = 0; i < len; i++) mono[i] += d[i] / ch; }
      const offline = new OfflineAudioContext(1, Math.max(1, Math.ceil((len * SR) / decoded.sampleRate)), SR);
      const buf = offline.createBuffer(1, len, decoded.sampleRate);
      buf.copyToChannel(mono, 0);
      const src = offline.createBufferSource(); src.buffer = buf; src.connect(offline.destination); src.start();
      const out = (await offline.startRendering()).getChannelData(0);
      return encodeWav(out, SR);
    }
    function encodeWav(samples, sr) {
      const view = new DataView(new ArrayBuffer(44 + samples.length * 2));
      const w = (o, s) => { for (let i = 0; i < s.length; i++) view.setUint8(o + i, s.charCodeAt(i)); };
      w(0, 'RIFF'); view.setUint32(4, 36 + samples.length * 2, true); w(8, 'WAVE'); w(12, 'fmt ');
      view.setUint32(16, 16, true); view.setUint16(20, 1, true); view.setUint16(22, 1, true);
      view.setUint32(24, sr, true); view.setUint32(28, sr * 2, true); view.setUint16(32, 2, true); view.setUint16(34, 16, true);
      w(36, 'data'); view.setUint32(40, samples.length * 2, true);
      let o = 44; for (let i = 0; i < samples.length; i++) { const x = Math.max(-1, Math.min(1, samples[i])); view.setInt16(o, x < 0 ? x * 0x8000 : x * 0x7fff, true); o += 2; }
      return new Blob([view], { type: 'audio/wav' });
    }
    const blobToB64 = (blob) => new Promise((res) => { const fr = new FileReader(); fr.onload = () => res(String(fr.result).split(',')[1]); fr.readAsDataURL(blob); });

    // ── enroll UI ─────────────────────────────────────────────────────────
    function curLang() { return LANGS.find((l) => l.code === enrollLang); }
    function renderEnrollLangs() {
      const wrap = $('px-enroll-langs'); wrap.innerHTML = '';
      LANGS.forEach((l) => {
        const b = document.createElement('button');
        b.className = 'px-lang' + (l.code === enrollLang ? ' is-on' : '');
        b.type = 'button';
        b.innerHTML = (enrolled.has(l.code) ? '<span class="px-check"></span>' : '') + l.label;
        b.onclick = () => { enrollLang = l.code; renderEnrollLangs(); $('px-phrase').textContent = curLang().phrase; resetReview(); };
        wrap.appendChild(b);
      });
      $('px-phrase').textContent = curLang().phrase;
    }
    function resetReview() {
      recBlob = null;
      $('px-review').hidden = true;
      $('px-rec-state').textContent = 'Tap to record';
      $('px-rec-timer').textContent = '0:00';
    }
    function setMsg(el, kind, text) { el.className = 'px-msg' + (kind ? ' is-' + kind : ''); el.textContent = text || ''; }

    async function onRecClick() {
      const btn = $('px-rec-btn');
      if (btn.classList.contains('is-rec')) {
        btn.classList.remove('is-rec');
        $('px-rec-state').textContent = 'Processing…';
        try {
          recBlob = await stopRec();
          $('px-review-audio').src = URL.createObjectURL(recBlob);
          $('px-review').hidden = false;
          $('px-rec-state').textContent = 'Recorded — listen back, then save';
          setMsg($('px-enroll-msg'), '', '');
        } catch (e) { setMsg($('px-enroll-msg'), 'err', 'Could not process the recording. Try again.'); }
        return;
      }
      setMsg($('px-enroll-msg'), '', '');
      try {
        await startRec();
        btn.classList.add('is-rec');
        $('px-rec-state').textContent = 'Recording… tap to stop';
      } catch (e) {
        setMsg($('px-enroll-msg'), 'err', 'Microphone permission is needed to record your voice.');
      }
    }

    async function onSave() {
      if (!recBlob) return;
      const l = curLang();
      const btn = $('px-save'); btn.disabled = true;
      setMsg($('px-enroll-msg'), 'busy', 'Checking it’s really you and saving privately…');
      try {
        const audio_base64 = await blobToB64(recBlob);
        const r = await fetch(API + '/api/voice-clone/enroll', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + session.token },
          body: JSON.stringify({ language: l.code, audio_base64, mime_type: 'audio/wav', prompt_phrase: l.phrase }),
        });
        const j = await r.json();
        if (j.ok) {
          setMsg($('px-enroll-msg'), 'ok', 'Saved! Your ' + l.label + ' voice is ready.');
          resetReview();
          await loadStatus();
        } else {
          const code = j.error && j.error.code;
          const map = {
            liveness_failed: 'That didn’t match the phrase — please read it aloud, exactly, clearly.',
            clip_too_short: 'Too short — read the whole phrase, then stop.',
            liveness_unavailable: 'Couldn’t verify the recording just now. Please try again.',
          };
          setMsg($('px-enroll-msg'), 'err', map[code] || (j.error && j.error.message) || 'Could not save. Try again.');
        }
      } catch (e) {
        setMsg($('px-enroll-msg'), 'err', 'Network error — is the backend reachable? Try again.');
      } finally { btn.disabled = false; }
    }

    async function loadStatus() {
      try {
        const r = await fetch(API + '/api/voice-clone/status', { headers: { Authorization: 'Bearer ' + session.token } });
        const j = await r.json();
        enrolled = new Set(((j.data && j.data.clones) || []).filter((c) => c.status === 'ready').map((c) => c.language));
      } catch { /* leave enrolled as-is */ }
      // reflect everywhere
      const ready = enrolled.size > 0;
      $('px-voice-tag').textContent = ready ? (enrolled.size + ' language' + (enrolled.size > 1 ? 's' : '') + ' ready') : 'not recorded yet';
      $('px-voice-tag').classList.toggle('is-ready', ready);
      renderEnrollLangs();
      const list = $('px-enrolled-list'); list.innerHTML = '';
      LANGS.filter((l) => enrolled.has(l.code)).forEach((l) => {
        const li = document.createElement('li'); li.innerHTML = '<span class="px-check"></span>' + l.label; list.appendChild(li);
      });
      $('px-enrolled').hidden = !ready;
      renderTalkOptions();
    }

    async function onDelete() {
      if (!confirm('Delete your voice in all languages? This removes your recordings permanently.')) return;
      const btn = $('px-delete'); btn.disabled = true;
      try {
        await fetch(API + '/api/voice-clone', { method: 'DELETE', headers: { Authorization: 'Bearer ' + session.token } });
        await loadStatus();
        setMsg($('px-enroll-msg'), 'ok', 'Your voice was deleted.');
      } catch { setMsg($('px-enroll-msg'), 'err', 'Could not delete. Try again.'); }
      finally { btn.disabled = false; }
    }

    // ── talk ──────────────────────────────────────────────────────────────
    function renderTalkOptions() {
      const sel = $('px-talk-select'); const prev = sel.value;
      sel.innerHTML = '';
      LANGS.forEach((l) => {
        const o = document.createElement('option'); o.value = l.code;
        o.textContent = l.label + (enrolled.has(l.code) ? ' · your voice' : ' · stand-in');
        sel.appendChild(o);
      });
      if (prev) sel.value = prev;
    }
    function addBubble(kind, text) {
      const d = document.createElement('div');
      d.className = 'px-bubble px-bubble-' + kind;
      d.textContent = text;
      $('px-thread').appendChild(d);
      $('px-thread').scrollTop = $('px-thread').scrollHeight;
      return d;
    }

    async function sendTurn(text) {
      const lang = $('px-talk-select').value;
      addBubble('me', text);
      history.push({ role: 'user', content: text });
      const thinking = addBubble('ai', '…'); thinking.classList.add('is-thinking');
      try {
        const cr = await fetch(API + '/api/chat', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_id: session.userId, messages: history.slice(-12) }),
        });
        if (!cr.ok || !cr.body) throw new Error('http_' + cr.status);
        // /api/chat streams Server-Sent Events: data: {"delta":"…"} … data: {"done":true}
        const reader = cr.body.getReader();
        const decoder = new TextDecoder();
        let reply = '', buf = '';
        thinking.classList.remove('is-thinking'); thinking.textContent = '';
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          buf += decoder.decode(value, { stream: true });
          const lines = buf.split('\n');
          buf = lines.pop() || '';
          for (const line of lines) {
            const t = line.trim();
            if (!t.startsWith('data:')) continue;
            const p = t.slice(5).trim();
            if (!p || p === '[DONE]') continue;
            let obj; try { obj = JSON.parse(p); } catch { continue; }
            if (obj.delta) { reply += obj.delta; thinking.textContent = reply; $('px-thread').scrollTop = $('px-thread').scrollHeight; }
            if (obj.error) throw new Error(String(obj.error));
          }
        }
        reply = (reply.trim()) || 'Sorry, I could not reply just now.';
        thinking.textContent = reply;
        history.push({ role: 'assistant', content: reply });
        // speak it back in the cloned voice
        thinking.classList.add('is-speaking');
        await speak(reply, lang, thinking);
        thinking.classList.remove('is-speaking');
      } catch (e) {
        thinking.classList.remove('is-thinking'); thinking.textContent = 'Network error — is the backend reachable?';
      }
    }

    // ── Voice: talk back via the self-hosted Svara-TTS engine (Modal GPU), called
    // DIRECTLY from the browser so the GPU cold-start (~2 min, one-time) isn't bound
    // by a serverless function timeout. Phase 1 = natural language preset voice;
    // phase 2 will swap to the user's clone (reference_audio + reference_transcript). ──
    // Your own voice-infer engine (OmniVoice — cross-lingual clone incl. Telugu).
    const SVARA_URL = 'https://ceo-91462--voice-infer-fastapi-app.modal.run';
    let svaraWarm = false;
    function svaraVoice(language) {
      return ({ en: 'en_female', hi: 'hi_female', te: 'te_female' })[language] || 'en_female';
    }
    // Unlock the <audio> element during a real user gesture (the Send tap) by playing
    // 0.1s of silence — so the browser lets us auto-play the spoken reply later, even
    // after the synth delay (otherwise autoplay is blocked and only a manual tap works).
    let audioUnlocked = false;
    function unlockAudio() {
      if (audioUnlocked) return;
      try {
        const a = $('px-talk-audio');
        a.src = URL.createObjectURL(encodeWav(new Float32Array(2400), 24000));
        const p = a.play();
        if (p && p.then) p.then(() => { a.pause(); a.currentTime = 0; audioUnlocked = true; }).catch(() => {});
        else audioUnlocked = true;
      } catch (e) {}
    }
    function svaraWarmPing() {
      // Fire-and-forget no-cors warm-up — kicks the GPU container awake WITHOUT
      // tripping CORS on Modal's cold-start redirect (no-cors fetches skip CORS).
      try { fetch(SVARA_URL + '/health', { mode: 'no-cors', cache: 'no-store' }); } catch (e) {}
    }
    async function svaraReady() {
      // A real CORS GET returns 200 ONLY once the container is warm. While it's cold,
      // Modal 303-redirects to a polling URL with no CORS header, so this fetch throws —
      // we treat that throw as "still warming" and poll until it answers a clean 200.
      try { const r = await fetch(SVARA_URL + '/health', { cache: 'no-store' }); return r.ok; }
      catch (e) { return false; }
    }
    async function ensureWarm(status) {
      if (svaraWarm) return true;
      svaraWarmPing();
      for (let i = 0; i < 75; i++) {
        if (await svaraReady()) { svaraWarm = true; return true; }
        if (status) status.textContent = '🔊 warming up your voice (first time, ~2 min)…';
        await new Promise((r) => setTimeout(r, 4000));
      }
      return false;
    }
    // Fetch the user's saved reference clip (base64) so the engine speaks in THEIR
    // voice. Cached per language. Falls back to null → preset voice if none saved.
    const refCache = {};
    async function getUserRef(language) {
      if (refCache[language] !== undefined) return refCache[language];
      let ref = null;
      try {
        if (session && session.token) {
          const r = await fetch(API + '/api/voice-clone/ref?language=' + encodeURIComponent(language), { headers: { Authorization: 'Bearer ' + session.token } });
          if (r.ok) {
            const d = (await r.json()).data || {};
            if (d.audio_base64) ref = { b64: d.audio_base64, transcript: d.transcript || '' };
          }
        }
      } catch (e) { ref = null; }
      refCache[language] = ref;
      return ref;
    }
    async function speak(text, language, bubble) {
      const audioEl = $('px-talk-audio');
      const voice = svaraVoice(language);
      const status = document.createElement('div');
      status.style.cssText = 'font-size:.82em;opacity:.75;margin-top:.45rem;';
      if (bubble) bubble.appendChild(status);
      try {
        if (!(await ensureWarm(status))) { status.textContent = '(voice is taking too long to start — try again in a minute)'; return; }
        const ref = await getUserRef(language).catch(() => null);
        // Call YOUR OmniVoice engine — clone mode uses the user's saved clip.
        const body = { language, text, mode: (ref && ref.b64) ? 'clone' : 'preset', format: 'mp3' };
        if (ref && ref.b64) { body.reference_base64 = ref.b64; body.reference_transcript = ref.transcript; }
        const synth = (b) => fetch(SVARA_URL + '/synthesize', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(b),
        });
        let res = await synth(body);
        if (!res.ok && body.mode === 'clone') {
          // Clone failed — fall back to a preset voice so it still speaks.
          res = await synth({ language, text, mode: 'preset', format: 'mp3' }).catch(() => res);
        }
        if (!res.ok) { status.textContent = '(voice unavailable — code ' + res.status + ')'; return; }
        audioEl.src = URL.createObjectURL(await res.blob());
        try { await audioEl.play(); status.remove(); }
        catch (e) {
          // Autoplay blocked (after a wait / no fresh gesture) — offer a tap.
          status.textContent = '';
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = '🔊 Tap to hear';
          btn.style.cssText = 'font:inherit;font-size:.85em;cursor:pointer;border:1px solid currentColor;border-radius:999px;padding:.25rem .7rem;background:transparent;color:inherit;';
          btn.onclick = () => { audioEl.play().catch(() => {}); btn.remove(); };
          status.appendChild(btn);
        }
      } catch (e) { status.textContent = '(voice could not be reached — try again)'; }
    }

    // browser speech-to-text for hands-free input (optional, no backend cost)
    let recog = null, listening = false;
    function setupVoiceIn() {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) { $('px-voicein').style.display = 'none'; return; }
      $('px-voicein').onclick = () => {
        if (listening) { recog && recog.stop(); return; }
        recog = new SR();
        recog.lang = (LANGS.find((l) => l.code === $('px-talk-select').value) || LANGS[0]).stt;
        recog.interimResults = false; recog.maxAlternatives = 1;
        recog.onresult = (e) => { const t = e.results[0][0].transcript; if (t) sendTurn(t.trim()); };
        recog.onend = () => { listening = false; $('px-voicein').classList.remove('is-rec'); };
        recog.onerror = () => { listening = false; $('px-voicein').classList.remove('is-rec'); };
        listening = true; $('px-voicein').classList.add('is-rec'); recog.start();
      };
    }

    // ── boot ──────────────────────────────────────────────────────────────
    (async () => {
      // AppLayout gates the whole beta app, so by here the user is signed in.
      svaraWarmPing();   // start warming the voice GPU now — overlaps with the user recording/reading
      session = await getSession();
      // After a hard refresh the Supabase session can hydrate a beat late — retry
      // briefly so the first loadStatus() runs with a real token (fixes the saved
      // voice wrongly showing as "deleted" on reload).
      for (let i = 0; !session && i < 20; i++) { await new Promise((r) => setTimeout(r, 150)); session = await getSession(); }
      $('px-app').hidden = false;
      renderEnrollLangs();
      renderTalkOptions();
      setupVoiceIn();
      $('px-rec-btn').onclick = onRecClick;
      $('px-save').onclick = onSave;
      $('px-redo').onclick = resetReview;
      $('px-delete').onclick = onDelete;
      $('px-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const v = $('px-input').value.trim(); if (!v) return;
        unlockAudio();                 // bless audio playback within this user gesture
        $('px-input').value = ''; sendTurn(v);
      });
      await loadStatus();
      // Keep the token fresh and re-sync the saved voice whenever auth hydrates or
      // the token auto-refreshes — so a reload never loses the recorded voice.
      if (supabase) {
        supabase.auth.onAuthStateChange((_event, s) => {
          if (s) { session = { token: s.access_token, userId: s.user.id, email: s.user.email }; loadStatus(); }
        });
      }
    })();
  </script>
</AppLayout>
