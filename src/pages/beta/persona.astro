---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout active="persona" title="Persona">
  <div class="ap-page px">
    <p class="ap-kicker">Persona · your digital self</p>
    <h1 class="ap-h1">A you that speaks <span class="px-accent">in your own voice.</span></h1>
    <p class="ap-sub">Build your Persona by just talking. Answer a few questions out loud — in any language you like. The more you say, the more it becomes you.</p>

    <div id="px-app" hidden>
      <!-- ── 1. YOUR VOICE — interview enrollment ─────────────────── -->
      <section class="ap-card px-card">
        <div class="px-card-head">
          <h2 class="px-card-title">Meet your Persona</h2>
          <span class="px-card-tag" id="px-voice-tag">not started</span>
        </div>

        <div class="px-progress" id="px-progress" aria-hidden="true"></div>

        <p class="px-phrase-label" id="px-q-label">Answer out loud, in any language:</p>
        <blockquote class="px-phrase" id="px-question"></blockquote>

        <div class="px-rec">
          <button type="button" class="px-mic" id="px-rec-btn" aria-label="Record your answer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
          </button>
          <div class="px-rec-meta">
            <span class="px-rec-state" id="px-rec-state">Tap to answer</span>
            <span class="px-rec-timer" id="px-rec-timer">0:00</span>
          </div>
        </div>

        <div class="px-review" id="px-review" hidden>
          <audio id="px-review-audio" controls></audio>
          <div class="px-review-actions">
            <button type="button" class="px-btn px-btn-go" id="px-save">Save &amp; next</button>
            <button type="button" class="px-btn px-btn-ghost" id="px-redo">Re-record</button>
          </div>
        </div>

        <p class="px-msg" id="px-enroll-msg" role="status"></p>

        <div class="px-enrolled" id="px-enrolled" hidden>
          <p class="px-enrolled-label" id="px-enrolled-label"></p>
          <div class="px-train" id="px-train" hidden>
            <button type="button" class="px-btn px-btn-go" id="px-train-btn">Make it sound exactly like me</button>
            <p class="px-train-hint">Trains a private model on your recordings so your Persona speaks Telugu, Hindi &amp; English natively — in your own voice. ~10–20 min, one time.</p>
            <p class="px-train-msg" id="px-train-msg" role="status"></p>
          </div>
          <button type="button" class="px-btn px-btn-danger" id="px-delete">Delete my voice</button>
        </div>
      </section>

      <!-- ── 2. YOUR MIND — self-interview (feeds the same profile) ── -->
      <section class="ap-card px-card">
        <div class="px-card-head">
          <h2 class="px-card-title">Your mind</h2>
          <span class="px-card-tag" id="px-mind-tag">tell it about you</span>
        </div>
        <p class="px-phrase-label">Tell your Persona about you — in your own words, any language. The more you share, the more it thinks like you.</p>
        <blockquote class="px-phrase" id="px-mind-q"></blockquote>
        <div class="px-mind">
          <textarea id="px-mind-answer" class="px-mind-text" rows="3" placeholder="Type or speak your answer…"></textarea>
          <div class="px-mind-actions">
            <button type="button" class="px-mic-sm" id="px-mind-mic" aria-label="Speak your answer" title="Speak">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
            </button>
            <button type="button" class="px-btn px-btn-go" id="px-mind-save">Save &amp; next</button>
            <button type="button" class="px-btn px-btn-ghost" id="px-mind-skip">Skip</button>
          </div>
        </div>
        <p class="px-msg" id="px-mind-msg" role="status"></p>
      </section>

      <!-- ── 3. TALK TO YOUR PERSONA ──────────────────────────────── -->
      <section class="ap-card px-card">
        <div class="px-card-head">
          <h2 class="px-card-title">Talk to your persona</h2>
        </div>

        <div class="px-thread" id="px-thread" aria-live="polite">
          <div class="px-bubble px-bubble-ai">Record a few answers above, then say anything here — in any language — and I’ll reply in your voice.</div>
        </div>

        <form class="px-composer" id="px-form">
          <button type="button" class="px-mic-sm" id="px-voicein" aria-label="Speak" title="Speak">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
          </button>
          <input type="text" id="px-input" placeholder="Say something — any language…" autocomplete="off" />
          <button type="submit" class="px-send" aria-label="Send"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
        <audio id="px-talk-audio" hidden></audio>
      </section>

      <p class="px-note">Your voice is stored privately, only for you. One‑tap delete any time. Nothing is ever sent as you without your approval.</p>
    </div>
  </div>

  <style>
    .px-accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; background: linear-gradient(110deg, var(--lavender), var(--lavender-deep)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    html[data-theme="light"] .px-accent { background: linear-gradient(110deg, var(--lavender-ink), #5b46ad); -webkit-background-clip: text; background-clip: text; }

    .px-card { padding: 1.3rem 1.4rem 1.5rem; margin-top: 1.6rem; }
    .px-card-head { display: flex; align-items: center; gap: .8rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); margin-bottom: 1.1rem; }
    .px-card-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); margin: 0; }
    .px-card-tag { margin-left: auto; font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .12em; text-transform: uppercase; color: var(--lavender); border: 1px solid rgba(201,184,255,.4); border-radius: 999px; padding: .2rem .6rem; }
    .px-card-tag.is-ready { color: var(--mint); border-color: rgba(127, 224, 183, .45); }

    .px-progress { display: flex; gap: .4rem; margin-bottom: 1.1rem; }
    .px-progress .px-dot { flex: 1; height: 4px; border-radius: 2px; background: var(--line-strong); transition: background .25s; }
    .px-progress .px-dot.is-done { background: var(--mint); }
    .px-progress .px-dot.is-now { background: var(--lavender); }

    .px-phrase-label { margin: 0 0 .5rem; font-size: var(--fs-sm); color: var(--ink-faint); }
    .px-phrase { margin: 0 0 1.3rem; padding: 1rem 1.15rem; border-radius: 6px 16px 16px 16px; background: rgba(201,184,255,.10); border: 1px solid rgba(201,184,255,.22); font-size: var(--fs-lg); line-height: 1.55; color: var(--ink); }

    .px-rec { display: flex; align-items: center; gap: 1rem; }
    .px-mic { flex: none; width: 64px; height: 64px; border-radius: 50%; border: 0; cursor: pointer; color: #fff; background: linear-gradient(135deg, var(--lavender-deep), var(--lavender)); box-shadow: 0 0 22px rgba(201,184,255,.45); transition: transform .15s; display: grid; place-items: center; }
    .px-mic:hover { transform: scale(1.04); }
    .px-mic svg { width: 26px; height: 26px; }
    .px-mic.is-rec { background: linear-gradient(135deg, #F4458C, #FF6B9D); box-shadow: 0 0 0 0 rgba(244,69,140,.5); animation: px-pulse 1.4s infinite; }
    @keyframes px-pulse { 0% { box-shadow: 0 0 0 0 rgba(244,69,140,.5); } 70% { box-shadow: 0 0 0 14px rgba(244,69,140,0); } 100% { box-shadow: 0 0 0 0 rgba(244,69,140,0); } }
    .px-rec-meta { display: flex; flex-direction: column; line-height: 1.3; }
    .px-rec-state { font-size: var(--fs-md); color: var(--ink); font-weight: 500; }
    .px-rec-timer { font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--ink-faint); }

    .px-review { margin-top: 1.2rem; }
    .px-review audio { width: 100%; height: 40px; }
    .px-review-actions { display: flex; gap: .6rem; margin-top: .8rem; }

    .px-btn { font: inherit; font-size: var(--fs-md); font-weight: 550; border-radius: var(--r-pill); padding: .6rem 1.2rem; cursor: pointer; border: 1px solid transparent; transition: .15s; }
    .px-btn-go { color: #1b1030; background: var(--cta-grad); box-shadow: 0 0 16px rgba(255,107,157,.3); border: 0; }
    .px-btn-go:hover { transform: translateY(-1px); }
    .px-btn-ghost { background: var(--surface); border-color: var(--line-strong); color: var(--ink-soft); }
    .px-btn-ghost:hover { color: var(--ink); }
    .px-btn-danger { background: none; border-color: rgba(244,69,140,.4); color: var(--coral); margin-top: 1rem; }
    .px-btn-danger:hover { background: rgba(244,69,140,.08); }
    .px-btn:disabled { opacity: .5; cursor: progress; transform: none; }

    .px-msg { margin: 1rem 0 0; font-size: var(--fs-sm); min-height: 1.2em; }
    .px-msg.is-err { color: var(--coral); }
    .px-msg.is-ok { color: var(--mint); }
    .px-msg.is-busy { color: var(--ink-faint); }

    .px-enrolled { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
    .px-enrolled-label { margin: 0; font-size: var(--fs-sm); color: var(--ink-soft); }
    .px-train { margin: 1rem 0; }
    .px-train-hint { margin: .5rem 0 0; font-size: var(--fs-sm); color: var(--ink-soft); }
    .px-train-msg { margin: .5rem 0 0; }
    .px-mind { display: flex; flex-direction: column; gap: .6rem; }
    .px-mind-text { width: 100%; box-sizing: border-box; resize: vertical; min-height: 3.4rem; padding: .7rem .8rem; border-radius: 12px; border: 1px solid var(--line); background: transparent; color: var(--ink); font: inherit; font-size: 16px; line-height: 1.5; }
    .px-mind-actions { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }

    /* talk */
    .px-thread { display: flex; flex-direction: column; gap: .7rem; max-height: 320px; overflow-y: auto; padding: .3rem .1rem .6rem; }
    .px-bubble { max-width: 85%; padding: .75rem 1rem; border-radius: 16px; font-size: var(--fs-base); line-height: 1.55; }
    .px-bubble-ai { align-self: flex-start; border-radius: 6px 16px 16px 16px; background: rgba(201,184,255,.12); border: 1px solid rgba(201,184,255,.22); color: var(--ink); }
    .px-bubble-me { align-self: flex-end; border-radius: 16px 16px 6px 16px; background: var(--surface-strong); border: 1px solid var(--line-strong); color: var(--ink); }
    .px-bubble-ai.is-speaking { box-shadow: 0 0 0 1px rgba(201,184,255,.4); }
    .px-bubble.is-thinking { color: var(--ink-faint); font-style: italic; }

    .px-composer { display: flex; gap: .5rem; margin-top: 1.1rem; align-items: center; }
    .px-composer input { flex: 1; min-width: 0; padding: .8rem 1.05rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: 16px; }
    .px-composer input:focus { outline: none; border-color: var(--lavender); }
    .px-mic-sm, .px-send { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer; display: grid; place-items: center; color: #fff; }
    .px-mic-sm { background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink-soft); }
    .px-mic-sm:hover { color: var(--ink); }
    .px-mic-sm.is-rec { background: linear-gradient(135deg, #F4458C, #FF6B9D); color: #fff; border: 0; animation: px-pulse 1.4s infinite; }
    .px-send { background: linear-gradient(135deg, var(--lavender-deep), var(--lavender)); }
    .px-mic-sm svg, .px-send svg { width: 18px; height: 18px; }

    .px-note { margin: 1.2rem .2rem 0; font-size: var(--fs-xs); color: var(--ink-faint); text-align: center; line-height: 1.6; }
  </style>

  <script>
    import { supabase } from '../../lib/supabaseClient';

    // Same-origin '/api' in production (Netlify proxies to the backend). For local
    // dev against a running symp-backend, set PUBLIC_API_BASE=http://localhost:4000.
    const API = (import.meta.env.PUBLIC_API_BASE || '').replace(/\/+$/, '');

    // The interview — open, warm questions; the user answers out loud in ANY language.
    // No language picker, no fixed phrase: enrollment auto-detects the language server-side.
    const QUESTIONS = [
      "How's your day going so far?",
      "Tell me about something you're looking forward to.",
      "What's a place you love — and why?",
      "Describe someone who really matters to you.",
      "What's something that made you laugh recently?",
      "What's been on your mind lately?",
      "If you had a totally free afternoon, what would you do?",
      "Tell me anything you'd want your Persona to know about you.",
    ];

    const $ = (id) => document.getElementById(id);
    let session = null;          // { token, userId }
    let answersCount = 0;        // interview answers saved (server is the source of truth)
    let qIndex = 0;              // which question is showing
    let recBlob = null;          // last recorded WAV blob
    let personaTrained = false;  // user has a fine-tuned Svara voice (talk uses it)
    let trainPoll = null;        // train-status polling timer
    const history = [];          // chat history for /api/chat

    // ── auth ──────────────────────────────────────────────────────────────
    async function getSession() {
      if (!supabase) return null;
      try {
        const { data } = await supabase.auth.getSession();
        const s = data && data.session;
        if (!s) return null;
        return { token: s.access_token, userId: s.user.id, email: s.user.email };
      } catch { return null; }
    }

    // ── recording → 24kHz mono 16-bit WAV (clean reference for every engine) ──
    let mediaRecorder = null, chunks = [], micStream = null, recTimer = null, recStart = 0;

    async function startRec() {
      micStream = await navigator.mediaDevices.getUserMedia({ audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true } });
      chunks = [];
      mediaRecorder = new MediaRecorder(micStream);
      mediaRecorder.ondataavailable = (e) => { if (e.data && e.data.size) chunks.push(e.data); };
      mediaRecorder.start();
      recStart = Date.now();
      recTimer = setInterval(updateTimer, 200);
    }
    function stopRec() {
      return new Promise((resolve) => {
        mediaRecorder.onstop = async () => {
          clearInterval(recTimer);
          if (micStream) micStream.getTracks().forEach((t) => t.stop());
          const raw = new Blob(chunks, { type: mediaRecorder.mimeType || 'audio/webm' });
          resolve(await toWav24kMono(raw));
        };
        mediaRecorder.stop();
      });
    }
    function updateTimer() {
      const s = Math.floor((Date.now() - recStart) / 1000);
      $('px-rec-timer').textContent = Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
    }

    async function toWav24kMono(blob) {
      const AC = window.AudioContext || window.webkitAudioContext;
      const ctx = new AC();
      const decoded = await ctx.decodeAudioData(await blob.arrayBuffer());
      ctx.close && ctx.close();
      const SR = 24000, len = decoded.length, ch = decoded.numberOfChannels;
      const mono = new Float32Array(len);
      for (let c = 0; c < ch; c++) { const d = decoded.getChannelData(c); for (let i = 0; i < len; i++) mono[i] += d[i] / ch; }
      const offline = new OfflineAudioContext(1, Math.max(1, Math.ceil((len * SR) / decoded.sampleRate)), SR);
      const buf = offline.createBuffer(1, len, decoded.sampleRate);
      buf.copyToChannel(mono, 0);
      const src = offline.createBufferSource(); src.buffer = buf; src.connect(offline.destination); src.start();
      const out = (await offline.startRendering()).getChannelData(0);
      return encodeWav(out, SR);
    }
    function encodeWav(samples, sr) {
      const view = new DataView(new ArrayBuffer(44 + samples.length * 2));
      const w = (o, s) => { for (let i = 0; i < s.length; i++) view.setUint8(o + i, s.charCodeAt(i)); };
      w(0, 'RIFF'); view.setUint32(4, 36 + samples.length * 2, true); w(8, 'WAVE'); w(12, 'fmt ');
      view.setUint32(16, 16, true); view.setUint16(20, 1, true); view.setUint16(22, 1, true);
      view.setUint32(24, sr, true); view.setUint32(28, sr * 2, true); view.setUint16(32, 2, true); view.setUint16(34, 16, true);
      w(36, 'data'); view.setUint32(40, samples.length * 2, true);
      let o = 44; for (let i = 0; i < samples.length; i++) { const x = Math.max(-1, Math.min(1, samples[i])); view.setInt16(o, x < 0 ? x * 0x8000 : x * 0x7fff, true); o += 2; }
      return new Blob([view], { type: 'audio/wav' });
    }
    const blobToB64 = (blob) => new Promise((res) => { const fr = new FileReader(); fr.onload = () => res(String(fr.result).split(',')[1]); fr.readAsDataURL(blob); });

    // ── interview UI ────────────────────────────────────────────────────────
    function renderQuestion() {
      $('px-question').textContent = QUESTIONS[qIndex % QUESTIONS.length];
      $('px-q-label').textContent = answersCount === 0
        ? 'Answer out loud, in any language:'
        : 'Question ' + (qIndex + 1) + ' · answer in any language:';
      const prog = $('px-progress'); prog.innerHTML = '';
      for (let i = 0; i < QUESTIONS.length; i++) {
        const d = document.createElement('span');
        d.className = 'px-dot' + (i < answersCount ? ' is-done' : (i === (qIndex % QUESTIONS.length) ? ' is-now' : ''));
        prog.appendChild(d);
      }
    }
    function resetReview() {
      recBlob = null;
      $('px-review').hidden = true;
      $('px-rec-state').textContent = 'Tap to answer';
      $('px-rec-timer').textContent = '0:00';
    }
    function setMsg(el, kind, text) { el.className = 'px-msg' + (kind ? ' is-' + kind : ''); el.textContent = text || ''; }

    async function onRecClick() {
      const btn = $('px-rec-btn');
      if (btn.classList.contains('is-rec')) {
        btn.classList.remove('is-rec');
        $('px-rec-state').textContent = 'Processing…';
        try {
          recBlob = await stopRec();
          $('px-review-audio').src = URL.createObjectURL(recBlob);
          $('px-review').hidden = false;
          $('px-rec-state').textContent = 'Recorded — listen back, then save';
          setMsg($('px-enroll-msg'), '', '');
        } catch (e) { setMsg($('px-enroll-msg'), 'err', 'Could not process the recording. Try again.'); }
        return;
      }
      setMsg($('px-enroll-msg'), '', '');
      try {
        await startRec();
        btn.classList.add('is-rec');
        $('px-rec-state').textContent = 'Listening… tap to stop';
      } catch (e) {
        setMsg($('px-enroll-msg'), 'err', 'Microphone permission is needed to record your voice.');
      }
    }

    async function onSave() {
      if (!recBlob) return;
      const btn = $('px-save'); btn.disabled = true;
      setMsg($('px-enroll-msg'), 'busy', 'Saving privately…');
      try {
        const audio_base64 = await blobToB64(recBlob);
        const r = await fetch(API + '/api/voice-clone/enroll', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + session.token },
          body: JSON.stringify({ audio_base64, mime_type: 'audio/wav', prompt_phrase: QUESTIONS[qIndex % QUESTIONS.length] }),
        });
        const j = await r.json();
        if (j.ok) {
          qIndex++;
          resetReview();
          await loadStatus();              // refreshes answersCount from the server
          renderQuestion();
          const done = answersCount >= QUESTIONS.length;
          setMsg($('px-enroll-msg'), 'ok', done
            ? 'Your Persona is ready — answer more any time to make it even more you.'
            : 'Got it (' + answersCount + '/' + QUESTIONS.length + '). Here’s the next one.');
        } else {
          const code = j.error && j.error.code;
          const map = {
            clip_too_short: 'A bit short — say a full sentence or two.',
            no_speech: 'Didn’t catch any speech — try again, a little louder.',
          };
          setMsg($('px-enroll-msg'), 'err', map[code] || (j.error && j.error.message) || 'Could not save. Try again.');
        }
      } catch (e) {
        setMsg($('px-enroll-msg'), 'err', 'Network error — is the backend reachable? Try again.');
      } finally { btn.disabled = false; }
    }

    async function loadStatus() {
      let total = 0, ready = false;
      try {
        const r = await fetch(API + '/api/voice-clone/status', { headers: { Authorization: 'Bearer ' + session.token } });
        const j = await r.json();
        const counts = (j.data && j.data.clips) || {};
        total = Object.values(counts).reduce((a, b) => a + b, 0);
        if (!total && j.data && Array.isArray(j.data.clones)) total = j.data.clones.filter((c) => c.status === 'ready').length;
        ready = total > 0;
      } catch { /* keep current */ }
      answersCount = total;
      if (qIndex < answersCount) qIndex = answersCount;   // resume where they left off
      $('px-voice-tag').textContent = ready ? (total + ' answer' + (total > 1 ? 's' : '') + ' recorded') : 'not started';
      $('px-voice-tag').classList.toggle('is-ready', ready);
      $('px-enrolled').hidden = !ready;
      if (ready) $('px-enrolled-label').textContent = total + ' answer' + (total > 1 ? 's' : '') + ' saved — your Persona can speak in your voice.';
      renderQuestion();
      updateTrainUI(total);
    }

    async function onDelete() {
      if (!confirm('Delete your voice? This removes all your saved recordings permanently.')) return;
      const btn = $('px-delete'); btn.disabled = true;
      try {
        await fetch(API + '/api/voice-clone', { method: 'DELETE', headers: { Authorization: 'Bearer ' + session.token } });
        qIndex = 0;
        for (const k in refCache) delete refCache[k];
        await loadStatus();
        setMsg($('px-enroll-msg'), 'ok', 'Your voice was deleted.');
      } catch { setMsg($('px-enroll-msg'), 'err', 'Could not delete. Try again.'); }
      finally { btn.disabled = false; }
    }

    // ── train: per-user fine-tuned voice (Svara LoRA) ───────────────────────
    function b64ToBlob(b64, mime) {
      const bin = atob(b64); const u8 = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);
      return new Blob([u8], { type: mime || 'audio/wav' });
    }
    function setTrained(on, msg) {
      personaTrained = on;
      $('px-train-btn').hidden = on;
      if (msg) setMsg($('px-train-msg'), on ? 'ok' : '', msg);
    }
    async function refreshTrainStatus() {
      try {
        const r = await fetch(API + '/api/voice-clone/train-status', { headers: { Authorization: 'Bearer ' + session.token } });
        const d = ((await r.json()) || {}).data || {};
        if (d.ready) {
          setTrained(true, '✓ Your voice is trained — your Persona now speaks in your own voice.');
          if (trainPoll) { clearInterval(trainPoll); trainPoll = null; }
          return true;
        }
      } catch { /* keep polling */ }
      return false;
    }
    function startTrainPoll() {
      if (trainPoll) clearInterval(trainPoll);
      trainPoll = setInterval(refreshTrainStatus, 20000);
    }
    async function onTrain() {
      const btn = $('px-train-btn'); btn.disabled = true;
      setMsg($('px-train-msg'), 'busy', 'Starting…');
      try {
        const r = await fetch(API + '/api/voice-clone/finetune', { method: 'POST', headers: { Authorization: 'Bearer ' + session.token } });
        const j = await r.json();
        if (r.ok && j.data && j.data.queued) {
          setMsg($('px-train-msg'), 'busy', 'Training your voice on ' + (j.data.clips || '') + ' recordings… (~10–20 min). I’ll switch to it automatically when it’s ready.');
          startTrainPoll();
        } else {
          setMsg($('px-train-msg'), 'err', (j.error && j.error.message) || 'Could not start training.');
          btn.disabled = false;
        }
      } catch { setMsg($('px-train-msg'), 'err', 'Network error starting training. Try again.'); btn.disabled = false; }
    }
    async function updateTrainUI(total) {
      const enough = total >= 3;
      $('px-train').hidden = !enough;
      if (enough) await refreshTrainStatus();   // reflect "already trained" if so
    }

    // ── talk ──────────────────────────────────────────────────────────────
    function addBubble(kind, text) {
      const d = document.createElement('div');
      d.className = 'px-bubble px-bubble-' + kind;
      d.textContent = text;
      $('px-thread').appendChild(d);
      $('px-thread').scrollTop = $('px-thread').scrollHeight;
      return d;
    }

    // ── Streaming voice pipeline ────────────────────────────────────────────
    // As the LLM streams, we cut the reply into sentences, synthesize each the moment
    // it completes, and play them back-to-back. First audio lands after ~1 sentence,
    // not the whole answer. A turn id lets a new turn cancel the old pipeline (barge-in).
    let turnSeq = 0;
    let synthQ = [], synthRunning = false;
    let audioQ = [], audioPlaying = false;
    let speakingBubble = null, tapBtnShown = false, firstChunkEmitted = false;

    function extractSentences(buf) {
      const out = []; const re = /[^.!?।\n]*[.!?।\n]+/g; let m, last = 0;
      while ((m = re.exec(buf)) !== null) { out.push(m[0]); last = re.lastIndex; }
      return [out, buf.slice(last)];
    }
    function takeFirstChunk(buf) {
      const m = buf.match(/^[^.!?।\n]*[.!?।\n]+/);
      if (m) return [m[0], buf.slice(m[0].length)];
      const c = buf.search(/[,;—–]/);
      if (c >= 25) return [buf.slice(0, c + 1), buf.slice(c + 1)];
      if (buf.length >= 60) { let cut = buf.lastIndexOf(' ', 60); if (cut < 30) cut = 60; return [buf.slice(0, cut), buf.slice(cut)]; }
      return [null, buf];
    }

    function resetPipeline() {
      if (speakingBubble) speakingBubble.classList.remove('is-speaking');
      turnSeq++; synthQ = []; audioQ = []; synthRunning = false; audioPlaying = false; tapBtnShown = false; firstChunkEmitted = false;
      const a = $('px-talk-audio'); try { a.pause(); a.removeAttribute('src'); a.load(); } catch (e) {}
      return turnSeq;
    }

    function enqueueSentence(turn, s) {
      s = (s || '').trim(); if (!s) return;
      synthQ.push({ turn, s });
      if (!synthRunning) runSynthWorker();
    }

    async function runSynthWorker() {
      synthRunning = true;
      const warm = await ensureWarm();
      while (synthQ.length) {
        const job = synthQ.shift();
        if (!warm || job.turn !== turnSeq) continue;
        const blob = await synthSentence(job.s).catch(() => null);
        if (blob && job.turn === turnSeq) enqueueAudio(job.turn, blob);
      }
      synthRunning = false;
    }

    function enqueueAudio(turn, blob) {
      audioQ.push({ turn, blob });
      if (!audioPlaying) playNextAudio();
    }
    function playNextAudio() {
      const a = $('px-talk-audio');
      const job = audioQ.shift();
      if (!job) { audioPlaying = false; if (speakingBubble) speakingBubble.classList.remove('is-speaking'); return; }
      if (job.turn !== turnSeq) return playNextAudio();
      audioPlaying = true;
      const url = URL.createObjectURL(job.blob);
      a.src = url;
      a.onended = () => { URL.revokeObjectURL(url); playNextAudio(); };
      a.play().catch(() => { URL.revokeObjectURL(url); audioQ.unshift(job); audioPlaying = false; offerTapToHear(); });
    }
    function offerTapToHear() {
      if (tapBtnShown || !speakingBubble) return;
      tapBtnShown = true;
      const btn = document.createElement('button');
      btn.type = 'button'; btn.textContent = '🔊 Tap to hear';
      btn.style.cssText = 'display:block;margin-top:.45rem;font:inherit;font-size:.85em;cursor:pointer;border:1px solid currentColor;border-radius:999px;padding:.25rem .7rem;background:transparent;color:inherit;';
      btn.onclick = () => { tapBtnShown = false; btn.remove(); if (!audioPlaying) playNextAudio(); };
      speakingBubble.appendChild(btn);
    }

    async function sendTurn(text) {
      const myTurn = resetPipeline();
      addBubble('me', text);
      history.push({ role: 'user', content: text });
      const thinking = addBubble('ai', '…'); thinking.classList.add('is-thinking');
      speakingBubble = thinking;

      const warmStatus = document.createElement('div');
      warmStatus.style.cssText = 'font-size:.82em;opacity:.75;margin-top:.45rem;';
      thinking.appendChild(warmStatus);
      ensureWarm(warmStatus).then((okWarm) => { warmStatus.textContent = okWarm ? '' : '(voice unavailable right now — your reply is above)'; });
      getUserRef().catch(() => null);

      try {
        // Talk to the RICH brain as the user's own clone: JWT-authed proxy →
        // symp-v1-chat with mode:'clone' (first-person identity + their profile +
        // continuous learning). SSE format is identical, so the voice pipeline below
        // is unchanged.
        const cr = await fetch(API + '/api/blaksyd/symp/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + session.token },
          body: JSON.stringify({ messages: history.slice(-12), mode: 'clone', stream: true }),
        });
        if (!cr.ok || !cr.body) throw new Error('http_' + cr.status);
        const reader = cr.body.getReader();
        const decoder = new TextDecoder();
        let reply = '', buf = '', sentBuf = '';
        thinking.classList.remove('is-thinking'); thinking.textContent = '';
        thinking.classList.add('is-speaking');
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          buf += decoder.decode(value, { stream: true });
          const lines = buf.split('\n');
          buf = lines.pop() || '';
          for (const line of lines) {
            const t = line.trim();
            if (!t.startsWith('data:')) continue;
            const p = t.slice(5).trim();
            if (!p || p === '[DONE]') continue;
            let obj; try { obj = JSON.parse(p); } catch { continue; }
            if (obj.delta) {
              reply += obj.delta; sentBuf += obj.delta;
              thinking.textContent = reply; $('px-thread').scrollTop = $('px-thread').scrollHeight;
              if (!firstChunkEmitted) {
                const [fc, rest0] = takeFirstChunk(sentBuf);
                if (fc) { sentBuf = rest0; firstChunkEmitted = true; enqueueSentence(myTurn, fc); }
              }
              if (firstChunkEmitted) {
                const [sents, rest] = extractSentences(sentBuf); sentBuf = rest;
                for (const s of sents) enqueueSentence(myTurn, s);
              }
            }
            if (obj.error) throw new Error(String(obj.error));
          }
        }
        if (sentBuf.trim()) enqueueSentence(myTurn, sentBuf);
        reply = (reply.trim()) || 'Sorry, I could not reply just now.';
        thinking.textContent = reply;
        history.push({ role: 'assistant', content: reply });
      } catch (e) {
        if (myTurn === turnSeq) { thinking.classList.remove('is-thinking', 'is-speaking'); thinking.textContent = 'Network error — is the backend reachable?'; }
      }
    }

    // ── Voice: the self-hosted OmniVoice engine (Modal GPU), called directly from the
    // browser. OmniVoice is multilingual and speaks whatever language the text is in —
    // no language param needed; it clones from the user's saved reference. ──
    const SVARA_URL = 'https://ceo-91462--voice-infer-fastapi-app.modal.run';
    let svaraWarm = false;
    let audioUnlocked = false;
    function unlockAudio() {
      if (audioUnlocked) return;
      try {
        const a = $('px-talk-audio');
        a.src = URL.createObjectURL(encodeWav(new Float32Array(2400), 24000));
        const p = a.play();
        if (p && p.then) p.then(() => { a.pause(); a.currentTime = 0; audioUnlocked = true; }).catch(() => {});
        else audioUnlocked = true;
      } catch (e) {}
    }
    function svaraWarmPing() {
      try { fetch(SVARA_URL + '/health', { mode: 'no-cors', cache: 'no-store' }); } catch (e) {}
    }
    async function svaraReady() {
      try { const r = await fetch(SVARA_URL + '/health', { cache: 'no-store' }); return r.ok; }
      catch (e) { return false; }
    }
    async function ensureWarm(status) {
      if (svaraWarm) return true;
      svaraWarmPing();
      for (let i = 0; i < 75; i++) {
        if (await svaraReady()) { svaraWarm = true; return true; }
        if (status) status.textContent = '🔊 warming up your voice (first time, ~30s)…';
        await new Promise((r) => setTimeout(r, 4000));
      }
      return false;
    }
    // Fetch the user's best saved reference clip (base64) so the engine speaks in THEIR
    // voice. No language needed — the engine clones cross-lingually and speaks the text.
    const refCache = {};
    async function getUserRef() {
      if (refCache.best !== undefined) return refCache.best;
      let ref = null;
      try {
        if (session && session.token) {
          const r = await fetch(API + '/api/voice-clone/ref', { headers: { Authorization: 'Bearer ' + session.token } });
          if (r.ok) {
            const d = (await r.json()).data || {};
            if (d.audio_base64) ref = { b64: d.audio_base64, transcript: d.transcript || '' };
          }
        }
      } catch (e) { ref = null; }
      refCache.best = ref;
      return ref;
    }
    // Synthesize ONE sentence in the user's cloned voice → audio Blob (or null).
    async function synthSentence(text) {
      // Fine-tuned voice: route through the backend (JWT-gated → the user's Svara
      // adapter). Falls through to the zero-shot path if it's not trained/available.
      if (personaTrained) {
        try {
          const r = await fetch(API + '/api/voice-clone/speak', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + session.token },
            body: JSON.stringify({ text }),
          });
          if (r.ok) {
            const d = ((await r.json()) || {}).data || {};
            if (d.audio_base64 && d.voice === 'clone:trained') return b64ToBlob(d.audio_base64, d.mime_type || 'audio/wav');
          }
        } catch { /* fall through */ }
      }
      const ref = await getUserRef().catch(() => null);
      const body = { text, mode: (ref && ref.b64) ? 'clone' : 'preset', format: 'mp3' };
      if (ref && ref.b64) { body.reference_base64 = ref.b64; body.reference_transcript = ref.transcript; }
      const synth = (b) => fetch(SVARA_URL + '/synthesize', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b) });
      let res = await synth(body).catch(() => null);
      if ((!res || !res.ok) && body.mode === 'clone') res = await synth({ text, mode: 'preset', format: 'mp3' }).catch(() => null);
      if (!res || !res.ok) return null;
      return await res.blob();
    }

    // Hands-free voice input — browser STT in the user's own locale (no language picker).
    let recog = null, listening = false;
    function setupVoiceIn() {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) { $('px-voicein').style.display = 'none'; return; }
      $('px-voicein').onclick = () => {
        if (listening) { recog && recog.stop(); return; }
        recog = new SR();
        recog.lang = navigator.language || 'en-US';
        recog.interimResults = false; recog.maxAlternatives = 1;
        recog.onresult = (e) => { const t = e.results[0][0].transcript; if (t) { unlockAudio(); sendTurn(t.trim()); } };
        recog.onend = () => { listening = false; $('px-voicein').classList.remove('is-rec'); };
        recog.onerror = () => { listening = false; $('px-voicein').classList.remove('is-rec'); };
        listening = true; $('px-voicein').classList.add('is-rec'); recog.start();
      };
    }

    // ── Your Mind: a self-interview that feeds the SAME profile the clone reads.
    // Each answer is pushed through the shared learning loop (call-learn →
    // extractKnowledge + updateRollingMemory), so the clone's mind grows fast. ──
    const MIND_QUESTIONS = [
      "What's a strong opinion you hold that not everyone agrees with?",
      "Tell me about someone who matters a lot to you — and why.",
      "What's a story about yourself you always end up telling people?",
      "How would your closest friends describe you?",
      "What do you care about more than most people do?",
      "What always makes you laugh?",
      "What were you like growing up?",
      "What's a goal or dream you're chasing right now?",
      "What's a hot take you'd happily defend?",
      "Walk me through what a normal day looks like for you.",
      "What's something you've completely changed your mind about?",
      "What do you do when you're stressed or low?",
      "What's a small thing that genuinely makes you happy?",
      "Who do you look up to, and why?",
    ];
    let mindIndex = 0, mindSaved = 0;
    function renderMindQuestion() { $('px-mind-q').textContent = MIND_QUESTIONS[mindIndex % MIND_QUESTIONS.length]; }
    function nextMind() { mindIndex = (mindIndex + 1) % MIND_QUESTIONS.length; renderMindQuestion(); }

    async function onMindSave() {
      const q = MIND_QUESTIONS[mindIndex % MIND_QUESTIONS.length];
      const a = $('px-mind-answer').value.trim();
      if (a.length < 2) { setMsg($('px-mind-msg'), 'err', 'Say a little more — a sentence or two.'); return; }
      if (!session || !session.token) { setMsg($('px-mind-msg'), 'err', 'Sign in first.'); return; }
      const btn = $('px-mind-save'); btn.disabled = true;
      setMsg($('px-mind-msg'), 'busy', 'Saving to your mind…');
      try {
        const r = await fetch(API + '/api/blaksyd/symp/call-learn', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + session.token },
          body: JSON.stringify({ userText: q + '\n\nMy answer: ' + a, assistantText: '' }),
        });
        if (!r.ok) throw new Error('http_' + r.status);
        mindSaved++;
        $('px-mind-answer').value = '';
        $('px-mind-tag').textContent = mindSaved + ' shared — your clone is learning you';
        setMsg($('px-mind-msg'), 'ok', 'Got it. Your Persona just learned a little more about you.');
        nextMind();
      } catch (e) {
        setMsg($('px-mind-msg'), 'err', 'Could not save just now. Try again.');
      } finally { btn.disabled = false; }
    }

    // Dictate the answer with the browser's speech recognition (its own recognizer,
    // independent of the talk mic).
    let mindRecog = null, mindListening = false;
    function setupMindMic() {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) { $('px-mind-mic').style.display = 'none'; return; }
      $('px-mind-mic').onclick = () => {
        if (mindListening) { mindRecog && mindRecog.stop(); return; }
        mindRecog = new SR();
        mindRecog.lang = navigator.language || 'en-US';
        mindRecog.interimResults = false; mindRecog.maxAlternatives = 1;
        mindRecog.onresult = (e) => { const t = e.results[0][0].transcript; if (t) { const ta = $('px-mind-answer'); ta.value = (ta.value ? ta.value + ' ' : '') + t.trim(); } };
        mindRecog.onend = () => { mindListening = false; $('px-mind-mic').classList.remove('is-rec'); };
        mindRecog.onerror = () => { mindListening = false; $('px-mind-mic').classList.remove('is-rec'); };
        mindListening = true; $('px-mind-mic').classList.add('is-rec'); mindRecog.start();
      };
    }

    // ── boot ──────────────────────────────────────────────────────────────
    (async () => {
      svaraWarmPing();   // start warming the voice GPU now — overlaps with the interview
      session = await getSession();
      for (let i = 0; !session && i < 20; i++) { await new Promise((r) => setTimeout(r, 150)); session = await getSession(); }
      $('px-app').hidden = false;
      renderQuestion();
      setupVoiceIn();
      $('px-rec-btn').onclick = onRecClick;
      $('px-save').onclick = onSave;
      $('px-redo').onclick = resetReview;
      $('px-delete').onclick = onDelete;
      $('px-train-btn').onclick = onTrain;
      renderMindQuestion();
      setupMindMic();
      $('px-mind-save').onclick = onMindSave;
      $('px-mind-skip').onclick = nextMind;
      $('px-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const v = $('px-input').value.trim(); if (!v) return;
        unlockAudio();
        $('px-input').value = ''; sendTurn(v);
      });
      await loadStatus();
      if (supabase) {
        supabase.auth.onAuthStateChange((_event, s) => {
          if (s) { session = { token: s.access_token, userId: s.user.id, email: s.user.email }; loadStatus(); }
        });
      }
    })();
  </script>
</AppLayout>
