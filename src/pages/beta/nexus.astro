---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout active="nexus" title="Nexus">
  <!-- ════════ HOME ════════ -->
  <div class="ap-page nx-view" id="nx-home">
    <p class="ap-kicker">Nexus</p>
    <h1 class="ap-h1" id="nx-greet">Welcome back.</h1>

    <!-- ── LIVE ROOMS (the star) ── -->
    <div class="nx-sec-head">
      <h2 class="nx-sec-title"><span class="nx-livedot"></span>Live Rooms <span class="nx-sec-sub" id="nx-rooms-sub">real-time</span></h2>
      <button type="button" class="nx-start" id="nx-start">+ Start a room</button>
    </div>

    <div class="nx-rooms" id="nx-rooms">
      <div class="nx-start-card" style="cursor:default;opacity:.6">Loading rooms…</div>
    </div>


    <!-- ── TRIBES ── -->
    <div class="nx-sec-head" style="margin-top:2.2rem">
      <h2 class="nx-sec-title">Tribes</h2>
      <button type="button" class="nx-start ghost" id="nx-newtribe">+ Create a tribe</button>
    </div>
    <div class="nx-tribes-grid" id="nx-tribes-grid">
      <div class="nx-tribe-card" style="cursor:default;opacity:.6"><span class="nx-tc-mark" style="background:var(--surface-strong)"></span><span class="nx-tc-who"><b>Loading tribes…</b></span></div>
    </div>
  </div>

  <!-- ════════ IN-ROOM ════════ -->
  <div class="nx-view nx-room" id="nx-room" hidden>
    <header class="nx-room-top">
      <button type="button" class="nx-back" data-home>← Leave</button>
      <div class="nx-room-id"><span class="nx-livedot"></span><b id="nx-room-title">—</b><i id="nx-room-here">— here</i></div>
      <div class="nx-room-pulse" id="nx-room-pulse" title="Room pulse"><span class="nx-flame"></span><b id="nx-pulse-n">0</b></div>
    </header>

    <div class="nx-room-body">
      <div class="nx-room-main">
        <div class="nx-room-feed" id="nx-room-feed" aria-live="polite"></div>
        <form class="nx-room-composer" id="nx-room-form">
          <input type="text" id="nx-room-input" placeholder="Say something to the room…" autocomplete="off" />
          <button type="submit" aria-label="Send"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
      </div>

      <aside class="nx-room-side">
        <div class="nx-pulse-card ap-card">
          <p class="nx-pulse-k">Room pulse</p>
          <div class="nx-pulse-orb" id="nx-pulse-orb"><span class="nx-pulse-num" id="nx-pulse-big">0</span></div>
          <div class="nx-pulse-stats">
            <div><b id="nx-stat-day">day 1</b><span>alive</span></div>
            <div><b id="nx-stat-time">0m</b><span>this session</span></div>
            <div><b id="nx-stat-here">1</b><span>here now</span></div>
          </div>
          <div class="nx-heat"><span id="nx-heat-fill"></span></div>
          <p class="nx-pulse-note">Glows while you're here.</p>
        </div>

        <div class="nx-here-card ap-card">
          <p class="nx-pulse-k">Here now</p>
          <div class="nx-here-faces" id="nx-here-faces"></div>
        </div>
      </aside>
    </div>
  </div>

  <!-- ════════ TRIBE ════════ -->
  <div class="ap-page nx-view nx-tribe" id="nx-tribe" hidden>
    <button type="button" class="nx-back" data-home>← All of Nexus</button>
    <div class="nx-tribe-head">
      <span class="nx-tribe-mark" id="nx-tribe-mark"></span>
      <div>
        <h1 class="ap-h1" id="nx-tribe-name">—</h1>
        <p class="nx-tribe-meta" id="nx-tribe-meta">—</p>
      </div>
      <button type="button" class="nx-joined" id="nx-tribe-join">Join</button>
    </div>
    <p class="nx-tribe-desc" id="nx-tribe-desc"></p>

    <div class="nx-tribe-live ap-card" id="nx-tribe-live"></div>

    <form class="nx-room-composer nx-disc-composer" id="nx-disc-form">
      <input type="text" id="nx-disc-input" placeholder="Start a discussion…" autocomplete="off" />
      <button type="submit">Post</button>
    </form>
    <div class="nx-discussions" id="nx-discussions"></div>
  </div>

  <!-- ════════ CREATE-ROOM MODAL ════════ -->
  <div class="nx-modal" id="nx-modal" hidden>
    <div class="nx-modal-card ap-card">
      <p class="nx-pulse-k">Start a Live Room</p>
      <h3 class="nx-modal-title">What are you gathering around?</h3>
      <form id="nx-create-form">
        <input id="nx-create-title" maxlength="80" placeholder="e.g. Late-night writing sprint" autocomplete="off" required />
        <input id="nx-create-topic" maxlength="140" placeholder="one line on the vibe (optional)" autocomplete="off" />
        <div class="nx-modal-actions">
          <button type="button" class="nx-modal-cancel" id="nx-create-cancel">Cancel</button>
          <button type="submit" class="nx-modal-go">Open the room</button>
        </div>
        <p class="nx-modal-note">Lights up as people gather. No timers, no pressure.</p>
      </form>
    </div>
  </div>

  <style is:global>
    /* global (not scoped): room/tribe cards are built in JS at runtime and would
       miss Astro's scope attribute. Everything is .nx-* namespaced. */
    .nx-view[hidden] { display: none !important; }
    .nx-view { animation: nx-fade .3s var(--ease-out) both; }
    @keyframes nx-fade { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }
    .nx-accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; background: linear-gradient(110deg, var(--mint), var(--aqua)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .nx-livedot { width: 9px; height: 9px; border-radius: 50%; background: #ff5a6e; box-shadow: 0 0 0 0 rgba(255,90,110,.6); animation: nx-beat 1.8s infinite; display: inline-block; }
    @keyframes nx-beat { 0%{box-shadow:0 0 0 0 rgba(255,90,110,.55)} 70%{box-shadow:0 0 0 8px rgba(255,90,110,0)} 100%{box-shadow:0 0 0 0 rgba(255,90,110,0)} }

    .nx-sec-head { display: flex; align-items: center; gap: 1rem; margin: clamp(1.4rem,4vh,2.2rem) 0 1rem; }
    .nx-sec-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); display: inline-flex; align-items: center; gap: .55rem; margin: 0; }
    .nx-sec-sub { font-family: var(--font-mono); font-size: var(--fs-2xs); text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint); font-weight: 400; }
    .nx-start { margin-left: auto; font: inherit; font-size: var(--fs-sm); font-weight: 600; color: #06231C; background: linear-gradient(135deg, var(--mint), var(--aqua)); border: 0; border-radius: var(--r-pill); padding: .55rem 1rem; cursor: pointer; transition: transform .2s var(--ease-spring); }
    .nx-start:hover { transform: translateY(-1px); }
    .nx-start.ghost { color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); }

    /* live room cards */
    .nx-rooms { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 1rem; }
    .nx-room-card { position: relative; overflow: hidden; padding: 1.1rem 1.2rem 1.2rem; border-radius: var(--r-lg); border: 1px solid var(--line-strong); background: var(--glass-strong); cursor: pointer; transition: transform .25s var(--ease-spring), border-color .2s; }
    .nx-room-card::before { content:''; position:absolute; inset:0; background: radial-gradient(80% 60% at 80% -10%, var(--heat, rgba(255,150,90,.16)), transparent 70%); pointer-events:none; }
    .nx-room-card:hover { transform: translateY(-3px); border-color: rgba(91,192,255,.4); }
    .nx-room-card.resting::before { opacity: .35; }
    .nx-rc-top { display: flex; align-items: center; gap: .5rem; position: relative; }
    .nx-rc-live { font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .12em; text-transform: uppercase; color: #ff8a96; }
    .nx-rc-rest { font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); }
    .nx-rc-pulse { margin-left: auto; display: inline-flex; align-items: center; gap: .3rem; font-size: var(--fs-sm); font-weight: 700; color: #ffc46b; }
    .nx-flame { width: 13px; height: 13px; flex: none; border-radius: 50% 50% 50% 0; transform: rotate(45deg); background: radial-gradient(circle at 60% 60%, #ffd27a, #ff7a4d); box-shadow: 0 0 10px rgba(255,150,90,.7); }
    .nx-flame.dim { background: radial-gradient(circle at 60% 60%, #cbc4bb, #8b8178); box-shadow: none; opacity: .65; }
    .nx-rc-title { font-size: var(--fs-xl); font-weight: 650; margin: .7rem 0 .1rem; position: relative; }
    .nx-rc-host { font-size: var(--fs-sm); color: var(--ink-faint); position: relative; }
    .nx-rc-bottom { display: flex; align-items: center; gap: .6rem; margin-top: .9rem; position: relative; }
    .nx-faces { display: inline-flex; } .nx-faces span { width: 26px; height: 26px; border-radius: 50%; margin-left: -8px; border: 2px solid var(--bg); display: inline-block; }
    .nx-faces span:first-child { margin-left: 0; }
    .nx-here-n { font-size: var(--fs-sm); color: var(--ink-soft); }
    .nx-join-btn { margin-left: auto; font: inherit; font-size: var(--fs-sm); font-weight: 600; color: var(--aqua-ink); background: rgba(91,192,255,.14); border: 1px solid rgba(91,192,255,.3); border-radius: var(--r-pill); padding: .4rem .9rem; cursor: pointer; }
    html[data-theme="dark"] .nx-join-btn { color: #BFE9FF; }
    .nx-start-card { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .4rem; min-height: 150px; border: 1.5px dashed var(--line-strong); border-radius: var(--r-lg); color: var(--ink-faint); cursor: pointer; transition: .2s; }
    .nx-start-card:hover { border-color: var(--aqua); color: var(--aqua); }
    .nx-start-card b { font-size: 1.5rem; }
    .nx-pulse-explain { margin: 1rem 0 0; font-size: var(--fs-sm); color: var(--ink-faint); max-width: 60ch; } .nx-pulse-explain b { color: #ffc46b; }
    .nx-empty { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: .45rem; padding: 2.4rem 1.5rem; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--glass-strong); }
    .nx-empty b { font-size: var(--fs-xl); font-weight: 650; color: var(--ink); }
    .nx-empty span { font-size: var(--fs-sm); color: var(--ink-faint); max-width: 44ch; }
    .nx-empty-orb { width: 54px; height: 54px; border-radius: 50%; margin-bottom: .4rem; background: radial-gradient(circle at 50% 45%, rgba(255,180,100,.28), rgba(255,120,80,.1) 60%, transparent 72%); box-shadow: 0 0 30px rgba(255,150,90,.22); animation: nx-glow 3.6s var(--ease-soft) infinite; }

    /* tribes */
    .nx-tribes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: .8rem; }
    .nx-tribe-card { display: flex; align-items: center; gap: .7rem; padding: .9rem 1rem; border-radius: var(--r-md); border: 1px solid var(--line-strong); background: var(--glass-strong); cursor: pointer; transition: transform .2s var(--ease-spring), border-color .2s; }
    .nx-tribe-card:hover { transform: translateY(-2px); border-color: rgba(91,192,255,.4); }
    .nx-tc-mark { width: 38px; height: 38px; border-radius: 12px; flex: none; }
    .nx-tc-who b { font-size: var(--fs-md); display: block; } .nx-tc-who span { font-size: var(--fs-sm); color: var(--ink-faint); }
    .nx-tc-new { margin-left: auto; font-size: var(--fs-3xs); font-family: var(--font-mono); color: var(--aqua); background: rgba(91,192,255,.14); border-radius: 999px; padding: .15rem .45rem; }

    /* in-room */
    .nx-room { display: flex; flex-direction: column; height: 100vh; height: 100svh; }
    .nx-room-top { display: flex; align-items: center; gap: .8rem; padding: 1rem clamp(1rem,3vw,1.6rem); border-bottom: 1px solid var(--line); }
    .nx-back { font: inherit; font-size: var(--fs-md); color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .4rem .8rem; cursor: pointer; }
    .nx-back:hover { color: var(--ink); }
    .nx-room-id { display: flex; align-items: center; gap: .5rem; } .nx-room-id b { font-size: var(--fs-lg); } .nx-room-id i { font-style: normal; font-size: var(--fs-sm); color: var(--ink-faint); }
    .nx-room-pulse { margin-left: auto; display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; color: #ffc46b; font-size: var(--fs-lg); }
    .nx-room-body { flex: 1; display: grid; grid-template-columns: 1fr 300px; gap: 1rem; min-height: 0; padding: 1rem clamp(1rem,3vw,1.6rem); }
    .nx-room-main { display: flex; flex-direction: column; min-height: 0; }
    .nx-room-feed { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: .7rem; padding: .4rem; }
    .nx-rmsg { display: flex; gap: .6rem; align-items: flex-start; animation: nx-fade .3s ease both; max-width: 90%; }
    .nx-rmsg .nx-rav { width: 28px; height: 28px; border-radius: 50%; flex: none; margin-top: .15rem; }
    .nx-rmsg .nx-rh { font-family: var(--font-mono); font-size: var(--fs-3xs); color: var(--aqua); } .nx-rmsg p { margin: .1rem 0 0; font-size: var(--fs-md); color: var(--ink); line-height: 1.45; }
    .nx-rmsg.me { margin-left: auto; flex-direction: row-reverse; } .nx-rmsg.me p { color: var(--ink-soft); }
    .nx-room-composer { display: flex; gap: .5rem; padding-top: .6rem; }
    .nx-room-composer input { flex: 1; min-width: 0; padding: .8rem 1.05rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-md); }
    .nx-room-composer input:focus { outline: none; border-color: var(--aqua); }
    .nx-room-composer button { flex: none; padding: 0 1.1rem; min-width: 46px; border-radius: var(--r-pill); border: 0; cursor: pointer; color: #06231C; font: inherit; font-weight: 650; background: linear-gradient(135deg, var(--mint), var(--aqua)); } .nx-room-composer button svg { width: 18px; height: 18px; }

    .nx-room-side { display: flex; flex-direction: column; gap: 1rem; overflow-y: auto; }
    .nx-pulse-card { padding: 1.2rem; text-align: center; }
    .nx-pulse-k { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 .8rem; }
    .nx-pulse-orb { position: relative; width: 130px; height: 130px; margin: 0 auto; border-radius: 50%; display: grid; place-items: center;
      background: radial-gradient(circle at 50% 45%, rgba(255,180,100,.28), rgba(255,120,80,.12) 60%, transparent 72%);
      box-shadow: 0 0 50px rgba(255,150,90,.35); animation: nx-glow 3.2s var(--ease-soft) infinite; transition: filter .6s, box-shadow .6s; }
    .nx-pulse-orb.resting { animation: none; box-shadow: 0 0 18px rgba(255,150,90,.10); filter: saturate(.55) brightness(.82); }
    @keyframes nx-glow { 0%,100%{transform:scale(1);box-shadow:0 0 44px rgba(255,150,90,.3)} 50%{transform:scale(1.05);box-shadow:0 0 64px rgba(255,150,90,.5)} }
    .nx-pulse-num { font-family: var(--font-display); font-weight: 700; font-size: 2.6rem; color: #ffd9a8; text-shadow: 0 0 24px rgba(255,170,100,.6); }
    .nx-pulse-stats { display: flex; justify-content: space-around; margin-top: 1rem; }
    .nx-pulse-stats b { display: block; font-size: var(--fs-lg); color: var(--ink); } .nx-pulse-stats span { font-size: var(--fs-2xs); color: var(--ink-faint); }
    .nx-heat { height: 6px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; margin-top: 1rem; } .nx-heat span { display: block; height: 100%; width: 8%; border-radius: 999px; background: linear-gradient(90deg, #ff7a4d, #ffd27a); transition: width 1.2s var(--ease-out); }
    .nx-pulse-note { margin: .9rem 0 0; font-size: var(--fs-xs); color: var(--ink-faint); }
    .nx-here-card { padding: 1rem 1.2rem; } .nx-here-faces { display: flex; flex-wrap: wrap; gap: .4rem; } .nx-here-faces span { width: 30px; height: 30px; border-radius: 50%; }

    /* ── mobile in-room: feed fills the screen; Pulse is a slim vibe bar ── */
    @media (max-width: 900px) {
      .nx-room { height: calc(100svh - 124px); }
      #nx-room-here, .nx-room-pulse { display: none; }   /* carried by the vibe bar */
      .nx-room-body { display: flex; flex-direction: column; gap: .7rem; padding-top: .7rem; }
      .nx-room-main { flex: 1; min-height: 0; order: 1; }
      .nx-room-side { order: 0; flex-direction: row; align-items: center; overflow: visible; }
      .nx-pulse-card { flex: 1; display: flex; align-items: center; gap: .6rem; padding: .5rem .85rem; text-align: left; }
      .nx-pulse-k, .nx-pulse-note, .nx-heat, .nx-here-card { display: none; }
      .nx-pulse-orb { width: 34px; height: 34px; margin: 0; box-shadow: 0 0 14px rgba(255,150,90,.45); animation: none; }
      .nx-pulse-num { font-size: .85rem; text-shadow: none; }
      .nx-pulse-stats { margin: 0 0 0 auto; gap: 1.1rem; }
      .nx-pulse-stats b { font-size: var(--fs-md); }
      .nx-pulse-stats span { font-size: 9px; }
    }

    /* tribe view */
    .nx-tribe-head { display: flex; align-items: center; gap: 1rem; margin: 1rem 0 .6rem; }
    .nx-tribe-mark { width: 56px; height: 56px; border-radius: 16px; flex: none; }
    .nx-tribe-meta { color: var(--ink-faint); font-size: var(--fs-md); margin: .2rem 0 0; }
    .nx-joined { margin-left: auto; font: inherit; font-size: var(--fs-sm); font-weight: 600; color: var(--mint); background: rgba(106,211,184,.14); border: 1px solid rgba(106,211,184,.3); border-radius: var(--r-pill); padding: .45rem 1rem; cursor: pointer; }
    .nx-tribe-desc { color: var(--ink-soft); max-width: 60ch; margin: 0 0 1.2rem; }
    .nx-tribe-live { padding: 1rem 1.2rem; margin-bottom: 1.2rem; }
    .nx-disc-composer { margin-bottom: 1.2rem; }
    .nx-disc { padding: 1rem 1.1rem; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--glass-strong); margin-bottom: .7rem; animation: nx-fade .3s ease both; }
    .nx-disc-top { display: flex; align-items: center; gap: .5rem; font-size: var(--fs-sm); color: var(--ink-faint); margin-bottom: .4rem; } .nx-disc-av { width: 22px; height: 22px; border-radius: 50%; }
    .nx-disc-text { font-size: var(--fs-lg); color: var(--ink); line-height: 1.5; }
    .nx-disc-foot { display: flex; gap: 1rem; margin-top: .7rem; font-size: var(--fs-sm); color: var(--ink-faint); } .nx-reso { color: var(--aqua); cursor: pointer; } .nx-reso.on { color: #ffd9a8; }

    /* create-room modal */
    .nx-modal { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; padding: 1.2rem; background: rgba(6,7,18,.62); backdrop-filter: blur(6px); animation: nx-fade .2s ease both; }
    .nx-modal[hidden] { display: none !important; }
    .nx-modal-card { width: min(460px, 100%); padding: 1.4rem; }
    .nx-modal-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); margin: .2rem 0 1rem; }
    #nx-create-form { display: flex; flex-direction: column; gap: .6rem; }
    #nx-create-form input { padding: .8rem 1rem; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-md); }
    #nx-create-form input:focus { outline: none; border-color: var(--aqua); }
    .nx-modal-actions { display: flex; gap: .6rem; justify-content: flex-end; margin-top: .4rem; }
    .nx-modal-cancel { font: inherit; color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .55rem 1rem; cursor: pointer; }
    .nx-modal-go { font: inherit; font-weight: 650; color: #06231C; background: linear-gradient(135deg, var(--mint), var(--aqua)); border: 0; border-radius: var(--r-pill); padding: .55rem 1.1rem; cursor: pointer; }
    .nx-modal-note { font-size: var(--fs-xs); color: var(--ink-faint); margin: .6rem 0 0; line-height: 1.5; }

    /* toast */
    .nx-toast { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%) translateY(20px); z-index: 70; background: var(--surface-strong); color: var(--ink); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .6rem 1.1rem; font-size: var(--fs-sm); box-shadow: var(--shadow-soft); opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s; }
    .nx-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* ── LIGHT theme: deepen warm/vivid accent TEXT so it reads on cream ── */
    html[data-theme="light"] .nx-accent { background: linear-gradient(110deg, var(--mint-ink), var(--aqua-ink)); -webkit-background-clip: text; background-clip: text; }
    html[data-theme="light"] .nx-rc-live { color: var(--coral-ink); }
    html[data-theme="light"] .nx-rc-pulse,
    html[data-theme="light"] .nx-room-pulse,
    html[data-theme="light"] .nx-pulse-explain b { color: var(--gold-ink); }
    html[data-theme="light"] .nx-rmsg .nx-rh,
    html[data-theme="light"] .nx-reso,
    html[data-theme="light"] .nx-tc-new,
    html[data-theme="light"] .nx-start-card:hover { color: var(--aqua-ink); }
    html[data-theme="light"] .nx-pulse-num,
    html[data-theme="light"] .nx-reso.on { color: #C2410C; text-shadow: none; }
    html[data-theme="light"] .nx-pulse-orb { background: radial-gradient(circle at 50% 45%, rgba(255,150,90,.34), rgba(255,120,80,.14) 60%, transparent 72%); box-shadow: 0 0 40px rgba(255,150,90,.26); }
  </style>

  <script>
    // ── Nexus, wired ──────────────────────────────────────────────────────────
    // Live Rooms (the star) are genuinely real-time: Supabase Realtime carries
    // PRESENCE (who's here) + BROADCAST (live chat); the nexus_rooms table is the
    // persistent registry + Pulse history. Tribes read the real nexus_communities
    // / nexus_posts. Works for anonymous beta visitors (anon key, RLS-safe) and
    // uses your real identity if signed in.
    import { supabase, supabaseConfigured } from '../../lib/supabaseClient';

    const grad = [
      'linear-gradient(135deg,#5BC0FF,#1872B0)','linear-gradient(135deg,#6AD3B8,#1E7D62)',
      'linear-gradient(135deg,#C9B8FF,#7459CE)','linear-gradient(135deg,#FFD27A,#FF9B6C)',
      'linear-gradient(135deg,#FF6B9D,#7459CE)'
    ];
    const g = (i) => grad[((i % grad.length) + grad.length) % grad.length];
    const hashIdx = (s) => { let h = 0; s = s || ''; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return h; };
    const faces = (n, seed = 0) => { let s = ''; for (let i = 0; i < n; i++) s += '<span style="background:' + g(seed + i) + '"></span>'; return s; };
    const el = (id) => document.getElementById(id);
    const esc = (t) => { const d = document.createElement('div'); d.textContent = (t == null ? '' : String(t)); return d.innerHTML; };
    const rel = (ts) => { if (!ts) return 'now'; let s = Math.max(1, Math.floor((Date.now() - new Date(ts).getTime()) / 1000)); if (s < 60) return s + 's'; let m = Math.floor(s / 60); if (m < 60) return m + 'm'; let h = Math.floor(m / 60); if (h < 24) return h + 'h'; return Math.floor(h / 24) + 'd'; };
    const dayOf = (ts) => Math.max(1, Math.round((Date.now() - new Date(ts).getTime()) / 86400000));

    let toastT;
    function toast(msg) {
      let t = el('nx-toast');
      if (!t) { t = document.createElement('div'); t.id = 'nx-toast'; t.className = 'nx-toast'; document.body.appendChild(t); }
      t.textContent = msg; t.classList.add('show');
      clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('show'), 2600);
    }

    // ── identity: anonymous-by-default friendly handle, real email if signed in ──
    const ADJ = ['quiet','warm','steady','night','soft','open','kind','calm','bright','still','easy','true'];
    const NOUN = ['harbor','signal','ember','meadow','tide','comet','willow','lantern','river','pine','spark','haven'];
    const ME = (() => {
      let id, handle, color;
      try { id = localStorage.getItem('nx_id'); handle = localStorage.getItem('nx_handle'); color = localStorage.getItem('nx_color'); } catch (e) {}
      if (!id) id = 'g' + hashIdx(String(Math.random()) + performance.now()).toString(36);
      if (!handle) handle = ADJ[hashIdx(id) % ADJ.length] + '-' + NOUN[hashIdx(id + 'n') % NOUN.length];
      if (color == null) color = String(hashIdx(id) % grad.length);
      try { localStorage.setItem('nx_id', id); localStorage.setItem('nx_handle', handle); localStorage.setItem('nx_color', color); } catch (e) {}
      return { id, handle, color: +color };
    })();
    let SESSION = null;

    const views = { home: el('nx-home'), room: el('nx-room'), tribe: el('nx-tribe') };
    function show(v) { for (const k in views) views[k].hidden = (k !== v); window.scrollTo(0, 0); }

    const roomsEl = el('nx-rooms');
    const tribesEl = el('nx-tribes-grid');

    // graceful degrade if env vars missing
    if (!supabaseConfigured || !supabase) {
      roomsEl.innerHTML = '<div class="nx-start-card" style="cursor:default">Live data needs the Supabase env vars (PUBLIC_SUPABASE_URL / _ANON_KEY).</div>';
    } else {
      boot();
    }

    function boot() {
      let ROOMS = [];
      let TRIBES = [];

      // ── lobby: rooms — a room exists ONLY while real people are in it ──────
      // No seeded/mock rooms, ever. The lobby shows only rooms with someone here
      // right now (fresh heartbeat); when the last person leaves, the room is gone.
      const FRESH_MS = 90000;
      const isActive = (r) => r.here_now > 0 && !r.archived_at && (Date.now() - new Date(r.last_active_at).getTime() < FRESH_MS);
      function roomCard(r) {
        const heat = Math.min(0.12 + r.here_now / 22, 0.5);
        return '<div class="nx-room-card" data-room="' + esc(r.id) + '" style="--heat:rgba(255,150,90,' + heat + ')">'
          + '<div class="nx-rc-top"><span class="nx-livedot"></span><span class="nx-rc-live">live</span>'
          + '<span class="nx-rc-pulse"><span class="nx-flame"></span>' + r.pulse + '</span></div>'
          + '<div class="nx-rc-title">' + esc(r.title) + '</div>'
          + '<div class="nx-rc-host">' + (r.topic ? esc(r.topic) : 'hosted by @' + esc(r.host_handle)) + '</div>'
          + '<div class="nx-rc-bottom"><span class="nx-faces">' + faces(Math.min(r.here_now, 5), hashIdx(r.id)) + '</span>'
          + '<span class="nx-here-n">' + r.here_now + ' here now</span><span class="nx-join-btn">Join</span></div></div>';
      }
      function renderRooms() {
        const live = ROOMS.filter(isActive).sort((a, b) => (b.here_now - a.here_now) || (b.pulse - a.pulse));
        el('nx-rooms-sub').textContent = live.length ? (live.length + (live.length === 1 ? ' room live now' : ' rooms live now')) : 'real-time';
        const startCard = '<div class="nx-start-card" data-start><b>+</b>Start a Live Room</div>';
        if (!live.length) {
          roomsEl.innerHTML = '<div class="nx-empty"><span class="nx-empty-orb"></span><b>No rooms live right now</b>'
            + '<span>Start one — it lights up the moment you arrive.</span></div>' + startCard;
          return;
        }
        roomsEl.innerHTML = live.map(roomCard).join('') + startCard;
      }
      async function loadRooms() {
        try { await supabase.rpc('nexus_sweep_rooms'); } catch (e) {}
        const { data, error } = await supabase.from('nexus_rooms').select('*').is('archived_at', null).gt('here_now', 0).order('last_active_at', { ascending: false }).limit(40);
        ROOMS = (error ? [] : (data || [])); renderRooms();
      }

      // live lobby updates: rooms appear when occupied, vanish when the last leaves
      supabase.channel('nx-lobby')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'nexus_rooms' }, (payload) => {
          const row = payload.new || payload.old; if (!row) return;
          const gone = payload.eventType === 'DELETE' || (payload.new && (payload.new.here_now <= 0 || payload.new.archived_at));
          if (gone) ROOMS = ROOMS.filter((r) => r.id !== row.id);
          else {
            const i = ROOMS.findIndex((r) => r.id === payload.new.id);
            if (i >= 0) ROOMS[i] = payload.new; else ROOMS.push(payload.new);
          }
          renderRooms();
        }).subscribe();

      // prune ghosts + pick up rooms started elsewhere, periodically
      setInterval(loadRooms, 30000);

      // ── lobby: tribes (real communities) ──────────────────────────────────
      async function loadTribes() {
        const { data: comms } = await supabase.from('nexus_communities').select('id,slug,name,description,visibility').eq('visibility', 'public').order('created_at');
        if (!comms) { tribesEl.innerHTML = '<p class="nx-pulse-explain">Could not load tribes.</p>'; return; }
        const counts = {};
        const { data: posts } = await supabase.from('nexus_posts').select('community_id').eq('is_soft_hidden', false);
        if (posts) posts.forEach((p) => { counts[p.community_id] = (counts[p.community_id] || 0) + 1; });
        TRIBES = comms;
        tribesEl.innerHTML = comms.length
          ? comms.map((c) => {
              const n = counts[c.id] || 0;
              return '<div class="nx-tribe-card" data-tribe="' + esc(c.id) + '"><span class="nx-tc-mark" style="background:' + g(hashIdx(c.id)) + '"></span>'
                + '<span class="nx-tc-who"><b>' + esc(c.name) + '</b><span>' + n + ' discussion' + (n === 1 ? '' : 's') + '</span></span></div>';
            }).join('')
          : '<p class="nx-pulse-explain">No public tribes yet — they’re being curated during the beta.</p>';
      }

      // ── in-room (the star): presence + broadcast + pulse ──────────────────
      let chan = null, here = 0, sessionStart = 0, timer = null, keepAlive = null, hbAt = 0, curRoom = null;
      const setPulse = (n) => { el('nx-pulse-big').textContent = n; el('nx-pulse-n').textContent = n; };

      async function heartbeat(h, msgDelta) {
        if (!curRoom) return;
        const now = Date.now();
        if (!msgDelta && now - hbAt < 2500) return;
        hbAt = now;
        const { data } = await supabase.rpc('nexus_room_heartbeat', { p_room_id: curRoom.id, p_here: h, p_msg_delta: msgDelta || 0 });
        if (data) { curRoom = data; setPulse(data.pulse); }
      }
      function renderHere(state) {
        const metas = Object.values(state).map((a) => a && a[0]).filter(Boolean);
        here = Math.max(Object.keys(state).length, 1); // I'm always here while in the room
        el('nx-room-here').textContent = here + ' here';
        el('nx-stat-here').textContent = here;
        el('nx-here-faces').innerHTML = metas.slice(0, 12).map((m) => '<span style="background:' + g(m.color || 0) + '"></span>').join('') || faces(1, hashIdx(ME.id));
        const orb = el('nx-pulse-orb'); if (orb) orb.classList.toggle('resting', here === 0);
        el('nx-heat-fill').style.width = Math.min(8 + here * 12, 100) + '%';
      }
      function appendMsg(m, me) {
        const feed = el('nx-room-feed');
        const d = document.createElement('div'); d.className = 'nx-rmsg' + (me ? ' me' : '');
        d.innerHTML = '<span class="nx-rav" style="background:' + g(me ? ME.color : (m.color || 0)) + '"></span><div><span class="nx-rh"></span><p></p></div>';
        d.querySelector('.nx-rh').textContent = me ? 'you' : (m.handle || 'someone');
        d.querySelector('p').textContent = m.text;
        feed.appendChild(d); feed.scrollTop = feed.scrollHeight;
      }
      function openRoom(r) {
        curRoom = r;
        el('nx-room-title').textContent = r.title;
        el('nx-stat-day').textContent = 'day ' + dayOf(r.created_at);
        setPulse(r.pulse); el('nx-stat-here').textContent = 1; el('nx-stat-time').textContent = '0m';
        el('nx-heat-fill').style.width = '20%';
        el('nx-pulse-orb').classList.remove('resting');
        el('nx-room-feed').innerHTML = '<div class="nx-rmsg"><span class="nx-rav" style="background:' + g(3) + '"></span><div><span class="nx-rh">blak · quiet moderator</span><p></p></div></div>';
        el('nx-room-feed').querySelector('p').textContent = 'You’re in — say hello 👋';
        show('room');
        sessionStart = Date.now(); clearInterval(timer); clearInterval(keepAlive);
        timer = setInterval(() => { el('nx-stat-time').textContent = Math.floor((Date.now() - sessionStart) / 60000) + 'm'; }, 5000);
        keepAlive = setInterval(() => { if (chan) heartbeat(here, 0); }, 25000); // stay listed while occupied

        chan = supabase.channel('nx-room:' + r.id, { config: { presence: { key: ME.id }, broadcast: { self: false } } });
        chan
          .on('presence', { event: 'sync' }, () => { renderHere(chan.presenceState()); heartbeat(here, 0); })
          .on('broadcast', { event: 'msg' }, ({ payload }) => appendMsg(payload, false))
          .subscribe(async (status) => { if (status === 'SUBSCRIBED') await chan.track({ handle: ME.handle, color: ME.color, at: Date.now() }); });
      }
      async function leaveRoom() {
        clearInterval(timer); clearInterval(keepAlive);
        const room = curRoom, leftHere = Math.max(0, here - 1);
        try { if (chan) { await chan.untrack(); await supabase.removeChannel(chan); } } catch (e) {}
        chan = null; curRoom = null;
        if (room) { try { await supabase.rpc('nexus_room_heartbeat', { p_room_id: room.id, p_here: leftHere, p_msg_delta: 0 }); } catch (e) {} }
        show('home'); loadRooms();
      }

      el('nx-room-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const inp = el('nx-room-input'); const v = inp.value.trim(); if (!v || !chan) return; inp.value = '';
        chan.send({ type: 'broadcast', event: 'msg', payload: { handle: ME.handle, color: ME.color, text: v } });
        appendMsg({ text: v }, true); heartbeat(here, 1);
      });

      // ── create room (modal) ───────────────────────────────────────────────
      const modal = el('nx-modal');
      const openCreate = () => { modal.hidden = false; setTimeout(() => el('nx-create-title').focus(), 30); };
      const closeCreate = () => { modal.hidden = true; el('nx-create-form').reset(); };
      el('nx-create-cancel').addEventListener('click', closeCreate);
      modal.addEventListener('click', (e) => { if (e.target === modal) closeCreate(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closeCreate(); });
      el('nx-create-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const title = el('nx-create-title').value.trim(); if (!title) return;
        const topic = el('nx-create-topic').value.trim();
        const { data, error } = await supabase.rpc('nexus_create_room', { p_title: title, p_topic: topic || null, p_emoji: null, p_host_handle: ME.handle });
        closeCreate();
        if (error || !data) { toast('Could not start the room — try again.'); return; }
        openRoom(data);
      });

      roomsEl.addEventListener('click', (e) => {
        if (e.target.closest('[data-start]')) return openCreate();
        const c = e.target.closest('[data-room]'); if (!c) return;
        const r = ROOMS.find((x) => x.id === c.getAttribute('data-room')); if (r) openRoom(r);
      });
      el('nx-start').addEventListener('click', openCreate);

      // ── tribe view (real communities + posts) ─────────────────────────────
      let curTribe = null;
      async function openTribe(c) {
        curTribe = c;
        el('nx-tribe-name').textContent = c.name;
        el('nx-tribe-mark').style.background = g(hashIdx(c.id));
        el('nx-tribe-desc').textContent = c.description || 'A Blaksyd tribe.';
        el('nx-tribe-meta').textContent = 'community';
        el('nx-tribe-join').textContent = SESSION ? 'Join' : 'Sign in to join';
        el('nx-tribe-live').innerHTML = '<div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap"><span class="nx-livedot"></span><b>' + esc(c.name) + ' · live room</b><span class="nx-here-n" style="margin-left:auto">gather in real time</span><span class="nx-join-btn" data-tribe-room>Start a room</span></div>';
        const disc = el('nx-discussions'); disc.innerHTML = '<p class="nx-pulse-explain">Loading discussions…</p>';
        show('tribe');
        const { data: posts } = await supabase.from('nexus_posts')
          .select('id,title,body,impact_count,comment_count,created_at')
          .eq('community_id', c.id).eq('is_soft_hidden', false).order('created_at', { ascending: false });
        if (!posts || !posts.length) { disc.innerHTML = '<p class="nx-pulse-explain">No discussions yet — be the first.</p>'; return; }
        disc.innerHTML = posts.map((p) =>
          '<div class="nx-disc" data-post="' + esc(p.id) + '"><div class="nx-disc-top"><span class="nx-disc-av" style="background:' + g(hashIdx(p.id)) + '"></span>member · ' + rel(p.created_at) + '</div>'
          + (p.title ? '<div class="nx-disc-text" style="font-weight:650">' + esc(p.title) + '</div>' : '')
          + '<div class="nx-disc-text">' + esc(p.body) + '</div>'
          + '<div class="nx-disc-foot"><span class="nx-reso" data-reso>◈ <b>' + (p.impact_count || 0) + '</b> resonate</span><span>' + (p.comment_count || 0) + ' replies</span></div></div>'
        ).join('');
      }
      tribesEl.addEventListener('click', (e) => { const c = e.target.closest('[data-tribe]'); if (!c) return; const t = TRIBES.find((x) => x.id === c.getAttribute('data-tribe')); if (t) openTribe(t); });

      el('nx-tribe-live').addEventListener('click', async (e) => {
        if (!e.target.closest('[data-tribe-room]') || !curTribe) return;
        const { data } = await supabase.rpc('nexus_create_room', { p_title: curTribe.name, p_topic: 'live room · ' + curTribe.name, p_emoji: null, p_host_handle: ME.handle });
        if (data) openRoom(data); else toast('Could not open the room — try again.');
      });

      el('nx-discussions').addEventListener('click', async (e) => {
        const r = e.target.closest('[data-reso]'); if (!r) return;
        if (!SESSION) { toast('Sign in to resonate.'); return; }
        if (r.classList.contains('on')) return;
        const post = e.target.closest('[data-post]'); const id = post && post.getAttribute('data-post'); if (!id) return;
        const b = r.querySelector('b'); b.textContent = (+b.textContent + 1); r.classList.add('on');
        await supabase.from('nexus_impacts').insert({ post_id: id, user_id: SESSION.user.id, impact_type: 'resonate' });
      });

      el('nx-disc-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const inp = el('nx-disc-input'); const v = inp.value.trim(); if (!v) return;
        if (!SESSION) { toast('Sign in to post a discussion.'); return; }
        inp.value = '';
        const disc = el('nx-discussions');
        const d = document.createElement('div'); d.className = 'nx-disc';
        d.innerHTML = '<div class="nx-disc-top"><span class="nx-disc-av" style="background:var(--cta-grad)"></span>you · now</div><div class="nx-disc-text"></div><div class="nx-disc-foot"><span class="nx-reso">◈ <b>0</b> resonate</span><span>0 replies</span></div>';
        d.querySelector('.nx-disc-text').textContent = v;
        if (disc.firstChild && disc.firstChild.classList && disc.firstChild.classList.contains('nx-disc')) disc.insertBefore(d, disc.firstChild);
        else { disc.innerHTML = ''; disc.appendChild(d); }
        const { error } = await supabase.from('nexus_posts').insert({ community_id: curTribe.id, author_user_id: SESSION.user.id, body: v });
        if (error) toast('Posted locally, but the server rejected it.');
      });

      el('nx-tribe-join').addEventListener('click', async () => {
        if (!SESSION) { toast('Sign in to join this tribe.'); return; }
        const { error } = await supabase.from('nexus_community_members').insert({ community_id: curTribe.id, user_id: SESSION.user.id });
        el('nx-tribe-join').textContent = 'Joined ✓';
        if (error && error.code !== '23505') toast('Could not join — try again.');
      });

      el('nx-newtribe').addEventListener('click', () => toast('New tribes are curated during the beta. Live Rooms are open — start one above.'));

      // back buttons
      document.querySelectorAll('[data-home]').forEach((b) => b.addEventListener('click', () => { if (chan) leaveRoom(); else show('home'); }));
      window.addEventListener('beforeunload', () => { if (chan && curRoom) { try { navigator.sendBeacon; } catch (e) {} } });

      // ── greeting: they're logged in, so greet them (don't explain Nexus) ──
      function setGreeting() {
        const h = new Date().getHours();
        const g = h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
        let name = '';
        try { const u = SESSION && SESSION.user; name = (u && u.user_metadata && (u.user_metadata.full_name || u.user_metadata.name)) || (u && u.email ? u.email.split('@')[0] : ''); } catch (e) {}
        name = (name || '').trim().split(/[ .@]/)[0];
        name = name ? name.charAt(0).toUpperCase() + name.slice(1) : '';
        const gEl = el('nx-greet'); if (!gEl) return;
        gEl.textContent = '';
        if (name) gEl.appendChild(document.createTextNode(g + ', '));
        const s = document.createElement('span'); s.className = 'nx-accent'; s.textContent = name || g;
        gEl.appendChild(s); gEl.appendChild(document.createTextNode('.'));
      }

      // ── go ──
      (async () => {
        try { const { data } = await supabase.auth.getSession(); SESSION = data.session || null; if (SESSION && SESSION.user && SESSION.user.email) ME.handle = SESSION.user.email.split('@')[0]; } catch (e) {}
        setGreeting();
        await Promise.all([loadRooms(), loadTribes()]);
      })();
    }
  </script>
</AppLayout>
