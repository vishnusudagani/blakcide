---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout active="nexus" title="Nexus">
  <div class="ap-page nx">
    <p class="ap-kicker">Nexus · your community</p>
    <h1 class="ap-h1">Find where you fit. <span class="nx-accent">No performance needed.</span></h1>
    <p class="ap-sub">Tribes, live rooms, and the few who genuinely resonate with you — a feed built around you, not engagement.</p>

    <div class="nx-tribes" id="nx-tribes">
      <button class="nx-tribe is-on" data-t="founders"><i></i>Founders Who Overthink</button>
      <button class="nx-tribe" data-t="starting"><i></i>Starting Over</button>
      <button class="nx-tribe" data-t="today"><i></i>Made It Through Today <span class="nx-live">live</span></button>
      <button class="nx-tribe nx-reso-btn" data-t="reso"><i></i>Resonance</button>
    </div>

    <div class="nx-feed ap-card" id="nx-feed"></div>

    <form class="nx-composer" id="nx-form">
      <input type="text" id="nx-input" placeholder="Share something — anonymous by default…" autocomplete="off" />
      <button type="submit">Post</button>
    </form>
    <p class="nx-note">Beta preview — rooms are sample content for now. Real tribes, live discussion rooms, and resonance matching come next.</p>
  </div>

  <style>
    .nx-accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; background: linear-gradient(110deg, var(--mint), var(--aqua)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .nx-tribes { display: flex; flex-wrap: wrap; gap: .5rem; margin: clamp(1.1rem,3vh,1.6rem) 0 1rem; }
    .nx-tribe { display: inline-flex; align-items: center; gap: .45rem; font: inherit; font-size: var(--fs-sm); color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .5rem .85rem; cursor: pointer; transition: .16s; min-height: 44px; }
    .nx-tribe i { width: 8px; height: 8px; border-radius: 50%; background: linear-gradient(135deg, var(--aqua), var(--mint-deep)); }
    .nx-tribe:hover { color: var(--ink); transform: translateY(-1px); }
    .nx-tribe.is-on { color: var(--ink); background: var(--surface-strong); box-shadow: inset 0 0 0 1px rgba(91,192,255,.5); }
    .nx-live { font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .1em; text-transform: uppercase; color: var(--aqua); border: 1px solid rgba(91,192,255,.4); border-radius: 999px; padding: .05rem .35rem; }
    .nx-reso-btn i { background: radial-gradient(circle at 40% 40%, #BFE9FF, var(--aqua)); box-shadow: 0 0 8px rgba(91,192,255,.6); }

    .nx-feed { padding: 1.1rem 1.2rem; min-height: 240px; }
    .nx-room-head { display: flex; align-items: center; gap: .6rem; margin-bottom: 1rem; }
    .nx-room-head b { font-size: var(--fs-lg); } .nx-here { margin-left: auto; font-family: var(--font-mono); font-size: var(--fs-2xs); color: var(--ink-faint); display: inline-flex; align-items: center; gap: .35rem; } .nx-here i { width: 6px; height: 6px; border-radius: 50%; background: var(--aqua); box-shadow: 0 0 8px var(--aqua); }
    .nx-msg { display: flex; gap: .6rem; align-items: flex-start; margin-bottom: .9rem; animation: nx-in .35s ease both; }
    @keyframes nx-in { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }
    .nx-anon { width: 30px; height: 30px; border-radius: 50%; flex: none; margin-top: .1rem; }
    .nx-a1{background:linear-gradient(135deg,var(--aqua),var(--aqua-ink))} .nx-a2{background:linear-gradient(135deg,var(--mint),var(--mint-deep))} .nx-a3{background:linear-gradient(135deg,var(--lavender),var(--lavender-deep))} .nx-a4{background:linear-gradient(135deg,var(--peach-deep),var(--gold))}
    .nx-handle { font-family: var(--font-mono); font-size: var(--fs-3xs); text-transform: lowercase; letter-spacing: .04em; color: var(--aqua); } .nx-text { font-size: var(--fs-md); color: var(--ink-soft); line-height: 1.45; margin: .1rem 0 0; }
    .nx-feels { margin-left: auto; flex: none; font-family: var(--font-mono); font-size: var(--fs-3xs); color: var(--aqua); background: rgba(91,192,255,.12); border: 1px solid rgba(91,192,255,.24); border-radius: 999px; padding: .2rem .5rem; }

    .nx-composer { display: flex; gap: .5rem; margin-top: 1rem; }
    .nx-composer input { flex: 1; min-width: 0; padding: .8rem 1.05rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-md); }
    .nx-composer input:focus { outline: none; border-color: var(--aqua); }
    .nx-composer button { flex: none; padding: 0 1.2rem; border-radius: var(--r-pill); border: 0; cursor: pointer; font: inherit; font-weight: 650; color: #06231C; background: linear-gradient(135deg, var(--aqua), var(--mint-deep)); }
    .nx-note { margin: .9rem .2rem 0; font-size: var(--fs-xs); color: var(--ink-faint); text-align: center; }
  </style>

  <script is:inline>
    (function () {
      var ROOMS = {
        founders: { name: 'Founders Who Overthink', here: '1.2k here', msgs: [['a1','3am brain','shipped the thing. immediately found nine problems with it.'],['a2','still building',"anyone else rehearse conversations that'll never happen?"],['a3','ramen szn','overthinking is just caring with the volume turned up.']] },
        starting: { name: 'Starting Over', here: '840 here', msgs: [['a3','first week','day 1 of the rest of it. terrified. here anyway.'],['a1','been there',"you showed up. that's the whole job today."]] },
        today:    { name: 'Made It Through Today', here: '122 here · live', msgs: [['a4','rough one',"barely. but I'm here and that counts for something."],['a2','night shift','genuinely proud of you. no notes.']] },
        reso:     { name: 'Resonance match', here: 'for you', reso: true, msgs: [['a3','also starting over','resonates'],['a1','quiet, like you','resonates'],['a2','one step ahead','resonates']] },
      };
      var feed = document.getElementById('nx-feed'), tribes = document.getElementById('nx-tribes'),
          form = document.getElementById('nx-form'), input = document.getElementById('nx-input');
      function render(k) {
        var r = ROOMS[k];
        var head = '<div class="nx-room-head"><b>' + r.name + '</b><span class="nx-here"><i></i>' + r.here + '</span></div>';
        var body = r.msgs.map(function (m) {
          var feels = r.reso ? '<span class="nx-feels">' + m[2] + '</span>' : '';
          var text = r.reso ? '' : '<p class="nx-text">' + m[2] + '</p>';
          return '<div class="nx-msg"><span class="nx-anon nx-' + m[0] + '"></span><div style="flex:1"><span class="nx-handle">' + m[1] + '</span>' + text + '</div>' + feels + '</div>';
        }).join('');
        feed.innerHTML = head + body;
      }
      tribes.addEventListener('click', function (e) {
        var b = e.target.closest('.nx-tribe'); if (!b) return;
        [].forEach.call(tribes.children, function (x) { x.classList.remove('is-on'); }); b.classList.add('is-on');
        render(b.getAttribute('data-t'));
      });
      form.addEventListener('submit', function (e) {
        e.preventDefault(); var v = input.value.trim(); if (!v) return; input.value = '';
        var msg = document.createElement('div'); msg.className = 'nx-msg';
        msg.innerHTML = '<span class="nx-anon nx-a2"></span><div style="flex:1"><span class="nx-handle">you · anon</span><p class="nx-text">' + v.replace(/</g,'&lt;') + '</p></div>';
        var first = feed.querySelector('.nx-msg'); if (first) feed.insertBefore(msg, first); else feed.appendChild(msg);
      });
      render('founders');
    })();
  </script>
</AppLayout>
