---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout active="nexus" title="Nexus">
  <!-- ════════ HOME ════════ -->
  <div class="ap-page nx-view nx-home" id="nx-home">
    <div class="nx-home-top">
      <div>
        <p class="ap-kicker" style="margin:0 0 .15rem">Nexus</p>
        <p class="nx-anon-note" id="nx-greet">You’re anonymous here.</p>
      </div>
      <button type="button" class="nx-msg-icon" id="nx-home-msgs" aria-label="Messages" title="Messages">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.5 7.5L3 21l2-5.5A8.5 8.5 0 1 1 21 11.5z"/></svg>
        <span>Messages</span>
      </button>
    </div>

    <div class="nx-onboard" id="nx-onboard" hidden>
      <p><b>Welcome to Nexus.</b> Your tribes, live rooms, and a feed built around you — and you're always anonymous here. Resonate with what moves you; start a tribe for your people.</p>
      <button type="button" id="nx-onboard-ok">Got it</button>
    </div>

    <div class="nx-standing" id="nx-standing" hidden></div>

    <!-- ── LIVE ROOMS (horizontal strip; + Start leads) — first per product order ── -->
    <div class="nx-sec-head">
      <h2 class="nx-sec-title"><span class="nx-livedot"></span>Live Rooms <span class="nx-sec-sub" id="nx-rooms-sub">real-time</span></h2>
    </div>
    <div class="nx-rooms-strip" id="nx-rooms" data-noswipe>
      <div class="nx-start-card compact" style="cursor:default;opacity:.6">Loading…</div>
    </div>

    <!-- ── TRIBES (carousel) ── -->
    <div class="nx-sec-head" style="margin-top:2rem">
      <h2 class="nx-sec-title">Your tribes</h2>
      <button type="button" class="nx-start ghost" id="nx-newtribe">+ New tribe</button>
    </div>
    <input type="text" id="nx-tribe-search" class="nx-search" placeholder="Search all tribes…" autocomplete="off" />
    <div class="nx-tiles" id="nx-tribes-grid" data-noswipe>
      <div class="nx-tile" style="opacity:.6"><p class="nx-tile-k">Loading your tribes…</p></div>
    </div>
    <div class="nx-carousel-ctrl" id="nx-tribes-ctrl" hidden>
      <button type="button" class="nx-car-arrow" id="nx-tribes-prev" aria-label="Previous">‹</button>
      <div class="nx-dots" id="nx-tribes-dots"></div>
      <button type="button" class="nx-car-arrow" id="nx-tribes-next" aria-label="Next">›</button>
    </div>

    <!-- ── FOR YOU (resonance-ranked feed / threads) — third per product order ── -->
    <div class="nx-sec-head" style="margin-top:2rem"><h2 class="nx-sec-title">For you <span class="nx-sec-sub">resonance</span></h2></div>
    <div class="nx-feed" id="nx-feed" data-noswipe><div class="nx-pulse-explain" style="margin:0">Loading your feed…</div></div>

    <div class="nx-sec-head" style="margin-top:2rem"><h2 class="nx-sec-title">Discover</h2></div>
    <div class="nx-discover" id="nx-discover" data-noswipe></div>
  </div>

  <!-- ════════ IN-ROOM ════════ -->
  <div class="nx-view nx-room" id="nx-room" hidden>
    <header class="nx-room-top">
      <button type="button" class="nx-back" data-home>← Leave</button>
      <div class="nx-room-id"><span class="nx-livedot"></span><b id="nx-room-title">—</b><i id="nx-room-here">— here</i></div>
      <div class="nx-room-pulse" id="nx-room-pulse" title="Room pulse"><span class="nx-flame"></span><b id="nx-pulse-n">0</b></div>
      <button type="button" class="nx-room-close" id="nx-room-close" hidden title="Close this room for everyone">✕ Close</button>
    </header>

    <div class="nx-room-body">
      <div class="nx-room-main">
        <div class="nx-room-feed" id="nx-room-feed" aria-live="polite"></div>
        <form class="nx-room-composer" id="nx-room-form">
          <input type="text" id="nx-room-input" placeholder="Say something to the room…" autocomplete="off" />
          <button type="submit" aria-label="Send"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
      </div>

      <aside class="nx-room-side">
        <div class="nx-pulse-card ap-card">
          <p class="nx-pulse-k">Room pulse</p>
          <div class="nx-pulse-orb" id="nx-pulse-orb"><span class="nx-pulse-num" id="nx-pulse-big">0</span></div>
          <div class="nx-pulse-stats">
            <div><b id="nx-stat-day">day 1</b><span>alive</span></div>
            <div><b id="nx-stat-time">0m</b><span>this session</span></div>
            <div><b id="nx-stat-here">1</b><span>here now</span></div>
          </div>
          <div class="nx-heat"><span id="nx-heat-fill"></span></div>
          <p class="nx-pulse-note">Glows while you're here.</p>
        </div>

        <div class="nx-here-card ap-card">
          <p class="nx-pulse-k">Here now</p>
          <div class="nx-here-faces" id="nx-here-faces"></div>
        </div>
      </aside>
    </div>
  </div>

  <!-- ════════ TRIBE ════════ -->
  <div class="ap-page nx-view nx-tribe" id="nx-tribe" hidden>
    <button type="button" class="nx-back" data-home>← All of Nexus</button>
    <div class="nx-tribe-head">
      <span class="nx-tribe-mark" id="nx-tribe-mark"></span>
      <div>
        <h1 class="ap-h1" id="nx-tribe-name">—</h1>
        <p class="nx-tribe-meta" id="nx-tribe-meta">—</p>
      </div>
      <button type="button" class="nx-joined" id="nx-tribe-join">Join</button>
      <button type="button" class="nx-msg-btn" id="nx-tribe-msgs" title="Messages" aria-label="Messages">✉</button>
      <button type="button" class="nx-msg-btn" id="nx-tribe-share" title="Share this tribe" aria-label="Share">🔗</button>
    </div>
    <p class="nx-tribe-desc" id="nx-tribe-desc"></p>

    <div class="nx-tribe-live ap-card" id="nx-tribe-live"></div>

    <form class="nx-disc-composer" id="nx-disc-form">
      <input type="text" id="nx-disc-title" placeholder="Title (optional)" autocomplete="off" maxlength="120" />
      <div class="nx-disc-row">
        <label class="nx-img-btn" title="Add image"><input type="file" accept="image/*" id="nx-disc-img" hidden /><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></label>
        <textarea id="nx-disc-input" placeholder="Start a discussion… (long-form welcome)" rows="1"></textarea>
        <button type="submit">Post</button>
      </div>
      <div class="nx-img-preview" id="nx-disc-preview" hidden><img id="nx-disc-preview-img" alt="" /><button type="button" id="nx-disc-preview-x" aria-label="Remove image">✕</button></div>
    </form>
    <div class="nx-discussions" id="nx-discussions"></div>
  </div>

  <!-- ════════ DMs (tribe-scoped, anonymous 1:1) ════════ -->
  <div class="nx-view nx-room" id="nx-dm" hidden>
    <header class="nx-room-top">
      <button type="button" class="nx-back" id="nx-dm-back">← Back</button>
      <div class="nx-room-id"><b id="nx-dm-title">Messages</b><i id="nx-dm-sub">anonymous · members only</i></div>
      <button type="button" class="nx-more-btn" id="nx-dm-more" hidden aria-label="More options" style="margin-left:auto">⋯</button>
    </header>
    <div class="nx-room-body" style="grid-template-columns:1fr">
      <div class="nx-room-main">
        <div class="nx-room-feed" id="nx-dm-feed"></div>
        <form class="nx-room-composer" id="nx-dm-form" hidden>
          <label class="nx-img-btn" title="Add image"><input type="file" accept="image/*" id="nx-dm-img" hidden /><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></label>
          <input type="text" id="nx-dm-input" placeholder="Message privately…" autocomplete="off" />
          <button type="submit" aria-label="Send"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
        <div class="nx-img-preview" id="nx-dm-preview" hidden><img id="nx-dm-preview-img" alt="" /><button type="button" id="nx-dm-preview-x" aria-label="Remove image">✕</button></div>
      </div>
    </div>
  </div>

  <!-- ════════ CREATE-ROOM MODAL ════════ -->
  <div class="nx-modal" id="nx-modal" hidden>
    <div class="nx-modal-card ap-card">
      <p class="nx-pulse-k">Start a Live Room</p>
      <h3 class="nx-modal-title">What are you gathering around?</h3>
      <form id="nx-create-form">
        <input id="nx-create-title" maxlength="80" placeholder="e.g. Late-night writing sprint" autocomplete="off" required />
        <input id="nx-create-topic" maxlength="140" placeholder="one line on the vibe (optional)" autocomplete="off" />
        <div class="nx-modal-actions">
          <button type="button" class="nx-modal-cancel" id="nx-create-cancel">Cancel</button>
          <button type="submit" class="nx-modal-go">Open the room</button>
        </div>
        <p class="nx-modal-note">Lights up as people gather. No timers, no pressure.</p>
      </form>
    </div>
  </div>

  <!-- ════════ CREATE-TRIBE MODAL ════════ -->
  <div class="nx-modal" id="nx-tribe-modal" hidden>
    <div class="nx-modal-card ap-card">
      <p class="nx-pulse-k">Start a Tribe</p>
      <h3 class="nx-modal-title">Name your community</h3>
      <form id="nx-tribe-form">
        <input id="nx-tribe-name-in" maxlength="60" placeholder="e.g. Founders Who Overthink" autocomplete="off" required />
        <input id="nx-tribe-desc-in" maxlength="160" placeholder="one line on what it's about (optional)" autocomplete="off" />
        <div class="nx-vis-row" id="nx-tribe-vis">
          <button type="button" class="nx-vis on" data-vis="public">🌐 Public</button>
          <button type="button" class="nx-vis" data-vis="private">🔒 Private</button>
          <button type="button" class="nx-vis" data-vis="anonymous">🕶️ Anonymous</button>
        </div>
        <div class="nx-modal-actions">
          <button type="button" class="nx-modal-cancel" id="nx-tribe-cancel">Cancel</button>
          <button type="submit" class="nx-modal-go">Create tribe</button>
        </div>
        <p class="nx-modal-note">A persistent space others can join and post in — you'll be its first member.</p>
      </form>
    </div>
  </div>

  <!-- ════════ CRISIS SUPPORT (private, author-only) ════════ -->
  <div class="nx-modal" id="nx-crisis" hidden>
    <div class="nx-modal-card ap-card nx-crisis-card">
      <div class="nx-crisis-orb"></div>
      <h3 class="nx-crisis-title">You don’t have to carry this alone.</h3>
      <p class="nx-crisis-body">What you shared sounds really heavy — and reaching out takes courage. Someone who’s been there is ready to listen, any time.</p>
      <a class="nx-crisis-cta" href="/beta/minit/">Talk to a Listener →</a>
      <div class="nx-crisis-lines">
        <p class="nx-crisis-k">Free, confidential helplines</p>
        <a href="tel:18005990019">KIRAN (India) · 1800-599-0019</a>
        <a href="tel:14416">Tele-MANAS · 14416</a>
        <p class="nx-crisis-note">If you’re in immediate danger, call your local emergency number (112 in India).</p>
      </div>
      <button type="button" class="nx-modal-cancel" id="nx-crisis-ok" style="width:100%;margin-top:.7rem">I’m okay for now</button>
    </div>
  </div>

  <!-- ════════ SAFETY SHEET (report / block) ════════ -->
  <div class="nx-modal" id="nx-safety" hidden>
    <div class="nx-modal-card ap-card nx-safety-card">
      <p class="nx-pulse-k">Safety</p>
      <h3 class="nx-modal-title" id="nx-safety-title">@someone</h3>
      <div id="nx-safety-main">
        <button type="button" class="nx-safety-act" data-safety-report>⚑ Report this</button>
        <button type="button" class="nx-safety-act danger" data-safety-block>⊘ Block this person</button>
        <button type="button" class="nx-safety-act" id="nx-safety-remove" data-safety-remove hidden>🗑 Remove from tribe (moderator)</button>
        <button type="button" class="nx-safety-act danger" id="nx-safety-ban" data-safety-ban hidden>⛔ Ban from tribe (moderator)</button>
        <button type="button" class="nx-modal-cancel" data-safety-cancel style="width:100%">Cancel</button>
      </div>
      <div id="nx-safety-reasons" hidden>
        <p class="nx-modal-note" style="margin:0 0 .7rem">Why are you reporting this?</p>
        <div class="nx-reason-grid">
          <button type="button" class="nx-reason" data-reason="spam">Spam</button>
          <button type="button" class="nx-reason" data-reason="harassment">Harassment</button>
          <button type="button" class="nx-reason" data-reason="hate">Hate speech</button>
          <button type="button" class="nx-reason" data-reason="sexual">Sexual</button>
          <button type="button" class="nx-reason" data-reason="self_harm">Self-harm</button>
          <button type="button" class="nx-reason" data-reason="violence">Violence</button>
          <button type="button" class="nx-reason" data-reason="misinfo">Misinfo</button>
          <button type="button" class="nx-reason" data-reason="other">Other</button>
        </div>
        <button type="button" class="nx-modal-cancel" data-safety-cancel style="width:100%;margin-top:.7rem">Cancel</button>
      </div>
    </div>
  </div>

  <style is:global>
    /* global (not scoped): room/tribe cards are built in JS at runtime and would
       miss Astro's scope attribute. Everything is .nx-* namespaced. */
    .nx-view[hidden] { display: none !important; }
    .nx-view { animation: nx-fade .3s var(--ease-out) both; }
    @keyframes nx-fade { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }
    .nx-accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; background: linear-gradient(110deg, var(--mint), var(--aqua)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .nx-livedot { width: 9px; height: 9px; border-radius: 50%; background: #ff5a6e; box-shadow: 0 0 0 0 rgba(255,90,110,.6); animation: nx-beat 1.8s infinite; display: inline-block; }
    @keyframes nx-beat { 0%{box-shadow:0 0 0 0 rgba(255,90,110,.55)} 70%{box-shadow:0 0 0 8px rgba(255,90,110,0)} 100%{box-shadow:0 0 0 0 rgba(255,90,110,0)} }

    .nx-sec-head { display: flex; align-items: center; gap: 1rem; margin: clamp(1.4rem,4vh,2.2rem) 0 1rem; }
    .nx-sec-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); display: inline-flex; align-items: center; gap: .55rem; margin: 0; }
    .nx-sec-sub { font-family: var(--font-mono); font-size: var(--fs-2xs); text-transform: uppercase; letter-spacing: .12em; color: var(--ink-faint); font-weight: 400; }
    .nx-start { margin-left: auto; font: inherit; font-size: var(--fs-sm); font-weight: 600; color: #06231C; background: linear-gradient(135deg, var(--mint), var(--aqua)); border: 0; border-radius: var(--r-pill); padding: .55rem 1rem; cursor: pointer; transition: transform .2s var(--ease-spring); }
    .nx-start:hover { transform: translateY(-1px); }
    .nx-start.ghost { color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); }
    /* ── home top bar ── */
    .nx-home-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
    .nx-anon-note { font-size: var(--fs-sm); color: var(--ink-faint); margin: 0; }
    .nx-msg-icon { display: inline-flex; flex-direction: column; align-items: center; gap: 2px; background: none; border: 0; color: var(--ink-soft); cursor: pointer; font: inherit; flex: none; }
    .nx-msg-icon:hover { color: var(--aqua); } .nx-msg-icon svg { width: 26px; height: 26px; } .nx-msg-icon span { font-size: var(--fs-2xs); }
    html[data-theme="light"] .nx-msg-icon:hover { color: var(--aqua-ink); }
    /* ── live rooms strip ── */
    .nx-rooms-strip { display: flex; gap: .7rem; overflow-x: auto; padding-bottom: .5rem; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; }
    .nx-rooms-strip::-webkit-scrollbar { height: 6px; } .nx-rooms-strip::-webkit-scrollbar-thumb { background: var(--line-strong); border-radius: 999px; }
    .nx-rooms-strip .nx-room-card { flex: 0 0 auto; width: clamp(150px, 44vw, 188px); scroll-snap-align: start; padding: .9rem 1rem; }
    .nx-room-card.compact .nx-rc-title { font-size: var(--fs-lg); margin: .55rem 0 .15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nx-room-card.compact .nx-rc-bottom { margin-top: .6rem; }
    .nx-start-card.compact { min-height: 0; flex: 0 0 auto; width: clamp(108px, 30vw, 130px); padding: 1rem .8rem; scroll-snap-align: start; gap: .2rem; }
    .nx-start-card.compact b { font-size: 1.6rem; } .nx-start-card.compact span { font-size: var(--fs-sm); }
    .nx-rooms-hint { flex: 1; align-self: center; min-width: 160px; color: var(--ink-faint); font-size: var(--fs-sm); padding: 0 .4rem; }
    /* ── tribes carousel ── */
    .nx-carousel { overflow: hidden; }
    .nx-tribes-track { display: flex; gap: .8rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .4rem; -webkit-overflow-scrolling: touch; }
    .nx-tribes-track::-webkit-scrollbar { height: 6px; } .nx-tribes-track::-webkit-scrollbar-thumb { background: var(--line-strong); border-radius: 999px; }
    .nx-tribes-track .nx-tribe-card { flex: 0 0 auto; width: clamp(230px, 80vw, 340px); scroll-snap-align: start; }
    .nx-carousel-ctrl { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: .9rem; }
    .nx-carousel-ctrl[hidden] { display: none; }
    .nx-car-arrow { width: 44px; height: 44px; border-radius: 50%; background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink-soft); cursor: pointer; font-size: 1.3rem; line-height: 1; display: grid; place-items: center; }
    .nx-car-arrow:hover { color: var(--ink); border-color: var(--aqua); }
    .nx-dots { display: flex; gap: .4rem; align-items: center; }
    .nx-dots span { width: 7px; height: 7px; border-radius: 999px; background: var(--line-strong); transition: width .2s, background .2s; }
    .nx-dots span.on { background: var(--aqua); width: 18px; }
    html[data-theme="light"] .nx-dots span.on { background: var(--aqua-ink); }
    /* ── tribe tiles (one-per-view swiper) ── */
    .nx-tiles { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .4rem; -webkit-overflow-scrolling: touch; }
    .nx-tiles::-webkit-scrollbar { height: 6px; } .nx-tiles::-webkit-scrollbar-thumb { background: var(--line-strong); border-radius: 999px; }
    .nx-tiles.list { display: block; overflow: visible; }
    .nx-tiles.list .nx-tribe-card { margin-bottom: .6rem; }
    .nx-tile { flex: 0 0 100%; width: 100%; box-sizing: border-box; scroll-snap-align: center; background: var(--glass-strong); border: 1px solid var(--line-strong); border-radius: var(--r-lg); padding: 1.1rem 1.2rem; }
    .nx-tile-head { display: flex; align-items: center; gap: .8rem; cursor: pointer; }
    .nx-tile-head .nx-tc-mark { width: 46px; height: 46px; border-radius: 14px; flex: none; }
    .nx-tile-id b { font-size: var(--fs-xl); font-weight: 650; display: block; } .nx-tile-id span { font-size: var(--fs-sm); color: var(--aqua); }
    html[data-theme="light"] .nx-tile-id span { color: var(--aqua-ink); }
    .nx-tile-compose { display: flex; gap: .5rem; margin: 1rem 0 .4rem; }
    .nx-tile-compose input[type="text"] { flex: 1; min-width: 0; padding: .7rem 1rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-md); }
    .nx-tile-compose input[type="text"]:focus { outline: none; border-color: var(--aqua); }
    .nx-tile-compose button { flex: none; padding: 0 1.1rem; border-radius: var(--r-pill); border: 0; cursor: pointer; color: #06231C; font: inherit; font-weight: 650; background: linear-gradient(135deg, var(--mint), var(--aqua)); }
    .nx-tile-prev { position: relative; width: max-content; margin: 0 0 .6rem; } .nx-tile-prev img { max-height: 90px; max-width: 160px; border-radius: var(--r-md); border: 1px solid var(--line-strong); display: block; } .nx-tile-prev button { position: absolute; top: -10px; right: -10px; width: 30px; height: 30px; border-radius: 50%; border: 0; background: var(--coral); color: #fff; cursor: pointer; font-size: .8rem; display: grid; place-items: center; }
    .nx-tile-k { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); margin: .8rem 0 .5rem; }
    .nx-tile-updates { display: flex; flex-direction: column; gap: .4rem; }
    .nx-tile-post { display: flex; align-items: center; gap: .6rem; width: 100%; text-align: left; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: .55rem .8rem; cursor: pointer; font: inherit; }
    .nx-tile-post:hover { border-color: rgba(91,192,255,.4); }
    .nx-tile-av { width: 24px; height: 24px; border-radius: 50%; flex: none; }
    .nx-tile-ptxt { flex: 1; min-width: 0; font-size: var(--fs-sm); color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nx-tile-when { font-size: var(--fs-xs); color: var(--ink-faint); flex: none; }
    .nx-tile-empty { font-size: var(--fs-sm); color: var(--ink-faint); margin: 0; }
    .nx-tile-empty-state { text-align: center; } .nx-tile-empty-state .nx-start { margin: .8rem auto 0; }

    /* live room cards */
    .nx-rooms { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 1rem; }
    .nx-room-card { position: relative; overflow: hidden; padding: 1.1rem 1.2rem 1.2rem; border-radius: var(--r-lg); border: 1px solid var(--line-strong); background: var(--glass-strong); cursor: pointer; transition: transform .25s var(--ease-spring), border-color .2s; }
    .nx-room-card::before { content:''; position:absolute; inset:0; background: radial-gradient(80% 60% at 80% -10%, var(--heat, rgba(255,150,90,.16)), transparent 70%); pointer-events:none; }
    .nx-room-card:hover { transform: translateY(-3px); border-color: rgba(91,192,255,.4); }
    .nx-room-card.resting::before { opacity: .35; }
    .nx-rc-top { display: flex; align-items: center; gap: .5rem; position: relative; }
    .nx-rc-live { font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .12em; text-transform: uppercase; color: #ff8a96; }
    .nx-rc-rest { font-family: var(--font-mono); font-size: var(--fs-3xs); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); }
    .nx-rc-pulse { margin-left: auto; display: inline-flex; align-items: center; gap: .3rem; font-size: var(--fs-sm); font-weight: 700; color: #ffc46b; }
    .nx-flame { width: 13px; height: 13px; flex: none; border-radius: 50% 50% 50% 0; transform: rotate(45deg); background: radial-gradient(circle at 60% 60%, #ffd27a, #ff7a4d); box-shadow: 0 0 10px rgba(255,150,90,.7); }
    .nx-flame.dim { background: radial-gradient(circle at 60% 60%, #cbc4bb, #8b8178); box-shadow: none; opacity: .65; }
    .nx-rc-title { font-size: var(--fs-xl); font-weight: 650; margin: .7rem 0 .1rem; position: relative; }
    .nx-rc-host { font-size: var(--fs-sm); color: var(--ink-faint); position: relative; }
    .nx-rc-bottom { display: flex; align-items: center; gap: .6rem; margin-top: .9rem; position: relative; }
    .nx-faces { display: inline-flex; } .nx-faces span { width: 26px; height: 26px; border-radius: 50%; margin-left: -8px; border: 2px solid var(--bg); display: inline-block; }
    .nx-faces span:first-child { margin-left: 0; }
    .nx-here-n { font-size: var(--fs-sm); color: var(--ink-soft); }
    .nx-join-btn { margin-left: auto; font: inherit; font-size: var(--fs-sm); font-weight: 600; color: var(--aqua-ink); background: rgba(91,192,255,.14); border: 1px solid rgba(91,192,255,.3); border-radius: var(--r-pill); padding: .4rem .9rem; min-height: 44px; cursor: pointer; }
    html[data-theme="dark"] .nx-join-btn { color: #BFE9FF; }
    .nx-start-card { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .4rem; min-height: 150px; border: 1.5px dashed var(--line-strong); border-radius: var(--r-lg); color: var(--ink-faint); cursor: pointer; transition: .2s; }
    .nx-start-card:hover { border-color: var(--aqua); color: var(--aqua); }
    .nx-start-card b { font-size: 1.5rem; }
    .nx-pulse-explain { margin: 1rem 0 0; font-size: var(--fs-sm); color: var(--ink-faint); max-width: 60ch; } .nx-pulse-explain b { color: #ffc46b; }
    .nx-empty { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: .45rem; padding: 2.4rem 1.5rem; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--glass-strong); }
    .nx-empty b { font-size: var(--fs-xl); font-weight: 650; color: var(--ink); }
    .nx-empty span { font-size: var(--fs-sm); color: var(--ink-faint); max-width: 44ch; }
    .nx-empty-orb { width: 54px; height: 54px; border-radius: 50%; margin-bottom: .4rem; background: radial-gradient(circle at 50% 45%, rgba(255,180,100,.28), rgba(255,120,80,.1) 60%, transparent 72%); box-shadow: 0 0 30px rgba(255,150,90,.22); animation: nx-glow 3.6s var(--ease-soft) infinite; }

    /* tribes */
    .nx-tribes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: .8rem; }
    .nx-tribe-card { display: flex; align-items: center; gap: .7rem; padding: .9rem 1rem; border-radius: var(--r-md); border: 1px solid var(--line-strong); background: var(--glass-strong); cursor: pointer; transition: transform .2s var(--ease-spring), border-color .2s; }
    .nx-tribe-card:hover { transform: translateY(-2px); border-color: rgba(91,192,255,.4); }
    .nx-tc-mark { width: 38px; height: 38px; border-radius: 12px; flex: none; }
    .nx-tc-who b { font-size: var(--fs-md); display: block; } .nx-tc-who span { font-size: var(--fs-sm); color: var(--ink-faint); }
    .nx-tc-new { margin-left: auto; font-size: var(--fs-3xs); font-family: var(--font-mono); color: var(--aqua); background: rgba(91,192,255,.14); border-radius: 999px; padding: .15rem .45rem; }

    /* in-room */
    .nx-room { display: flex; flex-direction: column; height: 100vh; height: 100svh; }
    .nx-room-top { display: flex; align-items: center; gap: .8rem; padding: 1rem clamp(1rem,3vw,1.6rem); border-bottom: 1px solid var(--line); }
    .nx-back { font: inherit; font-size: var(--fs-md); color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .4rem .8rem; cursor: pointer; }
    .nx-back:hover { color: var(--ink); }
    .nx-room-id { display: flex; align-items: center; gap: .5rem; } .nx-room-id b { font-size: var(--fs-lg); } .nx-room-id i { font-style: normal; font-size: var(--fs-sm); color: var(--ink-faint); }
    .nx-room-pulse { margin-left: auto; display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; color: #ffc46b; font-size: var(--fs-lg); }
    .nx-room-body { flex: 1; display: grid; grid-template-columns: 1fr 300px; gap: 1rem; min-height: 0; padding: 1rem clamp(1rem,3vw,1.6rem); }
    .nx-room-main { display: flex; flex-direction: column; min-height: 0; }
    .nx-room-feed { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: .7rem; padding: .4rem; }
    .nx-rmsg { display: flex; gap: .6rem; align-items: flex-start; animation: nx-fade .3s ease both; max-width: 90%; }
    .nx-rmsg .nx-rav { width: 28px; height: 28px; border-radius: 50%; flex: none; margin-top: .15rem; }
    .nx-rmsg .nx-rh { font-family: var(--font-mono); font-size: var(--fs-3xs); color: var(--aqua); } .nx-rmsg p { margin: .1rem 0 0; font-size: var(--fs-md); color: var(--ink); line-height: 1.45; }
    .nx-rmsg.me { margin-left: auto; flex-direction: row-reverse; } .nx-rmsg.me p { color: var(--ink-soft); }
    .nx-room-composer { display: flex; gap: .5rem; padding-top: .6rem; }
    .nx-room-composer input { flex: 1; min-width: 0; padding: .8rem 1.05rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-md); }
    .nx-room-composer input:focus { outline: none; border-color: var(--aqua); }
    .nx-room-composer button { flex: none; padding: 0 1.1rem; min-width: 46px; border-radius: var(--r-pill); border: 0; cursor: pointer; color: #06231C; font: inherit; font-weight: 650; background: linear-gradient(135deg, var(--mint), var(--aqua)); } .nx-room-composer button svg { width: 18px; height: 18px; }

    .nx-room-side { display: flex; flex-direction: column; gap: 1rem; overflow-y: auto; }
    .nx-pulse-card { padding: 1.2rem; text-align: center; }
    .nx-pulse-k { font-family: var(--font-mono); font-size: var(--fs-2xs); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 .8rem; }
    .nx-pulse-orb { position: relative; width: 130px; height: 130px; margin: 0 auto; border-radius: 50%; display: grid; place-items: center;
      background: radial-gradient(circle at 50% 45%, rgba(255,180,100,.28), rgba(255,120,80,.12) 60%, transparent 72%);
      box-shadow: 0 0 50px rgba(255,150,90,.35); animation: nx-glow 3.2s var(--ease-soft) infinite; transition: filter .6s, box-shadow .6s; }
    .nx-pulse-orb.resting { animation: none; box-shadow: 0 0 18px rgba(255,150,90,.10); filter: saturate(.55) brightness(.82); }
    @keyframes nx-glow { 0%,100%{transform:scale(1);box-shadow:0 0 44px rgba(255,150,90,.3)} 50%{transform:scale(1.05);box-shadow:0 0 64px rgba(255,150,90,.5)} }
    .nx-pulse-num { font-family: var(--font-display); font-weight: 700; font-size: 2.6rem; color: #ffd9a8; text-shadow: 0 0 24px rgba(255,170,100,.6); }
    .nx-pulse-stats { display: flex; justify-content: space-around; margin-top: 1rem; }
    .nx-pulse-stats b { display: block; font-size: var(--fs-lg); color: var(--ink); } .nx-pulse-stats span { font-size: var(--fs-2xs); color: var(--ink-faint); }
    .nx-heat { height: 6px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; margin-top: 1rem; } .nx-heat span { display: block; height: 100%; width: 8%; border-radius: 999px; background: linear-gradient(90deg, #ff7a4d, #ffd27a); transition: width 1.2s var(--ease-out); }
    .nx-pulse-note { margin: .9rem 0 0; font-size: var(--fs-xs); color: var(--ink-faint); }
    .nx-here-card { padding: 1rem 1.2rem; } .nx-here-faces { display: flex; flex-wrap: wrap; gap: .4rem; } .nx-here-faces span { width: 30px; height: 30px; border-radius: 50%; }

    /* light-mode legibility: accent TEXT that sits on light "glass" needs the darker
       -ink tints (the bright dark-theme accents wash out on a cream background) */
    html[data-theme="light"] .nx-rmsg .nx-rh { color: var(--aqua-ink); }
    html[data-theme="light"] .nx-rc-live { color: var(--coral-ink); }
    html[data-theme="light"] .nx-rc-pulse,
    html[data-theme="light"] .nx-room-pulse { color: var(--gold-ink); }
    html[data-theme="light"] .nx-pulse-num { color: var(--gold-ink); text-shadow: none; }
    html[data-theme="light"] .nx-pulse-explain b { color: var(--gold-ink); }

    /* ── mobile in-room: feed fills the screen; Pulse is a slim vibe bar ── */
    @media (max-width: 900px) {
      .nx-room { height: calc(100svh - 124px - env(safe-area-inset-bottom, 0px)); }
      #nx-room-here, .nx-room-pulse { display: none; }   /* carried by the vibe bar */
      .nx-room-body { display: flex; flex-direction: column; gap: .7rem; padding-top: .7rem; }
      .nx-room-main { flex: 1; min-height: 0; order: 1; }
      .nx-room-side { order: 0; flex-direction: row; align-items: center; overflow: visible; }
      .nx-pulse-card { flex: 1; display: flex; align-items: center; gap: .6rem; padding: .5rem .85rem; text-align: left; }
      .nx-pulse-k, .nx-pulse-note, .nx-heat, .nx-here-card { display: none; }
      .nx-pulse-orb { width: 34px; height: 34px; margin: 0; box-shadow: 0 0 14px rgba(255,150,90,.45); animation: none; }
      .nx-pulse-num { font-size: .85rem; text-shadow: none; }
      .nx-pulse-stats { margin: 0 0 0 auto; gap: 1.1rem; }
      .nx-pulse-stats b { font-size: var(--fs-md); }
      .nx-pulse-stats span { font-size: 9px; }
    }

    /* tribe view */
    .nx-tribe-head { display: flex; align-items: center; gap: 1rem; margin: 1rem 0 .6rem; }
    .nx-tribe-mark { width: 56px; height: 56px; border-radius: 16px; flex: none; }
    .nx-tribe-meta { color: var(--ink-faint); font-size: var(--fs-md); margin: .2rem 0 0; }
    .nx-joined { margin-left: auto; font: inherit; font-size: var(--fs-sm); font-weight: 600; color: var(--mint); background: rgba(106,211,184,.14); border: 1px solid rgba(106,211,184,.3); border-radius: var(--r-pill); padding: .45rem 1rem; cursor: pointer; }
    .nx-tribe-desc { color: var(--ink-soft); max-width: 60ch; margin: 0 0 1.2rem; }
    .nx-tribe-live { padding: 1rem 1.2rem; margin-bottom: 1.2rem; }
    .nx-disc-composer { margin-bottom: 1.2rem; }
    .nx-disc { padding: 1rem 1.1rem; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--glass-strong); margin-bottom: .7rem; animation: nx-fade .3s ease both; }
    .nx-disc-top { display: flex; align-items: center; gap: .5rem; font-size: var(--fs-sm); color: var(--ink-faint); margin-bottom: .4rem; } .nx-disc-av { width: 22px; height: 22px; border-radius: 50%; }
    .nx-disc-text { font-size: var(--fs-lg); color: var(--ink); line-height: 1.5; }
    .nx-disc-foot { display: flex; gap: 1rem; margin-top: .7rem; font-size: var(--fs-sm); color: var(--ink-faint); } .nx-reso { color: var(--aqua); cursor: pointer; } .nx-reso.on { color: #ffd9a8; }
    .nx-disc-replies { cursor: pointer; } .nx-disc-replies:hover, .nx-reso:hover { color: var(--ink); }
    .nx-search { width: 100%; padding: .7rem 1rem; margin: 0 0 1rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-md); }
    .nx-search:focus { outline: none; border-color: var(--aqua); }
    .nx-disc-composer { display: flex; flex-direction: column; gap: .5rem; margin-bottom: 1.2rem; }
    .nx-disc-composer input { padding: .8rem 1.05rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-md); min-width: 0; }
    .nx-disc-composer input:focus { outline: none; border-color: var(--aqua); }
    .nx-disc-row { display: flex; gap: .5rem; } .nx-disc-row input { flex: 1; }
    .nx-disc-composer button { flex: none; padding: 0 1.2rem; min-height: 44px; border-radius: var(--r-pill); border: 0; cursor: pointer; color: #06231C; font: inherit; font-weight: 650; background: linear-gradient(135deg, var(--mint), var(--aqua)); }
    .nx-comments { margin-top: .8rem; border-top: 1px solid var(--line); padding-top: .8rem; }
    .nx-cmt { display: flex; gap: .55rem; margin-bottom: .65rem; }
    .nx-cmt-av { width: 24px; height: 24px; border-radius: 50%; flex: none; margin-top: .15rem; }
    .nx-cmt-h { font-family: var(--font-mono); font-size: var(--fs-3xs); color: var(--aqua); }
    html[data-theme="light"] .nx-cmt-h { color: var(--aqua-ink); }
    .nx-cmt p { margin: .1rem 0 0; font-size: var(--fs-md); color: var(--ink); line-height: 1.45; word-wrap: break-word; overflow-wrap: anywhere; }
    .nx-cmt-form { display: flex; gap: .5rem; margin-top: .5rem; }
    .nx-cmt-form input { flex: 1; min-width: 0; padding: .55rem .9rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-sm); }
    .nx-cmt-form input:focus { outline: none; border-color: var(--aqua); }
    .nx-cmt-form button { flex: none; padding: 0 1rem; min-height: 38px; border-radius: var(--r-pill); border: 1px solid var(--line-strong); background: var(--surface-strong); color: var(--ink); font: inherit; font-weight: 600; cursor: pointer; }
    .nx-dm-link { color: var(--aqua); cursor: pointer; }
    html[data-theme="light"] .nx-dm-link { color: var(--aqua-ink); }
    .nx-dm-link:hover { text-decoration: underline; }
    .nx-msg-btn { flex: none; margin-left: .5rem; font-size: 1.05rem; line-height: 1; color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .45rem .75rem; min-height: 44px; min-width: 44px; cursor: pointer; }
    .nx-msg-btn:hover { color: var(--ink); border-color: var(--aqua); }
    .nx-img { max-width: min(340px, 100%); max-height: 340px; border-radius: var(--r-md); margin-top: .5rem; display: block; border: 1px solid var(--line); object-fit: cover; }
    .nx-img-btn { flex: none; display: grid; place-items: center; width: 46px; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink-soft); cursor: pointer; }
    .nx-img-btn:hover { color: var(--aqua); border-color: var(--aqua); } .nx-img-btn svg { width: 18px; height: 18px; }
    .nx-img-preview { position: relative; margin-top: .5rem; width: max-content; max-width: 100%; }
    .nx-img-preview img { max-height: 120px; max-width: 220px; border-radius: var(--r-md); display: block; border: 1px solid var(--line-strong); }
    .nx-img-preview button { position: absolute; top: -10px; right: -10px; width: 30px; height: 30px; border-radius: 50%; border: 0; background: var(--coral); color: #fff; cursor: pointer; font-size: .8rem; line-height: 1; display: grid; place-items: center; }
    .nx-inbox-row { display: flex; align-items: center; gap: .7rem; width: 100%; text-align: left; padding: .7rem .9rem; background: var(--glass-strong); border: 1px solid var(--line); border-radius: var(--r-md); margin-bottom: .5rem; cursor: pointer; font: inherit; }
    .nx-inbox-row:hover { border-color: rgba(91,192,255,.4); } .nx-inbox-row .nx-disc-av { width: 34px; height: 34px; flex: none; }
    .nx-inbox-meta { flex: 1; min-width: 0; } .nx-inbox-meta b { display: block; font-size: var(--fs-md); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .nx-inbox-meta span { font-size: var(--fs-sm); color: var(--ink-faint); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nx-inbox-when { font-size: var(--fs-xs); color: var(--ink-faint); flex: none; }
    .nx-dm-search { width: 100%; box-sizing: border-box; padding: .7rem 1rem; margin: 0 0 .8rem; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-md); }
    .nx-dm-search:focus { outline: none; border-color: var(--aqua); }

    /* create-room modal */
    .nx-modal { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; padding: 1.2rem; overflow-y: auto; background: rgba(6,7,18,.62); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: nx-fade .2s ease both; }
    .nx-modal[hidden] { display: none !important; }
    .nx-modal-card { width: min(460px, 100%); padding: 1.4rem; max-height: calc(100dvh - 2.4rem); overflow-y: auto; }
    .nx-modal-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); margin: .2rem 0 1rem; }
    #nx-create-form, #nx-tribe-form { display: flex; flex-direction: column; gap: .6rem; }
    #nx-create-form input, #nx-tribe-form input { padding: .8rem 1rem; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line-strong); color: var(--ink); font: inherit; font-size: var(--fs-md); }
    #nx-create-form input:focus, #nx-tribe-form input:focus { outline: none; border-color: var(--aqua); }
    .nx-modal-actions { display: flex; gap: .6rem; justify-content: flex-end; margin-top: .4rem; }
    .nx-modal-cancel { font: inherit; color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .55rem 1rem; cursor: pointer; }
    .nx-modal-go { font: inherit; font-weight: 650; color: #06231C; background: linear-gradient(135deg, var(--mint), var(--aqua)); border: 0; border-radius: var(--r-pill); padding: .55rem 1.1rem; cursor: pointer; }
    .nx-modal-note { font-size: var(--fs-xs); color: var(--ink-faint); margin: .6rem 0 0; line-height: 1.5; }

    /* toast */
    .nx-toast { position: fixed; left: 50%; bottom: calc(96px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%) translateY(20px); z-index: 70; background: var(--surface-strong); color: var(--ink); border: 1px solid var(--line-strong); border-radius: var(--r-pill); padding: .6rem 1.1rem; font-size: var(--fs-sm); box-shadow: var(--shadow-soft); opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s; }
    .nx-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* ── LIGHT theme: deepen warm/vivid accent TEXT so it reads on cream ── */
    html[data-theme="light"] .nx-accent { background: linear-gradient(110deg, var(--mint-ink), var(--aqua-ink)); -webkit-background-clip: text; background-clip: text; }
    html[data-theme="light"] .nx-rc-live { color: var(--coral-ink); }
    html[data-theme="light"] .nx-rc-pulse,
    html[data-theme="light"] .nx-room-pulse,
    html[data-theme="light"] .nx-pulse-explain b { color: var(--gold-ink); }
    html[data-theme="light"] .nx-rmsg .nx-rh,
    html[data-theme="light"] .nx-reso,
    html[data-theme="light"] .nx-tc-new,
    html[data-theme="light"] .nx-start-card:hover { color: var(--aqua-ink); }
    html[data-theme="light"] .nx-pulse-num,
    html[data-theme="light"] .nx-reso.on { color: #C2410C; text-shadow: none; }
    html[data-theme="light"] .nx-pulse-orb { background: radial-gradient(circle at 50% 45%, rgba(255,150,90,.34), rgba(255,120,80,.14) 60%, transparent 72%); box-shadow: 0 0 40px rgba(255,150,90,.26); }

    /* ── mobile bug-fixes ──────────────────────────────────────────────── */
    @media (max-width: 820px) {
      /* iOS auto-zooms text inputs under 16px on focus — force 16px across Nexus */
      .nx-view input, .nx-view textarea, .nx-view select,
      #nx-create-form input, #nx-tribe-form input { font-size: 16px; }
      /* a full-height room / DM takeover owns its own height — drop the shell's
         bottom reserve so the composer isn't double-offset / hidden behind the bar */
      .ap-main:has(.nx-room:not([hidden])) { padding-bottom: 0; }
    }

    /* Blak — the synthetic community member, shown as a named coral peer */
    .nx-blak { color: var(--coral); font-weight: 650; letter-spacing: -.01em; }
    html[data-theme="light"] .nx-blak { color: var(--coral-ink); }
    .nx-av-blak { background: linear-gradient(135deg, var(--coral), #ffb38a); box-shadow: 0 0 0 1px rgba(255,107,157,.35); }
    .nx-disc-blak, .nx-cmt-blak { border-color: rgba(255,107,157,.28); }

    /* safety sheet (report / block) + the ⋯ trigger */
    .nx-safety-card { width: min(420px, 100%); }
