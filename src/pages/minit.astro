---
// /minit — the Minit pillar page. Voice: happy, futuristic, "real people on demand"
// — the human side of your world. (Not framed as support/wellness.)
import Page from '../layouts/Page.astro';

const faqs = [
  {
    q: 'Who’s on the other end of Minit?',
    a: `Real, friendly people — humans who are genuinely up for a conversation. Not bots, not randoms who don’t get it. And yes, we vet everyone, so you’re always in good company. People to talk to, plan with, get hyped by, or just vibe with.`,
  },
  {
    q: 'Is Minit anonymous?',
    a: `Totally — anonymous by default. You’re you, with zero pressure to share more than you want. Found someone you click with? Reconnect anytime and pick up right where you left off, still on your terms.`,
  },
  {
    q: 'How do I connect with someone?',
    a: `Four ways: Instant Match (the next person, right now), Smart Match (matched on your vibe, topic, and language), Reconnect (someone you clicked with before), and Listener Discovery (browse and pick your person). 24/7, by text or voice.`,
  },
  {
    q: 'Is Minit free?',
    a: `It’s session-based, with free trials for new users, then premium subscriptions or pay-per-session. Blaksyd is pre-launch right now with an open waitlist.`,
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': 'https://blaksyd.com/minit/#webpage',
    url: 'https://blaksyd.com/minit/',
    name: 'Minit — real people, on demand, 24/7',
    description:
      'Minit is the human side of your Blaksyd world: real, friendly people available 24/7 by text or voice, anonymous by default — to talk, plan, and vibe with.',
    isPartOf: { '@id': 'https://blaksyd.com/#website' },
    about: { '@id': 'https://blaksyd.com/#organization' },
    breadcrumb: { '@id': 'https://blaksyd.com/minit/#breadcrumb' },
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: 'https://blaksyd.com/assets/blaksyd-minit.png',
      caption: 'Minit — real people on Blaksyd, available 24/7.',
    },
  },
  {
    '@type': 'FAQPage',
    '@id': 'https://blaksyd.com/minit/#faq',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Page
  title="Minit — real people, on demand, 24/7 | Blaksyd"
  description="Minit is the human side of your Blaksyd world: real, friendly people available 24/7 by text or voice, anonymous by default — to talk, plan, and vibe with, whenever you want."
  image="/assets/blaksyd-minit.png"
  kicker="Minit · real humans"
  kickerClass="k-mint"
  heading="Real people,"
  accent="whenever you want them."
  accentCool={true}
  lede="Sometimes you just want a real human in the mix. Minit brings friendly, real people into your world — 24/7, by text or voice, anonymous by default — to talk things through, plan something fun, or just vibe."
  heroImage="/assets/blaksyd-minit.png"
  heroAlt="Minit — real, friendly people on Blaksyd, available 24/7 by text or voice, anonymous by default."
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Minit', href: '/minit/' }]}
  schema={schema}
>
  <section>
    <h2>Real people, on tap</h2>
    <p>
      Minit is the human heartbeat of Blaksyd: friendly, genuine people who are actually up for a conversation —
      whenever you are. Want to brainstorm a trip, get a pep talk before the big thing, talk something out, or
      just shoot the breeze with someone who gets it? They’re right there. We vet everyone, so you’re always in
      good company.
    </p>
  </section>

  <section>
    <h2>Four ways to connect</h2>
    <ul>
      <li><b>Instant Match</b> — connect to the next available person, right now.</li>
      <li><b>Smart Match</b> — share your vibe, topic, and language, and we find your best match.</li>
      <li><b>Reconnect</b> — go back to someone you clicked with; the good ones get better over time.</li>
      <li><b>Listener Discovery (premium)</b> — browse people by style, languages, and ratings, and pick exactly who you want.</li>
    </ul>
    <p>Available <b>24/7, by text or voice</b>. Anonymous by default — you share only what you feel like sharing.</p>
  </section>

  <section>
    <h2>Warm from the first hello</h2>
    <p>
      The best part: you never start from scratch. Before you connect, <a href="/blak/">Blak</a> gives your
      person a quick sense of the conversation — context only, never your private stuff — so you skip the
      backstory and jump straight to the good part. It’s the AI and the human side of your world working
      together, just for you.
    </p>
    <p class="callout"><b>Minit is one of four pillars.</b> It works alongside <a href="/blak/">Blak</a> (your AI friend), <a href="/persona/">Persona</a> (your digital self), and <a href="/nexus/">Nexus</a> (your communities). <a href="/about/">See how they fit together →</a></p>
  </section>

  <section>
    <h2>Questions about Minit</h2>
    {faqs.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
  </section>
</Page>
