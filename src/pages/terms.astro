---
// Terms of Service — real page (replaces the old /terms static HTML).
// Built on the new Base layout; legal substance carried over from the prior
// Terms and modernised to the Blak / Persona / Minit / Nexus / Learning naming.
// NOTE: not legal advice — have counsel review before relying on it. The
// effective date and contact email below are placeholders to confirm.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const effective = 'June 2, 2026';
const contact = 'ceo@blaksyd.com';
---

<Base
  title="Terms of Service — Blaksyd"
  description="The terms that govern your use of Blaksyd — Blak, Persona, Minit, and Nexus."
>
  <main class="legal" id="main" tabindex="-1">
    <header class="legal-head">
      <a href="/" class="legal-brand" aria-label="Blaksyd — home">
        <span class="bm" aria-hidden="true"></span>
      </a>
      <h1>Terms of Service</h1>
      <p class="legal-meta">Effective {effective} · Blaksyd LLP · blaksyd.com</p>
    </header>

    <article class="legal-body">
      <p class="lede">
        These Terms of Service (“Terms”) govern your access to and use of the websites,
        apps, and services operated by <b>Blaksyd LLP</b> — including Blak, Persona, Minit,
        and Nexus. By using the services, you agree to these Terms.
      </p>

      <section>
        <h2>1. Acceptance</h2>
        <p>By accessing or using the services, you agree to these Terms and to our Privacy Policy.</p>
      </section>

      <section>
        <h2>2. Eligibility</h2>
        <p>
          The services are intended for adults aged <b>18 years or older</b>. They are not
          directed to anyone under 18, and we do not knowingly permit under-18s to create an
          account or use the services; where we learn a user is under 18, we may suspend or
          remove access. In India, the Digital Personal Data Protection Act, 2023 treats
          anyone under 18 as a child — during beta, Blaksyd is restricted to adults.
        </p>
      </section>

      <section>
        <h2>3. The services</h2>
        <p>
          Blaksyd may provide AI-assisted experiences (Blak, Persona), human-assisted
          connection (Minit), community rooms (Nexus), personalization, accounts,
          support tools, and related content. Features may change, launch, or be retired over time.
        </p>
      </section>

      <section>
        <h2>4. Not a medical, legal, or emergency service</h2>
        <p class="warn">
          <b>Important:</b> Blaksyd is not a substitute for medical, psychiatric, psychological,
          crisis, legal, or emergency services. In an emergency, contact the appropriate
          professionals, helplines, or emergency services immediately.
        </p>
      </section>

      <section>
        <h2>5. Your account</h2>
        <p>
          You agree to provide accurate information, keep your account secure, and take
          responsibility for activity under your account.
        </p>
      </section>

      <section>
        <h2>6. Your content</h2>
        <p>
          You may submit messages, journal entries, prompts, profile details, and other
          content (“Your Content”). <b>You keep ownership of Your Content.</b> You grant Blaksyd
          a non-exclusive, worldwide, royalty-free licence to host, process, store, and display
          it only as needed to operate, secure, moderate, and improve the services for you —
          subject to the Privacy Policy and your memory controls.
        </p>
      </section>

      <section>
        <h2>7. Acceptable use</h2>
        <p>You agree not to:</p>
        <ul>
          <li>Violate the law;</li>
          <li>Harass, threaten, exploit, or abuse others;</li>
          <li>Upload unlawful, infringing, or harmful material;</li>
          <li>Attempt to reverse engineer, scrape, or disrupt the services;</li>
          <li>Misuse the Minit features;</li>
          <li>Impersonate others or misrepresent a Persona as a real person;</li>
          <li>Use the platform to exploit minors or distribute prohibited content.</li>
        </ul>
      </section>

      <section>
        <h2>8. AI and human outputs</h2>
        <p>
          AI outputs may be inaccurate, incomplete, delayed, or unsuitable for your
          circumstances. Human support varies and is not professional counselling unless
          expressly stated. Always exercise your own judgement.
        </p>
      </section>

      <section>
        <h2>9. Payments</h2>
        <p>
          Some features may become paid in future. If so, pricing, billing, renewal, refund,
          and tax terms will be disclosed separately or through updated Terms before you are charged.
        </p>
      </section>

      <section>
        <h2>10. Suspension and termination</h2>
        <p>
          We may suspend, restrict, or terminate access for breach, safety concerns, fraud,
          abuse, legal risk, or to protect platform integrity.
        </p>
      </section>

      <section>
        <h2>11. Intellectual property</h2>
        <p>
          The software, trademarks, branding, designs, interfaces, and platform materials are
          owned by or licensed to Blaksyd. Your Content remains yours.
        </p>
      </section>

      <section>
        <h2>12. Privacy</h2>
        <p>Your use of the services is also governed by our <a href="/privacy/">Privacy Policy</a>.</p>
      </section>

      <section>
        <h2>13. Disclaimer</h2>
        <p>
          The services are provided on an “as is” and “as available” basis, to the maximum
          extent permitted by law.
        </p>
      </section>

      <section>
        <h2>14. Limitation of liability</h2>
        <p>
          To the maximum extent permitted by law, Blaksyd is not liable for indirect,
          incidental, special, consequential, exemplary, or punitive damages, or for loss of
          profits, goodwill, data, business opportunity, or emotional distress arising from
          your use of the services.
        </p>
      </section>

      <section>
        <h2>15. Indemnity</h2>
        <p>
          You agree to indemnify Blaksyd against claims arising from your misuse, your breach
          of these Terms, or your violation of any right or law.
        </p>
      </section>

      <section>
        <h2>16. Governing law</h2>
        <p>
          These Terms are governed by the laws of India. The courts at Hyderabad, Telangana
          have jurisdiction, subject to any mandatory consumer-law rights you may have.
        </p>
      </section>

      <section>
        <h2>17. Changes</h2>
        <p>We may update these Terms from time to time by posting the revised version with a new effective date.</p>
      </section>

      <section>
        <h2>18. Contact</h2>
        <p>Questions about these Terms? Contact <b>Blaksyd LLP</b> at <a href={`mailto:${contact}`}>{contact}</a>.</p>
      </section>
    </article>

    <a href="/" class="legal-back">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      Back to Blaksyd
    </a>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    max-width: 760px; margin-inline: auto;
    padding: clamp(5.5rem, 12vh, 8rem) clamp(1.25rem, 5vw, 2rem) clamp(4rem, 9vh, 6rem);
    position: relative; z-index: 1;
  }

  .legal-head { text-align: center; margin-bottom: clamp(2.4rem, 5vh, 3.6rem); }
  .legal-brand { display: inline-flex; align-items: center; transition: transform var(--t-fast) var(--ease-spring); }
  .legal-brand:hover { transform: scale(1.04); }
  /* one wordmark fetched per theme (CSS background — inactive theme never downloaded) */
  .bm {
    display: block; height: 28px; width: auto; aspect-ratio: 737 / 338;
    background: url('/assets/blaksyd-white.webp') center / contain no-repeat;
  }
  html[data-theme="light"] .bm {
    aspect-ratio: 758 / 329;
    background-image: url('/assets/blaksyd-black.webp');
  }

  .legal-head h1 {
    margin-top: 1.5rem;
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem); letter-spacing: -.03em; color: var(--ink);
  }
  .legal-meta {
    margin-top: .9rem;
    font-family: var(--font-mono); font-size: var(--fs-2xs);
    text-transform: uppercase; letter-spacing: .14em; color: var(--ink-faint);
  }

  .legal-body { color: var(--ink-soft); }
  .legal-body .lede {
    font-size: var(--fs-xl); line-height: 1.7; color: var(--ink);
    padding-bottom: 1.8rem; margin-bottom: .6rem; border-bottom: 1px solid var(--line);
  }
  .legal-body .lede b { font-weight: 600; }
  .legal-body section { margin-top: 2.1rem; }
  .legal-body h2 {
    font-family: var(--font-display); font-weight: 600;
    font-size: var(--fs-xl); letter-spacing: -.01em; color: var(--ink); margin-bottom: .7rem;
  }
  .legal-body p { font-size: var(--fs-lg); line-height: 1.75; margin-bottom: .8rem; }
  .legal-body b { color: var(--ink); font-weight: 600; }
  .legal-body ul { list-style: none; margin: .2rem 0 1rem; display: grid; gap: .55rem; }
  .legal-body li {
    position: relative; padding-left: 1.4rem; font-size: var(--fs-lg); line-height: 1.65;
  }
  .legal-body li::before {
    content: ''; position: absolute; left: .15rem; top: .62em;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent-grad);
  }
  .legal-body a { color: var(--coral); text-decoration: underline; text-underline-offset: 2px; }
  .legal-body a:hover { color: var(--coral-deep, var(--coral)); }
  html[data-theme="light"] .legal-body a { color: var(--coral-ink); }

  .legal-body .warn {
    margin-top: .4rem; padding: 1rem 1.1rem; border-radius: var(--r-md);
    background: rgba(255, 107, 157, .08); border: 1px solid rgba(255, 107, 157, .28);
    border-left: 3px solid var(--coral); color: var(--ink);
  }

  .legal-back {
    display: inline-flex; align-items: center; gap: .5rem;
    margin-top: clamp(3rem, 7vh, 4.5rem);
    font-size: var(--fs-base); font-weight: 600; color: var(--ink-soft);
    transition: color var(--t-fast) var(--ease-out), gap var(--t-fast) var(--ease-out);
  }
  .legal-back:hover { color: var(--ink); gap: .75rem; }
  .legal-back svg {
    width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2;
    stroke-linecap: round; stroke-linejoin: round;
  }
</style>
