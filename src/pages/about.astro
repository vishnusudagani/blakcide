//   2. states the company facts as crawlable text (entity / Knowledge Graph fuel)
// so search and AI engines converge on the same, correct description of Blaksyd
// and stop confusing the coined name with similar-sounding ones.
import Page from '../layouts/Page.astro';

const schema = [
  {
    '@type': 'AboutPage',
    '@id': 'https://blaksyd.com/about/#webpage',
    url: 'https://blaksyd.com/about/',
    name: 'About Blaksyd — one Human + AI world, built around you',
    description:
      'About Blaksyd: a Human + AI life platform of four pillars — Blak, Persona, Minit, Nexus — unified by a learning co-pilot layer. Operated by Blaksyd LLP, India.',
    isPartOf: { '@id': 'https://blaksyd.com/#website' },
    about: { '@id': 'https://blaksyd.com/#organization' },
    mainEntity: { '@id': 'https://blaksyd.com/#organization' },
