---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Spine from '../components/Spine.astro';
import Hero from '../components/Hero.astro';
import Lede from '../components/Lede.astro';
import Blak from '../components/Blak.astro';
import Persona from '../components/Persona.astro';
import Learning from '../components/Learning.astro';
import Minit from '../components/Minit.astro';
import Nexus from '../components/Nexus.astro';
import Faq from '../components/Faq.astro';
import WhyBlaksyd from '../components/WhyBlaksyd.astro';
import Finale from '../components/Finale.astro';
import Footer from '../components/Footer.astro';
import Microinteractions from '../components/Microinteractions.astro';
import TalkToBlak from '../components/TalkToBlak.astro';

// The homepage owns the brand line — the approved tagline ships as the <title>.
const title = 'Blaksyd — Human + AI, revolving around you.';
const description =
  'Human + AI, together, revolving around you. Blak knows you and acts for you, Persona is your digital self, Minit brings real listeners close, and Nexus is where you belong — one world, always learning you.';

// Single source of truth for the FAQ. The visible <Faq> on the page AND the
// FAQPage JSON-LD below are both built from this array, so the structured data
// always mirrors what a user can actually see (Google's requirement) and answer
// engines get identical, canonical text. Every answer is from "What is BLAKSYD?".
const faqs = [
  {
    q: 'What is Blaksyd?',
    a: `Blaksyd is a Human + AI life platform built around you — summed up as "Human + AI, together, revolving entirely around you." It combines four pillars: Blak and Persona on the AI side, and Minit and Nexus on the human side, unified by a learning co-pilot layer with Blak as the connective spine. Blaksyd is operated by Blaksyd LLP and is currently pre-launch with a waitlist.`,
  },
  {
    q: 'What is Blak?',
    a: `Blak is Blaksyd's proactive AI friend — not an assistant or a bot. Shaped uniquely around each user, it talks by text and voice anytime, checks in unprompted, plans your day, and can act across your connected apps (for example booking a cab, ordering food, or getting tickets). It learns continuously and hands off to a human Minit listener when something needs a real person.`,
  },
  {
    q: 'What is Persona?',
    a: `Persona is your digital self on Blaksyd. Real Persona is an evolving AI clone of you that you can train and share with friends under your control; Fantasy Persona lets you build characters such as a study buddy, a critic, or a hype person. When personas connect with each other, Blaksyd sees it as a new "future of social."`,
  },
  {
    q: 'What is Minit?',
    a: `Minit is Blaksyd's human connection layer: real listeners who are carefully trained through Blaksyd's own program and thoroughly screened. It is available 24/7 by text or voice, anonymous by default, with four ways to connect — Instant Match, Smart Match, Reconnect, and premium Listener Discovery. Minit is session-based with free trials, and offers real human support — not an emergency service.`,
  },
  {
    q: 'What is Nexus?',
    a: `Nexus is Blaksyd's community — part Threads, part Reddit, part X. It has persistent Tribes, live Discussion Rooms, and anonymous direct messages, with a feed built around you rather than around engagement metrics. Recognition comes through Resonance, Streaks, and Badges instead of vanity likes.`,
  },
  {
    q: 'Is Blaksyd private and anonymous?',
    a: `Yes. On Minit and Nexus you are anonymous by default, and you control what Blak and Persona remember. Blaksyd states that it does not sell your personal data.`,
  },
  {
    q: 'How much does Blaksyd cost?',
    a: `Blaksyd is pre-launch with an open waitlist. Minit is session-based, with free trials for new users and access through premium subscriptions or pay-per-session.`,
  },
  {
    q: 'Who can use Blaksyd?',
    a: `Blaksyd is intended for users aged 13 and over.`,
  },
  {
    q: 'Is Blaksyd a dating app or just a chatbot?',
    a: `No. Blaksyd is a Human + AI life platform — not a dating or romantic-companion app, and not a single AI chatbot. It combines AI (Blak and Persona) with real people (Minit and Nexus), all built around you. Minit offers real human connection and support; in an emergency, contact the appropriate professionals or helplines.`,
  },
  {
    q: 'What makes Blaksyd different from other apps?',
    a: `Most platforms solve one thing — social media gives you a feed but not a friend, chat apps give you messages but not meaning, AI tools give you answers but not companionship. Blaksyd brings it together around you: a proactive AI friend (Blak) and your digital self (Persona) on the AI side, and real human listeners (Minit) and your community (Nexus) on the human side — one platform, always learning you. It is not a single AI chatbot, not a dating or romantic-companion app, and not a substitute for professional care.`,
  },
  {
    q: 'Is Blaksyd safe to use?',
    a: `Safety is built in on both sides. Minit uses trained, screened listeners with two-sided safety protections and crisis resources one tap away; Minit and Nexus are anonymous by default; and you control what Blak and Persona remember. Blaksyd is intended for ages 13 and over and does not sell your personal data. It is not an emergency service — in a crisis, contact the appropriate professionals or helplines.`,
  },
  {
    q: 'Who is behind Blaksyd?',
    a: `Blaksyd is built and operated by Blaksyd LLP, a company based in India (Hyderabad, Telangana). It is currently pre-launch. You can reach the team at ceo@blaksyd.com.`,
  },
  {
    q: 'How do I join Blaksyd, and when does it launch?',
    a: `Blaksyd is pre-launch with an open waitlist — join from the homepage to get early access. When Minit opens, new users will get free trials.`,
  },
  {
    q: 'Is Blaksyd available in India?',
    a: `Yes. Blaksyd is built in India and operated by Blaksyd LLP, with an India-first focus, and is available to anyone aged 13 and over as it rolls out. It is currently pre-launch with an open waitlist.`,
  },
];

// Homepage JSON-LD (folded into Base's site-wide @graph). SoftwareApplication
// types the product; WebPage adds a Speakable hint for voice assistants; FAQPage
// is generated from `faqs` so it always matches the visible FAQ. No invented
// ratings or prices.
const pageSchema = [
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://blaksyd.com/#app',
    name: 'Blaksyd',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    url: 'https://blaksyd.com/',
    description:
      'Blaksyd is a Human + AI life platform: Blak (a proactive AI friend) and Persona (your AI digital self) on the AI side; Minit (24/7 real human listeners) and Nexus (your community) on the human side — unified by a learning co-pilot layer.',
    publisher: { '@id': 'https://blaksyd.com/#organization' },
    featureList: [
      'Blak — proactive AI friend over text and voice that acts across your apps',
      'Persona — your AI digital self, Real and Fantasy',
      'Minit — 24/7 real human listeners, anonymous by default',
      'Nexus — community of tribes, live discussion rooms, and anonymous DMs',
    ],
  },
  {
    '@type': 'WebPage',
    '@id': 'https://blaksyd.com/#webpage',
    url: 'https://blaksyd.com/',
    name: title,
    description,
    isPartOf: { '@id': 'https://blaksyd.com/#website' },
    about: { '@id': 'https://blaksyd.com/#organization' },
    // Voice assistants may read these sections aloud — the definition and the FAQ.
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.lede-def', '.faq-q', '.faq-a'],
    },
  },
  {
    '@type': 'FAQPage',
    '@id': 'https://blaksyd.com/#faq',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={title} description={description} schema={pageSchema}>
  <Nav />
  <Spine />
  <main>
    <Hero />
    {/* one crawlable, plain-language definition (SEO/AEO/GEO) before the deep dive */}
    <Lede />
    {/* AI side — the minds that know you. A held warm stage carries both cards. */}
    <div class="act act-ai">
      <div class="act-stage" aria-hidden="true">
        <span class="act-aura"></span>
      </div>
      <Blak />
      <Persona />
    </div>
    {/* try-it moment — a scripted, no-API taste of talking to Blak */}
    <TalkToBlak />
    {/* keystone — the engine that ties both sides */}
    <Learning />
    {/* Human side — the people who show up. A held cool stage carries both cards. */}
    <div class="act act-human">
      <div class="act-stage" aria-hidden="true">
        <span class="act-aura"></span>
      </div>
      <Minit />
      <Nexus />
    </div>
    {/* the questions a first-time visitor — and answer engines — actually ask */}
    <Faq items={faqs} />
    {/* the one-line "why we exist" — brand-signed, with optional voice-over */}
    <WhyBlaksyd />
    {/* payoff + the two real CTAs */}
    <Finale />
  </main>
  <Footer />
  {/* desktop-only pointer micro-interactions (card tilt + magnetic CTA) */}
  <Microinteractions />
</Base>
